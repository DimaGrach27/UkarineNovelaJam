    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u0456\u0441\u043A\u043E\u0447\u0438\u0442\u0438
        \u0432\u043D\u0438\u0437 \u044F\u043A\u043E\u043C\u043E\u0433\u0430 \u0448\u0432\u0438\u0434\u0448\u0435,
        \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u044E\u0447\u0438\u0441\u044C
        \u043D\u0430 \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_209_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0443\u0441\u043A\u0430\u0442\u0438\u0441\u044F \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E,
        \u043F\u043E \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
        \u0442\u0440\u0438\u043C\u0430\u044E\u0447\u0438\u0441\u044C \u0440\u0443\u043A\u043E\u044E
        \u0437\u0430 \u043E\u043F\u043E\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_209_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u0438\u0441\u044C \u043C\u0456\u0441\u0446\u0435\u043C,
        \u044F\u043A\u0435 \u0437\u0430\u0440\u043E\u0441\u043B\u043E \u0442\u0440\u0430\u0432\u043E\u044E
        \u0456 \u043C\u0430\u043B\u043E \u0447\u0456\u043F\u043A\u0456\u0448\u0438\u0439
        \u0491\u0440\u0443\u043D\u0442."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0443, \u0449\u043E \u0436, \u0431\u0443\u043B\u0430 \u043D\u0435
        \u0431\u0443\u043B\u0430!"
    - Language: 1
      Text: 
  - Key: scene_4_210_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C
        \u043D\u0430 \u043C\u0456\u0437\u0435\u0440\u043D\u0438\u0439 \u0448\u0430\u043D\u0441
        \u0432\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u0443
        \u0456 \u044F\u043A\u0443\u0441\u044C \u0435\u0444\u0435\u043C\u0435\u0440\u043D\u0443
        \u0431\u043E\u0436\u0443 \u043F\u043E\u043C\u0456\u0447, \u044F \u043C\u0435\u0442\u043D\u0443\u043B\u0441\u044F
        \u0441\u0445\u0438\u043B\u043E\u043C \u0443\u043D\u0438\u0437. \u041D\u043E\u0433\u0438
        \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0437\u0430\u043A\u043E\u0432\u0437\u0430\u043B\u0438
        \u043F\u043E \u0431\u043E\u0433\u043D\u044E\u0446\u0456. \u0411\u0435\u0437
        \u0436\u043E\u0434\u043D\u0438\u0445 \u0437\u0443\u0441\u0438\u043B\u044C
        \u0456\u0437 \u043C\u043E\u0454\u0457 \u0441\u0442\u043E\u0440\u043E\u043D\u0438,
        \u043C\u0435\u043D\u0435 \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u043B\u043E
        \u0432\u043D\u0438\u0437."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u043C\u0430\u0433\u0430\u044E\u0447\u0438\u0441\u044C \u0445\u043E\u0447
        \u044F\u043A\u043E\u0441\u044C \u0431\u0430\u043B\u0430\u043D\u0441\u0443\u0432\u0430\u0442\u0438
        \u0430-\u043B\u044F \u043A\u0430\u043D\u0430\u0442\u043E\u0445\u043E\u0434\u0435\u0446\u044C,
        \u044F \u0445\u0438\u043B\u0438\u0442\u0430\u043B\u0430\u0441\u044F \u0437\u0456
        \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u0406\u043D\u043E\u0434\u0430 \u0431\u0456\u0433\u043B\u0430, \u0456\u043D\u043E\u0434\u0456
        \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0438\u0431\u0443\u0432\u0430\u043B\u0438
        \xAB\u043F\u0440\u0456\u0440\u0432\u0438\xBB, \u0430 \u0456\u043D\u043E\u0434\u0456
        \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u2019\u0457\u0436\u0434\u0436\u0430\u043B\u0430
        \u0432\u043D\u0438\u0437. \u0421\u043F\u0443\u0441\u043A \u0442\u0440\u0438\u0432\u0430\u0432
        \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0441\u0435\u043A\u0443\u043D\u0434, \u0430\u043B\u0435 \u043C\u0435\u043D\u0456
        \u0437\u0434\u0430\u0432\u0441\u044F \u0432\u0456\u0447\u043D\u0456\u0441\u0442\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0436 \u043E\u0441\u044C \u044F \u0431\u0443\u043B\u0430 \u0432\u0436\u0435
        \u043C\u0430\u0439\u0436\u0435 \u0432\u043D\u0438\u0437\u0443. \u0417\u0435\u043C\u043B\u044F
        \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u043B\u0430\u0441\u044F
        \u0443 \u0437\u0432\u0438\u0447\u043D\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0435
        \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F. \u0406 \u0432 \u0441\u0430\u043C\u0435
        \u0432 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u044F \u043F\u043E\u0447\u0443\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_210_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0440\u0443\u0441\u044C!.."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u0434\u0443\u0447\u0438\u0439 \u0431\u0456\u043B\u044C \u043F\u043E\u0448\u0438\u0440\u0438\u0432\u0441\u044F
        \u043C\u043E\u0454\u044E \u043D\u043E\u0433\u043E\u044E. \u0412\u043E\u043D\u0430
        \u0432\u0438\u0433\u043D\u0443\u043B\u0430\u0441\u044C \u0443 \u043D\u0435\u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044C\u043E\u043C\u0443
        \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u0456, \u0456 \u0432\u0456\u0434
        \u0446\u0456\u0454\u0457 \u0440\u0456\u0437\u043A\u043E\u0441\u0442\u0456
        \u044F \u043C\u0430\u043B\u043E \u043D\u0435 \xAB\u0432\u0434\u0430\u0440\u0438\u043B\u0430
        \u043E\u0431\u043B\u0438\u0447\u0447\u044F\u043C \u0443 \u0431\u043E\u043B\u043E\u0442\u043E\xBB."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u043D\u0435 \u0432\u0442\u0440\u0438\u043C\u0430\u043B\u0430\u0441\u044C
        \u0432\u0456\u0434 \u043A\u0430\u043B\u0430\u043C\u0431\u0443\u0440\u0443.
        \u0410 \u043E\u0441\u044C \u0456\u0437 \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u043E\u044E
        \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E \u0431\u0456\u043B\u044C\u0448\u0435
        -- \u0457\u0457 \u044F \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438
        \u0432\u0442\u0440\u0438\u043C\u0430\u043B\u0430!"
    - Language: 1
      Text: 
  - Key: scene_4_210_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u0447 \u0443 \u043D\u043E\u0437\u0456 \u0449\u0435 \u0441\u0438\u043B\u044C\u043D\u043E
        \u0439 \u043F\u0435\u043A\u043B\u043E, \u0430\u043B\u0435 \u044F\u043A \u0432\u043F\u0440\u0430\u0432\u043D\u0438\u0439
        \u0430\u043C\u0430\u0442\u043E\u0440 \u0441\u0435\u0440\u0435\u0434 \u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0456\u0432
        \u0443 \u0441\u0444\u0435\u0440\u0456 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0438
        \u044F \u0437\u0440\u043E\u0431\u0438\u043B\u0430 \u0432\u0438\u0441\u043D\u043E\u0432\u043E\u043A,
        \u0449\u043E \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0437\u043B\u0430\u043C\u0430\u043B\u0430
        \u0439 \u043D\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0438\u0439
        \u0432\u0438\u0432\u0438\u0445."
    - Language: 1
      Text: 
  - Key: scene_4_210_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u043C\u0438
        \u043B\u0456\u043A\u0430\u043C\u0438 \u0431\u0443\u043B\u043E \u0441\u0442\u0438\u0441\u043D\u0443\u0442\u0438
        \u0437\u0443\u0431\u0438 \u0439 \u043D\u0435 \u0436\u0430\u043B\u0456\u0442\u0438\u0441\u044F.
        \u0420\u043E\u0437\u0435\u0442\u0435\u0440\u0448\u0438 \u0431\u0456\u043B\u044C
        \u0443 \u043D\u043E\u0437\u0456, \u044F \u0432\u0440\u0435\u0448\u0442\u0456
        \u0440\u0443\u0448\u0438\u043B\u0430 \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430,
        \u0430\u0434\u0436\u0435 \u0432\u0456\u043D \u0431\u0443\u0432 \u0443\u0436\u0435
        \u043D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456 \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u043E\u0457
        \u0440\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0443, \u0449\u043E \u0436, \u0431\u0443\u043B\u0430 \u043D\u0435
        \u0431\u0443\u043B\u0430!"
    - Language: 1
      Text: 
  - Key: scene_4_211_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043D\u0430 \u0441\u0445\u0438\u043B
        \u043E\u0434\u0438\u043D \u0440\u0430\u0437, \u043F\u043E\u0442\u0456\u043C
        \u0434\u0440\u0443\u0433\u0438\u0439. \u041F\u043E\u0432\u043E\u043B\u0456
        \u044F \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u0430\u0441\u044F \u0434\u043E\u0434\u043E\u043B\u0443.
        \u0422\u0440\u043E\u0445\u0438 \u043F\u0440\u0438\u0445\u0438\u043B\u0438\u0432\u0448\u0438\u0441\u044C
        \u0443\u0431\u0456\u043A, \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u043F\u0440\u0438\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
        \u0440\u0443\u0445 \u0440\u0443\u043A\u043E\u044E, \u0445\u043E\u0447 \u0456
        \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u0434\u043E\u0431\u0440\u044F\u0447\u0435
        \u043F\u043E\u043A\u043E\u043F\u0438\u0440\u0441\u0430\u0442\u0438\u0441\u044F
        \u0432 \u0431\u0430\u0433\u043D\u044E\u0446\u0456. \u0422\u0430 \u0446\u0435
        \u0431\u0443\u043B\u0430 \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u043D\u0430
        \u043F\u043B\u0430\u0442\u0430 \u0437\u0430 \u043D\u0435\u0437\u043B\u0430\u043C\u0430\u043D\u0443
        \u0448\u0438\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u044F \u0456 \u0440\u0443\u0445\u0430\u043B\u0430\u0441\u044F
        \u0432\u0441\u0435 \u043D\u0438\u0436\u0447\u0435, \u043A\u0440\u043E\u043A
        \u0437\u0430 \u043A\u0440\u043E\u043A\u043E\u043C\u2026 \u041E\u0431\u0435\u0440\u0435\u0436\u043D\u0435\u043D\u044C\u043A\u043E\u2026
        \u041F\u0440\u043E\u043C\u0430\u0446\u0443\u044E\u0447\u0438 \u0448\u043B\u044F\u0445,
        \u0449\u043E\u0431 \u043D\u0435 \u0441\u0442\u0443\u043F\u0430\u0442\u0438
        \u0432 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0441\u043B\u0438\u0437\u044C\u043A\u0443
        \u0432\u043E\u0433\u043A\u0443 \u0437\u0435\u043C\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u0435 \u0442\u0440\u0456\u0448\u0435\u0447\u043A\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_211_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0436 \u043E\u0441\u044C \u044F \u0431\u0443\u043B\u0430 \u0432\u0436\u0435
        \u043C\u0430\u0439\u0436\u0435 \u0432\u043D\u0438\u0437\u0443. \u0417\u0435\u043C\u043B\u044F
        \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u0432\u043E \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u043B\u0430\u0441\u044F
        \u0443 \u0437\u0432\u0438\u0447\u043D\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u0435
        \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044F. \u041B\u0438\u0448\u0438\u043B\u043E\u0441\u044C
        \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u043C\u0435\u0442\u0440\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0428-\u0443-\u0443\u0445!.."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u0441\u0430\u043C\u0435
        \u0432 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u043C\u043E\u044F
        \u043D\u043E\u0433\u0430 \u043F\u0456\u0434\u043B\u0435\u0442\u0456\u043B\u0430,
        \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u0430\u0436 \u0434\u043E
        \u0441\u0430\u043C\u043E\u0433\u043E \u043D\u0435\u0431\u0430. \u0422\u0456\u043B\u043E
        \u0437\u0430\u0432\u0435\u0440\u0442\u0456\u043B\u043E\u0441\u044F \u0443
        \u0432\u0438\u0434\u043E\u0432\u0438\u0449\u043D\u043E\u043C\u0443 \u043F\u0456\u0440\u0443\u0435\u0442\u0456
        \u2014 \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u0437\u0430\u0440\u0430\u0437
        \u044F \u0441\u043E\u0431\u0456 \u0446\u0435 \u0442\u0430\u043A \u0443\u044F\u0432\u043B\u044F\u044E.
        \u0406 \u0432\u0441\u0456\u0454\u044E \u0432\u0430\u0433\u043E\u044E \u043C\u0435\u043D\u0435
        \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u043B\u043E \u0432\u043D\u0438\u0437."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u0438 \u0437\u043B\u0430\u043C\u0430\u043D\u043E\u0457
        \u0448\u0438\u0457 \u0432 \u043E\u0434\u0438\u043D \u043C\u043E\u043C\u0435\u043D\u0442
        \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u0431\u043B\u0438\u0436\u0447\u0438\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_211_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0404\u0434\u0438\u043D\u0438\u043C \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043A\u043E\u043C
        \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F \u0437\u0430 \u0449\u043E\u0441\u044C
        \u0432\u0445\u043E\u043F\u0438\u0442\u0438\u0441\u044C, \u043F\u0440\u043E\u0442\u0435
        \u0440\u043E\u0431\u0438\u0442\u0438 \u0446\u0435 \u0442\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u043C\u0438\u0442\u0442\u0454\u0432\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_211_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0445\u043E\u043F\u0438\u0442\u0438\u0441\u044F \u0437\u0430
        \u043A\u0430\u043C\u0456\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_4_211_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0445\u043E\u043F\u0438\u0442\u0438\u0441\u044F \u0437\u0430
        \u0441\u0443\u0445\u0443 \u0440\u043E\u0441\u043B\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_212_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0457 \u043F\u0430\u043B\u044C\u0446\u0456 \u043B\u0435\u0434\u044C-\u043B\u0435\u0434\u044C
        \u0434\u0456\u0441\u0442\u0430\u043B\u0438 \u0434\u043E \u0443\u043B\u0430\u043C\u043A\u0443
        \u0432\u0435\u043B\u0438\u043A\u043E\u0457 \u043D\u0435\u0437\u0433\u0440\u0430\u0431\u043D\u043E\u0457
        \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0438, \u044F\u043A\u0430 \u0441\u0442\u0438\u0440\u0447\u0430\u043B\u0430
        \u0456\u0437 \u0437\u0435\u043C\u043B\u0456 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0456\u043A.
        \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0440\u0443\u043A\u0430
        \u0448\u0432\u0438\u0434\u043A\u043E \u043A\u043E\u0432\u0437\u043D\u0443\u043B\u0430
        \u043F\u043E \u043D\u0456\u0439, \u0430\u043B\u0435 \u0432 \u043E\u0441\u0442\u0430\u043D\u043D\u044E
        \u043C\u0438\u0442\u044C \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0432\u0445\u043E\u043F\u0438\u0442\u0438\u0441\u044F \u0446\u0443\u043F\u043A\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_212_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u0443\u0445!"
    - Language: 1
      Text: 
  - Key: scene_4_212_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041B\u0438\u0448\u0435 \u0434\u043B\u044F \u0442\u043E\u0433\u043E,
        \u0430\u0431\u0438 \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0430 \u0432\u0438\u0441\u043B\u0438\u0437\u043D\u0443\u043B\u0430
        \u0437\u0456 \u0441\u0432\u043E\u0454\u0457 \u0432\u043E\u0433\u043A\u043E\u0457
        \u0437\u0435\u043C\u043B\u044F\u043D\u043E\u0457 \u043B\u0443\u043D\u043A\u0438
        \u043F\u0456\u0434 \u043C\u043E\u0454\u044E \u0432\u0430\u0433\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_212_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0430\u0434\u0441\u0442\u0432\u043E, \u0442\u0430\u043A \u0456
        \u0437\u043D\u0430\u043B\u0430, \u0449\u043E \u043D\u0435 \u0442\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u043A\u0443\u043F\u0443\u0432\u0430\u0442\u0438
        \u0437\u0440\u0430\u043D\u043A\u0443 \u0442\u043E\u0439 \u043F\u0430\u043D\u0456\u043D\u0456!"
    - Language: 1
      Text: 
  - Key: scene_4_212_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u0434\u043E\u0434\u043E\u043B\u0443
        \u043A\u043E\u0442\u0438\u043B\u0438\u0441\u044F \u043C\u0438 \u0434\u0432\u043E\u0454.
        \u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430
        \u0449\u043E \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0454 \u043A\u0443\u043B\u044F
        \u0441\u043D\u0456\u0433\u0443, \u044F\u043A\u0430 \u0441\u043A\u043E\u0447\u0443\u0454\u0442\u044C\u0441\u044F
        \u0437 \u0432\u0438\u0441\u043E\u043A\u043E\u0457 \u0433\u0456\u043C\u0430\u043B\u0430\u0439\u0441\u044C\u043A\u043E\u0457
        \u0433\u043E\u0440\u0438. \u0423\u0441\u0435 \u0442\u0456\u043B\u043E \u0430\u0436
        \u043F\u0456\u0434\u0441\u043A\u0430\u043A\u0443\u0432\u0430\u043B\u043E
        \u0432\u0438\u0431\u043E\u0457\u043D\u0430\u0445, \u0443 \u0432\u0443\u0445\u0430\u0445
        \u043D\u0435\u0449\u0430\u0434\u043D\u043E \u0442\u0440\u0456\u0441\u043A\u043E\u0442\u0456\u043B\u043E,
        \u0430 \u0440\u043E\u0442 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
        \u0437\u0430\u0431\u0438\u0432\u0441\u044F \u043C\u043E\u043A\u0440\u043E\u044E
        \u0437\u0435\u043C\u043B\u0435\u044E. (-2 \u0417\u0434\u043E\u0440\u043E\u0432\u2019\u044F)"
    - Language: 1
      Text: 
  - Key: scene_4_212_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u043E\u043B\u044F\u0447\u0435 \u0431\u0443\u043B\u043E \u043F\u0440\u043E\u0441\u0442\u043E
        \u0436\u0430\u0445\u043B\u0438\u0432\u043E, \u0430\u043B\u0435 \u043C\u043E\u044F
        \u0441\u043F\u0440\u043E\u0431\u0430 \u0432\u0440\u0435\u0448\u0442\u0456
        \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0430 \u043C\u0435\u043D\u0456
        \u0436\u0438\u0442\u0442\u044F. \u0410\u0434\u0436\u0435 \u043A\u043E\u043B\u0438
        \u044F \u043D\u0435\u0441\u0430\u043C\u043E\u0432\u0438\u0442\u043E \u0441\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044F
        \u0437\u0430 \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0443, \u043C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0445\u043E\u0447 \u0442\u0440\u043E\u0445\u0438
        \u0437\u043C\u0435\u043D\u0448\u0438\u0442\u0438 \u0442\u0435\u043C\u043F
        \u043F\u0430\u0434\u0456\u043D\u043D\u044F \u0456 \u0432\u0441\u0435 \u0436
        \u0437\u0430\u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F \u0436\u0438\u0432\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_212_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0441\u0442\u0430\u043B\u0430 \u0456 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u043F\u0440\u0438\u0432\u0435\u0441\u0442\u0438 \u0441\u0435\u0431\u0435
        \u0434\u043E \u043B\u0430\u0434\u0443. \u0423\u0441\u0456 \u0447\u043E\u0440\u043D\u0430
        \u0432\u0456\u0434 \u0431\u0440\u0443\u0434\u0443, \u0437 \u0442\u0440\u0435\u043C\u0442\u0456\u043D\u043D\u044F\u043C
        \u0443 \u0441\u0443\u0433\u043B\u043E\u0431\u0430\u0445 \u0442\u0430 \u0441\u0438\u043D\u0446\u044F\u0445,
        \u044F\u043A\u0456 \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u043B\u0438
        \u043F\u043E\u043A\u0440\u0438\u0442\u0438 \u0447\u0438 \u043D\u0435 \u0432\u0441\u0435
        \u0442\u0456\u043B\u043E, \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u0449\u043E \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u043C\u0438
        \u043B\u0456\u043A\u0430\u043C\u0438 \u0431\u0443\u043B\u043E \u0441\u0442\u0438\u0441\u043D\u0443\u0442\u0438
        \u0437\u0443\u0431\u0438 \u0439 \u043D\u0435 \u0436\u0430\u043B\u0456\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_212_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F
        \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u043E\u0441\u044F,
        \u0442\u043E\u043C\u0443 \u044F \u0440\u0443\u0448\u0438\u043B\u0430 \u0434\u043E
        \u0431\u0435\u0440\u0435\u0433\u0430, \u0430\u0434\u0436\u0435 \u0432\u0456\u043D
        \u0431\u0443\u0432 \u0443\u0436\u0435 \u043D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
        \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u043E\u0457 \u0440\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_213_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0457 \u043F\u0430\u043B\u044C\u0446\u0456 \u043B\u0435\u0434\u044C-\u043B\u0435\u0434\u044C
        \u0434\u0456\u0441\u0442\u0430\u043B\u0438 \u0434\u043E \u0441\u0443\u0445\u043E\u0433\u043E
        \u0432\u0456\u0434\u0440\u043E\u0441\u0442\u043A\u0443 \u0431\u0443\u0440\u2019\u044F\u043D\u0443
        \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E\u0433\u043E
        \u043F\u043E\u0445\u043E\u0434\u0436\u0435\u043D\u043D\u044F \u0442\u0430
        \u0432\u0438\u0434\u0443. \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u0440\u0443\u043A\u0430 \u0448\u0432\u0438\u0434\u043A\u043E \u043A\u043E\u0432\u0437\u043D\u0443\u043B\u0430
        \u043F\u043E \u043D\u0456\u0439, \u0430\u043B\u0435 \u0432 \u043E\u0441\u0442\u0430\u043D\u043D\u044E
        \u043C\u0438\u0442\u044C \u044F \u0432\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044F
        \u0442\u0430\u043A, \u043D\u0456\u0431\u0438 \u0437\u043D\u0438\u0437\u0443
        \u0441\u0445\u0438\u043B\u0443 \u0432\u0436\u0435 \u0441\u0430\u043C\u0435
        \u043F\u0435\u043A\u043B\u043E \u0440\u043E\u0437\u043A\u0440\u0438\u0432\u0430\u043B\u043E
        \u043E\u0431\u0456\u0439\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_213_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0434\u0430\u043B\u043E\u0441\u044F!"
    - Language: 1
      Text: 
  - Key: scene_4_213_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u0447 \u0440\u043E\u0441\u043B\u0438\u043D\u0430 \u0439
        \u0432\u0438\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044F \u0437\u0430\u0441\u043E\u0445\u043B\u043E\u044E,
        \u0442\u0430, \u0441\u0445\u043E\u0436\u0435, \u0436\u0438\u0442\u0438 \u0445\u043E\u0442\u0456\u043B\u0430
        \u043D\u0435 \u043C\u0435\u043D\u0448\u0435 \u0437\u0430 \u043C\u0435\u043D\u0435,
        \u0442\u043E\u043C\u0443 \u0434\u0443\u0436\u0435 \u0446\u0443\u043F\u043A\u043E
        \u0442\u0440\u0438\u043C\u0430\u043B\u0430\u0441\u044F \u0432 \u0437\u0435\u043C\u043B\u0456."
    - Language: 1
      Text: 
  - Key: scene_4_213_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435 \u0431\u0443\u043B\u043E \u0441\u0445\u043E\u0436\u0435
        \u043D\u0430 \u0440\u044F\u0442\u0456\u0432\u043D\u0438\u0439 \u043A\u0430\u043D\u0430\u0442,
        \u0456 \u0445\u043E\u0447 \u044F \u043E\u0431\u0434\u0435\u0440\u043B\u0430
        \u0434\u043E\u043B\u043D\u0456 \u043D\u0456\u0431\u0438 \u0446\u0456\u043B\u0438\u0439
        \u0434\u0435\u043D\u044C \u043F\u0456\u0434\u0442\u044F\u0433\u0443\u0432\u0430\u043B\u0430\u0441\u044F
        \u043D\u0430 \u0442\u0443\u0440\u043D\u0456\u043A\u0443, \u0430\u043B\u0435
        \u0436\u0438\u0442\u0442\u044F \u0431\u0443\u043B\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_4_213_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0438\u0440\u0456\u0432\u043D\u044F\u043B\u0430 \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u0443
        \u0456 \u0432\u0436\u0435 \u043B\u0435\u0433\u043A\u043E \u0437\u043C\u043E\u0433\u043B\u0430
        \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438 \u0437\u0430\u043B\u0438\u0448\u043E\u043A
        \u0448\u043B\u044F\u0445\u0443 \u0434\u043E\u0434\u043E\u043B\u0443. \u0417\u0432\u0456\u0434\u0441\u0438
        \u0431\u0435\u0440\u0435\u0433 \u043E\u0437\u0435\u0440\u0430 \u0431\u0443\u0432
        \u0443\u0436\u0435 \u043D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
        \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u043E\u0457 \u0440\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_214_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0443\u0434\u043E\u0432\u0430 \u0456\u0434\u0435\u044F!"
    - Language: 1
      Text: 
  - Key: scene_4_214_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0435\u0440\u0439\u043E\u0437\u043D\u043E. \u0411\u0435\u0437
        \u0441\u0430\u0440\u043A\u0430\u0437\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_214_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u043E\u0433\u0438 \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435
        \u043A\u043E\u0432\u0437\u0430\u043B\u0438 \u043D\u0430 \u0442\u0440\u0430\u0432\u0456,
        \u0441\u043F\u0443\u0441\u043A \u0434\u0430\u0432\u0441\u044F \u043B\u0435\u0433\u043A\u043E,
        \u0456 \u0441\u043A\u043E\u0440\u043E \u044F \u0431\u0443\u043B\u0430 \u0431\u0456\u043B\u044F
        \u043F\u0456\u0434\u043D\u0456\u0436\u0436\u044F \u0441\u0445\u0438\u043B\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_214_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0436, \u0432\u0456\u043D \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F
        \u043D\u0435 \u0442\u0430\u043A\u0438\u043C \u0443\u0436\u0435 \u0456 \u0441\u0442\u0440\u0430\u0448\u043D\u0438\u043C,
        \u044F\u043A \u0437\u0434\u0430\u0432\u0441\u044F \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443.
        \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0456\u043D\u043E\u0434\u0456
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u0456\u044F\u0442\u0438
        \u0441\u043C\u0456\u043B\u0438\u0432\u0456\u0448\u0435. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E,
        \u044F\u043A\u0449\u043E \u0446\u0435 \u043F\u0456\u0434\u043A\u0430\u0437\u0443\u0454
        \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434 \u2014 \u043C\u0456\u0439
        \u043F\u043E\u043C\u0456\u0447\u043D\u0438\u043A, \u044F\u043A\u043E\u0433\u043E
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_214_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0435\u0448\u0442\u0456 \u044F \u0440\u0443\u0448\u0438\u043B\u0430
        \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430, \u0430\u0434\u0436\u0435
        \u0432\u0456\u043D \u0431\u0443\u0432 \u0443\u0436\u0435 \u043D\u0430 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
        \u0432\u0438\u0442\u044F\u0433\u043D\u0443\u0442\u043E\u0457 \u0440\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_31_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u043D\u043E\u0447\u0456 \u0432\u043E\u0434\u0430 \u0431\u0443\u043B\u043E
        \u0447\u043E\u0440\u043D\u043E\u044E, \u043D\u0435\u043C\u043E\u0432 \u043A\u043E\u0441\u043C\u0456\u0447\u043D\u0430
        \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0430. \u0412\u043E\u0434\u043E\u0439\u043C\u0430
        \u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044F \u043D\u0435\u043D\u0430\u0436\u0435\u0440\u043B\u0438\u0432\u043E\u044E
        \u043F\u0430\u0449\u0435\u044E, \u044F\u043A\u0430 \u043F\u0440\u0430\u0433\u043D\u0435
        \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u0442\u0438 \u0432\u0441\u0435
        \u0441\u0435\u043B\u043E, \u0443\u0441\u0456 \u043E\u043A\u043E\u043B\u0438\u0446\u0456
        \u041C\u0456\u0440\u0447\u0443, \u0456 \u043C\u0435\u043D\u0435 \u0440\u0430\u0437\u043E\u043C
        \u0456\u0437 \u043D\u0438\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_31_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u044F \u043C\u0430\u043B\u0430 \u043F\u0435\u0440\u0435\u0431\u043E\u0440\u043E\u0442\u0438
        \u0441\u0442\u0440\u0430\u0445 \u0456 \u043D\u0430\u0431\u043B\u0438\u0437\u0438\u0442\u0438\u0441\u044F
        \u0434\u043E \u0432\u043E\u0434\u0438, \u043F\u0440\u043E\u0442\u043E\u0440\u043E\u0432\u0443\u044E\u0447\u0438
        \u0448\u043B\u044F\u0445 \u043A\u0440\u0456\u0437\u044C \u0437\u0430\u0440\u043E\u0441\u0442\u0456
        \u043E\u0447\u0435\u0440\u0435\u0442\u0443. \u041C\u0435\u043D\u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0441\u044F
        \u0432\u0438\u0434 \u043D\u0430 \u043F\u0456\u0449\u0430\u043D\u0438\u0439
        \u0431\u0435\u0440\u0435\u0433, \u043E\u0437\u0434\u043E\u0431\u043B\u0435\u043D\u0438\u0439
        \u0437\u0435\u043B\u0435\u043D\u043E\u044E \u0442\u0432\u0430\u043D\u043D\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_31_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0440\u043E\u0445\u0438 \u043B\u0456\u0432\u0456\u0448\u0435
        \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E \u0440\u043E\u0437\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
        \u043D\u0435\u0432\u0435\u043B\u0438\u0447\u043A\u0438\u0439 \u0445\u0438\u0441\u0442\u043A\u0438\u0439
        \u043F\u0456\u0440\u0441, \u044F\u043A\u0438\u0439, \u0448\u0432\u0438\u0434\u0448\u0435
        \u0437\u0430 \u0432\u0441\u0435, \u0431\u0443\u0432 \u0443\u043B\u044E\u0431\u043B\u0435\u043D\u0438\u043C
        \u043C\u0456\u0441\u0446\u0435\u043C \u0437\u0431\u043E\u0440\u0456\u0432
        \u0441\u0456\u043B\u044C\u0441\u044C\u043A\u0438\u0445 \u0440\u0438\u0431\u0430\u043B\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_4_31_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435\u0441\u044C \u0442\u0443\u0442 \u0456 \u0441\u0442\u0430\u043B\u043E\u0441\u044F
        \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u041A\u043E\u0440\u043D\u0456\u044F.
        \u0423 \u0442\u0435\u043C\u043D\u043E\u0442\u0456 \u0446\u044C\u043E\u0433\u043E
        \u043C\u0456\u0441\u0446\u044F \u0442\u043E\u0447\u043D\u043E \u043A\u0440\u0438\u044E\u0442\u044C\u0441\u044F
        \u0434\u0435\u044F\u043A\u0456 \u0437 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0438\u0445
        \u043C\u0435\u043D\u0456 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0435\u0439."
    - Language: 1
      Text: 
  - Key: scene_4_32_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0456 \u0441\u0442\u043E\u044F\u0447\u0438 \u043A\u043E\u043B\u043E
        \u043E\u0437\u0435\u0440\u0430, \u0456\u0437 \u0432\u0456\u0442\u0440\u043E\u043C,
        \u0449\u043E \u0437\u0430\u0434\u0443\u0432\u0430\u0432 \u043C\u0435\u043D\u0456
        \u0443 \u0432\u043E\u043B\u043E\u0441\u0441\u044F, \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_32_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u043D\u0430
        \u043F\u0456\u0440\u0441 \u0434\u043B\u044F \u0440\u0438\u0431\u0430\u043B\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_4_32_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u043F\u0456\u0441\u043E\u043A
        \u043D\u0430 \u0431\u0435\u0440\u0435\u0437\u0456 \u0431\u0456\u043B\u044F
        \u0432\u043E\u0434\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_32_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0435\u043D\u043D\u044F
        \u0442\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
        \u0434\u043E \u0446\u0435\u043D\u0442\u0440\u0443 \u0441\u0435\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_33_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0430\u0440\u0435\u043D\u044C\u043A\u0438\u0439 \u043C\u0456\u0441\u0442\u043E\u043A
        \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0432 \u043D\u0435\u0430\u043A\u0443\u0440\u0430\u0442\u043D\u0438\u043C
        \u0442\u0430 \u0445\u0438\u0441\u0442\u043A\u0438\u043C. \u0421\u0442\u0430\u0432\u0430\u0442\u0438
        \u043D\u0430 \u043D\u044C\u043E\u0433\u043E \u0445\u043E\u0447 \u043E\u0434\u043D\u0456\u0454\u044E
        \u043D\u043E\u0433\u043E\u044E \u0432\u0436\u0435 \u0441\u0430\u043C\u0435
        \u0441\u043E\u0431\u043E\u044E \u0432\u0438\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
        \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C. \u0412\u0438\u0441\u043E\u0442\u0430
        \u0434\u043B\u044F \u043F\u0430\u0434\u0456\u043D\u043D\u044F \u043D\u0456\u0431\u0438
        \u0439 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430, \u0430\u043B\u0435
        \u0437\u043D\u0430\u044E\u0447\u0438 \u043C\u043E\u044E \u0432\u0434\u0430\u0447\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_33_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0456\u043D\u0448\u043E\u043C\u0443 \u043C\u0456\u0441\u0442\u043E\u043A
        \u043D\u0435 \u0445\u043E\u0432\u0430\u0432 \u0443 \u0441\u043E\u0431\u0456
        \u043D\u0456\u0447\u043E\u0433\u043E \u0446\u0456\u043A\u0430\u0432\u043E\u0433\u043E.
        \u041D\u0430 \u0434\u0430\u043B\u044C\u043D\u0456\u0439 \u0439\u043E\u0433\u043E
        \u0441\u0442\u043E\u0440\u043E\u043D\u0456 \u0442\u043E\u043C\u0438\u043B\u0438\u0441\u044F
        \u0441\u0430\u043C\u043E\u0442\u043D\u0456 \u0434\u0435\u0440\u0435\u0432\u2019\u044F\u043D\u0435
        \u0432\u0456\u0434\u0440\u043E \u0442\u0430 \u0441\u0430\u043C\u043E\u0440\u043E\u0431\u043D\u0430
        \u0432\u0443\u0434\u043A\u0430, \u0434\u0430\u0432\u043D\u043E \u043F\u043E\u043B\u0438\u0448\u0435\u043D\u0456
        \u043A\u0438\u043C\u043E\u0441\u044C."
    - Language: 1
      Text: 
  - Key: scene_4_33_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0434\u0456 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_34_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0448\u043B\u0430
        \u043C\u0456\u0441\u0442\u043A\u043E\u043C \u0442\u0440\u043E\u0445\u0438
        \u0434\u0430\u043B\u0456. \u042F\u043A \u043D\u0435 \u0434\u0438\u0432\u043D\u043E,
        \u0430\u043B\u0435 \u0441\u0442\u0430\u0440\u0435\u043D\u044C\u043A\u0438\u0439
        \u043F\u0456\u0440\u0441 \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F
        \u043C\u0456\u0446\u043D\u0438\u043C \u0442\u0430 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0440\u0438\u043F\u0456\u0432 \u043F\u0456\u0434 \u043C\u043E\u0457\u043C\u0438
        \u043A\u0440\u043E\u043A\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_34_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u044F \u0456 \u0433\u0430\u0434\u0430\u043B\u0430, \u0431\u0456\u043B\u044C\u0448\u0435
        \u043D\u0456\u0447\u043E\u0433\u043E \u0442\u0443\u0442 \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u0440\u0442\u0430\u043B\u043E
        \u043C\u043E\u0454\u0457 \u0443\u0432\u0430\u0433\u0438\u2026 \u0425\u0456\u0431\u0430
        \u0449\u043E \u043E\u043A\u0440\u0456\u043C \u0434\u0438\u0432\u043D\u043E\u0457
        \u043F\u0440\u0438\u043A\u0440\u0430\u0441\u0438, \u044F\u043A\u0430 \u0437\u0430\u0441\u0442\u0440\u044F\u0433\u043B\u0430
        \u043C\u0456\u0436 \u0434\u043E\u0449\u0435\u0447\u043E\u043A \u043C\u0456\u0441\u0442\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_34_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u044F\u0432\u0438\u0432\u0448\u0438 \u0447\u0443\u0434\u0435\u0441\u0430
        \u0441\u043F\u0440\u0438\u0442\u043D\u043E\u0441\u0442\u0456, \u043C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0457\u0457 \u0441\u0445\u043E\u043F\u0438\u0442\u0438,
        \u043D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0432\u043F\u0443\u0441\u0442\u0438\u0432\u0448\u0438
        \u0443 \u0432\u043E\u0434\u0443. \u0426\u0435 \u0432\u0438\u044F\u0432\u0438\u0441\u044F
        \u044F\u043A\u0438\u0439\u0441\u044C \u043F\u0440\u0430\u0434\u0430\u0432\u043D\u0456\u0439
        \u043C\u0435\u0434\u0430\u043B\u044C\u0439\u043E\u043D \u0443 \u0444\u043E\u0440\u043C\u0456
        \u043C\u0430\u0439\u0436\u0435 \u043F\u043E\u0432\u043D\u043E\u0433\u043E
        \u043C\u0456\u0441\u044F\u0446\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_34_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043C\u2026 \u0414\u043E\u0441\u0438\u0442\u044C \u0433\u0430\u0440\u043D\u0438\u0439,
        \u0445\u043E\u0447 \u0456 \u043D\u0430 \u0432\u0438\u0433\u043B\u044F\u0434
        \u0441\u0442\u0430\u0440\u0435\u0437\u043D\u0438\u0439. \u041D\u0430\u0432\u0456\u0442\u044C
        \u0431\u043B\u0438\u0449\u0438\u0442\u044C \u043F\u043E\u043F\u0440\u0438
        \u0456\u0440\u0436\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_34_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u044F
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F \u0434\u043E
        \u0431\u0435\u0440\u0435\u0433\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_35_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u043F\u0456\u0441\u043A\u0443 \u044F \u043E\u0434\u0440\u0430\u0437\u0443
        \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u0432\u0435\u043B\u0438\u043A\u0438\u0439
        \u0433\u043B\u0438\u0431\u043E\u043A\u0438\u0439 \u0441\u043B\u0456\u0434,
        \u043D\u0456\u0431\u0438 \u0456\u043D\u043E\u043F\u043B\u0430\u043D\u0435\u0442\u043D\u0438\u0439
        \u0445\u0440\u043E\u0431\u0430\u043A \u043F\u0440\u043E\u043F\u043E\u0432\u0437
        \u0442\u0443\u0442 \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
        \u0442\u0430 \u0437\u0430\u0431\u0440\u0430\u0432\u0441\u044F \u043A\u0443\u0434\u0438\u0441\u044C
        \u0443 \u0431\u0456\u043A \u043C\u043E\u0442\u043E\u0440\u043E\u0448\u043D\u043E\u0433\u043E
        \u0441\u0435\u043B\u0438\u0449\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_35_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u0446\u0435 \u0431\u0443\u0432 \u0441\u043B\u0456\u0434
        \u0432\u0456\u0434 \u0442\u0456\u043B\u0430 \u041A\u043E\u0440\u043D\u0456\u044F,
        \u0456 \u0437 \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443 \u0441\u0442\u0430\u043B\u043E
        \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E \u2014 \u0417\u0430\u0445\u0430\u0440\u0435\u0441
        \u043D\u0435 \u0431\u0440\u0435\u0445\u0430\u0432, \u0456 \u0434\u0456\u0439\u0441\u043D\u043E
        \u0442\u044F\u0433\u043D\u0443\u0432 \u0437\u0430\u0433\u0438\u0431\u043B\u043E\u0433\u043E
        \u0437\u0432\u0456\u0434\u0441\u0438 \u0430\u0436 \u0434\u043E \u0441\u0430\u043C\u043E\u0457
        \u043E\u0441\u0435\u043B\u0456 \u043D\u0430 \u0432\u043B\u0430\u0441\u043D\u0438\u0445
        \u043F\u043B\u0435\u0447\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_4_35_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0441\u043B\u0456\u0434\u0443 \u0437\u0456 \u0437\u0432\u043E\u0440\u043E\u0442\u043D\u0456\u043C
        \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u043E\u043C \u0431\u0440\u0430\u043A\u0443\u0432\u0430\u043B\u043E.
        \u0416\u043E\u0434\u043D\u0438\u0445 \u0441\u0432\u0456\u0434\u0447\u0435\u043D\u044C,
        \u0430\u0431\u0438 \u0442\u0456\u043B\u043E \u041A\u043E\u0440\u043D\u0456\u044F
        \u0442\u044F\u0433\u043D\u0443\u043B\u0438 \u0414\u041E \u043E\u0437\u0435\u0440\u0430.
        \u042F\u043A\u0449\u043E \u0447\u043E\u043B\u043E\u0432\u2019\u044F\u0433\u0443
        \u0443\u0431\u0438\u043B\u0438, \u0432\u0456\u043D \u043F\u0440\u0438\u0439\u0448\u043E\u0432
        \u0456\u0437 \u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0446\u0435\u043C
        \u0437\u0430 \u0432\u043B\u0430\u0441\u043D\u0438\u043C \u0431\u0430\u0436\u0430\u043D\u043D\u044F\u043C,
        \u0447\u0438 \u0432\u0436\u0435 \u0437\u043D\u0430\u0445\u043E\u0434\u0438\u0432\u0441\u044F
        \u0442\u0443\u0442, \u043A\u043E\u043B\u0438 \u0432\u0441\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_35_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435\u043F\u043E\u0434\u0430\u043B\u0456\u043A \u044F \u0442\u0430\u043A\u043E\u0436
        \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430 \u0437\u0431\u0438\u0442\u0435
        \u0434\u043E \u043A\u0443\u043F\u043A\u0438 \u0440\u0443\u0434\u0435 \u0432\u043E\u043B\u043E\u0441\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_35_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0439\u0440\u043E\u0437\u0443\u043C\u043D\u0456\u0448\u0438\u043C
        \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u043B\u043E\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_35_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0432\u0447\u0438\u0442\u0438 \u0432\u043E\u043B\u043E\u0441\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_35_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u043F\u0456\u0441\u043E\u043A
        \u043D\u0430 \u0431\u0435\u0440\u0435\u0437\u0456 \u044F\u043A\u043E\u043C\u043E\u0433\u0430
        \u0431\u043B\u0438\u0436\u0447\u0435."
    - Language: 1
      Text: 
  - Key: scene_4_35_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0431\u043B\u0443\u043A\u0430\u0442\u0438 \u0431\u0435\u0440\u0435\u0433\u043E\u043C
        \u0442\u0443\u0434\u0438-\u0441\u044E\u0434\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_36_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0456\u0434\u043D\u044F\u043B\u0430 \u0432\u043E\u043B\u043E\u0441\u0441\u044F
        \u0442\u0430 \u043F\u043E\u0442\u0435\u0440\u043B\u0430 \u0439\u043E\u0433\u043E
        \u043C\u0456\u0436 \u043F\u0430\u043B\u044C\u0446\u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_36_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043D\u0430\u0434\u0442\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0435
        \u0442\u0430 \u0436\u043E\u0440\u0441\u0442\u043A\u0435. \u0428\u0432\u0438\u0434\u0448\u0435
        \u0437\u0430 \u0432\u0441\u0435, \u0432\u043E\u043D\u043E \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E
        \u044F\u043A\u0456\u0439\u0441\u044C \u0442\u0432\u0430\u0440\u0438\u043D\u0456.
        \u041D\u0430\u043F\u0440\u0438\u043A\u043B\u0430\u0434, \u0441\u043E\u0431\u0430\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_4_36_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u044F
        \u0432\u0441\u0442\u0430\u043B\u0430, \u0449\u043E\u0431 \u0437\u043D\u043E\u0432\u0443
        \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0431\u0435\u0440\u0435\u0433
        \u0456\u2026 \u0414\u0456\u0434\u044C\u043A\u043E! \u041F\u043E\u043C\u0456\u0442\u0438\u043B\u0430,
        \u0449\u043E \u043C\u043E\u0454 \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u0435
        \u0445\u043E\u0434\u0456\u043D\u043D\u044F \u0437\u043E\u0432\u0441\u0456\u043C
        \u0437\u0430\u0442\u0435\u0440\u043B\u043E \u043F\u0456\u0441\u043E\u043A
        \u0456 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u0437\u0430\u0447\u0456\u043F\u043A\u0438,
        \u044F\u043A\u0456 \u043C\u043E\u0433\u043B\u0438 \u043D\u0430 \u043D\u044C\u043E\u043C\u0443
        \u043B\u0438\u0448\u0438\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_37_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0442\u0430\u043B\u0430 \u0443\u0432\u0430\u0436\u043D\u043E
        \u043F\u0440\u0438\u0434\u0438\u0432\u043B\u044F\u0442\u0438\u0441\u044F
        \u0434\u043E \u043F\u0456\u0441\u043A\u0443. \u041F\u0438\u043B\u044C\u043D\u0438\u043C
        \u043E\u043A\u043E\u043C \u0432\u0438\u0432\u0447\u0430\u0442\u0438 \u043A\u043E\u0436\u043D\u0438\u0439
        \u0439\u043E\u0433\u043E \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0438\u0439
        \u043C\u0435\u0442\u0440. \u0417\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438
        \u043C\u043E\u0457 \u0434\u0456\u0457, \u043C\u0430\u0431\u0443\u0442\u044C,
        \u0432\u0438\u0434\u0430\u0432\u0430\u043B\u0438\u0441\u044F \u0434\u0443\u0436\u0435
        \u0434\u0438\u0432\u043D\u0438\u043C\u0438. \u0410\u043B\u0435 \u0445\u0456\u0431\u0430
        \u0436 \u043D\u0435 \u0446\u0435 \u0454 \u0440\u043E\u0431\u043E\u0442\u0430
        \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u0430?"
    - Language: 1
      Text: 
  - Key: scene_4_37_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435\u0432\u0434\u043E\u0432\u0437\u0456 \u043C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u0438
        \u0434\u0435\u0449\u043E \u0432\u0430\u0436\u043B\u0438\u0432\u0435! \u0414\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0445 \u043F\u043B\u044F\u043C\u043E\u043A
        \u0437\u0430\u0441\u0442\u0438\u0433\u043B\u043E\u0457 \u043A\u0440\u043E\u0432\u0456
        \u043D\u0430 \u043F\u0456\u0441\u043A\u0443. \u041D\u0435 \u0441\u0445\u043E\u0436\u0435
        \u043D\u0430 \u0441\u043B\u0456\u0434\u0438 \u0437\u0430\u043F\u0435\u043A\u043B\u043E\u0457
        \u0431\u043E\u0440\u043E\u0442\u044C\u0431\u0438\u2026 \u0426\u0435 \u0441\u0432\u0456\u0434\u0447\u0438\u043B\u043E
        \u043F\u0440\u043E \u0432\u0456\u0434\u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
        \u0441\u0430\u043C\u043E\u0437\u0430\u0445\u0438\u0441\u0442\u0443 \u0432\u0456\u0434
        \u041A\u043E\u0440\u043D\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_37_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043A\u0440\u043E\u0432 \u043C\u043E\u0433\u043B\u0430
        \u0446\u0456\u043B\u043A\u043E\u043C \u043D\u0430\u043B\u0435\u0436\u0430\u0442\u0438
        \u0439\u043E\u043C\u0443. \u0410\u0431\u043E \u043A\u043E\u043C\u0443\u0441\u044C
        \u0456\u043D\u0448\u043E\u043C\u0443. \u0425\u0442\u043E \u0437\u043D\u0430,
        \u0442\u0435\u0441\u0442 \u0414\u041D\u041A \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E
        \u0431\u0443\u0432 \u043C\u0435\u043D\u0456 \u0432 \u0442\u0456\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457
        \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439."
    - Language: 1
      Text: 
  - Key: scene_4_37_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0440\u043E\u0431\u0438\u0432\u0448\u0438 \u043F\u0435\u0432\u043D\u0456
        \u0432\u0438\u0441\u043D\u043E\u0432\u043A\u0438, \u044F \u0432\u0456\u0434\u0456\u0439\u0448\u043B\u0430,
        \u0449\u043E\u0431 \u0437\u043D\u043E\u0432\u0443 \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438
        \u0431\u0435\u0440\u0435\u0433."
    - Language: 1
      Text: 
  - Key: scene_4_38_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u0446\u0435 \u043D\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u043E
        \u0437\u043D\u0430\u0447\u043D\u0438\u0445 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0456\u0432.
        \u0425\u0456\u0431\u0430 \u0449\u043E \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u0432\u0441\u044F
        \u043D\u0435\u0434\u043E\u043F\u0430\u043B\u043E\u043A \u0446\u0438\u0433\u0430\u0440\u043A\u0438
        \u0411\u0430\u043B\u044C\u043C\u043E\u0440\u043E. \u0422\u0430\u043A\u0456
        \u0441\u0430\u043C\u0456, \u044F\u043A\u0438\u043C \u0432\u0456\u0434\u0434\u0430\u0432\u0430\u043B\u0430
        \u043F\u0435\u0440\u0435\u0432\u0430\u0433\u0443 \u044F."
    - Language: 1
      Text: 
  - Key: scene_4_38_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u043A\u043E\u0433\u043E\u0441\u044C \u0433\u0430\u0440\u043D\u0438\u0439
        \u0441\u043C\u0430\u043A."
    - Language: 1
      Text: 
  - Key: scene_4_38_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u044F
        \u0432\u0456\u0434\u0456\u0439\u0448\u043B\u0430, \u0449\u043E\u0431 \u0437\u043D\u043E\u0432\u0443
        \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0431\u0435\u0440\u0435\u0433
        \u0456\u2026 \u0414\u0456\u0434\u044C\u043A\u043E! \u041F\u043E\u043C\u0456\u0442\u0438\u043B\u0430,
        \u0449\u043E \u043C\u043E\u0454 \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u0435
        \u0445\u043E\u0434\u0456\u043D\u043D\u044F \u0437\u043E\u0432\u0441\u0456\u043C
        \u0437\u0430\u0442\u0435\u0440\u043B\u043E \u043F\u0456\u0441\u043E\u043A
        \u0456 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456 \u0437\u0430\u0447\u0456\u043F\u043A\u0438,
        \u044F\u043A\u0456 \u043C\u043E\u0433\u043B\u0438 \u043D\u0430 \u043D\u044C\u043E\u043C\u0443
        \u043B\u0438\u0448\u0430\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043F\u0445\u0430\u0432\u0448\u0438 \u0440\u0443\u043A\u0438
        \u0432 \u043A\u0438\u0448\u0435\u043D\u0456 \u0436\u0430\u043A\u0435\u0442\u0430,
        \u044F \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u043F\u043E\u043A\u0440\u043E\u043A\u0443\u0432\u0430\u043B\u0430
        \u0432\u0437\u0434\u043E\u0432\u0436 \u0431\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0457
        \u043B\u0456\u043D\u0456\u0457. \u0411\u0456\u043B\u044C\u0448\u0430 \u0447\u0430\u0441\u0442\u0438\u043D\u0430
        \u043E\u0437\u0435\u0440\u0430 \u0442\u0430\u043A \u0456 \u043B\u0438\u0448\u0430\u043B\u0430\u0441\u044F
        \u0437\u0430\u0440\u043E\u0441\u043B\u043E\u044E \u043E\u0447\u0435\u0440\u0435\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u0438\u043B\u044F\u044E\u0447\u0438\u0441\u044C \u043F\u0456\u0434
        \u0432\u0456\u0442\u0440\u043E\u043C, \u0432\u043D\u043E\u0447\u0456 \u0446\u044F
        \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0430 \u0440\u043E\u0441\u043B\u0438\u043D\u0430
        \u0441\u0442\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u0430 \u0432\u0440\u0430\u0436\u0435\u043D\u043D\u044F
        \u0444\u0430\u043D\u0442\u0430\u0441\u043C\u0430\u0433\u043E\u0440\u0438\u0447\u043D\u0438\u0445
        \u0434\u0436\u0443\u043D\u0433\u043B\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435, \u043E\u0437\u0438\u0440\u0430\u044E\u0447\u0438\u0441\u044C
        \u043D\u0430\u0432\u043A\u043E\u043B\u043E, \u044F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
        \u043F\u0440\u0438\u043C\u0456\u0442\u0438\u0442\u0438 \u043D\u0456\u0447\u043E\u0433\u043E,
        \u0449\u043E \u0445\u043E\u0447\u0430 \u0431 \u0432\u0456\u0434\u0434\u0430\u043B\u0435\u043D\u043E
        \u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043B\u043E\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0438.
        \u0422\u0430\u043A \u044F \u0456 \u0437\u0430\u043A\u0456\u043D\u0447\u0443\u0432\u0430\u043B\u0430
        \u0431\u0435\u0437\u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438\u0432\u043D\u0438\u0439
        \u043F\u043E\u0445\u0456\u0434, \u0430\u0436 \u0440\u0430\u043F\u0442\u043E\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_39_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F
        \u043D\u0430 \u0445\u0432\u0438\u043B\u044F\u0441\u0442\u0435 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F
        \u043C\u0456\u0441\u044F\u0446\u044F \u0432 \u0447\u043E\u0440\u043D\u0456\u0439
        \u0432\u043E\u0434\u0456. \u041D\u0456\u0431\u0438 \u0441\u043C\u0443\u0436\u043A\u0430
        \u0440\u0435\u043F\u0442\u0438\u043B\u044C\u043D\u043E\u0433\u043E \u043E\u043A\u0430,
        \u044F\u043A\u0435 \u043D\u0430\u043B\u0435\u0436\u0430\u043B\u043E \u0432\u043B\u0430\u0441\u043D\u0438\u043A\u0443
        \u0432\u0441\u0435\u043F\u043E\u0433\u043B\u0438\u043D\u0430\u044E\u0447\u043E\u0457
        \u043F\u0430\u0449\u0456. \u0426\u0435\u0439 \u043E\u0431\u0440\u0430\u0437
        \u0437\u0430\u0432\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0432, \u0433\u0456\u043F\u043D\u043E\u0442\u0438\u0437\u0443\u0432\u0430\u0432
        \u043C\u0435\u043D\u0435, \u0442\u043E\u043C\u0443 \u044F \u0437\u0430\u0432\u043C\u0435\u0440\u043B\u0430
        \u043D\u0430 \u043C\u0456\u0441\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u043A\u043E\u043B\u0438 \u0437\u043D\u043E\u0432\u0443 \u0437\u043C\u043E\u0433\u043B\u0430
        \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F, \u0443 \u043C\u043E\u0454
        \u043F\u043E\u043B\u0435 \u0437\u043E\u0440\u0443 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0430
        \u0437\u0430\u0447\u0456\u043F\u043A\u0430, \u044F\u043A\u0430 \u0434\u0443\u0436\u0435
        \u0432\u0438\u0431\u0438\u0432\u0430\u043B\u0430\u0441\u044C  \u0456\u0437
        \u043A\u0440\u0430\u0454\u0432\u0438\u0434\u0443 \u043D\u0435\u0437\u0430\u0439\u043C\u0430\u043D\u043E\u0457
        \u043F\u0440\u0438\u0440\u043E\u0434\u0438. \u0413\u043B\u0438\u0431\u043E\u043A\u043E
        \u0432 \u043E\u0447\u0435\u0440\u0435\u0442\u0456 \u044F \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430
        \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A \u043C\u0435\u0442\u0430\u043B\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u043D\u044C\u043E\u0433\u043E \u0431\u0443\u043B\u043E \u0449\u0435
        \u0442\u0438\u043C \u0432\u0438\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043D\u043D\u044F\u043C.
        \u0414\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0430 \u043B\u0435\u0436\u0430\u043B\u0430
        \u043D\u0430 \u043C\u0456\u0437\u0435\u0440\u043D\u043E\u043C\u0443 \u0448\u043C\u0430\u0442\u043A\u0443
        \u0431\u043E\u043B\u043E\u0442\u043D\u043E\u0433\u043E \u043C\u0443\u043B\u0443,
        \u0449\u043E \u0437 \u0443\u0441\u0456\u0445 \u0431\u043E\u043A\u0456\u0432
        \u0432\u0456\u043D \u0431\u0443\u0432 \u043E\u0442\u043E\u0447\u0435\u043D\u0438\u0439
        \u0433\u043B\u0438\u0431\u043E\u043A\u043E\u044E \u0432\u043E\u0434\u043E\u044E.
        \u0413\u0443\u0441\u0442\u0438\u0439 \u043E\u0447\u0435\u0440\u0435\u0442
        \u0442\u0435\u0436 \u043D\u0435 \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u0432
        \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0446\u0456\u043B\u0456."
    - Language: 1
      Text: 
  - Key: scene_4_39_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0438\u0442\u0443\u0430\u0446\u0456\u044F \u0431\u0443\u043B\u0430
        \u0434\u0443\u0436\u0435 \u0434\u0435\u043B\u0456\u043A\u0430\u0442\u043D\u0430
        \u0439 \u0434\u0456\u044F\u0442\u0438 \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E
        \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E. \u0410\u0434\u0436\u0435
        \u043E\u0434\u0438\u043D \u043D\u0435\u0432\u0456\u0440\u043D\u0438\u0439
        \u0440\u0443\u0445 \u0456 \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0430
        \u0447\u043A\u0443\u0440\u043D\u0435 \u0443 \u0432\u043E\u0434\u0443, \u0434\u0435
        \u0448\u0443\u043A\u0430\u0442\u0438 \u0457\u0457 \u043C\u043E\u0436\u043D\u0430
        \u0431\u0443\u0434\u0435 \u0445\u0456\u0431\u0430 \u0449\u043E \u0437 \u0430\u043A\u0432\u0430\u043B\u0430\u043D\u0433\u043E\u043C.
        \u0422\u043E\u0436 \u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_39_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434\u0437\u0430\u043A\u043E\u0442\u0438\u043B\u0430 \u0448\u0442\u0430\u043D\u0438\u043D\u0438
        \u0439 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044F
        \u0437\u0430 \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u043E\u044E
        \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_39_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0448\u0443\u043A\u0430\u043B\u0430 \u043D\u0430\u0432\u043A\u043E\u043B\u043E,
        \u0449\u043E \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
        \u0434\u0456\u0441\u0442\u0430\u0442\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442."
    - Language: 1
      Text: 
  - Key: scene_4_39_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0439\u0448\u043B\u0430 \u0441\u0442\u0435\u0436\u043A\u043E\u044E,
        \u0434\u0435 \u0432\u043E\u0434\u0430 \u0431\u0443\u043B\u0430 \u0437\u043E\u0432\u0441\u0456\u043C
        \u043D\u0435\u0433\u043B\u0438\u0431\u043E\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_39_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434\u0456\u0431\u0440\u0430\u043B\u0430 \u0448\u043C\u0430\u0442\u043E\u043A
        \u0434\u043E\u0448\u043A\u0438 \u043A\u043E\u043B\u043E \u0434\u043E\u0440\u043E\u0433\u0438
        \u0439 \u043F\u0456\u0434\u043D\u044F\u043B\u0430 \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0443
        \u043D\u0438\u043C."
    - Language: 1
      Text: 
  - Key: scene_4_39_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u043D\u0435 \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u0442\u0438
        \u0442\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_39_2_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u043B\u0430
        \u0439 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438
        \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0438 \u0434\u0435\u0456\u043D\u0434\u0435."
    - Language: 1
      Text: 
  - Key: scene_4_39_2_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430 \u043F\u0456\u0434\u0434\u0456\u0442\u0438
        \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0443 \u0432\u0456\u0434\u043B\u0430\u043C\u0430\u043D\u043E\u044E
        \u043E\u0447\u0435\u0440\u0435\u0442\u0438\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_39_2_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0456\u0441\u0442\u0430\u043B\u0430 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E \u0432\u0443\u0434\u043A\u0438
        \u0442\u0430 \u0432\u0456\u0434\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_40_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u043F\u0435\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043B\u044F\u0434,
        \u0446\u0435 \u0432\u0438\u0434\u0430\u043B\u043E\u0441\u044F \u0433\u0430\u0440\u043D\u043E\u044E
        \u0456\u0434\u0435\u0454\u044E, \u0430 \u0442\u0438\u043C \u0431\u0456\u043B\u044C\u0448\u0435
        \u043B\u0435\u0433\u043A\u043E\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_4_40_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0447\u0438\u043C \u0434\u0430\u043B\u0456 \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0457\u0457 \u0432\u0442\u0456\u043B\u0438\u0442\u0438, \u0442\u0438\u043C
        \u0433\u0456\u0440\u0448\u0435 \u043C\u0435\u043D\u0456 \u0446\u0435 \u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F.
        \u041E\u0447\u0435\u0440\u0435\u0442\u0438\u043D\u0430 \u0431\u0443\u043B\u0430
        \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0433\u043D\u0443\u0447\u043A\u043E\u044E
        \u0456 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0445\u0438\u043B\u0438\u043B\u0430\u0441\u044F
        \u0432\u0456\u0434 \u0432\u0456\u0442\u0440\u0443. \u041C\u0435\u043D\u0456
        \u043C\u0430\u0439\u0436\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u043F\u0456\u0434\u0434\u0456\u0442\u0438 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0443
        \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0443 \u043D\u0430 \u0432\u043E\u043B\u043E\u0442\u044C
        \u0441\u0442\u0435\u0431\u043B\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_40_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0430\u043B\u0430\u043D\u0441\u0443\u044E\u0447\u0438, \u044F\u043A
        \u0442\u043E\u0439 \u0430\u043A\u0440\u043E\u0431\u0430\u0442, \u044F \u0432\u0436\u0435
        \u0442\u044F\u0433\u043D\u0443\u043B\u0430 \u043E\u0447\u0435\u0440\u0435\u0442\u0438\u043D\u0443
        \u043D\u0430\u0437\u0430\u0434, \u043F\u0440\u043E\u0442\u0435 \u0432\u0440\u0430\u0437\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_40_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u2026\u043F\u043B\u0430\u043D \u0431\u0443\u043B\u043E \u0437\u0440\u0443\u0439\u043D\u043E\u0432\u0430\u043D\u043E.
        \u0421\u0442\u0435\u0431\u043B\u0438\u043D\u0430 \u0440\u043E\u0437\u043B\u0430\u043C\u0430\u043B\u0430\u0441\u044F
        \u043D\u0430\u0432\u043F\u0456\u043B, \u0456 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u0431\u0443\u043B\u044C\u043A\u043D\u0443\u0432 \u0443 \u0432\u043E\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_40_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F
        \u0442\u0456\u043B\u044C\u043A\u0438 \u0433\u0430\u0434\u0430\u0442\u0438,
        \u0447\u0438 \u0431\u0443\u043B\u0430 \u0446\u044F \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0430
        \u044F\u043A\u043E\u0441\u044C \u043F\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0430
        \u0437 \u043C\u043E\u0457\u043C \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F\u043C.
        \u0417\u0430\u0441\u043C\u0443\u0447\u0435\u043D\u0430, \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0443\u0442 \u043D\u0435 \u0437\u0430\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438\u0441\u044F
        \u0456 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F
        \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430 \u043E\u0437\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0431\u0440\u0430\u0432\u0448\u0438\u0441\u044C \u0432\u0456\u0434\u0432\u0430\u0433\u0438,
        \u044F \u0441\u0442\u0440\u0438\u0431\u043D\u0443\u043B\u0430 \u0432 \u043E\u0447\u0435\u0440\u0435\u0442
        \u0442\u0430 \u0441\u0442\u0443\u0434\u0435\u043D\u0443 \u0432\u043E\u0434\u0443.
        \u0413\u043B\u0438\u0431\u0438\u043D\u0430 \u0431\u0443\u043B\u0430 \u043C\u0435\u043D\u0456
        \u043C\u0430\u0439\u0436\u0435 \u0434\u043E \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438
        \u0441\u0442\u0435\u0433\u043E\u043D. \u0412\u0456\u0434\u0447\u0443\u0442\u0442\u044F
        \u043D\u0435 \u0437 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0445,
        \u044F\u043A\u0449\u043E \u0434\u043E \u043D\u0456\u0447\u043D\u043E\u0433\u043E
        \u043A\u0443\u043F\u0430\u043D\u043D\u044F \u0442\u043E\u0431\u0456 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
        \u043F\u0435\u0440\u0435\u0436\u0438\u0442\u0438 \u0430\u0432\u0430\u0440\u0456\u044E
        \u0442\u0430 \u043F\u043E\u0431\u043B\u0443\u043A\u0430\u0442\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u0438\u043C
        \u043B\u0456\u0441\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0440\u0443\u0448\u0438\u043B\u0430 \u0434\u0430\u043B\u0456,
        \u0430\u0434\u0436\u0435 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0430
        \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0430 \u0431\u0443\u043B\u0430
        \u0432\u0436\u0435 \u0437\u043E\u0432\u0441\u0456\u043C \u0431\u043B\u0438\u0437\u044C\u043A\u043E."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0432 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u0436\u0438\u0442\u0442\u044F \u0437\u043D\u043E\u0432\u0443 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u043E
        \u0437 \u043C\u0435\u043D\u0435 \u043F\u043E\u0433\u043B\u0443\u0437\u0443\u0432\u0430\u0442\u0438.
        \u042F\u043A \u0443 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0456 \u0447\u0430\u0441\u0438
        \u043D\u0456\u043C\u0438\u0445 \u043A\u043E\u043C\u0435\u0434\u0456\u0439
        \u044F \u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E
        \u043D\u0430 \u0449\u043E\u0441\u044C \u0441\u043B\u0438\u0437\u044C\u043A\u0435,
        \u043F\u0435\u0432\u043D\u043E \u0433\u043B\u0438\u043D\u0443, \u0456 \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E
        \u0440\u043E\u0437\u043C\u0430\u0445\u0443\u044E\u0447\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
        \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u0432\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u044E\u0447\u0438
        \u043A\u043E\u0441\u043F\u043B\u0435\u0457\u0442\u0438 \u0433\u0432\u0438\u043D\u0442\u043E\u043A\u0440\u0438\u043B,
        \u044F \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044F \u043D\u0430
        \u0431\u0456\u043A. \u041D\u0430\u0432\u0456\u0442\u044C \u043F\u043E\u043F\u0440\u0438
        \u043E\u043F\u0456\u0440 \u0432\u043E\u0434\u0438, \u043F\u0430\u0434\u0456\u043D\u043D\u044F
        \u0432\u0438\u0439\u0448\u043B\u043E \u0431\u043E\u043B\u044E\u0447\u0438\u043C."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041D-\u0433-\u0433\u0445! \u041D\u0443 \u0449\u043E \u0437\u0430 \u043C\u0435\u0440\u0437\u0435\u043D\u043D\u0435
        \u0449\u0443\u0440\u044F\u0447\u0435 \u043B\u0430\u0439\u043D\u043E!!"
    - Language: 1
      Text: 
  - Key: scene_4_41_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0456 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0438
        \u0446\u0456\u0454\u0457 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u0457
        \u043F\u043E\u043B\u044F\u0433\u0430\u043B\u0438 \u0442\u0430\u043A\u043E\u0436
        \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u0442\u0435\u043F\u0435\u0440
        \u043C\u0456\u0439 \u043E\u0434\u044F\u0433 \u0431\u0443\u0432 \u043C\u043E\u043A\u0440\u0438\u043C
        \u0456 \u043D\u0430\u0441\u043A\u0440\u0456\u0437\u044C \u043F\u0440\u043E\u043F\u0430\u0445
        \u0431\u043E\u043B\u043E\u0442\u043D\u0438\u043C \u0434\u0443\u0445\u043E\u043C.
        \u0412\u0438\u0442\u0438\u0441\u043A\u0430\u0442\u0438 \u0439\u043E\u0433\u043E
        \u043F\u0456\u0437\u043D\u0456\u0448\u0435 \u043D\u0430 \u0431\u0435\u0440\u0435\u0437\u0456
        \u0441\u0442\u0430\u043B\u043E \u0447\u0443\u0434\u043E\u0432\u0438\u043C
        \u0434\u043E\u043F\u043E\u0432\u043D\u0435\u043D\u043D\u044F\u043C \u043C\u043E\u0433\u043E
        \u0432\u0435\u0447\u043E\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_41_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u044F\u043A\u0430\u0441\u044C \u0447\u0430\u0441\u0442\u0438\u043D\u043A\u0430
        \u0443\u0434\u0430\u0447\u0456 \u0449\u0435 \u0431\u0443\u043B\u0430 \u0434\u043E
        \u043C\u0435\u043D\u0435 \u043C\u0438\u043B\u043E\u0441\u0435\u0440\u0434\u043D\u043E\u044E.
        \u041C\u0435\u0442\u0430\u043B\u0435\u0432\u0430 \u0434\u0440\u0456\u0431\u043D\u0438\u0447\u043A\u0430
        \u0442\u0430\u043A \u0456 \u043B\u0438\u0448\u0430\u043B\u0430\u0441\u044F
        \u0441\u0442\u0438\u0440\u0447\u0430\u0442\u0438 \u0432 \u0448\u043C\u0430\u0442\u0430\u0445
        \u043C\u0443\u043B\u0443 \u0439 \u043D\u0435 \u0432\u0438\u043B\u0435\u0442\u0456\u043B\u0430
        \u0443 \u0432\u043E\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_4_42_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0435\u0434\u043C\u0435\u0442 \u0431\u0443\u0432 \u0443
        \u043C\u0435\u043D\u0435 \u0432 \u0440\u0443\u043A\u0430\u0445!"
    - Language: 1
      Text: 
  - Key: scene_4_42_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430 \u0431\u043B\u0438\u0436\u0447\u043E\u0433\u043E \u043E\u0433\u043B\u044F\u0434\u0443
        \u0441\u0442\u0430\u043B\u043E \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E,
        \u0449\u043E \u0446\u0435 \u0437\u0456\u043C\u2019\u044F\u0442\u0430 \u043A\u0443\u043B\u044F
        \u0432\u0456\u0434 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_4_42_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435\u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u0430 \u0437\u043D\u0430\u0445\u0456\u0434\u043A\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_4_42_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0431\u0443\u043B\u0430 \u0435\u043A\u0441\u043F\u0435\u0440\u0442\u043E\u043C
        \u0437\u0456 \u0437\u0431\u0440\u043E\u0457, \u043D\u0430 \u0446\u044C\u043E\u043C\u0443
        \u0440\u0430\u0434\u0448\u0435 \u0441\u043F\u0435\u0446\u0456\u0430\u043B\u0456\u0437\u0443\u0432\u0430\u0432\u0441\u044F
        \u043C\u0456\u0439 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A. \u0422\u043E\u0436
        \u043C\u0435\u043D\u0456 \u0441\u043A\u043B\u0430\u0434\u043D\u043E \u0431\u0443\u043B\u043E
        \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438, \u0456\u0437
        \u0447\u043E\u0433\u043E \u043C\u043E\u0433\u043B\u0438 \u0457\u0457 \u0432\u0438\u043F\u0443\u0441\u0442\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_4_42_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0449\u043E
        \u043A\u0443\u043B\u044F \u0432\u0436\u0435 \u0434\u0435\u044F\u043A\u0438\u0439
        \u0447\u0430\u0441 \u043F\u0440\u043E\u043B\u0435\u0436\u0430\u043B\u0430
        \u0442\u0443\u0442. \u041C\u043E\u0436\u043B\u0438\u0432\u043E \u043D\u0430\u0432\u0456\u0442\u044C
        \u043F\u043E\u0431\u0443\u0432\u0430\u043B\u0430 \u043F\u0456\u0434 \u0432\u043E\u0434\u043E\u044E,
        \u0430 \u043F\u043E\u0442\u0456\u043C \u0457\u0457 \u0432\u0456\u0434\u0431\u0438\u043B\u043E
        \u0434\u043E \u0431\u0435\u0440\u0435\u0433\u0430. \u041A\u0443\u043B\u044E
        \u0442\u043E\u0447\u043D\u043E \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0431\u0443\u043B\u043E \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
        \u044F\u043A \u0440\u0435\u0447\u043E\u0432\u0438\u0439 \u0434\u043E\u043A\u0430\u0437."
    - Language: 1
      Text: 
  - Key: scene_4_42_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043A\u0456\u043D\u0447\u0438\u0432\u0448\u0438 \u043E\u0433\u043B\u044F\u0434,
        \u044F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u043D\u0430 \u0431\u0435\u0440\u0435\u0433 \u043E\u0437\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_43_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438\u0441\u044C
        \u0432\u043A\u0430\u0437\u0456\u0432\u043E\u043A \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430,
        \u044F \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0441\u044F
        \u0434\u043E \u0440\u043E\u0434\u043E\u0432\u0438\u0449. \u0426\u0435 \u0431\u0443\u043B\u0430
        \u0441\u0438\u0440\u0430 \u043C\u0456\u0441\u0446\u0438\u043D\u0430, \u044F\u043A\u0430
        \u0442\u0430\u043A\u043E\u0436 \u0445\u043E\u0432\u0430\u043B\u0430\u0441\u044F
        \u043D\u0430 \u0443\u0437\u043B\u0456\u0441\u0441\u0456. \u0421\u0445\u043E\u0436\u0435
        \u0434\u043B\u044F \u043C\u0435\u043D\u0435, \u044F\u043A \u0456 \u0434\u043B\u044F
        \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0457 \u043F\u0442\u0430\u0448\u043A\u0438,
        \u0443\u0441\u0456 \u0434\u043E\u0440\u043E\u0433\u0438 \u0432\u0435\u043B\u0438
        \u0432 \u0434\u0438\u043A\u0443 \u043F\u0443\u0449\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_43_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u043D\u0435
        \u0437\u0431\u0440\u0435\u0445\u0430\u0432, \u043E\u0445\u043E\u0440\u043E\u043D\u0430
        \u0431\u0443\u043B\u0430 \u043D\u0430 \u043C\u0456\u0441\u0446\u0456. \u0417\u0430
        \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u044F \u0432\u0436\u0435
        \u0437\u0456\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u043B\u0430\u0441\u044F
        \u0432\u0456\u0447-\u043D\u0430-\u0432\u0456\u0447 \u0437 \u043E\u0446\u0438\u043D\u043A\u043E\u0432\u0430\u043D\u0438\u043C
        \u043F\u0430\u0440\u043A\u0430\u043D\u043E\u043C-\u0441\u0456\u0442\u043A\u043E\u044E.
        \u041F\u043E\u0437\u0430 \u043D\u0438\u043C \u0432\u0438\u0434\u043D\u0456\u043B\u0438\u0441\u044F
        \u043F\u0435\u0440\u0448\u0456 \u043E\u0437\u043D\u0430\u043A\u0438 \u043A\u043E\u043F\u0430\u043B\u0435\u043D\u044C:
        \u0433\u043B\u0438\u0431\u043E\u043A\u0456 \u0442\u0430 \u0432\u043E\u0433\u043A\u0456
        \u044F\u043C\u0438, \u0434\u0435\u0440\u0435\u0432\u2019\u044F\u043D\u0456
        \u0432\u0430\u0436\u0435\u043B\u0456 \u0442\u0430 \u043F\u043B\u0430\u0441\u0442\u0438\u043A\u043E\u0432\u0456
        \u0431\u0443\u0434\u0438\u043D\u043E\u0447\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_43_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0436, \u043E\u0440\u0434\u0435\u0440\u0443 \u043D\u0430
        \u043E\u0431\u0448\u0443\u043A \u044F \u043D\u0435 \u043C\u0430\u043B\u0430,
        \u0430 \u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u0439\u043E\u0433\u043E
        \u0437 \u0432\u0456\u0434\u0434\u0456\u043B\u043A\u0443 \u0437\u043D\u0430\u0447\u0438\u043B\u043E
        \u0431 \u0437\u0430\u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F
        \u0442\u0443\u0442 \u0449\u043E\u043D\u0430\u0439\u043C\u0435\u043D\u0448\u0435
        \u043D\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0442\u0438\u0436\u043D\u0456\u0432.
        \u0411\u0435\u0437 \u043F\u0430\u043F\u0456\u0440\u0446\u044F \u044F \u043D\u0435
        \u043C\u043E\u0433\u043B\u0430 \u0432\u0438\u043C\u0430\u0433\u0430\u0442\u0438
        \u043E\u0445\u043E\u0440\u043E\u043D\u0443 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438
        \u043C\u0435\u043D\u0435 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
        \u0442\u0430 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438 \u043F\u0445\u0430\u0442\u0438
        \u043D\u043E\u0441\u0430 \u0443 \u0432\u0441\u0435 \u043F\u043E\u0441\u043F\u0456\u043B\u044C."
    - Language: 1
      Text: 
  - Key: scene_5_43_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0432\u0438 \u0432\u0436\u0435 \u0442\u0440\u043E\u0445\u0438
        \u0437\u043D\u0430\u0454\u0442\u0435 \u043F\u0440\u043E \u043C\u0435\u043D\u0435.
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0443 \u043D\u0456\u043A\u043E\u043B\u0438
        \u0431 \u043D\u0435 \u0437\u0443\u043F\u0438\u043D\u0438\u0432 \u044F\u043A\u0438\u0439\u0441\u044C
        \u0436\u0430\u043B\u044E\u0433\u0456\u0434\u043D\u0438\u0439 \u043F\u0430\u0440\u043A\u0430\u043D.
        \u0422\u043E\u0436 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0437\u0430 \u0431\u0443\u0434\u044C-\u0449\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
        \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443. \u041C\u0435\u043D\u0456
        \u0437\u0434\u0430\u043B\u043E\u0441\u044F, \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435
        \u0431\u0443\u0434\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_43_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0435\u0440\u0435\u043B\u0456\u0437\u0442\u0438
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0440\u043A\u0430\u043D. \u042F\u043A
        \u0434\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0456\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_43_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u043B\u0430\u0437\u0456\u0432\u043A\u0443
        \u0432\u0437\u0434\u043E\u0432\u0436 \u043E\u0433\u043E\u0440\u043E\u0436\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_43_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043D\u0430\u0439\u0442\u0438
        \u0447\u0438\u043C \u0440\u043E\u0437\u0440\u0456\u0437\u0430\u0442\u0438
        \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u043F\u0430\u0440\u043A\u0430\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_44_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0456\u0439 \u0441\u0442\u0438\u043B\u044C\u043D\u0438\u0439
        \u043A\u043E\u0441\u0442\u044E\u043C\u0447\u0438\u043A \u0431\u0443\u0432,
        \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u043D\u0435 \u043D\u0430\u0439\u0437\u0440\u0443\u0447\u043D\u0456\u0448\u043E\u044E
        \u0444\u043E\u0440\u043C\u043E\u044E, \u0449\u043E\u0431 \u0432\u0438\u0434\u0435\u0440\u0430\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0432\u0438\u0441\u043E\u043A\u0438\u0439 \u043F\u0430\u0440\u043A\u0430\u043D.
        \u0422\u0430 \u0437\u0440\u0435\u0448\u0442\u043E\u044E, \u0446\u0435 \u0431\u0443\u043B\u043E
        \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E, \u0430\u0434\u0436\u0435
        \u0437\u0430 \u043F\u043E\u043A\u043B\u0438\u043A\u043E\u043C \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0457
        \u044F \u0431\u0443\u043B\u0430 \u0432 \u0433\u0430\u0440\u043D\u0456\u0439
        \u0444\u043E\u0440\u043C\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_44_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0435\u0440\u0435\u043C\u0430\u0445\u043D\u0443\u043B\u0430
        \u043F\u0430\u0440\u043A\u0430\u043D \u0437\u0433\u043E\u0440\u0438 \u0456
        \u0432\u0436\u0435 \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
        \u0437\u0456\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438 \u0432\u043D\u0438\u0437.
        \u0422\u0430 \u043A\u043E\u043B\u0438 \u043F\u043E\u043B\u0435\u0442\u0456\u043B\u0430
        \u0434\u043E\u0434\u043E\u043B\u0443, \u043F\u043E\u0447\u0443\u043B\u0430
        \u0440\u0438\u043F\u0456\u043D\u043D\u044F \u0442\u0430 \u0432\u0456\u0434\u0447\u0443\u043B\u0430
        \u0433\u043E\u0441\u0442\u0440\u0438\u0439 \u0431\u0456\u043B\u044C \u0443
        \u043D\u043E\u0437\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_44_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0432\u0448\u0438\u0441\u044C,
        \u044F \u0432\u0438\u044F\u0432\u0438\u043B\u0430 \u0431\u043E\u043B\u044E\u0447\u0443
        \u0440\u0430\u043D\u0443 \u0456\u0437 \u043A\u0440\u043E\u0432\u043E\u0442\u0435\u0447\u0435\u044E
        \u043D\u0430 \u043B\u0438\u0442\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_44_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041B\u0430\u0439\u043D\u043E! \u042F \u0442\u0456\u043B\u044C\u043A\u0438
        \u043A\u0443\u043F\u0438\u043B\u0430 \u043D\u043E\u0432\u0456 \u043A\u043E\u043B\u0433\u043E\u0442\u0438!"
    - Language: 1
      Text: 
  - Key: scene_5_44_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435 \u0436 \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E
        \u043A\u043B\u044F\u0442\u043E\u043C\u0443 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u043C\u0443
        \u0448\u0442\u0438\u0440\u044E \u0441\u0442\u0438\u0440\u0447\u0430\u0442\u0438
        \u0441\u0430\u043C\u0435 \u0442\u0443\u0442. \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456,
        \u043C\u0435\u043D\u0456 \u0431\u0443\u043B\u043E \u0447\u0438\u043C \u043F\u0435\u0440\u0435\u0432\u2019\u044F\u0437\u0430\u0442\u0438
        \u0440\u0430\u043D\u0443. \u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E
        \u044F \u043F\u043E\u0448\u043A\u0443\u0442\u0438\u043B\u044C\u0433\u0430\u043B\u0430
        \u0431\u043B\u0438\u0436\u0447\u0435 \u0434\u043E \u043A\u043E\u043F\u0430\u043B\u0435\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_5_45_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435\u0432\u0434\u043E\u0432\u0437\u0456 \u044F \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430
        \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0443 \u0448\u043F\u0430\u0440\u0438\u043D\u0443
        \u0432 \u0437\u0430\u0431\u043E\u0440\u0456. \u0406\u0437 \u043F\u0435\u0432\u043D\u043E\u044E
        \u043C\u0456\u0440\u043E\u044E \u0441\u043F\u0440\u0438\u0442\u043D\u043E\u0441\u0442\u0456
        \u044F \u043C\u0430\u043B\u0430 \u0448\u0430\u043D\u0441\u0438 \u0442\u0443\u0434\u0438
        \u043F\u0440\u043E\u043B\u0456\u0437\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_45_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
        \u0442\u0430\u043A\u043E\u0436 \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F
        \u0433\u043E\u043B\u043E\u0432\u043D\u0438\u0439 \u0432\u0445\u0456\u0434.
        \u0412\u0435\u043B\u0438\u043A\u0456 \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0456
        \u0432\u043E\u0440\u043E\u0442\u0430 \u0431\u0443\u043B\u0438 \u0442\u0440\u043E\u0445\u0438
        \u043F\u0440\u043E\u0447\u0438\u043D\u0435\u043D\u0456. \u042F \u043C\u043E\u0433\u043B\u0430
        \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u043E \u043F\u0440\u043E\u0441\u043E\u0447\u0438\u0442\u0438\u0441\u044F
        \u0432 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_45_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0440\u0430\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_45_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u043F\u0430\u0440\u0438\u043D\u0443 \u0432 \u043F\u0430\u0440\u043A\u0430\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_45_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0447\u0438\u043D\u0435\u043D\u0456 \u0433\u043E\u043B\u043E\u0432\u043D\u0456
        \u0432\u043E\u0440\u043E\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_46_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438\u043C \u044F \u0434\u0443\u043C\u0430\u043B\u0430,
        \u044F\u043A\u0449\u043E \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
        \u0448\u0443\u043A\u0430\u0442\u0438 \u044F\u043A\u0456\u0441\u044C \u0432\u0438\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0447\u043D\u0456
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0438 \u0434\u043B\u044F
        \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u043D\u044F \u0437\u0430\u0431\u043E\u0440\u0456\u0432
        \u0443 \u0433\u043B\u0443\u0445\u043E\u043C\u0443 \u043B\u0456\u0441\u0456.
        \u0428\u0430\u043D\u0441\u0438, \u043C\u2019\u044F\u043A\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
        \u043F\u0440\u0430\u0433\u043D\u0443\u043B\u0438 \u0434\u043E \u043D\u0443\u043B\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_46_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438 \u0456\u043D\u043E\u0434\u0456
        \u043D\u0430\u0439\u0431\u0435\u0437\u0433\u043B\u0443\u0437\u0434\u0456\u0448\u0456
        \u0440\u0456\u0448\u0435\u043D\u043D\u044F \u0441\u043F\u0440\u0430\u0446\u044C\u043E\u0432\u0443\u044E\u0442\u044C.
        \u0422\u0440\u043E\u0445\u0438 \u043F\u043E\u0431\u043B\u0443\u043A\u0430\u0432\u0448\u0438
        \u043B\u0456\u0441\u043E\u043C, \u044F \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u043B\u0430
        \u043D\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0434\u0435\u0440\u0435\u0432\u2019\u044F\u043D\u0438\u0439
        \u0431\u0443\u0434\u0438\u043D\u043E\u0447\u043E\u043A. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u043A\u043E\u043B\u0438\u0441\u044C \u0432\u0456\u043D \u043D\u0430\u043B\u0435\u0436\u0430\u0432
        \u043B\u0456\u0441\u043D\u0438\u043A\u0443? \u0422\u0430 \u0446\u0435 \u0431\u0443\u043B\u043E
        \u043D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E, \u0430\u0434\u0436\u0435
        \u0431\u0456\u043B\u044F \u043D\u044C\u043E\u0433\u043E \u043C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438
        \u043D\u0456\u0447\u043E\u0433\u0435\u043D\u044C\u043A\u0443 \u0441\u043E\u043A\u0438\u0440\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_46_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u043A\u0440\u0430\u0449\u0435 \u0442\u0456\u043A\u0430\u0439
        \u0432\u0456\u0434 \u043C\u0435\u043D\u0435, \u043F\u0430\u0440\u043A\u0430\u043D\u0435\u2026
        \u0425\u043E\u0447\u0430 \u0442\u0438 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E
        \u043D\u0435 \u043C\u043E\u0436\u0435\u0448."
    - Language: 1
      Text: 
  - Key: scene_5_46_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u043E\u0433\u043E\u0440\u043E\u0436\u0456 \u0442\u0430 \u043F\u043E\u0447\u0430\u043B\u0430
        \u0432\u0438\u0440\u0443\u0431\u0443\u0432\u0430\u0442\u0438 \u043F\u0435\u0440\u0435\u0445\u0440\u0435\u0449\u0435\u043D\u043D\u044F
        \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u0457 \u0441\u0456\u0442\u043A\u0438
        \u043E\u0434\u0438\u043D \u0437\u0430 \u043E\u0434\u0438\u043D. \u0426\u0435
        \u0431\u0443\u043B\u043E \u043D\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E,
        \u0430\u0434\u0436\u0435 \u0437\u0430 \u043F\u043E\u043A\u043B\u0438\u043A\u043E\u043C
        \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0457 \u044F \u0431\u0443\u043B\u0430
        \u0432 \u0433\u0430\u0440\u043D\u0456\u0439 \u0444\u043E\u0440\u043C\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_46_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0404\u0434\u0438\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
        \u044F\u043A\u0438\u0439 \u043C\u043E\u0454\u043C\u0443 \u0433\u0435\u043D\u0456\u0454\u0432\u0456
        \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043F\u0440\u043E\u0440\u0430\u0445\u0443\u0432\u0430\u0442\u0438,
        \u0431\u0443\u0432 \u0437\u0432\u0443\u043A \u0443\u0434\u0430\u0440\u0456\u0432
        \u0442\u0430 \u0441\u043A\u0440\u0435\u0433\u043E\u0442\u0456\u043D\u043D\u044F
        \u043C\u0435\u0442\u0430\u043B\u0443 \u043E\u0431 \u043C\u0435\u0442\u0430\u043B\u0443,
        \u044F\u043A\u0438\u0439 \u043B\u0443\u043D\u043E\u044E \u0440\u043E\u0437\u0445\u043E\u0434\u0438\u0432\u0441\u044F,
        \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u0443\u0441\u0456\u043C
        \u043B\u0456\u0441\u043E\u043C. \u041F\u0440\u043E\u0442\u0435 \u0432\u043D\u043E\u0447\u0456
        \u044F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
        \u043F\u0440\u0438\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0447\u0438\u044E\u0441\u044C
        \u0443\u0432\u0430\u0433\u0443, \u0430\u0432\u0436\u0435\u0436?"
    - Language: 1
      Text: 
  - Key: scene_5_46_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0440\u0435\u0448\u0442\u043E\u044E, \u043C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E
        \u0432\u0438\u0440\u043E\u0431\u0438\u0442\u0438 \u0441\u043E\u0431\u0456
        \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0443 \u0448\u043F\u0430\u0440\u0438\u043D\u0443
        \u0432 \u043F\u0430\u0440\u043A\u0430\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_47_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0448\u043C\u0438\u0433\u043D\u0443\u043B\u0430 \u043D\u0430
        \u0442\u0435\u0440\u0438\u0442\u043E\u0440\u0456\u044E \u0440\u043E\u0434\u043E\u0432\u0438\u0449.
        \u0417\u0432\u0456\u0434\u0441\u0438 \u0432\u0441\u0435 \u043C\u043E\u0436\u043D\u0430
        \u0431\u0443\u043B\u043E \u043E\u0433\u043B\u0435\u0434\u0456\u0442\u0438
        \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u043A\u0440\u0430\u0449\u0435,
        \u043F\u0440\u043E\u0442\u0435 \u0436\u0438\u0442\u0442\u044F, \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E,
        \u043D\u0435 \u043F\u043E\u0434\u0430\u043B\u043E \u043C\u0435\u043D\u0456
        \u0442\u0430\u043A\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u0443 \u043D\u0430
        \u0431\u043B\u044E\u0434\u0435\u0447\u043A\u0443, \u0430\u0434\u0436\u0435
        \u043F\u0440\u0438\u0433\u043E\u0434\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_47_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0432\u043E\u0457\u043C\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u0438\u043C\u0438
        \u0434\u0456\u044F\u043C\u0438 \u044F \u043F\u0440\u0438\u0432\u0435\u0440\u043D\u0443\u043B\u0430
        \u0443\u0432\u0430\u0433\u0443 \u0442\u043E\u0433\u043E, \u0437 \u043A\u0438\u043C
        \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0442\u0438\u0441\u044F
        \u0434\u0443\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u0431 \u043D\u0435
        \u0432\u043E\u043B\u0456\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_47_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435\u0441\u044C \u0437\u0434\u0430\u043B\u0435\u043A\u0443
        \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0456 \u043F\u043E\u0447\u0443\u0432\u0441\u044F
        \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u0438\u0439 \u0433\u0430\u0432\u043A\u0456\u0442
        \u0442\u0430 \u0441\u043F\u0440\u0438\u0442\u043D\u0438\u0439 \u0431\u0456\u0433.
        \u0426\u0435 \u0431\u0443\u0432 \u0441\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u0438\u0439
        \u043F\u0435\u0441, \u044F\u043A\u043E\u043C\u0443 \u0456\u043D\u0441\u0442\u0438\u043D\u043A\u0442
        \u043D\u0430\u043A\u0430\u0437\u0443\u0432\u0430\u0432 \u044F\u043A\u043E\u043C\u043E\u0433\u0430
        \u0448\u0432\u0438\u0434\u0448\u0435 \u0440\u043E\u0437\u0456\u0434\u0440\u0430\u0442\u0438
        \u043C\u0435\u043D\u0435 \u043D\u0430 \u0448\u043C\u0430\u0442\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_47_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u044F\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0431\u0443\u043B\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0440\u0430\u0437,
        \u0456 \u0448\u0432\u0438\u0434\u043A\u043E. \u0428\u0430\u043D\u0441\u0456\u0432
        \u0431\u0443\u043B\u043E \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u043E,
        \u043F\u0440\u043E\u0442\u0435, \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u044F \u0447\u043E\u0433\u043E\u0441\u044C \u043D\u0435 \u043F\u043E\u043C\u0456\u0447\u0430\u044E?
        \u042F\u043A\u0431\u0438 \u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430
        \u0441\u0432\u043E\u0457 \u043D\u0430\u0434\u043F\u0440\u0438\u0440\u043E\u0434\u043D\u0456
        \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456, \u0442\u043E \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
        \u043C\u0430\u043B\u0430 \u0431 \u0447\u0430\u0441 \u0449\u043E\u0441\u044C
        \u043E\u0431\u0440\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_47_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0447\u0438 \u0456\u043D\u0430\u043A\u0448\u0435,
        \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_47_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u0442\u0430
        \u043C\u043E\u043B\u0438\u0442\u0438\u0441\u044F \u043F\u0440\u043E \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_5_47_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0440\u0456\u043C\u0433\u043E\u043B\u043E\u0432 \u043F\u043E\u0431\u0456\u0433\u0442\u0438
        \u0437\u0432\u0456\u0434\u0442\u0438 \u043D\u0430\u0437\u0430\u0434 \u0434\u043E
        \u0441\u0435\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_47_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043B\u0456\u0437\u0442\u0438 \u043D\u0430 \u043E\u0433\u043E\u0440\u043E\u0436\u0443.
        \u041F\u0435\u0441 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u043C\u0435\u043D\u0435 \u0437\u0433\u043E\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_47_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438 \u0432
        \u043E\u0434\u043D\u0443 \u0437 \u044F\u043C \u043A\u043E\u043F\u0430\u043B\u044C\u043D\u0456.
        \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456, \u0442\u0430\u043C
        \u043B\u0435\u0433\u0448\u0435 \u0437\u0430\u0445\u0438\u0449\u0430\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u043D\u043E\u0432\u0443 \u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u043F\u0430\u0440\u043A\u0430\u043D\u0443. \u0423\u0441\u0435
        \u0436 \u0442\u0430\u043A\u0438 \u0446\u044F \u043D\u0456\u0447 \u0445\u043E\u0442\u0456\u043B\u0430
        \u0437\u043C\u0443\u0441\u0438\u0442\u0438 \u043C\u0435\u043D\u0435 \u0442\u0440\u043E\u0445\u0438
        \u043F\u043E\u0432\u0438\u0434\u0438\u0440\u0430\u0442\u0438\u0441\u044F.
        \u041D\u0430\u0433\u043E\u0440\u0443 \u044F \u0437\u0430\u0441\u043A\u043E\u0447\u0438\u043B\u0430
        \u0456\u0437 \u043D\u0430\u0434\u043B\u044E\u0434\u0441\u044C\u043A\u043E\u044E
        \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u0432 \u043F\u043E\u0440\u0438\u0432\u0456
        \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \u0436\u0438\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u0456\u0434\u0442\u0438 \u044F \u0456 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u043B\u0430
        \u0437\u0430 \u0440\u043E\u0437\u043C\u0438\u0442\u0438\u043C\u0438 \u043E\u0431\u0440\u0430\u0437\u0430\u043C\u0438
        \u0441\u043E\u0431\u0430\u043A\u0438, \u0449\u043E \u0431\u0456\u0433\u0430\u0432
        \u0442\u0430 \u043E\u0431\u043D\u044E\u0445\u0443\u0432\u0430\u0432 \u0437\u0435\u043C\u043B\u044E
        \u0432 \u0442\u0435\u043C\u0440\u044F\u0432\u0456 \u043B\u0456\u0441\u0443.
        \u042F\u043A \u043C\u0435\u043D\u0456 \u043F\u043E\u0449\u0430\u0441\u0442\u0438\u043B\u043E,
        \u0449\u043E \u0432\u0456\u043D \u043D\u0435 \u0437\u0432\u0438\u043A \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
        \u0434\u043E\u0433\u043E\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043A\u043B\u0430\u0432\u0448\u0438 \u043D\u043E\u0433\u0430
        \u043D\u0430 \u043D\u043E\u0433\u0443, \u044F \u0449\u0435 \u0442\u0440\u043E\u0445\u0438
        \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043B\u0430 \u0441\u0438\u0434\u044F\u0447\u0456
        \u043D\u0430 \u043E\u0433\u043E\u0440\u043E\u0436\u0456, \u0430\u0434\u0436\u0435
        \u0441\u043E\u0431\u0430\u0446\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0432\u0441\u044F
        \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441, \u0430\u0431\u0438
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438\u0441\u044C.
        \u042F \u0437\u0430\u043F\u0430\u043B\u0438\u043B\u0430 \u0446\u0438\u0433\u0430\u0440\u043A\u0443
        \u0442\u0430 \u0440\u043E\u0437\u0441\u043B\u0430\u0431\u0438\u043B\u0430\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u0447\u0443\u0432\u0430\u044E \u0441\u0435\u0431\u0435
        \u043A\u0440\u0430\u0449\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0456\u043C\u043F\u0440\u043E\u0432\u0456\u0437\u043E\u0432\u0430\u043D\u043E\u0457
        \u043F\u0435\u0440\u0435\u0440\u0432\u0438 \u044F \u0437\u0456\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u043B\u0430
        \u0434\u043E\u0434\u043E\u043B\u0443 \u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043B\u0430
        \u043F\u0443\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_5_48_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F \u0440\u043E\u0434\u043E\u0432\u0438\u0449.
        \u0417\u0435\u043C\u043B\u044F \u0443 \u044F\u043C\u043A\u0430\u0445 \u0431\u0443\u043B\u0430
        \u0432\u043E\u0433\u043A\u0430 \u0439 \u0434\u0435-\u043D\u0435-\u0434\u0435
        \u043F\u0456\u0434\u0442\u043E\u043F\u043B\u0435\u043D\u0430. \u0420\u0435\u043B\u044C\u0454\u0444
        \u0441\u0442\u0456\u043D\u043E\u043A \u0440\u0435\u0431\u0440\u0438\u0441\u0442\u0438\u0439,
        \u0456\u0437 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u043C\u0438
        \u0432\u043A\u0440\u0430\u043F\u043B\u0435\u043D\u043D\u044F\u043C\u0438
        \u043D\u0435\u0433\u0440\u0430\u043D\u043E\u0432\u0430\u043D\u043E\u0457
        \u0434\u043E\u0456\u0441\u0442\u043E\u0440\u0438\u0447\u043D\u043E\u0457
        \u0441\u043C\u043E\u043B\u0438, \u044F\u043A\u0443 \u043C\u0438 \u0437\u043D\u0430\u043B\u0438
        \u043F\u0456\u0434 \u043D\u0430\u0437\u0432\u043E\u044E \xAB\u0431\u0443\u0440\u0448\u0442\u0438\u043D\xBB
        \u0456 \u0434\u0443\u0436\u0435 \u0446\u0456\u043D\u0443\u0432\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_49_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0432\u0456\u0442 \u043D\u0430\u0432\u043A\u043E\u043B\u043E
        \u0437\u0430\u043A\u0440\u0443\u0442\u0438\u0432\u0441\u044F \u0456 \u0441\u0442\u0430\u0432
        \u0441\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u043A\u0430\u0440\u0443\u0441\u0435\u043B\u044C
        \u0456\u043C\u043F\u0440\u0435\u0441\u0456\u043E\u043D\u0456\u0441\u0442\u0441\u044C\u043A\u0438\u0445
        \u0444\u0430\u0440\u0431. \u0417\u0456\u0440\u0432\u0430\u0432\u0448\u0438\u0441\u044C
        \u0456\u0437 \u043C\u0456\u0441\u0446\u044F, \u044F \u0441\u043A\u043E\u0447\u0438\u043B\u0430
        \u0434\u043E \u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_49_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0434\u043D\u0456 \u044F \u0448\u0443\u0431\u043E\u0432\u0441\u043D\u0443\u043B\u0430
        \u0432 \u0440\u043E\u0437\u043C\u043E\u043A\u043B\u0438\u0439 \u0431\u0440\u0443\u0434.
        \u0427\u0430\u0441\u0443 \u0440\u043E\u0437\u0434\u0438\u0432\u043B\u044F\u0442\u0438\u0441\u044F
        \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043D\u0435 \u0431\u0443\u043B\u043E.
        \u0421\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u0438\u0439 \u0441\u043E\u0431\u0430\u043A\u0430
        \u043D\u0430\u0431\u043B\u0438\u0436\u0430\u0432\u0441\u044F \u0456 \u044F
        \u043C\u0430\u043B\u0430 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u0438,
        \u044F\u043A \u0439\u043E\u043C\u0443 \u043F\u0440\u043E\u0442\u0438\u0441\u0442\u043E\u044F\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_49_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417 \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u0433\u0443
        \u044F \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430 \u0441\u0442\u0430\u0440\u0438\u0439
        \u0431\u0440\u0435\u0437\u0435\u043D\u0442, \u044F\u043A\u0438\u043C \u0431\u0443\u043B\u043E
        \u0432\u043A\u0440\u0438\u0442\u043E \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u044F\u0449\u0438\u043A\u0456\u0432. \u0412\u0456\u043D \u043C\u0430\u0454
        \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0434\u043E\u0431\u0440\u0435
        \u043C\u0430\u0441\u043A\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043F\u0430\u0445\u0438,
        \u0430\u0431\u0438 \u044F \u043C\u043E\u0433\u043B\u0430 \u043F\u0456\u0434
        \u043D\u0438\u043C \u0441\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F.
        \u0417 \u0456\u043D\u0448\u043E\u0457 \u0436 \u0441\u0442\u043E\u0440\u043E\u043D\u0438
        \u0432 \u0437\u0435\u043C\u043B\u044E \u0431\u0443\u043B\u0438 \u0432\u0441\u0442\u0440\u043E\u043C\u043B\u0435\u043D\u0430
        \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430 \u043B\u043E\u043F\u0430\u0442\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_49_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0441\u0435\u0440\u0435\u0434\u043D\u044F \u0437\u0431\u0440\u043E\u044F,
        \u043F\u0440\u043E\u0442\u0435 \u044F\u043A \u0441\u043A\u0456\u043D\u0447\u0438\u043B\u0430\u0441\u044C
        \u043F\u0430\u043B\u044F\u043D\u0438\u0446\u044F, \u0442\u043E \u0439 \u043F\u0435\u0440\u0435\u043F\u0456\u0447\u043A\u0430
        \u0437\u0430 \u0445\u043B\u0456\u0431."
    - Language: 1
      Text: 
  - Key: scene_5_49_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0440\u0430\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_49_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0438\u0449\u0430\u0442\u0438\u0441\u044F \u043B\u043E\u043F\u0430\u0442\u043A\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_5_49_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u043F\u0456\u0434
        \u0431\u0440\u0435\u0437\u0435\u043D\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_5_50 _part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435 \u0431 \u044F \u043D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F, \u0443\u0441\u0435
        \u0431\u0443\u043B\u043E \u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043E.
        \u0421\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u0438\u0439 \u0441\u043E\u0431\u0430\u043A\u0430
        \u044F\u0432\u043D\u043E \u0431\u0443\u0432 \u043F\u0440\u0438\u0432\u0447\u0435\u043D\u0438\u0439
        \u0432\u0438\u0441\u0442\u0435\u0436\u0443\u0432\u0430\u0442\u0438 \u0436\u0435\u0440\u0442\u0432\u0443
        \u0432 \u043B\u0456\u0441\u0456 \u0439 \u043D\u0435 \u043D\u0430\u0434\u0442\u043E
        \u0441\u0445\u0438\u043B\u044C\u043D\u0438\u0439 \u0434\u043E \u043C\u0438\u043B\u043E\u0441\u0435\u0440\u0434\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_50 _part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043C\u0435\u0440\u0442\u044C \u0432\u0456\u0434 \u0433\u043E\u0441\u0442\u0440\u0438\u0445
        \u0456\u043A\u043B\u0456\u0432 \u043F\u0441\u0430 \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0430
        \u043C\u0435\u043D\u0435 \u0437 \u0440\u043E\u0437\u043F\u0440\u043E\u0441\u0442\u0435\u0440\u0442\u0438\u043C\u0438
        \u043E\u0431\u0456\u0439\u043C\u0430\u043C\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_51_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F, \u0449\u043E
        \u0444\u0435\u0445\u0442\u0443\u0432\u0430\u0442\u0438 \u043B\u043E\u043F\u0430\u0442\u043A\u043E\u044E
        \u0434\u043B\u044F \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043A\u0443
        \u0434\u043E\u0440\u043E\u0433\u043E\u0446\u0456\u043D\u043D\u0438\u0445
        \u043C\u0456\u043D\u0435\u0440\u0430\u043B\u0456\u0432 \u0456\u0437 \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u0438\u043C
        \u0441\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u0438\u043C \u0441\u043E\u0431\u0430\u043A\u043E\u044E
        \u2014 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0441\u043A\u043B\u0430\u0434\u043D\u0438\u0439
        \u0432\u0438\u0434 \u0431\u043E\u0439\u043E\u0432\u0438\u0445 \u043C\u0438\u0441\u0442\u0435\u0446\u0442\u0432.
        \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u043A\u043E\u043B\u0438\u0441\u044C
        \u0437\u043C\u0430\u0433\u0430\u043D\u043D\u044F \u0437 \u043D\u044C\u043E\u0433\u043E
        \u0434\u043E\u0434\u0430\u0434\u0443\u0442\u044C \u0434\u043E \u043E\u043B\u0456\u043C\u043F\u0456\u0439\u0441\u044C\u043A\u0438\u0445
        \u0456\u0433\u043E\u0440 \u043D\u0430 \u0447\u0435\u0441\u0442\u044C \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_51_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u044F \u0432\u0436\u0435 \u043D\u0435 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F,
        \u0430\u0434\u0436\u0435 \u0434\u043B\u044F \u043C\u0435\u043D\u0435 \u0432\u0441\u0435
        \u0431\u0443\u043B\u043E \u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043E.
        \u0421\u043C\u0435\u0440\u0442\u044C \u0432\u0456\u0434 \u0433\u043E\u0441\u0442\u0440\u0438\u0445
        \u0456\u043A\u043B\u0456\u0432 \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0430
        \u043C\u0435\u043D\u0435 \u0437 \u0440\u043E\u0437\u043F\u0440\u043E\u0441\u0442\u0435\u0440\u0442\u0438\u043C\u0438
        \u043E\u0431\u0456\u0439\u043C\u0430\u043C\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_52_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417-\u043F\u0456\u0434 \u0431\u0440\u0435\u0437\u0435\u043D\u0442\u0443
        \u044F \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u043B\u0430
        \u0437\u0430 \u0440\u043E\u0437\u043C\u0438\u0442\u0438\u043C\u0438 \u043E\u0431\u0440\u0430\u0437\u0430\u043C\u0438
        \u0441\u043E\u0431\u0430\u043A\u0438, \u0449\u043E \u0431\u0456\u0433\u0430\u0432
        \u0442\u0430 \u043E\u0431\u043D\u044E\u0445\u0443\u0432\u0430\u0432 \u0437\u0435\u043C\u043B\u044E
        \u0432 \u0442\u0435\u043C\u0440\u044F\u0432\u0456 \u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_52_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u044F \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0430
        \u0437\u0434\u043E\u0433\u0430\u0434\u043A\u0430 \u0432\u0438\u044F\u0432\u0438\u043B\u0430\u0441\u044F
        \u043F\u0440\u0430\u0432\u0434\u0438\u0432\u043E\u044E \u0442\u0430 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u043B\u0430
        \u0436\u0438\u0442\u0442\u044F \u2014 \u043F\u0435\u0441 \u0442\u0430\u043A
        \u0456 \u043D\u0435 \u0437\u043C\u0456\u0433 \u0432\u0456\u0434\u0447\u0443\u0442\u0438
        \u043C\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u0445\u0443 \u043F\u0456\u0434
        \u0431\u0440\u0435\u0437\u0435\u043D\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_5_52_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0449\u0435 \u0442\u0440\u043E\u0445\u0438 \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u043B\u0430,
        \u043B\u0435\u0436\u0430\u0447\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0456,
        \u0430\u0434\u0436\u0435 \u0441\u043E\u0431\u0430\u0446\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u0432\u0441\u044F
        \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441, \u0430\u0431\u0438
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438\u0441\u044C.
        \u041A\u043E\u043B\u0438 \u0432\u0456\u043D \u0437\u0430\u0431\u0440\u0430\u0432\u0441\u044F,
        \u044F \u043C\u043E\u0433\u043B\u0430 \u0434\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0438
        \u0441\u043E\u0431\u0456 \u0432\u0438\u043B\u0456\u0437\u0442\u0438 \u0442\u0430
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_52_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0435\u043C\u043E\u0433\u0430! \u041C\u0435\u043D\u0456
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0434\u0456\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0440\u043E\u0434\u043E\u0432\u0438\u0449."
    - Language: 1
      Text: 
  - Key: scene_5_52_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0435\u043C\u043B\u044F \u0443 \u044F\u043C\u043A\u0430\u0445
        \u0431\u0443\u043B\u0430 \u0432\u043E\u0433\u043A\u0430 \u0439 \u0434\u0435-\u043D\u0435-\u0434\u0435
        \u043F\u0456\u0434\u0442\u043E\u043F\u043B\u0435\u043D\u0430. \u0420\u0435\u043B\u044C\u0454\u0444
        \u0441\u0442\u0456\u043D\u043E\u043A \u0440\u0435\u0431\u0440\u0438\u0441\u0442\u0438\u0439,
        \u0456\u0437 \u0440\u0456\u0434\u043A\u0456\u0441\u043D\u0438\u043C\u0438
        \u0432\u043A\u0440\u0430\u043F\u043B\u0435\u043D\u043D\u044F\u043C\u0438
        \u043D\u0435\u0433\u0440\u0430\u043D\u043E\u0432\u0430\u043D\u043E\u0457
        \u0434\u043E\u0456\u0441\u0442\u043E\u0440\u0438\u0447\u043D\u043E\u0457
        \u0441\u043C\u043E\u043B\u0438, \u044F\u043A\u0443 \u043C\u0438 \u0437\u043D\u0430\u043B\u0438
        \u043F\u0456\u0434 \u043D\u0430\u0437\u0432\u043E\u044E \xAB\u0431\u0443\u0440\u0448\u0442\u0438\u043D\xBB
        \u0456 \u0434\u0443\u0436\u0435 \u0446\u0456\u043D\u0443\u0432\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_53_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u0434\u0430\u043B\u0456 \u044F \u0432\u0437\u044F\u043B\u0430\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_53_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u0432\u0441\u0435
        \u043C\u0456\u0436 \u0449\u0456\u043B\u0438\u043D\u0430\u043C\u0438 \u0442\u0430
        \u0432 \u0440\u0456\u0437\u043D\u0438\u0445 \u0441\u0445\u043E\u0432\u043A\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_5_54_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0430\u0441\u0442\u0438\u043D\u0430 \u044F\u043C \u043F\u043E\u0441\u0435\u0440\u0435\u0434
        \u043A\u043E\u043F\u0430\u043B\u0435\u043D\u044C \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u043B\u0430
        \u0434\u043E\u0432\u043E\u043B\u0456 \u0432\u0435\u043B\u0438\u043A\u043E\u044E
        \u0442\u0430 \u0433\u043B\u0438\u0431\u043E\u043A\u043E\u044E. \u0420\u043E\u0431\u043E\u0442\u0430
        \u0435\u043A\u0441\u043A\u0430\u0432\u0430\u0442\u043E\u0440\u0430, \u0430\u0434\u0436\u0435
        \u0449\u043E\u0431 \u0432\u0438\u043A\u043E\u043F\u0430\u0442\u0438 \u0457\u0445
        \u0440\u0443\u0447\u043D\u0438\u043C\u0438 \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
        \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044F \u0431\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439, \u043D\u0456\u0436
        \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043F\u0440\u043E\u0436\u0438\u0432\u0430\u0454
        \u0432 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_54_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430
        \u0447\u0430\u0441\u0442\u043A\u0430 \u044F\u043C\u043E\u043A \u043F\u043E\u043C\u0435\u043D\u0448\u0435,
        \u043A\u0440\u0438\u0432\u0443\u0432\u0430\u0442\u0438\u0445 \u0442\u0430
        \u0437 \u043D\u0435\u0440\u0456\u0432\u043D\u0438\u043C \u0440\u0435\u043B\u044C\u0454\u0444\u043E\u043C,
        \u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044F \u043F\u0440\u043E\u0440\u043E\u0431\u043B\u0435\u043D\u0430
        \u043B\u043E\u043F\u0430\u0442\u043E\u044E. \u0414\u0438\u0432\u043D\u043E,
        \u0449\u043E \u043A\u043E\u043C\u0443\u0441\u044C \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044F
        \u0442\u0430\u043A \u043D\u0430\u043F\u0440\u0443\u0436\u0443\u0432\u0430\u0442\u0438\u0441\u044C,
        \u044F\u043A\u0449\u043E \u0432 \u043D\u0438\u0445 \u0431\u0443\u043B\u0438
        \u043C\u0430\u0448\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_54_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0440\u0438\u0433\u0430\u0434\u0430\u043B\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u0430\u043F\u043E\u0440\u0442\u0456\u0432 \u043F\u0440\u043E \u043D\u0435\u043B\u0435\u0433\u0430\u043B\u044C\u043D\u0438\u0439
        \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043E\u043A \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0432 \u0446\u044C\u043E\u043C\u0443 \u0440\u0435\u0433\u0456\u043E\u043D\u0456.
        \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0447\u0435\u0440\u0435\u0437
        \u0446\u0435 \u0432\u043B\u0430\u0434\u0430 \u041C\u0456\u0440\u0447\u0443
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438
        \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u0443 \u043E\u0445\u043E\u0440\u043E\u043D\u0443?"
    - Language: 1
      Text: 
  - Key: scene_5_54_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0442\u0435 \u0449\u043E\u0431 \u0457\u0457 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
        \u0431\u0443\u043B\u043E \u043F\u043E\u0434\u043E\u043B\u0430\u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_54_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u043B\u043E\u0441\u044F,
        \u0449\u043E \u0446\u0456 \u0434\u0432\u0456 \u0437\u0430\u0447\u0456\u043F\u043A\u0438
        \u043C\u043E\u0436\u0443\u0442\u044C \u0431\u0443\u0442\u0438 \u043F\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0456
        \u043C\u0456\u0436 \u0441\u043E\u0431\u043E\u044E. \u0417\u0430\u0445\u0430\u0440\u0435\u0441
        \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0432, \u043D\u0456\u0431\u0438
        \u0437\u0430\u0433\u0438\u0431\u043B\u0438\u0439 \u043D\u0435 \u043C\u0430\u0432
        \u0441\u0442\u0456\u0439\u043A\u043E\u0433\u043E \u0434\u0436\u0435\u0440\u0435\u043B\u0430
        \u043F\u0440\u0438\u0431\u0443\u0442\u043A\u0443. \u0427\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0449\u043E \u0432\u043E\u043D\u043E \u0432\u0441\u0435 \u0436 \u0431\u0443\u043B\u043E
        \u0432 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430, \u0430\u043B\u0435
        \u041A\u043E\u0440\u043D\u0456\u0439 \u0442\u0440\u0438\u043C\u0430\u0432
        \u0439\u043E\u0433\u043E \u0432 \u0441\u0435\u043A\u0440\u0435\u0442\u0456?"
    - Language: 1
      Text: 
  - Key: scene_5_54_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u0432\u0441\u0435
        \u043E\u0433\u043B\u044F\u043D\u0443\u0432\u0448\u0438, \u044F \u0434\u0443\u043C\u0430\u043B\u0430
        \u0447\u0438 \u0437\u043C\u043E\u0436\u0443 \u0449\u0435 \u0449\u043E\u0441\u044C
        \u0437\u2019\u044F\u0441\u0443\u0432\u0430\u0442\u0438 \u0437 \u043B\u0430\u043D\u0434\u0448\u0430\u0444\u0442\u0443,
        \u044F\u043A\u0438\u0439 \u043C\u0435\u043D\u0435 \u043E\u0442\u043E\u0447\u0443\u0432\u0430\u0432,
        \u0456 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_54_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u0442\u044F\u0433\u0442\u0438
        \u043A\u0440\u0438\u0441\u0442\u0430\u043B \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0440\u0443\u043A\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_54_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0433\u0430\u044F\u0442\u0438 \u0447\u0430\u0441\u0443
        \u0442\u0430 \u043F\u0456\u0442\u0438 \u043F\u043E\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0449\u043E\u0441\u044C \u0456\u043D\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_55_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043E\u0434\u043D\u0456\u0439 \u0456\u0437 \u044F\u043C\u043E\u043A
        \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u0432\u0441\u044F
        \u0434\u043E\u0445\u043B\u0438\u0439 \u0449\u0443\u0440. \u0429\u043E\u0441\u044C
        \u0443 \u043D\u044C\u043E\u043C\u0443 \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043B\u043E
        \u041A\u043E\u0440\u043D\u0456\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_55_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u043B\u0456 \u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_55_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043B\u0430 \u043F\u043E\u0448\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_56_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434 \u0447\u0430\u0441 \u043E\u0431\u0445\u043E\u0434\u0443
        \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u043B\u0438\u0441\u044F
        \u043B\u0438\u0448\u0435 \u0437\u0430\u043B\u0438\u0448\u043A\u0438 \u0431\u0430\u0433\u0430\u0442\u0442\u044F,
        \u044F\u043A\u0456 \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u043D\u043E
        \u0442\u0445\u043D\u0443\u043B\u0438 \u0441\u0435\u0447\u0435\u044E."
    - Language: 1
      Text: 
  - Key: scene_5_56_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0440\u044F\u0434 \u0456\u0437 \u0437\u0430\u043B\u0438\u0448\u043A\u0430\u043C\u0438
        \u0431\u0430\u0433\u0430\u0442\u0442\u044F \u0432\u0430\u043B\u044F\u043B\u0438\u0441\u044F
        \u0447\u043E\u0442\u0438\u0440\u0438 \u043F\u0443\u0441\u0442\u0456 \u043F\u043B\u044F\u0448\u043A\u0438
        \u0437-\u043F\u0456\u0434 \u043F\u0438\u0432\u0430 \xAB\u041A\u0430\u043F\u043B\u0443\u043D
        \u0432\u0438\u0448\u043D\u0435\u0432\u0438\u0439\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_56_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0433\u043E\u0434\u043E\u043C \u043C\u0435\u043D\u0456 \u043D\u0430\u0431\u0440\u0438\u0434\u043B\u043E
        \u0457\u0445 \u0440\u043E\u0437\u0434\u0438\u0432\u043B\u044F\u0442\u0438\u0441\u044F,
        \u0442\u043E\u0436 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F \u0447\u0438\u043C-\u043D\u0435\u0431\u0443\u0434\u044C
        \u0456\u0449\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_57_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0440\u0430\u043B\u0430 \u043D\u0430\u0439\u0437\u0440\u0443\u0447\u043D\u0456\u0448\u0438\u0439,
        \u043D\u0430 \u043C\u043E\u044E \u0434\u0443\u043C\u043A\u0443, \u0448\u043C\u0430\u0442\u043E\u043A
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443 \u0442\u0430 \u0432\u0445\u043E\u043F\u0438\u043B\u0430\u0441\u044F
        \u043E\u0431\u043E\u043C\u0430 \u0440\u0443\u043A\u0430\u043C\u0438. \u041D\u0430\u043F\u0440\u0443\u0436\u0438\u0432\u0448\u0438
        \u043C\u2019\u044F\u0437\u0438, \u044F \u0449\u043E\u0441\u0438\u043B\u0438
        \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u043B\u0430 \u043A\u0430\u043C\u0435\u043D\u044E\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_57_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0440\u0456\u0441\u044C\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_57_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0456\u0434\u0443\u0447\u0438\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0438\u0439
        \u0431\u0456\u043B\u044C \u0443 \u043F\u0430\u043B\u044C\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_57_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u043B\u044F\u0445\u0430, \u043D\u0456\u0445\u0442\u043E \u043D\u0435
        \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0430\u0432, \u0449\u043E
        \u0446\u044F \u0441\u043F\u0440\u0430\u0432\u0430 \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u0454
        \u0437\u043B\u0430\u043C\u0430\u043D\u0456 \u043D\u0456\u0433\u0442\u0456!"
    - Language: 1
      Text: 
  - Key: scene_5_57_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043A\u0430\u043C\u2019\u044F\u043D\u0456\u043B\u0438\u0439 \u0432\u0456\u0434\u0440\u043E\u0441\u0442\u043E\u043A
        \u0442\u0430\u043A \u0456 \u043B\u0438\u0448\u0438\u0432\u0441\u044F \u0441\u0442\u0438\u0440\u0447\u0430\u0442\u0438
        \u0432 \u0441\u0442\u0456\u043D\u0446\u0456 \u044F\u043C\u0438. \u041D\u0430
        \u0432\u0456\u0434\u043C\u0456\u043D\u0443 \u0432\u0456\u0434 \u043C\u043E\u0433\u043E
        \u043D\u0456\u0433\u0442\u044F. \u0417\u0430\u0441\u043C\u0443\u0442\u0438\u0432\u0448\u0438\u0441\u044C,
        \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u043D\u0435 \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u0446\u044C\u043E\u0433\u043E \u043C\u0430\u0440\u043D\u043E\u0433\u043E
        \u0437\u0430\u043D\u044F\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_58_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u043B\u0430\u0441\u044F
        \u0443\u043F\u0430\u043A\u043E\u0432\u043A\u0430 \u0432\u0456\u0434 \u0448\u043E\u043A\u043E\u043B\u0430\u0434\u043D\u043E\u0433\u043E
        \u0431\u0430\u0442\u043E\u043D\u0447\u0438\u043A\u0430. \u0426\u0435 \u0432\u0441\u0435
        \u043F\u043E\u0447\u0438\u043D\u0430\u043B\u043E \u0437\u0434\u0430\u0432\u0430\u0442\u0438\u0441\u044F
        \u043C\u0430\u0440\u043D\u0438\u043C. \u0422\u043E\u0436 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_58_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u0443\u043A\u0430\u0442\u0438 \u0434\u0430\u043B\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_58_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0433\u043B\u0435\u0434\u0456\u0442\u0438 \u0449\u043E-\u043D\u0435\u0431\u0443\u0434\u044C
        \u0456\u043D\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u043E\u0442 \u0446\u0435 \u0432\u0436\u0435 \u0446\u0456\u043A\u0430\u0432\u043E!"
    - Language: 1
      Text: 
  - Key: scene_5_59_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043D\u0435\u0441\u0435\u043D\u0438\u0439 \u0432\u0456\u0442\u0440\u043E\u043C
        \u043C\u0456\u0436 \u043A\u0430\u043C\u2019\u044F\u043D\u0438\u043C\u0438
        \u043F\u043E\u0440\u043E\u0434\u0430\u043C\u0438, \u043C\u0435\u043D\u0456
        \u0442\u0440\u0430\u043F\u0438\u0432\u0441\u044F \u043E\u0431\u0456\u0440\u0432\u0430\u043D\u0438\u0439
        \u043A\u043B\u0430\u043F\u0442\u0438\u043A \u043F\u0430\u043F\u0435\u0440\u0443.
        \u0417 \u043E\u0434\u043D\u0456\u0454\u0457 \u0441\u0442\u043E\u0440\u043E\u043D\u0438
        \u043D\u0430 \u043D\u044C\u043E\u043C\u0443 \u0431\u0443\u043B\u0438 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0456
        \u043C\u0435\u043D\u0456 \u043F\u0456\u0434\u0440\u0430\u0445\u0443\u043D\u043A\u0438.
        \u042F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430, \u0449\u043E \u0446\u0435
        \u043D\u0435 \u0441\u0445\u043E\u0436\u0435 \u043D\u0430 \u0448\u0438\u0444\u0440.
        \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0445\u0442\u043E\u0441\u044C
        \u0456\u0437 \u0440\u043E\u0431\u0456\u0442\u043D\u0438\u043A\u0456\u0432
        \u043A\u043E\u043F\u0430\u043B\u0435\u043D\u044C \u043F\u0440\u043E\u0441\u0442\u043E
        \u043E\u0431\u0440\u0430\u0432 \u0441\u043E\u0431\u0456 \u0437\u0430 \u0445\u043E\u0431\u0456
        \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417 \u0456\u043D\u0448\u043E\u0457 \u0436 \u0441\u0442\u043E\u0440\u043E\u043D\u0438
        \u043D\u0430 \u043F\u0430\u043F\u0435\u0440\u0456 \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430
        \u043D\u043E\u043C\u0435\u0440 \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443
        \u0456\u0437 \u043F\u0456\u0434\u043F\u0438\u0441\u043E\u043C. \u041D\u0430
        \u0436\u0430\u043B\u044C, \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0430
        \u0431\u0443\u043B\u0430 \u0432\u0456\u0434\u0456\u0440\u0432\u0430\u043D\u0430
        \u044F\u043A\u0440\u0430\u0437 \u043F\u043E\u0441\u0435\u0440\u0435\u0434
        \u0456\u043C\u0435\u043D\u0456, \u0456 \u0432\u0456\u0434 \u043D\u044C\u043E\u0433\u043E
        \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F \u043B\u0438\u0448\u0435
        \xAB\u0417\u0431\u0443\u2026\xBB"
    - Language: 1
      Text: 
  - Key: scene_5_59_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0436\u0435 \u0434\u0456\u0441\u0442\u0430\u043B\u0430
        \u0437 \u043A\u0438\u0448\u0435\u043D\u0456 \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
        \u0449\u043E\u0431 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F,
        \u043A\u0438\u043C \u0431\u0443\u0432 \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0432\u0438\u0439
        \u0417\u0431\u0443, \u0430\u043B\u0435 \u0441\u043C\u0443\u0433\u0430 \u043D\u0435\u0432\u0434\u0430\u0447
        \u0434\u043E\u0441\u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0430\u0441\u044F.
        \u0422\u0435\u043B\u0435\u0444\u043E\u043D \u0440\u043E\u0437\u0440\u044F\u0434\u0438\u0432\u0441\u044F,
        \u0456 \u044F \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F
        \u0437\u043E\u0432\u0441\u0456\u043C \u0431\u0435\u0437 \u0437\u0432\u2019\u044F\u0437\u043A\u0443
        \u0456\u0437 \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u0456\u043C \u0441\u0432\u0456\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0437\u043D\u0430\u043B\u0430, \u0447\u0438 \u043C\u0456\u0433
        \u043F\u0430\u043F\u0456\u0440\u0435\u0446\u044C \u044F\u043A\u043E\u0441\u044C
        \u0441\u0442\u043E\u0441\u0443\u0432\u0430\u0442\u0438\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0438.
        \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0445\u0442\u043E\u0441\u044C
        \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043F\u0438\u0441\u0430\u0432
        \u043D\u043E\u043C\u0435\u0440 \u043C\u0456\u0441\u0446\u0435\u0432\u043E\u0457
        \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u043F\u0456\u0446\u0438.
        \u0422\u0430 \u044F \u0432\u0441\u0435 \u0436 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043A\u043B\u0430\u043F\u0442\u0438\u043A
        \u043F\u0430\u043F\u0435\u0440\u0443, \u0430\u0434\u0436\u0435 \u0446\u0435
        \u0431\u0443\u043B\u043E \u043F\u043E\u043A\u0438 \u0449\u043E \u043E\u0434\u043D\u0456\u0454\u044E
        \u0437 \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445 \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u0445
        \u0437\u0430\u0447\u0456\u043F\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0446\u044C\u043E\u043C\u0443 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438 \u043F\u043E\u0448\u0443\u043A\u0438
        \u0442\u0430\u0454\u043C\u043D\u0438\u0445 \u0441\u0445\u043E\u0432\u043A\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043C-\u043C\u2026 \u042F \u043F\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u0432 \u0443\u0441\u0456\u0445 \u043C\u0456\u0441\u0446\u044F\u0445, \u043F\u0440\u043E
        \u044F\u043A\u0456 \u043C\u0435\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u043E.
        \u0410\u043B\u0435 \u0437\u0430\u0447\u0456\u043F\u043E\u043A \u0443\u0441\u0435
        \u0449\u0435 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E."
    - Language: 1
      Text: 
  - Key: scene_5_59_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u0449\u043E\u0441\u044C
        \u0432\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u043F\u0456\u0434 \u0447\u0430\u0441
        \u043E\u0433\u043B\u044F\u0434\u0443 \u0442\u0456\u043B\u0430? \u0422\u0440\u0435\u0431\u0430
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
        \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434. \u0422\u0430\u043A \u043C\u0435\u043D\u0456
        \u0456\u043D\u043E\u0434\u0456 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F
        \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u043D\u0435\u0437\u0440\u0438\u043C\u0435
        \u0434\u043B\u044F \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E\u0433\u043E
        \u043E\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u0431\u0443\u043B\u0430 \u0432\u0436\u0435 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0430
        \u043D\u043E\u0447\u0456. \u042F \u0441\u0442\u043E\u044F\u043B\u0430 \u043D\u0430
        \u0441\u0456\u043B\u044C\u0441\u044C\u043A\u0456\u0439 \u0432\u0443\u043B\u0438\u0446\u0456
        \u0442\u0430 \u0440\u043E\u0437\u0434\u0438\u0432\u043B\u044F\u043B\u0430\u0441\u044F
        \u043D\u0456\u0447\u043D\u0435 \u043D\u0435\u0431\u043E, \u043D\u0456\u0431\u0438
        \u043F\u043E\u0444\u0430\u0440\u0431\u043E\u0432\u0430\u043D\u0435 \u0432
        \u0446\u044F\u0442\u043A\u0443. \u041A\u043E\u043B\u0438 \u043F\u0440\u0438\u0457\u0436\u0434\u0436\u0430\u0454\u0448
        \u0456\u0437 \u043C\u0456\u0441\u0442\u0430 \u0432 \u0442\u0430\u043A\u0443
        \u0433\u043B\u0443\u0448\u0438\u043D\u0443, \u0437\u0430\u0432\u0436\u0434\u0438
        \u0434\u0438\u0432\u0443\u0454\u0448\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439
        \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u0437\u0456\u0440\u043E\u043A
        \u043D\u0430 \u043D\u0435\u0431\u0456."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u044F \u0432 \u0440\u043E\u0437\u0434\u0443\u043C\u0430\u0445,
        \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430 \u0441\u043A\u043B\u0430\u0441\u0442\u0438
        \u0434\u043E\u043A\u0443\u043F\u0438, \u0449\u043E \u0432\u0436\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0430
        \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0437\u0430 \u0447\u0430\u0441
        \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u0447\u0435\u0441\u043D\u043E,
        \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0456\u0432 \u0431\u0443\u043B\u043E
        \u043D\u0435\u0431\u0430\u0433\u0430\u0442\u043E. \u041F\u0440\u0438\u0447\u0438\u043D\u043E\u044E
        \u0441\u043C\u0435\u0440\u0442\u0456 \u0441\u0442\u0430\u043B\u043E \u043D\u0435\u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u0435
        \u0437\u0430\u043D\u0443\u0440\u0435\u043D\u043D\u044F \u043F\u0456\u0434
        \u0432\u043E\u0434\u0443 \u043D\u0430 \u043D\u0430\u0434\u043C\u0456\u0440\u043D\u043E
        \u0434\u043E\u0432\u0433\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D.
        \u0410 \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u041A\u043E\u0440\u043D\u0456\u044F
        \u0445\u0442\u043E\u0441\u044C \u0443\u0431\u0438\u0432. \u0406\u043C\u2019\u044F
        \u0432\u0431\u0438\u0432\u0446\u0456 \u044F \u043F\u043E\u043A\u0438 \u0449\u043E
        \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0441\u043A\u0430\u0437\u0430\u0442\u0438
        \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E.
        \u042F\u043A \u0456 \u0439\u043E\u0433\u043E \u0430\u0431\u043E \u0457\u0457
        \u043C\u043E\u0442\u0438\u0432\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E
        \u043F\u0440\u0438\u043F\u0443\u0441\u0442\u0438\u0442\u0438, \u0449\u043E
        \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u044E \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044E
        \u041A\u043E\u0440\u043D\u0456\u044F \u043E\u0441\u0442\u0430\u043D\u043D\u0456
        \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u043E\u043A\u0456\u0432
        \u0431\u0443\u0432 \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u0438\u0439
        \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043E\u043A \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430\u0445 \u0431\u0456\u043B\u044F
        \u0441\u0435\u043B\u0430. \u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0445\u0442\u043E\u0441\u044C
        \u0456\u0437 \u043C\u0456\u0441\u0446\u0435\u0432\u0438\u0445 \u0434\u0456\u0437\u043D\u0430\u0432\u0441\u044F
        \u043F\u0440\u043E \u0446\u0435 \u0442\u0430 \u0432\u0438\u0440\u0456\u0448\u0438\u0432
        \u0441\u0430\u043C\u043E\u0442\u0443\u0436\u043A\u0438 \u0437\u0434\u0456\u0439\u0441\u043D\u0438\u0442\u0438
        \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0456\u0441\u0442\u044C?"
    - Language: 1
      Text: 
  - Key: scene_2_60_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043C\u043C\u2026 \u041D\u0456, \u043D\u0430\u0432\u0440\u044F\u0434
        \u0447\u0438 \u044F \u043C\u0430\u043B\u0430 \u0441\u043F\u0440\u0430\u0432\u0443
        \u0456\u0437 \u0441\u0456\u043B\u044C\u0441\u044C\u043A\u0438\u043C \u0441\u0443\u043F\u0435\u0440\u0433\u0435\u0440\u043E\u0454\u043C.
        \u0406\u043D\u0448\u0438\u043C \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u043E\u043C
        \u0431\u0443\u043B\u0430 \u043F\u043E\u043C\u0441\u0442\u0430. \u0426\u0435
        \u043E\u0434\u0438\u043D \u0456\u0437 \u043D\u0430\u0439\u0447\u0430\u0441\u0442\u0456\u0448\u0438\u0445
        \u043C\u043E\u0442\u0438\u0432\u0456\u0432 \u0434\u043B\u044F \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u044F\u043A \u041A\u043E\u0440\u043D\u0456\u0439
        \u0442\u0456\u0454\u0457 \u043D\u043E\u0447\u0456 \u043E\u043F\u0438\u043D\u0438\u0432\u0441\u044F
        \u043D\u0430 \u043E\u0437\u0435\u0440\u0456? \u0427\u0438 \u043C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0449\u043E \u0432\u0456\u043D \u0437\u043D\u0430\u0432 \u0441\u0432\u043E\u0433\u043E
        \u0432\u0431\u0438\u0432\u0446\u044E? \u0412 \u0456\u0441\u0442\u043E\u0440\u0456\u0457
        \u0431\u0440\u0430\u043A\u0443\u0432\u0430\u043B\u043E \u0449\u0435 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
        \u043F\u0430\u0437\u043B\u0438\u043A\u0456\u0432. \u0422\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u0440\u0443\u0448\u0430\u0442\u0438 \u0434\u0430\u043B\u0456
        \u0456\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_60_part_7
    LocalizationDatas:
    - Language: 0
      Text: 
    - Language: 1
      Text: 
  - Key: scene_2_60_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0430\u043F\u0442\u043E\u043C \u044F \u0432\u0456\u0434\u0447\u0443\u043B\u0430
        \u0434\u043E\u0442\u0438\u043A \u0434\u043E \u0448\u0438\u0457. \u041F\u0435\u0440\u0435\u0434
        \u043C\u043E\u0457\u043C \u043E\u0431\u043B\u0438\u0447\u0447\u044F\u043C
        \u0437\u2019\u044F\u0432\u0438\u043B\u0430\u0441\u044F \u0432\u0430\u0436\u043A\u0430
        \u0440\u0443\u043A\u0430. \u0425\u0442\u043E\u0441\u044C \u043D\u0435\u043F\u043E\u043C\u0456\u0442\u043D\u043E
        \u043F\u0456\u0434\u043A\u0440\u0430\u0432\u0441\u044F \u0434\u043E \u043C\u0435\u043D\u0435
        \u0437\u0456 \u0441\u043F\u0438\u043D\u0438!"
    - Language: 1
      Text: 
  - Key: scene_2_60_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0443\u0447!.."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438 \u0444\u0440\u0430\u0437\u0443
        \u044F \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0430. \u041C\u0456\u0439
        \u0440\u043E\u0442 \u0442\u0430 \u043D\u0456\u0441 \u0437\u0430\u0442\u0443\u043B\u0438\u043B\u0438
        \u0432\u043E\u043B\u043E\u0433\u0438\u043C \u0433\u0430\u043D\u0447\u0456\u0440\u2019\u044F\u043C."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041C-\u043C-\u043C!.. \u041C-\u043C-\u043C!!!"
    - Language: 1
      Text: 
  - Key: scene_2_60_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u043A\u0456\u0439\u043D\u043E-\u0441\u043F\u043E\u043A\u0456\u0439\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0445\u043E\u0442\u0456\u043B\u0430 \u0432\u0440\u0456\u0437\u0430\u0442\u0438
        \u043D\u0430\u043F\u0430\u0434\u043D\u0438\u043A\u0443 \u0432 \u043D\u0430\u0439\u0431\u043E\u043B\u044E\u0447\u0456\u0448\u0456
        \u043C\u0456\u0441\u0446\u044F, \u044F\u043A\u0456 \u0442\u0456\u043B\u044C\u043A\u0438
        \u043C\u043E\u0433\u043B\u0430 \u0443\u044F\u0432\u0438\u0442\u0438! \u041D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0445\u043E\u0447\u0430 \u0431 \u043F\u0440\u0443\u0447\u0430\u0442\u0438\u0441\u044F.
        \u0410\u043B\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0432\u0438\u0439\u0448\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_60_part_14
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0432\u0456\u0442 \u0434\u043E\u0432\u043A\u043E\u043B\u0430
        \u043C\u0435\u043D\u0435 \u0442\u0435\u043C\u043D\u0456\u0448\u0430\u0432\u2026
        \u0422\u0456\u043B\u043E \u0441\u043B\u0430\u0431\u0448\u0430\u043B\u043E\u2026
        \u041A\u0456\u043D\u0446\u0456\u0432\u043A\u0438 \u0441\u0442\u0430\u0432\u0430\u043B\u0438
        \u0434\u0435\u0434\u0430\u043B\u0456 \u0432\u0430\u0436\u0447\u0438\u043C\u0438,
        \u0456 \u0441\u043A\u043E\u0440\u043E \u044F \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_6_61_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043E\u043D\u0435\u0447\u043A\u043E, \u043F\u0440\u043E\u0431\u0430\u0447,
        \u044F \u0437\u043D\u043E\u0432\u0443 \u0437\u0430\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0432\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_6_61_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043A\u0430\u0436\u0438, \u0449\u043E \u043D\u0456\u0447\u043E\u0433\u043E
        \u043D\u0435 \u0432\u0441\u0442\u0438\u0433! \u041C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
        \u0457\u0441\u0442\u0438 \u0437\u0430 \u0434\u0432\u043E\u0445!"
    - Language: 1
      Text: 
  - Key: scene_6_61_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0431\u0430\u0447, \u0434\u0430\u0432\u0430\u0439
        \u043F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u043C\u043E\u0432\u0438\u043C\u043E
        \u043F\u0456\u0446\u0443? \u0428\u0430\u0445\u043C\u0430\u0442\u0456\u0442\u043E\u0441
        \u043F\u0456\u0434\u0456\u0439\u0434\u0435?"
    - Language: 1
      Text: 
  - Key: scene_6_61_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u044F\u043A \u0437\u0430\u0432\u0436\u0434\u0438\u2026
        \u0414\u043E-\u043E-\u043E\u0431\u0440\u0435."
    - Language: 1
      Text: 
  - Key: scene_6_61_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0449\u0435 \u0444\u0456\u043B\u044C\u043C \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F!
        \u0422\u043E\u0439 \u0441\u0442\u0430\u0440\u0438\u0439, \u0437 \u0414\u0436\u0435\u0439\u043D\u043E\u043C
        \u0414\u0436\u0438\u043C\u0441\u043E\u043C. \u0422\u0438 \u0436 \u0439\u043E\u0433\u043E
        \u043B\u044E\u0431\u0438\u0448, \u043A\u043B\u0430\u0441\u0438\u043A\u0430
        \u043A\u0456\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457,
        \u0443\u0441\u0435 \u0442\u0430\u043A\u0435."
    - Language: 1
      Text: 
  - Key: scene_6_61_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_6_61_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u043B\u043E\u0434."
    - Language: 1
      Text: 
  - Key: scene_6_62_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0443 \u0433\u0430\u0440\u0430\u0437\u0434-\u0433\u0430\u0440\u0430\u0437\u0434.
        \u0414\u0443\u043C\u0430\u044E, \u0449\u043E \u0437\u043C\u043E\u0436\u0443
        \u0432\u0438\u043F\u0440\u043E\u0441\u0438\u0442\u0438 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u043A\u0443
        \u043D\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0434\u043D\u0456\u0432.
        \u0422\u0438 \u0437\u043D\u0430\u0454\u0448, \u044F\u043A \u043F\u0456\u0434\u043D\u044F\u0442\u0438
        \u043C\u0435\u043D\u0456 \u043D\u0430\u0441\u0442\u0440\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_6_62_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0449\u043E
        \u0439 \u043D\u0430\u0448\u043E\u043C\u0443 \u043A\u0430\u0440\u0430\u043F\u0443\u0437\u0438\u043A\u0443
        \u043F\u043E\u0434\u043E\u0440\u043E\u0436 \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F.
        \u0412\u0456\u043D \u0443\u0436\u0435 \u0437\u043E\u0432\u0441\u0456\u043C
        \u0441\u043A\u043E\u0440\u043E \u0434\u043E \u043D\u0430\u0441 \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0454\u0442\u044C\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_6_62_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041A\u0430\u0440\u0430\u043F\u0443\u0437\u0438\u043A\u0443\xBB?
        \u0414\u0435 \u0442\u0438 \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u0456\u0432
        \u043D\u0430\u0431\u0440\u0430\u0432\u0441\u044F? \u0406 \u0447\u043E\u043C\u0443
        \u0442\u0430\u043A \u043F\u0435\u0432\u0435\u043D, \u0449\u043E \u0446\u0435
        \u0431\u0443\u0434\u0435 \u0441\u0438\u043D?"
    - Language: 1
      Text: 
  - Key: scene_6_62_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0445\u0442\u043E \u0449\u0435 \u043C\u043E\u0436\u0435 \u043D\u0430\u0440\u043E\u0434\u0438\u0442\u0438\u0441\u044F
        \u0432 \u0442\u0430\u043A\u043E\u0457 \u0441\u0438\u043B\u044C\u043D\u043E\u0457,
        \u043C\u0443\u0436\u043D\u044C\u043E\u0457 \u0442\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_6_62_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0440\u0430\u0437 \u043E\u0442\u0440\u0438\u043C\u0430\u0454\u0448!
        \u0423 \u043C\u0435\u043D\u0435 \u043C\u0430\u0442\u0438 \u0431\u0443\u043B\u0430
        \u0431\u043E\u043A\u0441\u0435\u0440\u043A\u043E\u044E! \u0419\u0434\u0438
        \u0441\u044E\u0434\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0446\u0456\u043B\u0443\u0454\u0448 \u0443 \u0436\u0438\u0432\u043E\u0442\u0438\u043A?"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0443 \u0441\u0432\u043E\u0454\u043C\u0443 \u0440\u043E\u0437\u0443\u043C\u0456!!!"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430 \u043A\u043E\u0433\u043E \u0442\u0438 \u043C\u0435\u043D\u0435
        \u043C\u0430\u0454\u0448?! \u0426\u0435 \u0442\u0438 \u0432\u0438\u043D\u0430,
        \u0447\u0443\u0454\u0448?"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u0440\u0432\u0430!"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0442\u0430 \u0442\u0432\u043E\u0454 \u043D\u0456 \u043D\u0430
        \u0449\u043E \u043D\u0435 \u0437\u0434\u0430\u0442\u043D\u0435 \u0422\u0406\u041B\u041E!!!"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u043C\u0443 \u0431\u043E\u0433 \u0441\u0442\u0432\u043E\u0440\u0438\u0432
        \u0442\u0435\u0431\u0435 \u0442\u0430\u043A\u043E\u044E? \u041D\u0430\u0449\u043E
        \u0432\u0456\u043D \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0430\u0441
        \u0437\u0432\u0456\u0432?!"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0448, \u043D\u0456\u0431\u0438
        \u0446\u0435 \u0432 \u0442\u0435\u0431\u0435 \u0432 \u0436\u0438\u0432\u043E\u0442\u0456
        \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u043C\u0456\u0441\u044F\u0446\u0456\u0432
        \u043B\u0435\u0436\u0430\u043B\u0430 \u041C\u0415\u0420\u0422\u0412\u0410
        \u0414\u0418\u0422\u0418\u041D\u0410!!!"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0445\u043E\u0447\u2026 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448\u2026
        \u044F\u043A \u0446\u0435\u2026 \u043D \u0430 \u0440 \u043E \u0434 \u0436
        \u0443 \u0432 \u0430 \u0442 \u0438 \u0442\u0440-\u0440-\u0440\u2026"
    - Language: 1
      Text: 
  - Key: scene_6_63_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
        \u0441\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0441\u043B\u0456\u0437."
    - Language: 1
      Text: 
  - Key: scene_3_64_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0433-\u0433-\u0433-\u0445-\u0445\u0445\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_64_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0436\u0435 \u0431\u043E\u043B\u0438\u0442\u044C \u0433\u043E\u043B\u043E\u0432\u0430.
        \u0416\u0430\u0445\u043B\u0438\u0432\u0438\u0439 \u0441\u043E\u043D\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_64_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u043E\u043F."
    - Language: 1
      Text: 
  - Key: scene_3_64_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435 \u0446\u0435 \u044F?"
    - Language: 1
      Text: 
  - Key: scene_3_64_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0430\u043C\u2019\u044F\u0442\u044C \u043F\u043E\u0442\u0440\u043E\u0445\u0443
        \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u043B\u0430\u0441\u044F \u0434\u043E
        \u043C\u0435\u043D\u0435. \u042F \u043F\u0440\u0438\u0433\u0430\u0434\u0430\u043B\u0430,
        \u044F\u043A \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u043B\u0430.
        \u042F \u043E\u0437\u0438\u0440\u043D\u0443\u043B\u0430\u0441\u044F \u043D\u0430\u0432\u043A\u0440\u0443\u0433\u0438
        \u0456 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u0449\u043E
        \u0441\u0438\u0434\u0436\u0443 \u043F\u043E\u0441\u0435\u0440\u0435\u0434
        \u043F\u043E\u0440\u043E\u0436\u043D\u044C\u043E\u0433\u043E \u043F\u0456\u0434\u0432\u0430\u043B\u0443,
        \u043F\u0440\u0438\u0432\u2019\u044F\u0437\u0430\u043D\u0430 \u0434\u043E
        \u0441\u0442\u0456\u043B\u044C\u0446\u044F. \u0406\u0434\u0435\u0430\u043B\u044C\u043D\u0430
        \u043A\u0456\u043C\u043D\u0430\u0442\u0430 \u0434\u043B\u044F \u0442\u043E\u0440\u0442\u0443\u0440."
    - Language: 1
      Text: 
  - Key: scene_3_64_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044F \u043D\u0430\u0440\u0435\u0448\u0442\u0456,
        \u0441\u0432\u043E\u043B\u043E\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_64_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0441\u0432\u0456\u0442\u043B\u043E \u043B\u0430\u043C\u043F\u043E\u0447\u043A\u0438
        \u0432\u0438\u0439\u0448\u043E\u0432 \u0432\u0435\u043B\u0435\u0442\u0435\u043D\u0441\u044C\u043A\u0438\u0439
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A. \u0420\u043E\u0441\u0442\u043E\u043C
        \u043C\u0430\u0439\u0436\u0435 \u043F\u0456\u0434 \u0434\u0432\u0430 \u043C\u0435\u0442\u0440\u0438,
        \u043A\u0440\u0435\u043C\u0435\u0437\u043D\u0438\u0439 \u044F\u043A \u0431\u0438\u043A.
        \u0412\u0456\u043D \u0434\u0438\u0432\u0438\u0432\u0441\u044F \u043D\u0430
        \u043C\u0435\u043D\u0435 \u0442\u0430\u043A\u0438\u043C \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u0438\u043C
        \u043F\u043E\u0433\u043B\u044F\u0434\u043E\u043C, \u043D\u0456\u0431\u0438
        \u044F \u0437\u2019\u0457\u043B\u0430 \u043F\u0430\u0447\u043A\u0443 \u0447\u0438\u043F\u0441\u0456\u0432,
        \u044F\u043A\u0443 \u0432\u0456\u043D \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u0432
        \u0434\u043B\u044F \u0441\u0435\u0431\u0435 \u043D\u0430 \u043F\u043E\u0442\u0456\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_65_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0435 \u0437\u0432\u0430\u0442\u0438 \u041E\u043B\u0435\u043A\u0441\u0456\u0439,
        \u0431\u0443\u0434\u0435\u043C\u043E \u0437\u043D\u0430\u0439\u043E\u043C\u0456.
        \u0414\u0430\u0432\u043D\u043E \u0437\u0430 \u0442\u043E\u0431\u043E\u044E
        \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u044E, \u044F\u043A
        \u0442\u0438 \u0442\u0443\u0442 \u0441\u0435\u043B\u043E\u043C \u0442\u0438\u043D\u044F\u0454\u0448\u0441\u044F.
        \u0410 \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0436\u0435
        \u0439 \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430 \u043F\u043E\u043B\u0456\u0437\u043B\u0430\u2026
        \u042F \u0442\u0430\u043C \u043E\u0445\u043E\u0440\u043E\u043D\u0435\u0446\u044C,
        \u0434\u043E \u0442\u0432\u043E\u0433\u043E \u0432\u0456\u0434\u043E\u043C\u0430!"
    - Language: 1
      Text: 
  - Key: scene_3_65_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u0442\u0456\u043B\u0430 \u0441\u043B\u0456\u0434\u0438
        \u0437\u0430\u0442\u0435\u0440\u0442\u0438, \u0433\u0430? \u041D\u0430\u0432\u0456\u0449\u043E
        \u0442\u043E\u0431\u0456 \u0446\u0435?! \u0412\u0431\u0438\u043B\u0430 \u043B\u044E\u0434\u0438\u043D\u0443,
        \u0430 \u0442\u0435\u043F\u0435\u0440 \u043B\u044F\u0447\u043D\u043E \u0441\u0442\u0430\u043B\u043E?
        \u041A\u043E\u0440\u043D\u0456\u0439 \u043C\u043E\u0457\u043C \u0434\u0440\u0443\u0433\u043E\u043C
        \u0431\u0443\u0432! \u0422\u0438 \u0437\u0430 \u0446\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0438!!
        \u0411\u0435\u0437 \u0456\u043C\u0435\u043D\u0456: \u0427\u043E\u043B\u043E\u0432\u0456\u043A
        \u0431\u0443\u0432 \u044F\u0432\u043D\u043E \u043D\u0435\u0441\u043F\u043E\u0432\u043D\u0430
        \u0440\u043E\u0437\u0443\u043C\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_65_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u043B\u043E\u0432\u0456\u043A \u0431\u0443\u0432 \u044F\u0432\u043D\u043E
        \u043D\u0435\u0441\u043F\u043E\u0432\u043D\u0430 \u0440\u043E\u0437\u0443\u043C\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_65_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0442\u0435\u0431\u0435 \u0449\u0435 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443 \u0437\u0430\u0441\u0456\u043A,
        \u043A\u043E\u043B\u0438 \u0442\u0438 \u0434\u043E \u0441\u0435\u043B\u0430
        \u0441\u0432\u043E\u0433\u043E \u043D\u043E\u0441\u0430 \u043F\u0440\u0438\u043F\u0445\u0430\u043B\u0430.
        \u041E\u0434\u0440\u0430\u0437\u0443 \u043F\u043E\u0434\u0443\u043C\u0430\u0432,
        \u0449\u043E \u0442\u0438 \u043B\u044E\u0434\u0438\u043D\u0430 \u043C\u0443\u0442\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_65_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410? \u041D\u0435 \u043F\u0440\u0438\u0433\u0430\u0434\u0443\u044E,
        \u0449\u043E\u0431 \u044F \u043A\u043E\u043B\u0438\u0441\u044C \u0431\u0443\u043B\u0430
        \u0432 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u043C\u0443 \u0440\u0430\u043D\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_65_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0442\u043E\u0431\u0456 \u0442\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u0432\u0456\u0434 \u041A\u043E\u0440\u043D\u0456\u044F?
        \u041A\u0430\u0436\u0438!"
    - Language: 1
      Text: 
  - Key: scene_3_65_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0443, \u0447\u043E\u0433\u043E \u043C\u043E\u0432\u0447\u0438\u0448,
        \u044F\u0437\u0438\u043A \u043F\u0440\u043E\u043A\u043E\u0432\u0442\u043D\u0443\u043B\u0430?!"
    - Language: 1
      Text: 
  - Key: scene_3_65_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0442\u0430 \u0432\u0441\u0435
        \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_65_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u043B\u0430\u044F\u0442\u0438\u0441\u044F \u043D\u0430
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_65_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044C \u0456
        \u043F\u0440\u043E\u043C\u043E\u0432\u0447\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_66_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u044E, \u0437\u0430\u0436\u0434\u0456\u0442\u044C\u2026
        \u041A\u0445\u0435\u2026 \u041C\u0438 \u043E\u0431\u0438\u0434\u0432\u0430
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0438 \u0432 \u0434\u0443\u0436\u0435
        \u0434\u0435\u043B\u0456\u043A\u0430\u0442\u043D\u0443 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E.
        \u041D\u0430\u0432\u0456\u0449\u043E \u043D\u0430\u043C \u043A\u0443\u0434\u0438\u0441\u044C
        \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0442\u0438 \u0442\u0430 \u0434\u0456\u044F\u0442\u0438
        \u0440\u0430\u0434\u0438\u043A\u0430\u043B\u044C\u043D\u043E? \u042F \u0431
        \u0445\u043E\u0442\u0456\u043B\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
        \u0432\u0430\u043C \u0432 \u0443\u0441\u044C\u043E\u043C\u0443 \u0440\u043E\u0437\u0456\u0431\u0440\u0430\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_66_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0439 \u0442\u0435, \u0449\u043E \u0432\u0438 \u0437\u0430\u0440\u0430\u0437
        \u0432\u0447\u0438\u043D\u044F\u0454\u0442\u0435 \u2014 \u0446\u0435 \u043D\u0435\u0437\u0430\u043A\u043E\u043D\u043D\u0456
        \u0434\u0456\u0457. \u042F \u0441\u043B\u0456\u0434\u0447\u0430 \u043F\u043E\u043B\u0456\u0446\u0456\u0457.
        \u042F\u043A\u0449\u043E \u0437\u0456 \u043C\u043D\u043E\u044E \u0449\u043E\u0441\u044C
        \u0441\u0442\u0430\u043D\u0435\u0442\u044C\u0441\u044F, \u043C\u0435\u043D\u0435
        \u0431\u0443\u0434\u0443\u0442\u044C \u0448\u0443\u043A\u0430\u0442\u0438,
        \u0456 \u0432\u0438 \u0432 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
        \u0432\u0438\u043F\u0430\u0434\u043A\u0443 \u043D\u0435\u0441\u0442\u0438\u043C\u0435\u0442\u0435
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_3_66_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E \u0442\u0438 \u0437 \u043C\u0443\u0441\u043E\u0440\u0456\u0432!?
        \u0425\u0435\u0445, \u043C\u0435\u043D\u0435 \u0446\u0435 \u043D\u0435 \u0434\u0438\u0432\u0443\u0454.
        \u042F \u0432\u0436\u0435 \u0434\u0430\u0432\u043D\u043E \u0432\u0430\u043C,
        \u0432\u0438\u0440\u043E\u0434\u043A\u0430\u043C, \u043D\u0435 \u0432\u0456\u0440\u044E.
        \u0422\u0438 \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F, \u0443 \u044F\u043A\u0438\u0445
        \u043C\u0438 \u0442\u0443\u0442 \u0437\u043B\u0438\u0434\u043D\u044F\u0445
        \u0436\u0438\u0432\u0435\u043C\u043E! \u0406 \u0447\u0435\u0440\u0435\u0437
        \u0449\u043E?"
    - Language: 1
      Text: 
  - Key: scene_3_66_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0435\u0440\u0435\u0437 \u0442\u0435, \u0449\u043E \u0436\u043E\u0434\u0435\u043D
        \u0456\u0437 \u0432\u0430\u0441, \u0441\u043E\u0431\u0430\u043A, \u043D\u0456\u0447\u043E\u0433\u043E
        \u043D\u0435 \u0440\u043E\u0431\u0438\u0442\u044C \u0456\u0437 \u043A\u0440\u0430\u0434\u0456\u0436\u043A\u0430\u043C\u0438
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443! \u0410 \u0446\u0435 \u0432\u0441\u0435,
        \u0449\u043E \u043C\u0438 \u043C\u0430\u0454\u043C\u043E!.. \u041D\u0430
        \u043B\u044E\u0434\u0441\u044C\u043A\u0456 \u0436\u0438\u0442\u0442\u044F
        \u0432\u0430\u043C \u0443\u0441\u0456\u043C \u043F\u043B\u044E\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_66_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u043D\u0430\u0447\u0438\u0442\u044C, \u0456 \u044F \u043D\u0435
        \u0431\u0443\u0434\u0443 \u0446\u0456\u043D\u0443\u0432\u0430\u0442\u0438
        \u0432\u0430\u0448\u0456. \u041D\u0435 \u043C\u043E\u0436\u043D\u0430 \u043F\u043E\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F
        \u043D\u0430 \u043F\u043E\u043B\u0456\u0446\u0456\u044E, \u043A\u0440\u0430\u0449\u0435
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0432\u0441\u0435 \u0441\u0430\u043C\u043E\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_66_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0441\u043A\u043B\u0430\u0432
        \u0440\u0443\u043A\u0438 \u0442\u0430 \u043F\u0440\u043E\u0445\u0440\u0443\u0441\u0442\u0456\u0432
        \u043A\u0456\u0441\u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u043F\u0430\u043B\u044C\u0446\u0456\u0432.
        \u0426\u0435 \u043D\u0435 \u043C\u0430\u043B\u043E \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0442\u0438
        \u0442\u0430\u043A \u0441\u0442\u0440\u0430\u0445\u0456\u0442\u043B\u0438\u0432\u043E,
        \u044F\u043A \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u043B\u043E \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_67_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u0441\u043C\u043E\u043A\u0447\u0438 \u043F\u0440\u0443\u0442\u043D\u044F,
        \u041E\u043B\u0435\u043A\u0441\u0456\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_67_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u0446\u0435
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0430 \u043E\u0431\u043B\u0438\u0447\u0447\u044F
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0449\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435
        \u043D\u0430\u043B\u0438\u043B\u043E\u0441\u044F \u0431\u0430\u0433\u0440\u044F\u043D\u0446\u0435\u043C.
        \u0412\u0435\u043D\u0438 \u043D\u0430 \u043B\u043E\u0431\u0456 \u0437\u0434\u0443\u043B\u0438\u0441\u044F,
        \u044F\u043A \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456
        \u0442\u0440\u0443\u0431\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_67_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u043B\u043E\u0432\u0456\u043A \u043F\u0456\u0434\u0441\u043A\u043E\u0447\u0438\u0432
        \u0434\u043E \u043C\u0435\u043D\u0435, \u0456 \u044F \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0430
        \u043D\u0430\u0432\u0456\u0442\u044C \u043F\u0440\u043E\u0441\u043B\u0456\u0434\u043A\u0443\u0432\u0430\u0442\u0438
        \u0437\u0430 \u0439\u043E\u0433\u043E \u043A\u0443\u043B\u0430\u043A\u043E\u043C.
        \u0412 \u043E\u0434\u0438\u043D \u043C\u043E\u043C\u0435\u043D\u0442 \u043F\u043E\u0432\u0456\u0442\u0440\u044F
        \u0432\u0438\u0441\u043A\u043E\u0447\u0438\u043B\u043E \u0437 \u043C\u043E\u0457\u0445
        \u0433\u0440\u0443\u0434\u0435\u0439. \u042F \u0432\u0456\u0434\u0447\u0443\u043B\u0430
        \u0441\u0438\u043B\u044C\u043D\u0438\u0439 \u0431\u0456\u043B\u044C \u0433\u043B\u0438\u0431\u043E\u043A\u043E
        \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456. \u041A\u0440\u0438\u043A
        \u0437\u0430\u0441\u0442\u0440\u044F\u0433 \u0443 \u0433\u043E\u0440\u043B\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_67_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u043E\u0434\u0440\u0430\u0437\u0443 \u043F\u0440\u0438\u0439\u043D\u044F\u0432
        \u0441\u0442\u0440\u0438\u043C\u0430\u043D\u0456\u0448\u0443 \u043F\u043E\u0437\u0443.
        \u042F \u0433\u043E\u043B\u043E\u0441\u043D\u043E \u0432\u0434\u0438\u0445\u043D\u0443\u043B\u0430.
        \u041F\u0435\u0440\u0435\u0434 \u043E\u0447\u0438\u043C\u0430 \u0432\u0441\u0435
        \u043F\u043E\u0447\u0430\u043B\u043E \u043F\u043B\u0438\u0441\u0442\u0438,
        \u0456 \u044F \u043B\u0435\u0434\u044C \u0437\u043D\u043E\u0432\u0443 \u043D\u0435
        \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430 \u0442\u044F\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_67_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0430\u0447, \u0456\u043D\u043E\u0434\u0456 \u043C\u0435\u043D\u0456
        \u0431\u0443\u0432\u0430\u0454 \u0441\u043A\u043B\u0430\u0434\u043D\u043E
        \u0441\u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
        \u0437 \u0442\u0438\u043C\u0438, \u0445\u0442\u043E \u0432\u0431\u0438\u0432
        \u043C\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
        \u0434\u0430\u043B\u0456 \u043C\u0438 \u043E\u0431\u0438\u0434\u0432\u0430
        \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043B\u0456\u0434\u043A\u0443\u0432\u0430\u0442\u0438
        \u0437\u0430 \u043C\u0430\u043D\u0435\u0440\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_68_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0432\u0447\u0438\u0448, \u043A\u0443\u0440\u0432\u043E?!
        \u0414\u0456\u0441\u0442\u0430\u0432\u0430\u0439 \u0443\u0436\u0435 \u0445\u043E\u0447
        \u044F\u043A\u0443\u0441\u044C \u0447\u0435\u0441\u043D\u0456\u0441\u0442\u044C
        \u0437\u0456 \u0441\u0432\u043E\u0454\u0457 \u0434\u0443\u043F\u0438, \u0447\u0438
        \u0434\u0435 \u0442\u0438 \u0457\u0457 \u0442\u0430\u043C \u0437\u0430\u043F\u0445\u0430\u043B\u0430?!
        \u042F \u043C\u043E\u0436\u0443 \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F
        \u0442\u0435\u0431\u0435 \u043F\u0440\u044F\u043C\u043E \u0437\u0430\u0440\u0430\u0437,
        \u0442\u0430 \u0441\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u0445\u043E\u0447\u0443
        \u0437\u043D\u0430\u0442\u0438 \u0437\u0430 \u0449\u043E \u0442\u0438 \u0442\u0430\u043A
        \u043E\u0431\u0456\u0439\u0448\u043B\u0430\u0441\u044F \u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C?!!"
    - Language: 1
      Text: 
  - Key: scene_3_68_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u0446\u0435
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u0442\u0430 \u043E\u0431\u043B\u0438\u0447\u0447\u044F
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0449\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435
        \u043D\u0430\u043B\u0438\u043B\u043E\u0441\u044F \u0431\u0430\u0433\u0440\u044F\u043D\u0446\u0435\u043C.
        \u0412\u0435\u043D\u0438 \u043D\u0430 \u043B\u043E\u0431\u0456 \u0437\u0434\u0443\u043B\u0438\u0441\u044F,
        \u044F\u043A \u043A\u0430\u043D\u0430\u043B\u0456\u0437\u0430\u0446\u0456\u0439\u043D\u0456
        \u0442\u0440\u0443\u0431\u0438. \u0422\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0457
        \u0441\u0435\u043A\u0443\u043D\u0434\u0438 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u043F\u0440\u0438\u0439\u043D\u044F\u0432 \u0441\u0442\u0440\u0438\u043C\u0430\u043D\u0456\u0448\u0443
        \u043F\u043E\u0437\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_68_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0430\u0447, \u0456\u043D\u043E\u0434\u0456 \u043C\u0435\u043D\u0456
        \u0431\u0443\u0432\u0430\u0454 \u0434\u0443\u0436\u0435 \u0441\u043A\u043B\u0430\u0434\u043D\u043E
        \u0441\u0442\u0440\u0438\u043C\u0430\u0442\u0438\u0441\u044F. \u041E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
        \u0437 \u0442\u0438\u043C\u0438, \u0445\u0442\u043E \u0432\u0431\u0438\u0432
        \u043C\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
        \u0434\u0430\u043B\u0456 \u043C\u0438 \u043E\u0431\u0438\u0434\u0432\u0430
        \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0441\u043B\u0456\u0434\u043A\u0443\u0432\u0430\u0442\u0438
        \u0437\u0430 \u043C\u0430\u043D\u0435\u0440\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_69_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435
        \u044F \u0445\u043E\u0447\u0443 \u0434\u043E\u043A\u043E\u043F\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u0456\u0441\u0442\u0438\u043D\u0438. \u0406 \u043F\u043E\u043C\u0441\u0442\u0438\u0442\u0438\u0441\u044F
        \u0437\u0430 \u041A\u043E\u0440\u043D\u0456\u044F. \u0419\u043E\u0433\u043E
        \u0432\u0431\u0438\u0432\u0446\u044F \u043C\u0430\u0454 \u0431\u0443\u0442\u0438
        \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u0438\u0439!"
    - Language: 1
      Text: 
  - Key: scene_3_69_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u0435\u0448 \u043D\u0435 \u0432\u0456\u0440\u0438\u0442\u0438,
        \u0442\u0430 \u044F \u0445\u043E\u0447\u0443 \u0442\u043E\u0433\u043E \u0436
        \u0441\u0430\u043C\u043E\u0433\u043E. \u0422\u0430\u043A\u0430 \u0432 \u043C\u0435\u043D\u0435
        \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u044F. \u0406 \u044F \u043C\u0430\u044E
        \u0437\u0430\u043A\u043E\u043D\u043D\u0435 \u043F\u0440\u0430\u0432\u043E
        \u0457\u0457 \u0440\u043E\u0431\u0438\u0442\u0438. \u0410 \u0442\u043E\u0431\u0456
        \u0442\u0430\u043A\u043E\u0433\u043E \u043F\u0440\u0430\u0432\u0430 \u043D\u0456\u0445\u0442\u043E
        \u043D\u0435 \u0434\u0430\u0432\u0430\u0432, \u041E\u043B\u0435\u043A\u0441\u0456\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_69_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0432 \u0447\u043E\u043C\u0443 \u043C\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E
        \u0432\u0456\u0434\u0440\u0456\u0437\u043D\u044F\u0454\u043C\u043E\u0441\u044F?
        \u041B\u0438\u0448\u0435 \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E \u044F\u043A\u0438\u0439\u0441\u044C
        \u0448\u0438\u0437\u0456\u043A \u0432\u0438\u0437\u043D\u0430\u0432 \u0442\u0435\u0431\u0435
        \u0433\u0456\u0434\u043D\u043E\u044E \u043D\u043E\u0441\u0438\u0442\u0438
        \u0437\u043D\u0430\u0447\u043E\u043A? \u0425\u0442\u043E \u0434\u0430\u0432
        \u0442\u043E\u0431\u0456 \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0456\u0441\u0442\u044C
        \u0442\u0430 \u043D\u0430\u0441\u0438\u043B\u043B\u044F? \u041F\u0435\u0440\u0435\u0434
        \u0411\u043E\u0433\u043E\u043C \u0443\u0441\u0456 \u0440\u0456\u0432\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_69_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u043D\u0430\u044E, \u0432\u0438 \u0448\u0432\u0438\u0434\u043A\u043E
        \u0434\u043E \u0440\u043E\u0437\u0432\u2019\u044F\u0437\u0430\u043D\u0438\u0445
        \u0440\u0443\u043A \u0437\u0432\u0438\u043A\u0430\u0454\u0442\u0435. \u041D\u0435
        \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F \u043D\u0430\u0432\u0456\u0442\u044C
        \u0440\u043E\u0437\u0434\u0443\u043C\u0443\u0432\u0430\u0442\u0438, \u043F\u0435\u0440\u0448
        \u043D\u0456\u0436 \u043A\u043E\u0433\u043E\u0441\u044C \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u0442\u0438
        \u0436\u0438\u0442\u0442\u044F. \u042F\u043A\u0430 \u043C\u043E\u0440\u0430\u043B\u044C
        \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u044F\u0454 \u043C\u0435\u043D\u0456
        \u0432\u0447\u0438\u043D\u044F\u0442\u0438 \u0442\u0430\u043A \u0441\u0430\u043C\u043E
        \u0437 \u0442\u043E\u0431\u043E\u044E?"
    - Language: 1
      Text: 
  - Key: scene_3_69_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0440\u0430\u0448\u043D\u043E \u0431\u0443\u043B\u043E
        \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u043B\u044E\u0432\u0430\u0442\u0438,
        \u0430\u043B\u0435 \u0432 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u044F \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F \u0437
        \u041E\u043B\u0435\u043A\u0441\u0456\u0454\u043C. \u0426\u0435\u0439 \u0447\u043E\u043B\u043E\u0432\u0456\u043A
        \u043C\u0430\u0432 \u0440\u0430\u0446\u0456\u044E, \u0430\u043B\u0435 \u0446\u044F
        \u043F\u0440\u0430\u0432\u0434\u0430 \u0437\u0434\u0430\u0432\u0430\u043B\u0430\u0441\u044F
        \u0447\u0438\u043C\u043E\u0441\u044C \u0434\u0443\u0436\u0435 \u0437\u0431\u043E\u0447\u0435\u043D\u0438\u043C
        \u0456 \u043F\u043E\u0442\u0432\u043E\u0440\u043D\u0438\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_69_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0436\u0435 \u043D\u0430\u0432\u0456\u0432 \u0434\u0435\u044F\u043A\u0456
        \u0441\u043F\u0440\u0430\u0432\u043A\u0438, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E,
        \u0456 \u0431\u0430\u0433\u0430\u0442\u043E \u0434\u0456\u0437\u043D\u0430\u0432\u0441\u044F.
        \u041E\u0442\u0440\u0438\u043C\u0430\u0442\u0438 \u0434\u043E\u0441\u0442\u0443\u043F
        \u0434\u043E \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u0438\u0445 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432
        \u043D\u0430 \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0438\u0445
        \u043D\u0435 \u0442\u0430\u043A \u0432\u0430\u0436\u043A\u043E, \u044F\u043A\u0449\u043E
        \u0437\u043D\u0430\u0454\u0448, \u0434\u0435 \u0448\u0443\u043A\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_69_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F, \u0447\u0438
        \u0442\u0438 \u0433\u0456\u0434\u043D\u0430 \u0437\u0432\u0430\u0442\u0438\u0441\u044F
        \u0442\u043E\u044E, \u043A\u0438\u043C \u0441\u0435\u0431\u0435 \u0432\u0432\u0430\u0436\u0430\u0454\u0448."
    - Language: 1
      Text: 
  - Key: scene_3_70_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0447\u043D\u0435\u043C\u043E. \u0406\u043C\u2019\u044F:
        \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u043E, \u043E\u0437\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
        \u043D\u0430 \u043F\u0440\u0456\u0437\u0432\u0438\u0441\u044C\u043A\u043E
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430. \u0411\u0430\u0447\u0443,
        \u0442\u043E\u0431\u0456 \u0454 \u0449\u043E \u043F\u0440\u0438\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_70_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u043A: \u0442\u0440\u0438\u0434\u0446\u044F\u0442\u044C
        \u0448\u0456\u0441\u0442\u044C \u0440\u043E\u043A\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_70_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u0437 \u0441\u043E\u0446\u0456\u0430\u043B\u044C\u043D\u0438\u0445
        \u043C\u0435\u0440\u0435\u0436 \u0432\u0456\u0434\u043E\u043C\u043E, \u0449\u043E
        \u0442\u0438 \u043C\u0430\u0454\u0448 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u044C
        \u0434\u043E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457.
        \u0425\u043C\u2026 \u0422\u0430\u043A\u0438\u0445, \u044F\u043A \u0432\u0438,
        \u043D\u0456\u0431\u0438 \u043D\u0435\u0447\u0430\u0441\u0442\u043E \u0442\u044F\u0433\u043D\u0435
        \u043D\u0430 \u0442\u0432\u043E\u0440\u0447\u0456\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_3_70_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
        \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457 \u044F \u0431\u0430\u0447\u0443
        \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0443 \u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C
        \u0440\u0435\u0447\u0435\u0439."
    - Language: 1
      Text: 
  - Key: scene_3_70_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435 \u0445\u043E\u0431\u0456 \u0449\u0435 \u0437 \u043F\u0456\u0434\u043B\u0456\u0442\u043A\u043E\u0432\u043E\u0433\u043E
        \u0432\u0456\u043A\u0443. \u0412\u043E\u043D\u043E \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u043B\u043E
        \u043C\u0435\u043D\u0456 \u0432 \u0441\u043A\u0440\u0443\u0442\u043D\u0456
        \u0447\u0430\u0441\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_70_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043A\u043E\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_71_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043E\u0432\u043E\u0440\u0438\u0448, \u043D\u0456\u0431\u0438
        \u0442\u0438 \u044F\u043A\u0430\u0441\u044C \u0445\u0443\u0434\u043E\u0436\u043D\u0438\u0446\u044F,
        \u0430 \u043D\u0435 \u043F\u043E\u043B\u0456\u0446\u0430\u0439\u043D\u044F!
        \u0414\u0438\u0432\u043D\u043E, \u0449\u043E \u0442\u0430\u043A\u0430 \u043B\u044E\u0434\u0438\u043D\u0430
        \u043C\u0430\u0454 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u0456
        \u0434\u043E \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_71_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u043D\u0443, \u0437\u0430\u0433\u043B\u044F\u043D\u0438 \u043C\u0435\u043D\u0456
        \u0432 \u043E\u0447\u0456. \u042F\u043A\u0443 \xAB\u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0443
        \u0441\u0443\u0442\u043D\u0456\u0441\u0442\u044C\xBB \u0440\u0435\u0447\u0435\u0439
        \u0442\u0438 \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u0431 \u0443
        \u043D\u0438\u0445?"
    - Language: 1
      Text: 
  - Key: scene_3_71_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u043A\u043E\u0437\u043B\u044F\u0440\u0430 \u0442\u0430
        \u0437\u043B\u043E\u0434\u0456\u0439! \u0422\u0443\u0442 \u0434\u043E\u0432\u0433\u043E
        \u0433\u0430\u0434\u0430\u0442\u0438 \u043D\u0435 \u0442\u0440\u0435\u0431\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_71_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u043D\u0430\u0434\u043B\u0430\u043C\u0430\u043D\u0430
        \u043B\u044E\u0434\u0438\u043D\u0430, \u0430\u043B\u0435 \u0432 \u0441\u0435\u0440\u0446\u0456
        \u043C\u0430\u0454\u0448 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u0435
        \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F \u0434\u043E\u0431\u0440\u0430.
        \u0421\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_72_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0438\u0432\u043D\u043E, \u0449\u043E \u0437\u0430\u043C\u0456\u0441\u0442\u044C
        \u0448\u043B\u044F\u0445\u0443 \u0442\u0432\u043E\u0440\u0447\u043E\u0457
        \u043B\u044E\u0434\u0438\u043D\u0438, \u0442\u0438 \u043E\u0431\u0440\u0430\u043B\u0430
        \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043D\u0430\u0432\u2019\u044F\u0437\u0443\u0432\u0430\u0442\u0438
        \u043A\u043E\u043C\u0443\u0441\u044C \u0441\u0432\u043E\u0457 \u043F\u0440\u0430\u0432\u0438\u043B\u0430
        \u0441\u0438\u043B\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_72_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u0447\u0430\u2026 \u042F \u0437\u0430\u0439\u043C\u0430\u044E\u0441\u044F
        \u0442\u0438\u043C \u0441\u0430\u043C\u0438\u043C. \u0421\u0445\u043E\u0436\u0435,
        \u0440\u0430\u043D\u043E \u0447\u0438 \u043F\u0456\u0437\u043D\u043E \u0436\u0438\u0442\u0442\u044F
        \u0437\u043C\u0443\u0448\u0443\u0454 \u0432\u0438\u0431\u0438\u0432\u0430\u0442\u0438
        \u043A\u0443\u043B\u0430\u043A\u0430\u043C\u0438 \u043F\u0440\u0430\u0432\u0434\u0443
        \u0437 \u0456\u043D\u0448\u0438\u0445 \u043B\u044E\u0434\u0435\u0439. \u042F\u043A\u0449\u043E
        \u043D\u0435 \u0445\u043E\u0447\u0435\u0448 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438,
        \u044F\u043A \u041A\u043E\u0440\u043D\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_3_72_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0433\u043B\u044F\u0434 \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0432\u0442\u0443\u043F\u0438\u0432\u0441\u044F \u0432 \u043E\u0434\u043D\u0443
        \u0442\u043E\u0447\u043A\u0443 \u0439 \u043D\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0441\u0435\u043A\u0443\u043D\u0434 \u0447\u043E\u043B\u043E\u0432\u0456\u043A
        \u043D\u0456\u0431\u0438 \u0437\u0430\u0432\u043C\u0435\u0440. \u0421\u0445\u043E\u0436\u0435,
        \u0432\u0456\u043D \u0437\u0430\u0434\u0443\u043C\u0430\u0432\u0441\u044F
        \u043F\u0440\u043E \u0449\u043E\u0441\u044C \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0435.
        \u0422\u0430 \u0446\u0435 \u0434\u0430\u043B\u043E \u043C\u0435\u043D\u0456
        \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043A\u0440\u0430\u0449\u0435
        \u043E\u0446\u0456\u043D\u0438\u0442\u0438 \u0441\u0432\u043E\u0454 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0449\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_72_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0434\u0443\u0436\u0435
        \u0442\u0456\u0441\u043D\u043E \u043F\u0440\u0438\u0432\u2019\u044F\u0437\u0430\u0432
        \u043C\u043E\u0457 \u0440\u0443\u043A\u0438 \u0434\u043E \u0441\u0442\u0456\u043B\u044C\u0446\u044F.
        \u0421\u043A\u043E\u0440\u043E \u044F \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u043B\u0430
        \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u0438 \u0457\u0445 \u0432\u0456\u0434\u0443\u0447\u0443\u0432\u0430\u0442\u0438
        \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0448\u043A\u043E\u0434\u0443
        \u043F\u043E\u0442\u043E\u043A\u0443 \u043A\u0440\u043E\u0432\u0456. \u0422\u0430
        \u0432\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438 \u0446\u0435 \u0431\u0443\u043B\u0430
        \u0433\u0440\u0443\u0431\u0430 \u0440\u043E\u0431\u043E\u0442\u0430, \u0430\u043C\u0430\u0442\u043E\u0440\u0441\u044C\u043A\u0430.
        \u0410 \u0437 \u0442\u0430\u043A\u043E\u0433\u043E \u043C\u0435\u043D\u0435
        \u0432\u0447\u0438\u043B\u0438 \u0432\u0438\u043F\u043B\u0443\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u043D\u043D\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_72_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u043A\u0438 \u0431\u0435\u0432\u0437\u0435\u043D\u044C
        \u043D\u0435 \u0440\u0435\u0430\u0433\u0443\u0432\u0430\u0432 \u0442\u0430
        \u043D\u0435 \u0434\u0438\u0432\u0438\u0432\u0441\u044F \u043D\u0430 \u043C\u0435\u043D\u0435,
        \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0443\u0442\u0438\u0442\u0438
        \u043E\u0434\u043D\u0443 \u0440\u0443\u043A\u0443, \u0449\u043E\u0431 \u0432\u0438\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438
        \u0457\u0457 \u0437 \u043F\u043E\u043B\u043E\u043D\u0443. \u0426\u0435 \u043C\u0435\u043D\u0456
        \u043C\u0430\u0439\u0436\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_72_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043F\u043E\u0433\u043B\u044F\u0434 \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0437\u043D\u043E\u0432\u0443 \u0432\u0442\u0443\u043F\u0438\u0432\u0441\u044F
        \u0432 \u043C\u0435\u043D\u0435. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0439 \u043D\u0430\u0434\u0430\u043B\u0456 \u0432\u0456\u0434\u0432\u0435\u0440\u0442\u0430\u0442\u0438
        \u0439\u043E\u0433\u043E \u0443\u0432\u0430\u0433\u0443 \u0440\u043E\u0437\u043C\u043E\u0432\u0430\u043C\u0438,
        \u0449\u043E\u0431 \u0432\u0438\u0433\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0456
        \u0442\u0440\u043E\u0445\u0438 \u0447\u0430\u0441\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_73_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0456 \u0431\u0443\u0434\u0435\u0448 \u0434\u0430\u043B\u0456
        \u0432\u0434\u0430\u0432\u0430\u0442\u0438 \u0456\u0437 \u0441\u0435\u0431\u0435
        \u043D\u0456\u043C\u0443? \u0429\u043E \u0436, \u0442\u0432\u043E\u0454 \u043F\u0440\u0430\u0432\u043E.
        \u0422\u0430 \u043D\u0435 \u0434\u0443\u043C\u0430\u0439, \u0449\u043E \u0432\u0456\u0434
        \u0446\u044C\u043E\u0433\u043E \u044F \u0441\u0442\u0430\u043D\u0443 \u0441\u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438
        \u0442\u0435\u0431\u0435 \u044F\u043A\u043E\u0441\u044C \u043A\u0440\u0430\u0449\u0435,
        \u0431\u043E\u044F\u0433\u0443\u0437\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_73_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u0440\u0442\u2026 \u042F \u0441\u0438\u043B\u044C\u043D\u043E
        \u0440\u0438\u0437\u0438\u043A\u0443\u044E, \u0449\u043E \u0446\u044F \u043D\u0456\u0447
        \u0441\u0442\u0430\u043D\u0435 \u0434\u043B\u044F \u043C\u0435\u043D\u0435
        \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u044E. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u0442\u0438
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0440\u043E\u0437\u043C\u043E\u0432\u0430\u043C\u0438,
        \u0449\u043E\u0431 \u0432\u0438\u0433\u0440\u0430\u0442\u0438 \u0441\u043E\u0431\u0456
        \u0442\u0440\u043E\u0445\u0438 \u0447\u0430\u0441\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_74_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0441\u0432\u043E\u0457\u0445 \u0441\u043B\u0456\u0432
        \u044F \u0432\u0456\u0434\u0447\u0443\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0438\u0439
        \u043B\u044F\u043F\u0430\u0441 \u043F\u043E \u043E\u0431\u043B\u0438\u0447\u0447\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_74_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0433-\u0445-\u0445!.."
    - Language: 1
      Text: 
  - Key: scene_3_74_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u0449\u043E\u043A\u043E\u044E \u0441\u0442\u0456\u043A\u0430\u043B\u0430
        \u0446\u0456\u0432\u043A\u0430 \u043A\u0440\u043E\u0432\u0456. \u0421\u0438\u043D\u0435\u0446\u044C
        \u043F\u0456\u0441\u043B\u044F \u0442\u0430\u043A\u043E\u0433\u043E \u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F
        \u043D\u0430\u0434\u043E\u0432\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_74_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435\u0439 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u0438\u0439
        \u043A\u043E\u0437\u0435\u043B \u0432\u0437\u0430\u0433\u0430\u043B\u0456
        \u0441\u0435\u0431\u0435 \u043D\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u0454!
        \u042F\u043A\u0449\u043E \u044F \u0431\u0443\u0434\u0443 \u0437\u0430\u043D\u0430\u0434\u0442\u043E
        \u0434\u0440\u0430\u0442\u0443\u0432\u0430\u0442\u0438 \u041E\u043B\u0435\u043A\u0441\u0456\u044F,
        \u0432\u0456\u043D \u043C\u043E\u0436\u0435 \u0432\u0431\u0438\u0442\u0438
        \u043C\u0435\u043D\u0435 \u043D\u0430\u0432\u0456\u0442\u044C \u0440\u0430\u043D\u0456\u0448\u0435,
        \u043D\u0456\u0436 \u0441\u0430\u043C \u0446\u044C\u043E\u0433\u043E \u0437\u0430\u0445\u043E\u0447\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_75_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0438\u0432\u0438\u0441\u044F, \u0430 \u0446\u0435 \u043C\u0435\u043D\u0456
        \u043F\u043E\u043F\u0430\u043B\u043E\u0441\u044F \u0432 \u043A\u0438\u0448\u0435\u043D\u0456
        \u0442\u0432\u043E\u0433\u043E \u0436\u0430\u043A\u0435\u0442\u0430, \u043A\u043E\u043B\u0438
        \u044F \xAB\u043A\u043E\u043D\u0444\u0456\u0441\u043A\u0443\u0432\u0430\u0432\xBB
        \u0434\u0435\u044F\u043A\u0456 \u0440\u0435\u0447\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_75_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u043A\u0440\u0443\u0442\u0438\u0432
        \u0443 \u0440\u0443\u043A\u0430\u0445 \u043E\u0431\u0440\u0443\u0447\u043A\u0443.
        \u041C\u043E\u044E \u043E\u0431\u0440\u0443\u0447\u043A\u0443. \u041D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0437\u043D\u0430\u044E, \u0447\u043E\u043C\u0443 \u0432 \u0442\u0456
        \u0447\u0430\u0441\u0438 \u044F \u0432\u0441\u0435 \u0449\u0435 \u0442\u044F\u0433\u0430\u043B\u0430
        \u0457\u0457 \u0443\u0441\u044E\u0434\u0438 \u0437\u0430 \u0441\u043E\u0431\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_75_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0438\u0432\u043D\u043E \u0431\u0430\u0447\u0438\u0442\u0438
        \u0442\u0430\u043A\u0443 \u0441\u0435\u043D\u0442\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
        \u0443 \u0432\u0431\u0438\u0432\u0446\u0456. \u0423 \u0434\u043E\u0441\u044C\u0454
        \u0439\u0434\u0435\u0442\u044C\u0441\u044F, \u0449\u043E \u0442\u0438 \u0434\u0430\u0432\u043D\u043E
        \u0432\u0436\u0435 \u0440\u043E\u0437\u043B\u0443\u0447\u0435\u043D\u0430
        \u0456\u0437 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u043E\u043C, \u0442\u043E
        \u0447\u043E\u0433\u043E \u0436 \u043D\u0456\u044F\u043A \u043D\u0435 \u043F\u043E\u0437\u0431\u0430\u0432\u0438\u0448\u0441\u044F
        \u043F\u0430\u043C\u2019\u044F\u0442\u0456 \u043F\u0440\u043E \u043D\u044C\u043E\u0433\u043E?"
    - Language: 1
      Text: 
  - Key: scene_3_75_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0456\u043A\u0430\u0432\u043E, \u0446\u0435 \u0432\u0456\u043D
        \u0442\u0435\u0431\u0435 \u043A\u0438\u043D\u0443\u0432, \u0430\u0431\u043E
        \u0436 \u0442\u0438 \u043F\u0435\u0440\u0448\u0430 \u043D\u0430\u043F\u043B\u044E\u0432\u0430\u043B\u0430
        \u043D\u0430 \u0432\u0435\u0441\u0456\u043B\u044C\u043D\u0456 \u043E\u0431\u0456\u0442\u043D\u0438\u0446\u0456?"
    - Language: 1
      Text: 
  - Key: scene_3_75_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0456\u0439 \u0447\u043E\u043B\u043E\u0432\u0456\u043A \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F
        \u043F\u043E\u043A\u0438\u0434\u044C\u043A\u043E\u043C. \u042F\u043A \u0456
        \u0432\u0441\u0456 \u0456\u043D\u0448\u0456 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0438,
        \u044F\u043A\u0438\u0445 \u044F \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430
        \u0432 \u0436\u0438\u0442\u0442\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_75_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430 \u0434\u0438\u0442\u0438\u043D\u0443.
        \u0426\u0435 \u0441\u0442\u0430\u043B\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C
        \u043D\u0430\u0434\u043B\u043E\u043C\u0443 \u0432 \u043D\u0430\u0448\u0438\u0445
        \u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_75_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043A\u043E\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_76_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0456\u043D\u0447\u0435\u043D\u0430 \u043A\u0443\u0440\u0432\u0430!
        \u041C\u043E\u0436\u0435, \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u0442\u0438
        \u0456 \u0432\u0431\u0438\u043B\u0430 \u041A\u043E\u0440\u043D\u0456\u044F,
        \u0442\u0430\u043A? \u041F\u0440\u043E\u0441\u0442\u043E \u0442\u043E\u043C\u0443,
        \u0449\u043E \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0448 \u043B\u044E\u0434\u0435\u0439,
        \u0431\u0435\u0437 \u0436\u043E\u0434\u043D\u043E\u0457 \u0432\u0430\u0433\u043E\u043C\u043E\u0457
        \u043F\u0440\u0438\u0447\u0438\u043D\u0438!"
    - Language: 1
      Text: 
  - Key: scene_3_76_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u043B\u0435\u0434\u044C \u0441\u0442\u0440\u0438\u043C\u0430\u0432\u0441\u044F
        \u0432\u0456\u0434 \u0443\u0434\u0430\u0440\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_76_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u0447\u043E\u043B\u043E\u0432\u0456\u043A
        \u043F\u0456\u0448\u043E\u0432 \u0432\u0456\u0434 \u0442\u0435\u0431\u0435
        \u043D\u0435 \u0434\u0430\u0440\u043C\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_76_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u043E\u0434\u0456 \u0442\u0430\u043A\u0456 \u043A\u043E\u043C\u0435\u043D\u0442\u0430\u0440\u0456
        \u0437\u0430\u0432\u0434\u0430\u0432\u0430\u043B\u0438 \u0448\u043A\u043E\u0434\u0438
        \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435 \u0437\u0430 \u0444\u0456\u0437\u0438\u0447\u043D\u0438\u0439
        \u0431\u0456\u043B\u044C\u2026 \u0422\u0430 \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u0448\u0432\u0438\u0434\u043A\u043E \u0432\u0438\u043A\u0438\u043D\u0443\u0442\u0438
        \u0446\u0435 \u0437 \u0433\u043E\u043B\u043E\u0432\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_76_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0442\u0440\u043E\u0445\u0438 \u043F\u043E\u0441\u043B\u0430\u0431\u0438\u0442\u0438
        \u0445\u0432\u0430\u0442\u043A\u0443 \u043C\u043E\u0442\u0443\u0437\u043E\u043A,
        \u044F\u043A\u0438\u043C\u0438 \u044F \u0431\u0443\u043B\u0430 \u043F\u0440\u0438\u0432\u2019\u044F\u0437\u0430\u043D\u0430
        \u0434\u043E \u0441\u0442\u0456\u043B\u044C\u0446\u044F. \u0406 \u0446\u0435
        \u0454\u0434\u0438\u043D\u0435, \u0449\u043E \u0437\u0430\u0440\u0430\u0437
        \u043C\u0430\u043B\u043E \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_77_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u2026 \u041F\u0440\u043E \u0446\u0435 \u0432 \u0434\u043E\u0441\u044C\u0454
        \u043D\u0435 \u043F\u0438\u0441\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_77_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u044F\u043A\u0438\u0439\u0441\u044C \u0447\u0430\u0441
        \u0443 \u043F\u0456\u0434\u0432\u0430\u043B\u0456 \u043F\u043E\u0432\u0438\u0441\u043B\u043E
        \u043C\u043E\u0432\u0447\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_77_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0448\u043A\u043E\u0434\u0430, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E.
        \u041F\u0440\u0430\u0432\u0434\u0430. \u0412\u0438\u0431\u0430\u0447, \u0449\u043E
        \u0437\u0430\u0447\u0435\u043F\u0438\u0432 \u0446\u044E \u0442\u0435\u043C\u0443.
        \u0422\u0430\u043A\u0430 \u043F\u043E\u0434\u0456\u044F \u0432 \u0436\u0438\u0442\u0442\u0456
        \u043C\u043E\u0436\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u0437\u043C\u0456\u043D\u0438\u0442\u0438
        \u043B\u044E\u0434\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_77_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0414\u0430 \u0442\u0438 \u0449\u043E!\xBB \u2014 \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0430
        \u044F."
    - Language: 1
      Text: 
  - Key: scene_3_77_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0446\u0435 \u043D\u0435 \u0437\u0432\u0456\u043B\u044C\u043D\u044F\u0454
        \u0442\u0435\u0431\u0435 \u0432\u0456\u0434 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456.
        \u0422\u0438 \u043C\u043E\u0433\u043B\u0430 \u043C\u0430\u0442\u0438 \u0441\u0432\u044F\u0442\u0443
        \u0434\u0438\u0442\u0438\u043D\u0443, \u0430\u043B\u0435 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E
        \u043C\u0443\u0441\u0438\u0448 \u043D\u0435\u0441\u0442\u0438 \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u043D\u044F
        \u0437\u0430 \u0442\u0456 \u0433\u0440\u0456\u0445\u0438, \u044F\u043A\u0456
        \u0447\u0438\u043D\u0438\u0448."
    - Language: 1
      Text: 
  - Key: scene_3_78_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0432\u0447\u0438\u0448? \u0425\u0435\u0445, \u0442\u0430\u043A
        \u0456 \u0437\u043D\u0430\u0432. \u0417\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u0442\u0438\u0441\u044F
        \u0437\u0456 \u0441\u0432\u043E\u0457\u043C \u043C\u0438\u043D\u0443\u043B\u0438\u043C
        \u0437\u0430\u0432\u0436\u0434\u0438 \u0441\u0442\u0440\u0430\u0448\u043D\u043E.
        \u041F\u0456\u0434\u0436\u0438\u043C\u0430\u0439 \u0445\u0432\u043E\u0441\u0442\u0430
        \u0439 \u0434\u0430\u043B\u0456, \u0446\u0435 \u0434\u0443\u0436\u0435 \u0443
        \u0442\u0432\u043E\u0454\u043C\u0443 \u0434\u0443\u0441\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_78_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u0442\u0438 \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0440\u043E\u0437\u043C\u043E\u0432\u043E\u044E, \u0449\u043E\u0431 \u0432\u0438\u0433\u0440\u0430\u0442\u0438
        \u0441\u043E\u0431\u0456 \u0442\u0440\u043E\u0445\u0438 \u0447\u0430\u0441\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_84_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0443\u0442 \u0454 \u0456 \u043F\u0440\u043E \u0442\u0432\u043E\u0454
        \u0434\u0438\u0442\u0438\u043D\u0441\u0442\u0432\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_84_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0420\u043E\u0441\u043B\u0430 \u0431\u0435\u0437 \u0431\u0430\u0442\u044C\u043A\u0430.
        \u0412\u0438\u0445\u043E\u0432\u0443\u0432\u0430\u043B\u0430\u0441\u044C
        \u043C\u0430\u0442\u0456\u0440\u2019\u044E-\u043E\u0434\u0438\u043D\u0430\u0447\u043A\u043E\u044E.
        \u0420\u0456\u0434 \u0437\u0430\u043D\u044F\u0442\u044C \u043C\u0430\u0442\u0435\u0440\u0456:
        \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0439\u043D\u0430 \u0441\u043F\u043E\u0440\u0442\u0441\u043C\u0435\u043D\u043A\u0430\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_84_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0446\u0435 \u043E\u0442 \u0456 \u0432\u0441\u0435. \u0412\u0440\u0430\u0445\u043E\u0432\u0443\u044E\u0447\u0438
        \u0431\u0440\u0430\u043A \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0445
        \u0456\u043D\u0448\u0438\u0445 \u0437\u0430\u0441\u043B\u0443\u0433, \u0442\u0432\u043E\u044F
        \u043C\u0430\u0442\u0438 \u043D\u0435 \u0434\u043E\u0441\u044F\u0433\u043B\u0430
        \u0437\u043D\u0430\u0447\u043D\u0438\u0445 \u0432\u0435\u0440\u0448\u0438\u043D
        \u043D\u0430 \u0441\u043F\u043E\u0440\u0442\u0438\u0432\u043D\u0456\u0439
        \u043D\u0438\u0432\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_84_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u0435, \u043F\u043E\u0434\u0456\u043B\u0438\u0448\u0441\u044F
        \u0441\u043F\u043E\u0433\u0430\u0434\u0430\u043C\u0438, \u0447\u0438\u043C
        \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E \u0432\u043E\u043D\u0430
        \u0437\u0430\u0439\u043C\u0430\u043B\u0430\u0441\u044F? \u0426\u0456\u043A\u0430\u0432\u043E,
        \u044F\u043A\u0435 \u0432\u0438\u0445\u043E\u0432\u0430\u043D\u043D\u044F
        \u043C\u0430\u0442\u0438 \u043C\u043E\u0433\u043B\u0430 \u0442\u043E\u0431\u0456
        \u0437\u0430\u043A\u043B\u0430\u0441\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_84_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0430\u043C\u0430 \u0431\u0443\u043B\u0430 \u0431\u043E\u043A\u0441\u0435\u0440\u043A\u043E\u044E.
        \u041F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456, \u0442\u0430\u043A\u043E\u044E,
        \u0449\u043E \u043B\u0435\u0433\u043A\u043E \u043D\u0430\u0434\u0440\u0430\u043B\u0430
        \u0431 \u0442\u043E\u0431\u0456 \u0434\u0443\u043F\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_84_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u043E\u043D\u0430 \u0437\u0430\u0439\u043C\u0430\u043B\u0430\u0441\u044F
        \u0431\u043E\u043A\u0441\u043E\u043C. \u0406 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u043D\u0430\u0432\u0447\u0438\u0442\u0438 \u043C\u0435\u043D\u0435 \u043D\u0435
        \u0432\u043F\u0430\u0434\u0430\u0442\u0438 \u0432 \u0437\u043D\u0435\u0432\u0456\u0440\u0443
        \u0432 \u043B\u044E\u0434\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_84_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043A\u043E\u043C\u0435\u043D\u0442\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E \u043A\u0440\u0435\u043C\u0435\u0437\u043D\u043E\u043C\u0443
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u043E\u0432\u0456 \u0431\u0443\u043B\u043E
        \u0434\u043E\u0431\u0440\u0435 \u0432\u0438\u0434\u043D\u043E, \u0449\u043E
        \u0432\u0456\u043D \u0441\u0443\u043C\u043D\u0456\u0432\u0430\u0454\u0442\u044C\u0441\u044F.
        \u0421\u0445\u043E\u0436\u0435, \u043C\u043E\u0457\u043C \u0441\u043B\u043E\u0432\u0430\u043C
        \u0443\u0441\u0435 \u0436 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043D\u0430\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u0438
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u043D\u0430 \u0434\u0443\u043C\u043A\u0443
        \u043F\u0440\u043E \u0440\u043E\u0437\u0431\u0456\u0436\u043D\u043E\u0441\u0442\u0456
        \u0432 \u0439\u043E\u0433\u043E \u0432\u0435\u0440\u0441\u0456\u0457 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430.
        \u0426\u0435 \u0431\u0443\u043B\u043E \u043C\u043E\u0457\u043C \u0448\u0430\u043D\u0441\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u044E, \u0440\u043E\u0437\u0432\u2019\u044F\u0436\u0438
        \u043C\u0435\u043D\u0435. \u0422\u0438 \u0436 \u0431\u0430\u0447\u0438\u0448,
        \u044F \u043D\u0435 \u043F\u0440\u0438\u0447\u0435\u0442\u043D\u0430 \u0434\u043E
        \u0442\u043E\u0433\u043E, \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F
        \u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C, \u044F \u0442\u0435\u0436
        \u043F\u0440\u0430\u0433\u043D\u0443 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u0456.
        \u0420\u0430\u0437\u043E\u043C \u043C\u0438 \u0443 \u0432\u0441\u044C\u043E\u043C\u0443
        \u0440\u043E\u0437\u0431\u0435\u0440\u0435\u043C\u043E\u0441\u044F. \u041E\u0431\u0456\u0446\u044F\u044E
        \u0442\u043E\u0431\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0437\u0432\u043E\u043B\u0456\u043A\u0430\u0432. \u0412\u0440\u0435\u0448\u0442\u0456
        \u0432\u0456\u043D \u0442\u044F\u0436\u043A\u043E \u0437\u0456\u0442\u0445\u043D\u0443\u0432,
        \u043F\u0456\u0434\u0456\u0439\u0448\u043E\u0432 \u0431\u043B\u0438\u0436\u0447\u0435
        \u0439 \u043F\u043E\u0447\u0430\u0432 \u0440\u043E\u0437\u043C\u043E\u0442\u0443\u0432\u0430\u0442\u0438
        \u043C\u043E\u0442\u0443\u0437\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u0442\u0438 \u043D\u0435 \u0441\u0445\u043E\u0436\u0430
        \u043D\u0430 \u0432\u0431\u0438\u0432\u0446\u044E. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u044F \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0442\u0440\u043E\u0445\u0438
        \u043F\u043E\u0433\u0430\u0440\u044F\u0447\u043A\u0443\u0432\u0430\u0432,
        \u043A\u043E\u043B\u0438 \u043F\u043E\u0431\u0430\u0447\u0438\u0432, \u044F\u043A
        \u0442\u0438 \u043D\u0438\u0448\u043F\u043E\u0440\u0438\u0448 \u0442\u0443\u0442
        \u0443 \u043D\u043E\u0447\u0456. \u0410\u043B\u0435 \u0449\u043E\u0431\u0438
        \u0431\u0435\u0437 \u0432\u0438\u043A\u0440\u0443\u0442\u0430\u0441\u0456\u0432.
        \u042F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0442\u0438
        \u0441\u0442\u0440\u0438\u043C\u0430\u0454\u0448 \u0441\u0432\u043E\u0454
        \u0441\u043B\u043E\u0432\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u0456\u043B\u044C\u043D\u0438\u0432\u0448\u0438 \u043C\u0435\u043D\u0435,
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0432\u0456\u0434\u0456\u0439\u0448\u043E\u0432,
        \u0449\u043E\u0431 \u0441\u0445\u043E\u0432\u0430\u0442\u0438 \u043C\u043E\u0442\u0443\u0437\u043A\u0438.
        \u042F \u0440\u043E\u0437\u0442\u0435\u0440\u043B\u0430 \u043A\u0438\u0441\u0442\u0456
        \u0440\u0443\u043A, \u044F\u043A\u0456 \u0441\u0438\u043B\u044C\u043D\u043E
        \u0437\u0430\u0442\u0435\u043A\u043B\u0438 \u0432\u0456\u0434 \u0437\u0432\u2019\u044F\u0437\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0442\u0456\u043B\u044C\u043A\u0438 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0432\u0456\u0434\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F, \u044F
        \u0441\u0445\u043E\u043F\u0438\u043B\u0430 \u0441\u0442\u0456\u043B\u0435\u0446\u044C,
        \u043F\u0456\u0434\u043D\u044F\u043B\u0430 \u0439\u043E\u0433\u043E \u0432\u0438\u0441\u043E\u043A\u043E
        \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u044E \u0456 \u0449\u043E\u0441\u0438\u043B\u0438
        \u0432\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430. \u0425\u043B\u0438\u043F\u043A\u0438\u0439
        \u0434\u0435\u0440\u0435\u0432\u2019\u044F\u043D\u0438\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
        \u0440\u043E\u0437\u043B\u0435\u0442\u0456\u0432\u0441\u044F \u043D\u0430
        \u0442\u0440\u0456\u0441\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0440\u0443\u0437\u044C\u043A\u0435 \u0442\u0456\u043B\u043E
        \u0433\u0443\u0447\u043D\u043E \u0441\u0442\u0443\u043A\u043D\u0443\u043B\u043E\u0441\u044F
        \u043E\u0431 \u043F\u0456\u0434\u043B\u043E\u0433\u0443. \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0431\u0443\u0432 \u0431\u0435\u0437 \u0442\u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0431\u0456\u0446\u044F\u043D\u043A\u0438-\u0446\u044F\u0446\u044F\u043D\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_85_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0430\u0442\u0447-\u0440\u0435\u0432\u0430\u043D\u0448 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E. "
    - Language: 1
      Text: 
  - Key: scene_3_86_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u044F \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u043A\u0440\u0430\u0449\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
        \u0449\u043E \u0442\u0438 \u0437\u0430 \u043B\u044E\u0434\u0438\u043D\u0430.
        \u0417\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438 \u0442\u0435\u0431\u0435
        \u0437\u2019\u0457\u0434\u0430\u0454 \u0441\u0442\u0440\u0430\u0445. \u0422\u043E\u0431\u0456
        \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0449\u043E \u0436\u0438\u0442\u0442\u044F
        \u0432\u0456\u0434\u0432\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044F
        \u0432\u0456\u0434 \u0442\u0435\u0431\u0435 \u043D\u0430 \u0432\u0441\u0456\u0445
        \u0444\u0440\u043E\u043D\u0442\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0454, \u0449\u043E \u0432 \u0442\u0435\u0431\u0435
        \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F, \u0446\u0435
        \u043A\u0440\u0430\u043F\u043B\u044F \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u0443
        \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u043E\u0457,
        \u0456 \u0442\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
        \u0439\u043E\u0433\u043E, \u0449\u043E\u0431 \u0445\u043E\u0447 \u0443 \u0447\u043E\u043C\u0443\u0441\u044C
        \u0441\u0430\u043C\u043E\u0441\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438\u0441\u044C.
        \u0414\u043E\u0441\u0438\u0442\u044C \u0442\u0456\u043A\u0430\u0442\u0438
        \u0432\u0456\u0434 \u0441\u0430\u043C\u043E\u0457 \u0441\u0435\u0431\u0435.
        \u0412\u0438\u0437\u043D\u0430\u0439 \u043F\u0440\u0430\u0432\u0434\u0443
        \u0442\u0430 \u0441\u0432\u043E\u044E \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u0432 \u0443\u0431\u0438\u0432\u0441\u0442\u0432\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u044F \u0442\u043E\u0431\u0456 \u0432 \u0446\u044C\u043E\u043C\u0443
        \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443. \u041F\u0435\u0440\u0435\u0439\u0434\u0435\u043C\u043E
        \u0434\u043E \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0432\u0438\u0440\u043E\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E
        \u043D\u0430\u0431\u043B\u0438\u0437\u0438\u0432\u0441\u044F \u0434\u043E
        \u043C\u0435\u043D\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_86_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u043C\u0430\u0454\u0448 \u0440\u0430\u0446\u0456\u044E.
        \u042F \u0436\u0430\u043B\u044E\u0433\u0456\u0434\u043D\u0430 \u043B\u044E\u0434\u0438\u043D\u0430,
        \u0437\u0430 \u0434\u0443\u0448\u0435\u044E \u0432 \u043C\u0435\u043D\u0435
        \u0442\u0430\u043A\u043E\u0436 \u0431\u0430\u0433\u0430\u0442\u043E \u0433\u0440\u0456\u0445\u0456\u0432.
        \u041F\u0440\u043E\u0442\u0435 \u0432 \u043C\u0435\u043D\u0435, \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456,
        \u0449\u0435 \u043B\u0438\u0448\u0430\u043B\u043E\u0441\u044F \u0446\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430 \u0447\u0430\u0441 \u0442\u0435\u0440\u0435\u0432\u0435\u043D\u044C\u043E\u043A
        \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438
        \u0432\u0456\u0434 \u043C\u043E\u0442\u0443\u0437\u043E\u043A \u043E\u0431\u0438\u0434\u0432\u0456
        \u0440\u0443\u043A\u0438. \u041F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0456
        \u0442\u0440\u0435\u043D\u0456\u043D\u0433\u0438 \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
        \u0434\u0430\u0440\u043C\u0430!"
    - Language: 1
      Text: 
  - Key: scene_3_86_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430
        \u0446\u0435\u0439 \u0448\u0430\u043D\u0441, \u0449\u043E\u0431 \u0441\u0445\u043E\u043F\u0438\u0442\u0438
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0437\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u043E\u0431\u043E\u043C\u0430 \u0440\u0443\u043A\u0430\u043C\u0438, \u0434\u043E\u043A\u0438
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A \u043D\u0456\u0447\u043E\u0433\u043E
        \u043D\u0435 \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u0432, \u0442\u0430
        \u0440\u0456\u0437\u043A\u043E \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u0442\u0438
        \u043D\u0430 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043E\u043B\u043E\u0432\u0430 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430
        \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u043B\u0430\u0441\u044F
        \u0437 \u043C\u043E\u0457\u043C \u043A\u043E\u043B\u0456\u043D\u043E\u043C.
        \u0411\u0443\u043B\u043E \u043F\u0440\u0438\u0454\u043C\u043D\u043E \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0442\u0438,
        \u044F\u043A \u0432\u043E\u043D\u043E \u0432\u043F\u0438\u0432\u0430\u0454\u0442\u044C\u0441\u044F
        \u0432 \u0439\u043E\u0433\u043E \u0437\u043B\u0456\u0441\u043D\u0443 \u043F\u0438\u043A\u0443
        \u0442\u0430 \u0447\u0443\u0442\u0438 \u0445\u0440\u0443\u0441\u043A\u0456\u0442
        \u043D\u043E\u0441\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0410-\u0430-\u0430-\u0433-\u0445!.."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0456 \u0437\u043B\u0430\u043C\u0430\u043D\u043E\u0433\u043E
        \u043D\u043E\u0441\u0430 \u0445\u043B\u044C\u043E\u0441\u043D\u0443\u043B\u0430
        \u043A\u0440\u043E\u0432. \u0414\u0435\u0437\u043E\u0440\u0456\u0454\u043D\u0442\u043E\u0432\u0430\u043D\u0438\u0439
        \u0432\u0456\u0434 \u0431\u043E\u043B\u044E, \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0437\u0430\u0445\u0438\u0442\u0430\u0432\u0441\u044F. \u0426\u0435 \u0434\u0430\u043B\u043E
        \u043C\u0435\u043D\u0456 \u0434\u0435\u044F\u043A\u0438\u0439 \u0447\u0430\u0441,
        \u0449\u043E\u0431 \u043A\u0438\u043D\u0443\u0442\u0438\u0441\u044F \u0442\u0430
        \u0432\u0441\u0442\u0438\u0433\u043D\u0443\u0442\u0438 \u0441\u0445\u043E\u043F\u0438\u0442\u0438
        \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434 \u0437\u0456 \u0441\u0442\u043E\u043B\u0443.
        \u0422\u0435\u043F\u0435\u0440 \u044F \u0431\u0443\u043B\u0430 \u043E\u0437\u0431\u0440\u043E\u0454\u043D\u0430
        \u0442\u0430 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_86_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0444\u0430\u043D\u0430\u0442\u0438\u0447\u043D\u0438\u0439
        \u0431\u043E\u0432\u0434\u0443\u0440 \u0443\u0436\u0435 \u0442\u0430\u043A\u043E\u0436
        \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0432 \u0434\u043E \u0442\u044F\u043C\u0438.
        \u042F \u043C\u0430\u043B\u0430 \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u0430\u0432\u0434\u0430\u0442\u0438
        \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u0443\u0434\u0430\u0440
        \u043F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0432\u0456\u043D \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
        \u043E\u043A\u043B\u0438\u0433\u0430\u0454. \u0426\u0435 \u0431\u0443\u0432\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_86_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0423\u0434\u0430\u0440 \u0443 \u043F\u0435\u0447\u0456\u043D\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_86_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0443\u043F\u043B\u0435\u043A\u0441."
    - Language: 1
      Text: 
  - Key: scene_3_86_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438\u0433\u0440 \u043F\u0456\u0434\u043A\u0440\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
        \u0434\u0440\u0430\u043A\u043E\u043D \u0445\u043E\u0432\u0430\u0454\u0442\u044C\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_87_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u044F \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u043A\u0440\u0430\u0449\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
        \u0449\u043E \u0442\u0438 \u0437\u0430 \u043B\u044E\u0434\u0438\u043D\u0430.
        \u0417\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438 \u0442\u0435\u0431\u0435
        \u0437\u2019\u0457\u0434\u0430\u0454 \u0441\u0442\u0440\u0430\u0445. \u0422\u043E\u0431\u0456
        \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0449\u043E \u0436\u0438\u0442\u0442\u044F
        \u0432\u0456\u0434\u0432\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044F
        \u0432\u0456\u0434 \u0442\u0435\u0431\u0435 \u043D\u0430 \u0432\u0441\u0456\u0445
        \u0444\u0440\u043E\u043D\u0442\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_87_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0454, \u0449\u043E \u0432 \u0442\u0435\u0431\u0435
        \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F, \u0446\u0435
        \u043A\u0440\u0430\u043F\u043B\u044F \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442\u0443
        \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u043E\u0457,
        \u0456 \u0442\u0438 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
        \u0457\u0457, \u0449\u043E\u0431 \u0445\u043E\u0447 \u0443 \u0447\u043E\u043C\u0443\u0441\u044C
        \u0441\u0430\u043C\u043E\u0441\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438\u0441\u044C.
        \u0414\u043E\u0441\u0438\u0442\u044C \u0442\u0456\u043A\u0430\u0442\u0438
        \u0432\u0456\u0434 \u0441\u0430\u043C\u043E\u0457 \u0441\u0435\u0431\u0435.
        \u0412\u0438\u0437\u043D\u0430\u0439 \u043F\u0440\u0430\u0432\u0434\u0443
        \u0442\u0430 \u0441\u0432\u043E\u044E \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u0432 \u0443\u0431\u0438\u0432\u0441\u0442\u0432\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_87_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u044F \u0442\u043E\u0431\u0456 \u0432 \u0446\u044C\u043E\u043C\u0443
        \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0443. \u041F\u0435\u0440\u0435\u0439\u0434\u0435\u043C\u043E
        \u0434\u043E \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F \u0432\u0438\u0440\u043E\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_87_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0441\u0442\u0438\u0433\u043B\u0430 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438
        \u043B\u0438\u0448\u0435 \u044F\u043A \u0434\u0435\u0431\u0435\u043B\u0438\u0439
        \u043A\u0443\u043B\u0430\u043A \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0437 \u043F\u043E\u0447\u0435\u0440\u0432\u043E\u043D\u0456\u043B\u0438\u043C\u0438 
        \u0432\u0456\u0434 \u0437\u043B\u043E\u0441\u0442\u0456 \u043A\u0456\u0441\u0442\u043E\u0447\u043A\u0430\u043C\u0438
        \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u0438\u0447\u043D\u043E \u043D\u0456\u0441\u0441\u044F
        \u043C\u0435\u043D\u0456 \u043F\u0440\u044F\u043C\u043E \u0432 \u043E\u0431\u043B\u0438\u0447\u0447\u044F.
        \u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u044E
        \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C \u043D\u0430\u0432\u0456\u043A\u0438
        \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u043B\u0430 \u043F\u0456\u0442\u044C\u043C\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_89_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435\u0439 \u043F\u0440\u0438\u0439\u043E\u043C \u044F \u043F\u0456\u0434\u0433\u043B\u0435\u0434\u0456\u043B\u0430,
        \u043A\u043E\u043B\u0438 \u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F
        \u043F\u043E \u0442\u0435\u043B\u0435\u0432\u0456\u0437\u043E\u0440\u0443
        \u0441\u0442\u0430\u0440\u0435\u043D\u044C\u043A\u0438\u0439 \u0445\u0456\u0440\u0442\u0443\u0430\u043D\u0441\u044C\u043A\u0438\u0439
        \u0444\u0456\u043B\u044C\u043C \u0456\u0437 \u043A\u0443\u043F\u043E\u044E
        \u0430\u043A\u0440\u043E\u0431\u0430\u0442\u0438\u0447\u043D\u0438\u0445
        \u0442\u0440\u044E\u043A\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_89_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0440\u043E\u0437\u0431\u0456\u0433\u043B\u0430\u0441\u044F,
        \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432 \u043F\u0456\u0434\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u043B\u0430,
        \u0432\u0456\u0434\u0448\u0442\u043E\u0432\u0445\u0443\u044E\u0447\u0438\u0441\u044C
        \u0432\u0456\u0434 \u043F\u0456\u0434\u043B\u043E\u0433\u0438, \u0456 \u0437\u0430\u043A\u0440\u0443\u0442\u0438\u043B\u0430\u0441\u044F
        \u0432 \u0440\u0443\u0441\u0456 \u0441\u0430\u043B\u044C\u0442\u043E, \u0432\u0438\u0442\u044F\u0433\u0430\u044E\u0447\u0438
        \u0432\u043F\u0435\u0440\u0435\u0434 \u043E\u0431\u0438\u0434\u0432\u0456
        \u043D\u043E\u0433\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_89_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u044F\u0436\u043A\u0438\u043C \u0434\u0440\u043E\u0431\u043E\u043C,
        \u043A\u043E\u0436\u043D\u0430 \u043D\u043E\u0433\u0430 \u043F\u043E \u0447\u0435\u0440\u0437\u0456
        \u0432\u043B\u0435\u0442\u0456\u043B\u0430 \u041E\u043B\u0435\u043A\u0441\u0456\u044E
        \u0432 \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044F. \u0423\u0434\u0430\u0440
        \u0431\u0443\u0432 \u0449\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0438\u0439
        \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0434\u043E\u0432\u0433\u0438\u043C
        \u043F\u0456\u0434\u0431\u043E\u0440\u0430\u043C (\u0442\u0430\u043A \u0456
        \u0437\u043D\u0430\u043B\u0430, \u0449\u043E \u0457\u0445 \u0431\u0443\u043B\u043E
        \u0432\u0430\u0440\u0442\u043E \u0432\u0437\u0443\u0442\u0438 \u043D\u0430
        \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0432 \u0441\u0435\u043B\u0456)."
    - Language: 1
      Text: 
  - Key: scene_3_89_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u043B\u0430\u0441\u044F,
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0443\u0436\u0435 \u043B\u0435\u0436\u0430\u0432
        \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0437\u0456 \u0431\u0435\u0437
        \u0442\u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_89_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0442\u043E \u043C\u0456\u0433 \u0437\u043D\u0430\u0442\u0438,
        \u0449\u043E \u0446\u0435\u0439 \u043F\u0440\u0438\u0439\u043E\u043C \u0432\u0438\u044F\u0432\u0438\u0442\u044C\u0441\u044F
        \u0442\u0430\u043A\u0438\u043C \u0435\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0438\u043C?"
    - Language: 1
      Text: 
  - Key: scene_3_90_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u0438\u0440\u043E\u043A\u043E\u044E \u0434\u0443\u0433\u043E\u044E
        \u044F \u0432\u0434\u0430\u0440\u0438\u043B\u0430 \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0432 \u0431\u0456\u043A. \u0427\u043E\u043B\u043E\u0432\u0456\u043A \u0437\u0434\u0440\u0438\u0433\u043D\u0443\u0432\u0441\u044F.
        \u042F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0442\u044F\u0433\u0430\u0442\u0438\u0441\u044F
        \u0456\u0437 \u0446\u0438\u043C \u0432\u0435\u043B\u0435\u0442\u043D\u0435\u043C
        \u0443 \u0441\u0438\u043B\u0456, \u0442\u043E\u043C\u0443 \u043C\u043E\u0457\u043C
        \u0454\u0434\u0438\u043D\u0438\u043C \u0448\u0430\u043D\u0441\u043E\u043C
        \u0431\u0443\u043B\u043E \u0447\u0456\u0442\u043A\u043E \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438
        \u043C\u0456\u0441\u0446\u044F \u0434\u043B\u044F \u0443\u0434\u0430\u0440\u0456\u0432
        \u2014 \u043D\u0430\u0439\u0432\u0440\u0430\u0437\u043B\u0438\u0432\u0456\u0448\u0456
        \u0442\u0430 \u043D\u0430\u0439\u0431\u043E\u043B\u044E\u0447\u0456\u0448\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0441\u0438\u043B\u043B\u044F \u2014 \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C.
        \u041D\u0430\u0441\u0438\u043B\u043B\u044F \u2014 \u0446\u0435 \u043F\u0438\u0442\u0430\u043D\u043D\u044F,
        \u0430 \u043C\u043E\u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
        \xAB\u0442\u0430\u043A\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0434\u0440\u0430\u0437\u0443 \u0436 \u0437\u043D\u043E\u0432\u0443
        \u0437\u0430\u0432\u0434\u0430\u043B\u0430 \u0443\u0434\u0430\u0440\u0443,
        \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043E\u0441\u043D\u043E\u0432\u043E\u044E
        \u0434\u043E\u043B\u043E\u043D\u0456 \u043F\u043E \u043D\u043E\u0441\u0443,
        \u0449\u043E \u043A\u0440\u043E\u0432\u043E\u0442\u043E\u0447\u0438\u0432
        \u0442\u0430 \u0431\u0443\u0432 \u0434\u043E\u0431\u0440\u044F\u0447\u0435
        \u043F\u043E\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u0438\u0439. \u0425\u0442\u043E\u0441\u044C
        \u043C\u0435\u043D\u0448\u0438\u0439 \u043C\u0430\u0432 \u0431\u0438 \u0432\u0436\u0435
        \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u0442\u0438.
        \u0422\u0430 \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0441\u0442\u043E\u044F\u0432.
        \u0425\u0430\u043E\u0442\u0438\u0447\u043D\u043E \u0432\u0456\u0434\u043C\u0430\u0445\u0443\u044E\u0447\u0438\u0441\u044C
        \u0440\u0443\u043A\u0430\u043C\u0438, \u0432\u0456\u043D \u0437\u0430\u0440\u0438\u0447\u0430\u0432
        \u0456 \u0441\u0443\u043D\u0443\u0432\u0441\u044F \u043D\u0430 \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0432\u0456\u0434\u0456\u0439\u0442\u0438, \u0445\u043E\u0447 \u044F\u043A\u043E\u0441\u044C
        \u0432\u0456\u0434\u0434\u0430\u043B\u0438\u0442\u0438\u0441\u044F \u0432\u0456\u0434
        \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u043E\u0433\u043E \u0432\u0435\u043B\u0435\u0442\u043D\u044F,
        \u043F\u0440\u043E\u0442\u0435 \u0432\u0456\u043D \u0431\u0443\u0432 \u043D\u0435\u043C\u043E\u0432
        \u043D\u043E\u0441\u043E\u0440\u0456\u0433, \u044F\u043A\u0438\u0439 \u0442\u0440\u043E\u0449\u0438\u0432
        \u0443\u0441\u0435 \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443 \u0448\u043B\u044F\u0445\u0443.
        \u0421\u043F\u0438\u043D\u043E\u044E \u044F \u0432\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044C
        \u0443 \u0442\u0432\u0435\u0440\u0434\u0443 \u0431\u0435\u0442\u043E\u043D\u043D\u0443
        \u0441\u0442\u0456\u043D\u0443 \u043F\u0456\u0434\u0432\u0430\u043B\u0443.
        \u0422\u0456\u043A\u0430\u0442\u0438 \u0432\u0436\u0435 \u0431\u0443\u043B\u043E
        \u043D\u0456\u043A\u0443\u0434\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u043C\u0435\u0442\u043D\u0443\u0432
        \u043E\u0431\u0438\u0434\u0432\u0456 \u0440\u0443\u043A\u0438 \u0432\u043F\u0435\u0440\u0435\u0434,
        \u0437\u0456\u043C\u043A\u043D\u0443\u0432 \u0457\u0445 \u043D\u0430 \u043C\u043E\u0457\u0439
        \u0448\u0438\u0457 \u0456 \u043F\u043E\u0447\u0430\u0432 \u0434\u0443\u0448\u0438\u0442\u0438.
        \u0411\u0456\u043B\u044C \u0431\u0443\u0432 \u043F\u0435\u043A\u0443\u0447\u0438\u0439,
        \u043F\u043E\u0432\u0456\u0442\u0440\u044F \u0432 \u043B\u0435\u0433\u0435\u043D\u044F\u0445
        \u0437\u0430\u043B\u0438\u0448\u0430\u043B\u043E\u0441\u044F \u0434\u0435\u0434\u0430\u043B\u0456
        \u043C\u0435\u043D\u0448\u0435. \u042F \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u043B\u0430
        \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438 \u044F\u043A \u041A\u043E\u0440\u043D\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0436\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
        \u043D\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u044E\u0447\u0438
        \u0441\u0435\u0431\u0435, \u044F \u043E\u0431\u043C\u0430\u0446\u0443\u0432\u0430\u043B\u0430
        \u043D\u0430\u0432\u043A\u043E\u043B\u0438\u0448\u043D\u0456\u0439 \u043F\u0440\u043E\u0441\u0442\u0456\u0440,
        \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C
        \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0445\u043E\u0447
        \u043D\u0430 \u044F\u043A\u0438\u0439\u0441\u044C \u0448\u0430\u043D\u0441
        \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0442\u043E\u0434\u0456 \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0430\u043B\u0430\u043D\u0438\u043B\u043E,
        \u0440\u0443\u043A\u043E\u044E \u044F \u0432\u0456\u0434\u0447\u0443\u043B\u0430
        \u0441\u043F\u0438\u043D\u043A\u0443 \u0441\u0442\u0456\u043B\u044C\u0446\u044F,
        \u0434\u043E \u044F\u043A\u043E\u0433\u043E \u0440\u0430\u043D\u0456\u0448\u0435
        \u0431\u0443\u043B\u0430 \u043F\u0440\u0438\u0432\u2019\u044F\u0437\u0430\u043D\u0430
        \u0456 \u044F\u043A\u0438\u0439 \u0443 \u043F\u0440\u043E\u0446\u0435\u0441\u0456
        \u0431\u0456\u0439\u043A\u0438 \u0432\u0456\u0434\u043B\u0435\u0442\u0456\u0432
        \u0434\u043E \u0441\u0442\u0456\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0445\u043E\u043F\u0438\u043B\u0430 \u0439\u043E\u0433\u043E,
        \u043F\u0456\u0434\u043D\u044F\u043B\u0430 \u0432\u0438\u0441\u043E\u043A\u043E
        \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u044E \u0456 \u0449\u043E\u0441\u0438\u043B\u0438
        \u0432\u043F\u0443\u0441\u0442\u0438\u043B\u0430 \u043D\u0430 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430.
        \u0425\u043B\u0438\u043F\u043A\u0438\u0439 \u0434\u0435\u0440\u0435\u0432\u2019\u044F\u043D\u0438\u0439
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0440\u043E\u0437\u043B\u0435\u0442\u0456\u0432\u0441\u044F
        \u043D\u0430 \u0442\u0440\u0456\u0441\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0440\u0443\u0437\u044C\u043A\u0435 \u0442\u0456\u043B\u043E
        \u0433\u0443\u0447\u043D\u043E \u0441\u0442\u0443\u043A\u043D\u0443\u043B\u043E\u0441\u044F
        \u043E\u0431 \u043F\u0456\u0434\u043B\u043E\u0433\u0443. \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0431\u0443\u0432 \u0431\u0435\u0437 \u0442\u044F\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_90_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0430\u0442\u0447-\u0440\u0435\u0432\u0430\u043D\u0448 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_91_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434\u0441\u043A\u043E\u0447\u0438\u0432\u0448\u0438 \u0434\u043E
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F, \u044F \u043E\u0431\u0445\u043E\u043F\u0438\u043B\u0430
        \u0439\u043E\u0433\u043E \u0437\u0430 \u0433\u0440\u0443\u0434\u0438. \u0414\u043E\u0432\u0436\u0438\u043D\u0438
        \u043C\u043E\u0457\u0445 \u0440\u0443\u043A \u043B\u0435\u0434\u044C \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E,
        \u0449\u043E\u0431 \u0437\u0456\u043C\u043A\u043D\u0443\u0442\u0438 \u043F\u0430\u043B\u044C\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_91_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u043A\u043E\u043B\u0438 \u044F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u0432\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438 \u043A\u0440\u0435\u043C\u0435\u0437\u043D\u043E\u0433\u043E
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430 \u0432\u0456\u0434 \u043F\u0456\u0434\u043B\u043E\u0433\u0438,
        \u043D\u043E\u0433\u0438 \u043F\u0456\u0434\u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044F.
        \u042F\u043A \u044F \u043D\u0435 \u043D\u0430\u043F\u0440\u0443\u0436\u0443\u0432\u0430\u043B\u0430\u0441\u044F,
        \u0430\u043B\u0435 \u0439\u043E\u0433\u043E \u0432\u0430\u0433\u0443 \u0432\u0456\u0434\u0456\u0440\u0432\u0430\u0442\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435, \u043D\u0456\u0436 \u043D\u0430 \u043C\u0456\u043B\u0456\u043C\u0435\u0442\u0440,
        \u0431\u0443\u043B\u0430 \u043D\u0435\u0441\u043F\u0440\u043E\u043C\u043E\u0436\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_91_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0456\u0434\u044C\u043A\u043E, \u0442\u0438 \u0446\u0438\u043C
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u043E\u043C \u0445\u0430\u0440\u0447\u0443\u0454\u0448\u0441\u044F
        \u0447\u0438 \u0449\u043E?!"
    - Language: 1
      Text: 
  - Key: scene_3_91_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0454, \u0449\u043E \u044F \u0432\u0441\u0442\u0438\u0433\u043B\u0430
        \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438, \u0431\u0443\u0432 \u0434\u0435\u0431\u0435\u043B\u0438\u0439
        \u043A\u0443\u043B\u0430\u043A \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0437 \u043F\u043E\u0447\u0435\u0440\u0432\u043E\u043D\u0456\u0432\u0448\u0438\u043C\u0438
        \u0432\u0456\u0434 \u0437\u043B\u043E\u0441\u0442\u0456 \u043A\u0456\u0441\u0442\u044F\u0448\u043A\u0430\u043C\u0438,
        \u044F\u043A\u0438\u0439 \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u0438\u0447\u043D\u043E
        \u043D\u0456\u0441\u0441\u044F \u043C\u0435\u043D\u0456 \u043F\u0440\u044F\u043C\u043E
        \u0432 \u043E\u0431\u043B\u0438\u0447\u0447\u044F. \u041F\u0456\u0441\u043B\u044F
        \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u044E \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C
        \u043D\u0430\u0432\u0456\u043A\u0438 \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u043B\u0430
        \u043F\u0456\u0442\u044C\u043C\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E,
        \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u043B\u043E\u0441\u044F, \u044F
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u043B\u0430, \u043D\u0430\u0447\u0435
        \u043C\u0435\u043D\u0435 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u0430\u0437\u0456\u0432 \u043F\u0435\u0440\u0435\u0457\u0445\u0430\u0432
        \u0442\u0440\u0430\u043A\u0442\u043E\u0440. \u0406 \u043D\u0430 \u0434\u0443\u0448\u0456,
        \u0456 \u0432 \u0442\u0456\u043B\u0456 \u0431\u0443\u043B\u043E \u0442\u0430\u043A
        \u043A\u0435\u043F\u0441\u044C\u043A\u043E, \u0449\u043E \u0432\u0441\u0456
        \u043F\u043E\u0434\u0456\u0457 \u0446\u0456\u0454\u0457 \u043D\u043E\u0447\u0456
        \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F \u0432\u0438\u0431\u043B\u044E\u0432\u0430\u0442\u0438
        \u0434\u0435\u0441\u044C \u0443 \u0437\u0430\u043A\u0443\u0442\u043A\u0443
        \u0439 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u043F\u0440\u043E
        \u043D\u0438\u0445 \u0437\u0430\u0431\u0443\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0440\u0435\u043C\u0442\u044F\u0447\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
        \u044F \u043D\u0430\u043C\u0430\u0446\u0430\u043B\u0430 \u043F\u0430\u0447\u043A\u0443
        \u0446\u0438\u0433\u0430\u0440\u043E\u043A \u0456 \u0437\u0430\u043F\u0430\u043B\u0438\u043B\u0430.
        \u041F\u0456\u0441\u043B\u044F \u0433\u043B\u0438\u0431\u043E\u043A\u043E\u0457
        \u0437\u0430\u0442\u044F\u0436\u043A\u0438 \u0436\u0438\u0442\u0442\u044F
        \u0441\u0442\u0430\u043B\u043E \u0437\u0434\u0430\u0432\u0430\u0442\u0438\u0441\u044F
        \u0445\u043E\u0447 \u0442\u0440\u043E\u0445\u0438 \u043F\u0440\u0438\u0454\u043C\u043D\u0456\u0448\u0438\u043C,
        \u0456 \u044F \u0437\u0456\u0431\u0440\u0430\u043B\u0430 \u0441\u0435\u0431\u0435
        \u0432 \u0440\u0443\u043A\u0438. \u0420\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F
        \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0449\u043E \u0442\u0435\u043F\u0435\u0440 \u0440\u043E\u0431\u0438\u0442\u0438
        \u0456\u0437 \u0446\u0438\u043C \u043A\u0440\u0435\u0442\u0438\u043D\u043E\u043C?"
    - Language: 1
      Text: 
  - Key: scene_3_92_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0433\u0430\u0434\u0430\u043B\u0430 \u043F\u0440\u043E
        \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0456 \u043A\u0430\u0439\u0434\u0430\u043D\u043A\u0438,
        \u044F\u043A\u0456 \u0431\u0443\u043B\u0438 \u0432 \u043C\u043E\u0454\u043C\u0443
        \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u043E\u043C\u0443
        \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u043E\u043C\u0443
        \u043D\u0430\u0431\u043E\u0440\u0456. \u041D\u0430 \u0449\u0430\u0441\u0442\u044F,
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u043D\u0435 \u0432\u0441\u0442\u0438\u0433
        \u0457\u0445 \u043F\u043E\u0437\u0443\u0431\u0438\u0442\u0438\u0441\u044F.
        \u041A\u0440\u0435\u043A\u0447\u0443\u0447\u0438, \u044F \u0434\u043E\u0442\u044F\u0433\u043B\u0430
        \u043D\u0435\u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0443 \u0442\u0443\u0448\u0443
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430 \u0434\u043E \u0454\u0434\u0438\u043D\u043E\u0457
        \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u043E\u0457 \u0442\u0440\u0443\u0431\u0438,
        \u044F\u043A\u0430 \u0441\u0442\u0438\u0440\u0447\u0430\u043B\u0430 \u0437\u0456
        \u0441\u0442\u0456\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043B\u0435\u0434\u044C \u0437\u043C\u043E\u0433\u043B\u0430
        \u0437\u0430\u043C\u043A\u043D\u0443\u0442\u0438 \u043A\u0430\u0439\u0434\u0430\u043D\u043A\u0438
        \u043D\u0430 \u0448\u0438\u0440\u043E\u0447\u0435\u043D\u043D\u0456\u0439
        \u0440\u0443\u0446\u0456 \u041E\u043B\u0435\u043A\u0441\u0456\u044F. \u041C\u043E\u0457\u0445
        \u043A\u0438\u0441\u0442\u0435\u0439 \u0442\u0443\u0434\u0438 \u0431 \u043F\u043E\u043C\u0456\u0441\u0442\u0438\u043B\u043E\u0441\u044F
        \u0448\u0442\u0443\u043A\u0438 \u0442\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041C-\u0434\u0430, \u043D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438
        \u0456\u0440\u0436\u0430\u0432\u0430 \u0442\u0440\u0443\u0431\u0430 \u0442\u0435\u0431\u0435
        \u043D\u0430\u0434\u043E\u0432\u0433\u043E \u0441\u0442\u0440\u0438\u043C\u0430\u0454.
        \u0422\u0430 \u0445\u043E\u0447\u0430 \u0431 \u043D\u0430\u043C\u0443\u0447\u0430\u0454\u0448\u0441\u044F,
        \u043A\u043E\u043B\u0438 \u0431\u0443\u0434\u0435\u0448 \u0432\u0438\u0431\u0438\u0440\u0430\u0442\u0438\u0441\u044F
        \u0437\u0432\u0456\u0434\u0441\u0438. \u041F\u043E\u043A\u0438\u0434\u044C\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_3_92_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0440\u0435\u0448\u0442\u0456 \u044F \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
        \u043E\u0442\u044F\u043C\u0438\u043B\u0430\u0441\u044F. \u0422\u043E\u0442\u0430\u043B\u044C\u043D\u0438\u0439
        \u0441\u043F\u043E\u043A\u0456\u0439 \u0442\u0430 \u0440\u0435\u043B\u0430\u043A\u0441\u2026
        \u0417 \u041E\u043B\u0435\u043A\u0441\u0456\u0454\u043C \u0431\u0443\u043B\u043E
        \u043A\u0456\u043D\u0447\u0435\u043D\u043E \u0456 \u044F \u043C\u043E\u0433\u043B\u0430
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u0438\u0445 \xAB\u0441\u043B\u0456\u0434\u0447\u0438\u0445\xBB
        \u0441\u043F\u0440\u0430\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_92_00_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0437\u0438\u0440\u0430\u044E\u0447\u0438\u0441\u044C
        \u043D\u0430\u0432\u043A\u0440\u0443\u0433\u0438 \u0432 \u043D\u0430\u043F\u0456\u0432\u0442\u0435\u043C\u043D\u043E\u043C\u0443
        \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456, \u044F \u043D\u0430\u0434\u0443\u043C\u0430\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_92_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0432\u0447\u0438\u0442\u0438 \u043F\u0456\u0434\u0432\u0430\u043B."
    - Language: 1
      Text: 
  - Key: scene_3_92_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0431\u0448\u0443\u043A\u0430\u0442\u0438 \u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0435
        \u0442\u0456\u043B\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_92_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438\u0441\u044F
        \u0434\u043E \u0441\u0442\u043E\u0440\u043E\u0436\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_92_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0406\u043B\u043E\u043D\u0443
        \u0431\u0456\u043B\u044F \u043C\u0430\u0448\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_93_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u043C\u0456\u0449\u0435\u043D\u043D\u044F \u0431\u0443\u043B\u043E
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u043F\u0443\u0441\u0442\u0438\u043C,
        \u044F\u043A\u0449\u043E \u043D\u0435 \u0440\u0430\u0445\u0443\u0432\u0430\u0442\u0438
        \u043C\u043E\u0457\u0445 \u0440\u0435\u0447\u0435\u0439 \u0442\u0430 \u0437\u0430\u043B\u0438\u0448\u043A\u0456\u0432
        \u0441\u0442\u0456\u043B\u044C\u0446\u044F. \u0421\u0435\u043D\u0441\u0443
        \u0432\u0441\u0435 \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u043E \u0442\u0443\u0442
        \u043E\u0431\u0448\u0443\u043A\u0443\u0432\u0430\u0442\u0438 \u044F \u043D\u0435
        \u0431\u0430\u0447\u0438\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_93_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
        \u0443\u0436\u0435 \u0432\u0456\u0434\u0432\u0435\u0440\u0442\u0430\u044E\u0447\u0438\u0441\u044C
        \u0434\u043B\u044F \u0447\u043E\u0433\u043E\u0441\u044C \u0431\u0456\u043B\u044C\u0448
        \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0433\u043E, \u044F \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430
        \u043C\u043E\u044E \u043E\u0431\u0440\u0443\u0447\u043A\u0443, \u044F\u043A\u0430
        \u0432\u0438\u043F\u0430\u043B\u0430 \u043F\u0456\u0434 \u0447\u0430\u0441
        \u0431\u0456\u0439\u043A\u0438 \u0437 \u041E\u043B\u0435\u043A\u0441\u0456\u0454\u043C
        \u0456 \u0437\u0430\u043A\u043E\u0442\u0438\u043B\u0430\u0441\u044F \u0432
        \u0434\u0430\u043B\u044C\u043D\u0456\u0439 \u043A\u0443\u0442."
    - Language: 1
      Text: 
  - Key: scene_3_93_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0434\u0456\u0439\u0441\u043D\u043E, \u0447\u043E\u043C\u0443
        \u044F \u0434\u043E\u0441\u0456 \u043D\u043E\u0441\u0438\u043B\u0430 \u043A\u0456\u043B\u044C\u0446\u0435
        \u0456\u0437 \u0441\u043E\u0431\u043E\u044E?"
    - Language: 1
      Text: 
  - Key: scene_3_93_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0432\u043E\u043D\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u043B\u043E
        \u043C\u0435\u043D\u0456 \u043F\u0440\u043E \u0442\u0456 \u0447\u0430\u0441\u0438,
        \u043A\u043E\u043B\u0438 \u0432\u0441\u0435 \u0432 \u043C\u043E\u0454\u043C\u0443
        \u0436\u0438\u0442\u0442\u0456 \u0449\u0435 \u0431\u0443\u043B\u043E \u0434\u043E\u0431\u0440\u0435.
        \u041A\u043E\u043B\u0438 \u0432\u0441\u0435 \u043C\u043E\u0433\u043B\u043E
        \u0441\u043A\u043B\u0430\u0441\u0442\u0438\u0441\u044F \u0456\u043D\u0430\u043A\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_93_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u043B\u0430\u043B\u0430 \u043E\u0431\u0440\u0443\u0447\u043A\u0443
        \u043D\u0430\u0437\u0430\u0434 \u0434\u043E \u043A\u0438\u0448\u0435\u043D\u0456
        \u0456 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0434\u0430\u043B\u0456
        \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_94_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u043A\u0438\u0448\u0435\u043D\u044C\u0446\u0456 \u043D\u0430
        \u0444\u0443\u0442\u0431\u043E\u043B\u0446\u0456 \u041E\u043B\u0435\u043A\u0441\u0456\u044F
        \u0437\u043D\u0430\u0439\u0448\u043E\u0432\u0441\u044F \u0441\u0442\u0430\u0440\u0438\u0439
        \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0438\u0439 \u043A\u043B\u044E\u0447."
    - Language: 1
      Text: 
  - Key: scene_3_94_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0443\u0436\u0438\u043A \u043A\u0430\u0437\u0430\u0432, \u0449\u043E
        \u043F\u0440\u0430\u0446\u044E\u0454 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0435\u043C
        \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430\u0445. \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
        \u044F \u0431\u0430\u0447\u0438\u043B\u0430 \u0441\u0442\u043E\u0440\u043E\u0436\u043A\u0443
        \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E \u0432\u0456\u0434 \u043D\u0438\u0445.
        \u041C\u043E\u0436\u0435, \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F
        \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443?"
    - Language: 1
      Text: 
  - Key: scene_3_94_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0445\u043E\u0432\u0430\u043B\u0430 \u043A\u043B\u044E\u0447\u0456
        \u0442\u0430 \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F
        \u043D\u0430 \u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0435
        \u0442\u0456\u043B\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_94_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0431\u0448\u0443\u043A\u0430\u0442\u0438 \u043A\u0438\u0448\u0435\u043D\u0456
        \u0448\u0442\u0430\u043D\u0456\u0432 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_94_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0431\u043B\u0438\u0448\u0438\u0442\u0438 \u0442\u0456\u043B\u043E
        \u0432 \u0441\u043F\u043E\u043A\u043E\u0457."
    - Language: 1
      Text: 
  - Key: scene_3_95_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417 \u043A\u0438\u0448\u0435\u043D\u0456 \u044F \u0434\u043E\u0431\u0443\u043B\u0430
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u041E\u043B\u0435\u043A\u0441\u0456\u044F.
        \u0426\u0435 \u0431\u0443\u043B\u0430 \u0441\u0442\u0430\u0440\u0430 \u0439
        \u043F\u043E\u0431\u0438\u0442\u0430 \u043C\u043E\u0434\u0435\u043B\u044C,
        \u044F\u043A\u0430 \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u0430
        \u0449\u0435 \u043D\u0430 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0456\u0457
        \u043F\u0440\u0443\u0436\u0438\u043D \u0442\u0430 \u0432\u0430\u0436\u0456\u043B\u044C\u0446\u0456\u0432
        \u0440\u0456\u0437\u043D\u043E\u0457 \u0434\u043E\u0432\u0436\u0438\u043D\u0438.
        \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0457\u0445 \u0443\u0436\u0435
        \u0440\u043E\u043A\u0456\u0432 \u0442\u0440\u0438\u0434\u0446\u044F\u0442\u044C
        \u043D\u0435 \u0432\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u044F\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_95_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
        \u0431\u0443\u0432 \u0446\u0456\u043B\u043A\u043E\u043C \u0443 \u0440\u043E\u0431\u043E\u0447\u043E\u043C\u0443
        \u0441\u0442\u0430\u043D\u0456 \u0439 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435\u043F\u043E\u0433\u0430\u043D\u043E \u043B\u043E\u0432\u0438\u0432
        \u0441\u0438\u0433\u043D\u0430\u043B. \u0426\u0435 \u0431\u0443\u043B\u0430
        \u0445\u043E\u0447 \u044F\u043A\u0430\u0441\u044C \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u0430
        \u043C\u043E\u0454\u043C\u0443 \u0440\u043E\u0437\u0440\u044F\u0434\u0436\u0435\u043D\u043E\u043C\u0443
        \u0433\u0430\u0434\u0436\u0435\u0442\u0443. \u0423 \u043D\u0430\u0448\u0456
        \u0447\u0430\u0441\u0438 \u0431\u0430\u0442\u0430\u0440\u0435\u0457 \u043A\u043B\u0435\u0432\u0435\u0440\u0444\u043E\u043D\u0456\u0432
        \u0443\u0436\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0432\u0430\u0440\u0442\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_95_00_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u043B\u0456 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_95_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443\u0432\u0430\u0442\u0438
        \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0443 \u0439 \u0437\u0430\u043F\u0438\u0442\u0430\u0442\u0438
        \u043F\u0440\u043E \u043A\u0443\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_95_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u0447\u0438\u0439
        \u043D\u043E\u043C\u0435\u0440 \u044F \u0437\u043D\u0430\u0439\u0448\u043B\u0430
        \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_95_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0432\u0430\u0442\u0438 \u0442\u0435\u043B\u0435\u0444\u043E\u043D."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F \u0456\u0437
        \u0446\u0438\u043C \u0441\u0442\u0430\u0440\u0438\u043C \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C
        \u0431\u0443\u043B\u043E \u0442\u0438\u043C \u0449\u0435 \u043F\u0440\u0438\u043B\u0438\u0432\u043E\u043C
        \u043D\u043E\u0441\u0442\u0430\u043B\u044C\u0433\u0456\u0457. \u0417\u0430
        \u0456\u043D\u0448\u0438\u0445 \u0443\u043C\u043E\u0432 \u0446\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043C\u043E\u0433\u043B\u043E \u0431 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
        \u044F\u043A\u0456\u0441\u044C \u0441\u0435\u043D\u0442\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0456
        \u043F\u043E\u0447\u0443\u0442\u0442\u044F. \u0412\u0440\u0435\u0448\u0442\u0456
        \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043D\u0430\u0431\u0440\u0430\u0442\u0438
        \u041E\u0440\u0435\u0441\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_2
    LocalizationDatas:
    - Language: 0
      Text: ......
    - Language: 1
      Text: 
  - Key: scene_3_96_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u043B\u043E, \u0446\u0435 \u044F. \u0423 \u043C\u0435\u043D\u0435
        \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F \u043D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u0435\u2026
        \u043E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443.
        \u042F\u043A \u0442\u0438 \u0442\u0430\u043C? \u0423\u0441\u0435 \u0449\u0435
        \u043F\u043E\u0440\u0430\u0454\u0448\u0441\u044F \u0437\u0456 \u0441\u0432\u043E\u0454\u044E
        \u043A\u043E\u043B\u0438\u043C\u0430\u0433\u043E\u044E?"
    - Language: 1
      Text: 
  - Key: scene_3_96_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430? \u0414\u044F\u043A\u0443\u0432\u0430\u0442\u0438
        \u0431\u043E\u0433\u0443, \u0437 \u0442\u043E\u0431\u043E\u044E \u0432\u0441\u0435
        \u0434\u043E\u0431\u0440\u0435. \u0425\u043E\u0442\u0456\u0432 \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
        \u044F\u043A \u0442\u0438, \u0430\u043B\u0435 \u0432\u0441\u0435 \u043D\u0435
        \u043C\u0456\u0433 \u0434\u043E\u0434\u0437\u0432\u043E\u043D\u0438\u0442\u0438\u0441\u044F.
        \u0406\u2026 \u0442\u0430\u043A, \u0443\u0441\u0435 \u0449\u0435 \u043F\u043E\u0440\u0430\u044E\u0441\u044C.
        \u042F \u0434\u0443\u043C\u0430\u0432, \u0443 \u043A\u0440\u0430\u043B\u044C\u043A\u0438
        \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u043E\u0442\u0456\u043A \u0431\u0430\u043A,
        \u0430\u043B\u0435, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0439\u043E\u043C\u0443
        \u0437\u043E\u0432\u0441\u0456\u043C \u043A\u0430\u044E\u043A. \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u043C\u0456\u043D\u044F\u0442\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u0441\u0435\u0431\u0435 \u044F \u0437\u0430\u0437\u043D\u0430\u0447\u0438\u043B\u0430,
        \u0449\u043E \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0438\u0439 \u0437\u0432\u2019\u044F\u0437\u043E\u043A
        \u0441\u0442\u0430\u0432 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u043A\u0440\u0430\u0449\u0438\u043C. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0440\u0430\u043D\u0456\u0448\u0435 \u0442\u0440\u0430\u0432\u0430 \u0456
        \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0431\u0443\u043B\u0430 \u0437\u0435\u043B\u0435\u043D\u0456\u0448\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043B\u0443\u0445\u0430\u0439, \u0434\u0430\u0432\u0430\u0439
        \u043F\u0440\u043E \xAB\u043A\u0440\u0430\u043B\u044C\u043A\u0443\xBB \u043F\u0456\u0437\u043D\u0456\u0448\u0435.
        \u0423 \u043C\u0435\u043D\u0435 \u0442\u0443\u0442 \u0441\u043B\u0456\u0434\u0441\u0442\u0432\u043E
        \u0432 \u0440\u043E\u0437\u043F\u0430\u043B\u0456. \u041D\u0430 \u043C\u0456\u0441\u0446\u0456
        \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430 \u044F \u0437\u043D\u0430\u0439\u0448\u043B\u0430
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0443 \u043A\u0443\u043B\u044E,
        \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u0448 \u0443\u043F\u0456\u0437\u043D\u0430\u0442\u0438?"
    - Language: 1
      Text: 
  - Key: scene_3_96_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0413\u0435\u0439, \u0445\u043E\u0447\u0435\u0448 \u0441\u043E\u0431\u0456
        \u0432\u0441\u044E \u0441\u043B\u0430\u0432\u0443 \u043F\u0440\u0438\u0432\u043B\u0430\u0441\u043D\u0438\u0442\u0438?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_96_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0443, \u0434\u043E\u0431\u0440\u0435-\u0434\u043E\u0431\u0440\u0435,
        \u043F\u043E\u043A\u0438 \u043C\u0435\u0445\u0430\u043D\u0456\u043A \u043E\u0433\u043B\u044F\u0434\u0430\u0454
        \u0430\u0432\u0442\u043E, \u043C\u0435\u043D\u0456 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E
        \u043D\u0435\u043C\u0430\u0454 \u0447\u0438\u043C \u0437\u0430\u0439\u043D\u044F\u0442\u0438\u0441\u044F.
        \u041D\u0430\u0434\u0441\u0438\u043B\u0430\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457
        \u043A\u0443\u043B\u0456. \u0422\u0456\u043B\u044C\u043A\u0438 \u0446\u044C\u043E\u0433\u043E
        \u0440\u0430\u0437\u0443 \u0432\u0438\u0441\u0442\u0430\u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439
        \u0444\u043E\u043A\u0443\u0441!\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_96_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u044F\u043A\u0443\u044E, \u041E\u0440\u0435\u0441\u0442\u0435.
        \u0414\u043E \u0437\u0432\u2019\u044F\u0437\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u043B\u0430\u043B\u0430 \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443
        \u0442\u0430 \u0434\u0456\u0441\u0442\u0430\u043B\u0430 \u043A\u0443\u043B\u044E,
        \u0449\u043E\u0431 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0444\u043E\u0442\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_96_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0442 \u0432\u0456\u043D \u0437\u0434\u0438\u0432\u0443\u0454\u0442\u044C\u0441\u044F,
        \u043A\u043E\u043B\u0438 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C,
        \u0437 \u044F\u043A\u043E\u044E \u044F\u043A\u0456\u0441\u0442\u044E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0454
        \u0446\u0435\u0439 \u0434\u0456\u0434\u0443\u043D\u044C \u043D\u0430 \u0432\u0430\u0436\u0456\u043B\u044C\u0446\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_97_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0423\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u0438\u0441\u044F \u0456\u0437
        \u0446\u0438\u043C \u0441\u0442\u0430\u0440\u0438\u043C \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C
        \u0431\u0443\u043B\u043E \u0442\u0438\u043C \u0449\u0435 \u043F\u0440\u0438\u043B\u0438\u0432\u043E\u043C
        \u043D\u043E\u0441\u0442\u0430\u043B\u044C\u0433\u0456\u0457. \u0417\u0430
        \u0456\u043D\u0448\u0438\u0445 \u0443\u043C\u043E\u0432 \u0446\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043C\u043E\u0433\u043B\u043E \u0431 \u0432\u0438\u043A\u043B\u0438\u043A\u0430\u0442\u0438
        \u044F\u043A\u0456\u0441\u044C \u0441\u0435\u043D\u0442\u0438\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u0456
        \u043F\u043E\u0447\u0443\u0442\u0442\u044F. \u0412\u0440\u0435\u0448\u0442\u0456
        \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u043D\u0430\u0431\u0440\u0430\u0442\u0438
        \u041E\u0440\u0435\u0441\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_97_part_2
    LocalizationDatas:
    - Language: 0
      Text: ......
    - Language: 1
      Text: 
  - Key: scene_3_97_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u043B\u043E, \u041E\u0440\u0435\u0441\u0442\u0435, \u0446\u0435
        \u044F. \u0423 \u043C\u0435\u043D\u0435 \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F
        \u043D\u0435\u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043D\u0435\u2026
        \u041E\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044F \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443.
        \u0429\u043E \u0442\u0438 \u0442\u0430\u043C? \u0423\u0441\u0435 \u0449\u0435
        \u043F\u043E\u0440\u0430\u0454\u0448\u0441\u044F \u0437\u0456 \u0441\u0432\u043E\u0454\u044E
        \u043A\u043E\u043B\u0438\u043C\u0430\u0433\u043E\u044E?"
    - Language: 1
      Text: 
  - Key: scene_3_97_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430? \u041D\u0435\u0432\u0436\u0435
        \u043D\u0430\u0448\u0430 \xAB\u043C\u0456\u0441 \u0433\u043E\u043B\u043E\u0432\u043D\u0430
        \u0441\u043B\u0456\u0434\u0447\u0430\xBB \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u043F\u0435\u0440\u0435\u0434\u0437\u0432\u043E\u043D\u0438\u0442\u0438?
        \u041C\u0430\u043B\u043E \u0442\u043E\u0431\u0456 \u0431\u0443\u043B\u043E
        \u0442\u0438\u0445 \u043E\u0431\u0440\u0430\u0437, \u044F\u043A\u0456 \u0442\u0438
        \u043D\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430, \u0442\u0430\u043A
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0439 \u0449\u0435\u0437\u043D\u0443\u0442\u0438
        \u043D\u0430 \u043F\u0456\u0432 \u043D\u043E\u0447\u0456 \u2014 \u043D\u0456
        \u0441\u043B\u0443\u0445\u0443, \u043D\u0456 \u0434\u0443\u0445\u0443\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_97_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u0441\u0435\u0431\u0435 \u044F \u0437\u0430\u0437\u043D\u0430\u0447\u0438\u043B\u0430,
        \u0449\u043E \u043C\u043E\u0431\u0456\u043B\u044C\u043D\u0438\u0439 \u0437\u0432\u2019\u044F\u0437\u043E\u043A
        \u0441\u0442\u0430\u0432 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u043A\u0440\u0430\u0449\u0438\u043C. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0440\u0430\u043D\u0456\u0448\u0435 \u0442\u0440\u0430\u0432\u0430 \u0456
        \u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0431\u0443\u043B\u0430 \u0437\u0435\u043B\u0435\u043D\u0456\u0448\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_97_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0431\u0430\u0447, \u043D\u0435 \u043C\u043E\u0436\u0443
        \u043F\u0456\u0434\u043B\u0430\u0448\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u0441\u044F
        \u043A\u043E\u0436\u0435\u043D \u0440\u0430\u0437, \u044F\u043A \u0442\u0438
        \u0441\u0442\u0430\u0454\u0448 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
        \u043F\u043E\u0431\u043B\u0430\u0436\u043B\u0438\u0432\u043E\u044E, \u0430\u0431\u0438
        \u043F\u0435\u0440\u0435\u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443\u0432\u0430\u0442\u0438.
        \u041C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430 \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0456 \u0430\u0432\u0442\u043E\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_97_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0447\u0443\u0432\u0448\u0438 \u0446\u0435, \u044F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_97_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0422\u0438 \u0445\u043E\u0447 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448,
        \u0447\u0435\u0440\u0435\u0437 \u0449\u043E \u044F \u043F\u0440\u043E\u0439\u0448\u043B\u0430?
        \u041F\u043E\u0446\u0456\u043B\u0443\u0439 \u0441\u043E\u0431\u0430\u043A\u0443
        \u0432 \u0441\u0440\u0430\u043A\u0443!\xBB \u2014 \u0406 \u043F\u043E\u043A\u043B\u0430\u043B\u0430
        \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_97_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0431\u0430\u0447, \u041E\u0440\u0435\u0441\u0442\u0435.
        \u0426\u0435 \u0431\u0443\u043B\u0430 \u0432\u0430\u0436\u043A\u0430 \u043D\u0456\u0447\xBB. "
    - Language: 1
      Text: 
  - Key: scene_3_98_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0434\u0456\u0441\u0442\u0430\u043B\u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0439
        \u0448\u043C\u0430\u0442\u043E\u0447\u043E\u043A \u043F\u0430\u043F\u0435\u0440\u0443,
        \u0434\u043E\u0431\u0440\u0435 \u0440\u043E\u0437\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F
        \u0456 \u043D\u0430\u0431\u0440\u0430\u043B\u0430 \u043D\u043E\u043C\u0435\u0440.
        \u0423 \u0442\u0430\u043A\u0456 \u043C\u043E\u043C\u0435\u043D\u0442\u0438
        \u043C\u0435\u043D\u0435 \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u2019\u0457\u0434\u0430\u043B\u0430
        \u0446\u0456\u043A\u0430\u0432\u0456\u0441\u0442\u044C. \u0417\u0443\u0441\u0442\u0440\u0456\u0447
        \u0456\u0437 \u043D\u0435\u0432\u0456\u0434\u043E\u043C\u0438\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0447\u0443\u043B\u0438\u0441\u044C \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043D\u0456
        \u0433\u0443\u0434\u043A\u0438. \u0429\u043E \u0436, \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456
        \u043D\u043E\u043C\u0435\u0440 \u0431\u0443\u0432 \u0440\u043E\u0431\u043E\u0447\u0438\u0439.
        \u042F \u0437\u0430\u0447\u0435\u043A\u0430\u043B\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0441\u0435\u043A\u0443\u043D\u0434, \u0430\u043B\u0435 \u0433\u0443\u0434\u043A\u0438
        \u0432\u0441\u0435 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u043B\u0438\u0441\u044F..."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u044F\u043A\u0438\u0439
        \u0447\u0430\u0441 \u0443 \u043C\u0435\u043D\u0435 \u043D\u0430\u0432\u0456\u0442\u044C
        \u0440\u043E\u0437\u0431\u043E\u043B\u0456\u043B\u0430\u0441\u044F \u0433\u043E\u043B\u043E\u0432\u0430
        \u0432\u0456\u0434 \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u043E\u0433\u043E
        \xAB\u0438-\u0438-\u0438-\u0438\xBB. \u042F \u0432\u0436\u0435 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430,
        \u0449\u043E \u043C\u0435\u043D\u0456 \u043D\u0456\u0445\u0442\u043E \u043D\u0435
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0441\u0442\u044C \u0456 \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
        \u0445\u043E\u0432\u0430\u0442\u0438 \u0442\u0435\u043B\u0435\u0444\u043E\u043D,
        \u0430\u0436 \u043E\u0441\u044C\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_98_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0434\u0440\u043E\u0442\u0456 \u043F\u043E\u0447\u0443\u0432\u0441\u044F
        \u0442\u0438\u0445\u0438\u0439, \u043D\u0435\u0440\u043E\u0437\u0431\u0456\u0440\u043B\u0438\u0432\u0438\u0439
        \u0447\u043E\u043B\u043E\u0432\u0456\u0447\u0438\u0439 \u0433\u043E\u043B\u043E\u0441.
        \u0412\u0456\u043D \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u0432
        \u043C\u0430\u0439\u0436\u0435 \u043F\u043E\u0448\u0435\u043F\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0424\u043E\u0440\u0435\u043B\u044C \u0440\u0443\u0448\u0438\u043B\u0430
        \u043D\u0430 \u043D\u0435\u0440\u0435\u0441\u0442. \u0427\u0438 \u0442\u0440\u0435\u0431\u0430
        \u043D\u0435\u0441\u0442\u0438 \u0440\u0438\u0431\u0443?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_98_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u0447\u0435\u0440\u0435\u0437 \u043C\u043E\u044E
        \u0442\u0440\u0438\u0432\u0430\u043B\u0443 \u043C\u043E\u0432\u0447\u0430\u043D\u043A\u0443
        \u0434\u043E \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A\u0430
        \u0434\u0456\u0439\u0448\u043B\u043E, \u0449\u043E \u044F \u043D\u0456\u0447\u043E\u0433\u043E
        \u043D\u0435 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u0442\u043E\u043C\u0443
        \u0432\u0456\u043D \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_98_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0430\u0437\u0432\u0456\u0442\u044C\u0441\u044F\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_98_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043B\u0456\u0434\u0447\u0430 \u043F\u043E\u043B\u0456\u0446\u0456\u0457."
    - Language: 1
      Text: 
  - Key: scene_3_98_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_98_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0432\u043E\u044F \u0434\u0430\u0432\u043D\u044F \u0437\u043D\u0430\u0439\u043E\u043C\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_98_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0441\u0442\u043E\u043C\u0438\u043B\u0430\u0441\u044F \u0432\u0456\u0434
        \u0442\u0432\u043E\u0454\u0457 \u0442\u0443\u043F\u043E\u0441\u0442\u0456.
        \u0422\u0435\u043B\u0435\u0444\u043E\u043D\u0443\u044E \u0437 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_98_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u0435, \u0437\u0456\u0433\u0440\u0430\u0454\u043C\u043E?
        \u042F \u0441\u043E\u0431\u0456 \u043D\u043E\u0432\u0438\u0439 \u043D\u0456\u043A
        \u043F\u0456\u0434\u0456\u0431\u0440\u0430\u043B\u0430. \u0412\u0433\u0430\u0434\u0430\u0454\u0448
        \u043F\u043E \u0433\u043E\u043B\u043E\u0441\u0443?"
    - Language: 1
      Text: 
  - Key: scene_3_99_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0434\u0440\u043E\u0442\u0456 \u0447\u0443\u043B\u043E\u0441\u044F
        \u0432\u0430\u0436\u043A\u0435 \u0434\u0438\u0445\u0430\u043D\u043D\u044F
        \u041E\u0440\u0435\u0441\u0442\u0430. \u0421\u0445\u043E\u0436\u0435, \u0432\u0456\u043D
        \u0432\u0430\u0433\u0430\u0432\u0441\u044F, \u0430\u043B\u0435 \u0437\u0440\u0435\u0448\u0442\u043E\u044E
        \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_99_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0414\u043E\u0431\u0440\u0435, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E.
        \u0417\u043D\u0430\u0454\u0448, \u0443 \u0432\u0456\u0434\u0434\u0456\u043B\u043A\u0443
        \u0432 \u0442\u0435\u0431\u0435 \u0454 \u043F\u0435\u0432\u043D\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0456\u044F.
        \u0422\u0435\u0431\u0435 \u0432\u0432\u0430\u0436\u0430\u044E\u0442\u044C
        \u0447\u0438\u043C\u043E\u0441\u044C \u0442\u0438\u043F\u0443 \u043E\u0431\u0434\u0430\u0440\u043E\u0432\u0430\u043D\u043E\u0433\u043E,
        \u0430\u043B\u0435 \u0441\u043A\u0430\u0436\u0435\u043D\u043E\u0433\u043E
        \u0433\u0435\u043D\u0456\u044F. \u0429\u0435 \u043D\u0435 \u0431\u0443\u043B\u043E
        \u0431 \u0442\u0430\u043A\u043E\u0457 \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456,
        \u044F\u043A\u0443 \u0431 \u0442\u0438 \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0430
        \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F. \u0410\u0431\u043E
        \u0442\u0430\u043A\u043E\u0457, \u044F\u043A\u0443 \u0431 \u043D\u0435 \u0437\u0430\u0445\u043E\u0442\u0456\u043B\u0430\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_99_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u042F \u0432\u0432\u0430\u0436\u0430\u0432 \u0446\u0435 \u0437\u0430
        \u0432\u0435\u043B\u0438\u043A\u0443 \u0447\u0435\u0441\u0442\u044C, \u043A\u043E\u043B\u0438
        \u043C\u0435\u043D\u0435 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0438\u043B\u0438
        \u0442\u0432\u043E\u0457\u043C \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u043E\u043C.
        \u041C\u0438 \u043C\u043E\u0436\u0435\u043C\u043E \u0439 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442\u0438
        \u043E\u0434\u0438\u043D \u043E\u0434\u043D\u043E\u0433\u043E. \u0410\u043B\u0435
        \u043F\u0440\u0438\u043D\u0430\u0439\u043C\u043D\u0456 \u044F \u043F\u043E\u0432\u0430\u0436\u0430\u044E
        \u0442\u0435\u0431\u0435 \u0442\u0430 \u0442\u0432\u043E\u0457 \u0434\u043E\u0441\u044F\u0433\u043D\u0435\u043D\u043D\u044F\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_99_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u043A\u043E\u043B\u0438\u0441\u044C
        \u0442\u0438 \u0437\u043C\u043E\u0436\u0435\u0448 \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F
        \u0442\u0438\u043C, \u0449\u043E \u0437\u0430 \u0442\u044F\u0433\u0430\u0440
        \u043D\u043E\u0441\u0438\u0448 \u0443 \u0434\u0443\u0448\u0456. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0442\u043E\u0434\u0456 \u043D\u0430\u0448\u0456 \u0432\u0456\u0434\u043D\u043E\u0441\u0438\u043D\u0438
        \u0441\u0442\u0430\u043D\u0443\u0442\u044C \u0442\u0440\u043E\u0445\u0438
        \u0442\u0435\u043F\u043B\u0456\u0448\u0438\u043C\u0438. \u0420\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0430\u0439,
        \u0442\u043E\u0431\u0456 \u0431\u0443\u043B\u043E \u0449\u043E\u0441\u044C
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_99_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u043C\u0456\u0441\u0446\u0456 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430
        \u044F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0432\u0456\u0434\u0441\u0442\u0440\u0456\u043B\u044F\u043D\u0443
        \u043A\u0443\u043B\u044E, \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435\u0448
        \u0443\u043F\u0456\u0437\u043D\u0430\u0442\u0438?"
    - Language: 1
      Text: 
  - Key: scene_3_99_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0430\u0434\u0441\u0438\u043B\u0430\u0439 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0457
        \u043A\u0443\u043B\u0456. \u0422\u0456\u043B\u044C\u043A\u0438 \u0446\u044C\u043E\u0433\u043E
        \u0440\u0430\u0437\u0443 \u0432\u0438\u0441\u0442\u0430\u0432 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u0438\u0439
        \u0444\u043E\u043A\u0443\u0441!\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_99_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u044F\u043A\u0443\u044E, \u041E\u0440\u0435\u0441\u0442\u0435.
        \u0414\u043E \u0437\u0432\u2019\u044F\u0437\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_99_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u043B\u0430\u043B\u0430 \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443
        \u0442\u0430 \u0434\u0456\u0441\u0442\u0430\u043B\u0430 \u043A\u0443\u043B\u044E,
        \u0449\u043E\u0431 \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0444\u043E\u0442\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_99_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0442 \u0432\u0456\u043D \u0437\u0434\u0438\u0432\u0443\u0454\u0442\u044C\u0441\u044F,
        \u043A\u043E\u043B\u0438 \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C,
        \u0437 \u044F\u043A\u043E\u044E \u044F\u043A\u0456\u0441\u0442\u044E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0454
        \u0446\u0435\u0439 \u0434\u0456\u0434\u0443\u043D\u044C \u043D\u0430 \u0432\u0430\u0436\u0456\u043B\u044C\u0446\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_100_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0431\u0430\u0447, \u043D\u0456\u0447\u0438\u043C \u043D\u0435
        \u043C\u043E\u0436\u0443 \u0442\u043E\u0431\u0456 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438.
        \u041D\u0435 \u0434\u0437\u0432\u043E\u043D\u0438 \u0441\u044E\u0434\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_100_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043C\u0456\u0439
        \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0438\u0439 \u0441\u043F\u0456\u0432\u0431\u0435\u0441\u0456\u0434\u043D\u0438\u043A
        \u043E\u0434\u0440\u0430\u0437\u0443 \u043F\u043E\u043A\u043B\u0430\u0432
        \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_100_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0449\u043E \u0446\u0435 \u0431\u0443\u043B\u043E?"
    - Language: 1
      Text: 
  - Key: scene_3_100_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0442\u0430\u043A \u0456 \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0430
        \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F, \u0445\u0442\u043E
        \u0445\u043E\u0432\u0430\u0432\u0441\u044F \u043F\u0456\u0434 \u0446\u0438\u043C
        \u043D\u043E\u043C\u0435\u0440\u043E\u043C \u0456 \u044F\u043A \u0431\u0443\u0432
        \u043F\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0438\u0439 \u0456\u0437
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u043E\u043C. \u041D\u0430 \u0436\u0430\u043B\u044C,
        \u0448\u0430\u043D\u0441 \u0443\u0436\u0435 \u0431\u0443\u043B\u043E \u0432\u0442\u0440\u0430\u0447\u0435\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_101_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0435 \u0437\u043D\u0430\u0439\u043E\u043C\u0438\u0439 \u0456\u0437
        \u0446\u0438\u043C \u043A\u043E\u0434\u043E\u0432\u0438\u043C \u0456\u043C\u0435\u043D\u0435\u043C\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_101_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041C\u043E\u0436\u0435, \u0442\u043E\u0431\u0456 \u0434\u043E
        \u0429\u0443\u0440\u0430? \u0410\u0437\u0430\u0440\u0442\u043D\u0438\u043C\u0438
        \u0443\u0433\u043E\u0434\u0430\u043C\u0438 \u0437\u0430\u0439\u043C\u0430\u0454\u0442\u044C\u0441\u044F
        \u0432\u0456\u043D. \u041D\u0430\u0441 \u0447\u0430\u0441\u0442\u043E \u043F\u043B\u0443\u0442\u0430\u044E\u0442\u044C\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_101_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u044F \u043F\u0440\u0430\u0446\u044E\u044E
        \u0437\u0456 \u0429\u0443\u0440\u043E\u043C, \u0442\u0430 \u0437\u0430\u0440\u0430\u0437
        \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456
        \u0432\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_101_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A\u0438\u0439 \u0449\u0443\u0440? \u041D\u0435\u0432\u0436\u0435
        \u043D\u0435 \u0432\u043F\u0456\u0437\u043D\u0430\u0454\u0448 \u043C\u0435\u043D\u0435?
        \u041C\u0438 \u0436 \u044F\u043A \u0434\u0440\u0443\u0437\u0456!"
    - Language: 1
      Text: 
  - Key: scene_3_102_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0406\u043B\u043E\u043D\u043E, \u0446\u0435 \u0442\u0438? \u0412\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0437 \u043C\u0435\u043D\u0435 \u043F\u043E\u0437\u043D\u0443\u0449\u0430\u0442\u0438\u0441\u044F?
        \u042F \u0446\u044E \u0433\u0430\u043B\u0456\u043C\u0430\u0442\u044C\u044E
        \u0434\u043E\u0432\u0433\u043E \u0442\u0435\u0440\u043F\u0456\u0442\u0438
        \u043D\u0435 \u0431\u0443\u0434\u0443\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_102_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0406 \u043C\u0438 \u0436 \u0434\u043E\u043C\u043E\u0432\u043B\u044F\u043B\u0438\u0441\u044C,
        \u043D\u0456\u044F\u043A\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443.
        \u041D\u0430\u0432\u0456\u0442\u044C \u0437 \u0456\u043D\u0448\u043E\u0433\u043E
        \u043D\u043E\u043C\u0435\u0440\u0443. \u041C\u0435\u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
        \u043F\u0440\u043E\u0441\u043B\u0443\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u0456 \u0441\u043E\u0431\u0430\u043A\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_102_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0417\u0432\u2019\u044F\u0436\u0438\u0441\u044C \u0437\u0456 \u043C\u043D\u043E\u044E,
        \u044F\u043A \u043C\u0438 \u043E\u0431\u0433\u043E\u0432\u043E\u0440\u044E\u0432\u0430\u043B\u0438
        \u0440\u0430\u043D\u0456\u0448\u0435. \u0406 \u0437\u0430\u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0439
        \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u043A\u043B\u044F\u0442\u0438\u0439
        \u043F\u0430\u0440\u043E\u043B\u044C!\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_102_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0447\u0435\u043A\u0430\u044E\u0447\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F
        \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u043A\u0438, \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A
        \u043F\u043E\u043A\u043B\u0430\u0432 \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443.
        \u042F \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0430 \u0432\u0438\u043D\u044E\u0445\u0430\u0442\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435, \u0430\u043B\u0435\u2026 \u0406\u043B\u043E\u043D\u0430?
        \u0426\u044E \u0434\u0456\u0432\u0447\u0438\u043D\u0443 \u044F \u0442\u043E\u0447\u043D\u043E
        \u043D\u0435 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043B\u0430
        \u0443 \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0438\u0445
        \u0437\u0432\u2019\u044F\u0437\u043A\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_102_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0430\u0440\u0442\u043E \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u0437\u043D\u043E\u0432\u0443 \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0457
        \u0456 \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043D\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_103_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0435 \u0441\u043C\u0456\u0439 \u0433\u0440\u0430\u0442\u0438\u0441\u044F
        \u0437\u0456 \u043C\u043D\u043E\u044E! \u0423 \u043C\u0435\u043D\u0435 \u0442\u0443\u0442
        \u0437\u0430\u043F\u0438\u0441\u043D\u0438\u043A \u043F\u0456\u0434 \u0440\u0443\u043A\u043E\u044E,
        \u0443\u0441\u0435 \u0442\u0430\u043C \u0454. \u042F \u0442\u0435\u0431\u0435
        \u043B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u0431\u2019\u044E \u043F\u043E
        \u0431\u0430\u0437\u0456\u2026\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_103_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0434\u043E\u0431\u0440\u0443 \u0445\u0432\u0438\u043B\u0438\u043D\u0443
        \u0437\u0430\u0432\u0438\u0441\u043B\u043E \u043C\u043E\u0432\u0447\u0430\u043D\u043D\u044F.
        \u042F \u0447\u0443\u043B\u0430 \u0448\u0443\u0440\u0445\u0456\u0442 \u0441\u0442\u043E\u0440\u0456\u043D\u043E\u043A
        \u0442\u0430 \u0441\u0442\u0443\u043A\u0456\u0442 \u043A\u043B\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0438.
        \u041D\u0435\u0432\u0436\u0435 \u0442\u0430\u0454\u043C\u043D\u0438\u0439
        \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A
        \u0456 \u043F\u0440\u0430\u0432\u0434\u0430 \xAB\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0432
        \u0449\u043E\u0441\u044C \u043F\u043E \u0431\u0430\u0437\u0456\xBB?"
    - Language: 1
      Text: 
  - Key: scene_3_103_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0435\u0448\u0442\u0456 \u0432\u0456\u043D \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F
        \u0434\u043E \u0440\u043E\u0437\u043C\u043E\u0432\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_103_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0427\u043E\u043C\u0443 \u043E\u0434\u0440\u0430\u0437\u0443 \u043D\u0435
        \u0441\u043A\u0430\u0437\u0430\u043B\u0430, \u0449\u043E \u0446\u0435 \u0442\u0438?
        \u0422\u043E\u0439 \u0431\u043E\u0432\u0434\u0443\u0440 \u0437\u043D\u043E\u0432\u0443
        \u0449\u043E\u0441\u044C \u043D\u0430\u043A\u043E\u0457\u0432? \u042F \u0436
        \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0436\u0430\u0432, \u0434\u0438\u043D\u0430\u043C\u0456\u0442
        \u2014 \u0442\u043E \u043D\u0435 \u0456\u0433\u0440\u0430\u0448\u043A\u0438\u2026\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_103_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0406 \u0434\u0435 \u041B\u044C\u043E\u0445\u0430? \u0427\u043E\u043C\u0443
        \u0437 \u0439\u043E\u0433\u043E \u043D\u043E\u043C\u0435\u0440\u0430 \u0434\u0437\u0432\u043E\u043D\u0438\u0448?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_104_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u0440\u0442 \u0437\u0430\u0431\u0438\u0440\u0430\u0439\u2026
        \u0421\u043A\u0456\u043B\u044C\u043A\u0438 \u043F\u0438\u0442\u0430\u043D\u044C
        \u0456 \u043D\u0435 \u0436\u043E\u0434\u043D\u0435 \u044F \u043D\u0435 \u0437\u043D\u0430\u043B\u0430
        \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0456. \u041C\u043E\u0436\u0435,
        \u043C\u043E\u0432\u0430 \u0439\u0448\u043B\u0430 \u043F\u0440\u043E \u041A\u043E\u0440\u043D\u0456\u044F?
        \u0423\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438, \u0432\u0456\u043D \u0431\u0443\u0432
        \u043A\u0440\u0430\u0449\u0438\u043C \u0434\u0440\u0443\u0433\u043E\u043C
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_104_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u0448\u043E\u0433\u043E \u0448\u0430\u043D\u0441\u0443
        \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u043D\u0435 \u0431\u0443\u043B\u043E,
        \u0442\u043E\u043C\u0443 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_104_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435\u0439 \u0456\u0434\u0456\u043E\u0442 \u041A\u043E\u0440\u043D\u0456\u0439
        \u0437\u043D\u043E\u0432\u0443 \u043D\u0430\u0431\u0443\u0445\u0430\u0432\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_104_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u044F\u043A \u0446\u0435 \u0441\u043A\u0430\u0437\u0430\u0442\u0438\u2026
        \u041A\u043E\u0440\u043D\u0456\u0439 \u043F\u043E\u043C\u0435\u0440."
    - Language: 1
      Text: 
  - Key: scene_3_104_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0435 \u041A\u043E\u0440\u043D\u0456\u0439 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0432
        \u0442\u0435\u0431\u0435 \u043D\u0430\u0431\u0440\u0430\u0442\u0438. \u0421\u0432\u0456\u0439
        \u0442\u0435\u043B\u0435\u0444\u043E\u043D \u044F \u0440\u043E\u0437\u0431\u0438\u043B\u0430,
        \u0430 \u043F\u043E\u0440\u0443\u0447 \u0431\u0443\u0432 \u0442\u0456\u043B\u044C\u043A\u0438
        \u041E\u043B\u0435\u043A\u0441\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_105_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0428\u043A\u043E\u0434\u0430\u2026 \u0410\u043B\u0435 \u0442\u0430\u043A\u0435
        \u0442\u0440\u0430\u043F\u043B\u044F\u0454\u0442\u044C\u0441\u044F. \u041C\u043E\u0457
        \u0441\u043F\u0456\u0432\u0447\u0443\u0442\u0442\u044F\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_105_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u041D\u0443, \u0430 \u0442\u0435\u043F\u0435\u0440 \u0434\u043E\u0431\u0440\u043E\u0457
        \u043D\u043E\u0447\u0456, \u0440\u0443\u0434\u0430\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_105_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0447\u0435\u043A\u0430\u044E\u0447\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F,
        \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A
        \u043F\u043E\u043A\u043B\u0430\u0432 \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443.
        \u041D\u0430 \u0436\u0430\u043B\u044C, \u044F \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0430
        \u0432\u0438\u043D\u044E\u0445\u0430\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_105_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u044F\u043A \u0432\u0456\u043D \u0442\u0430\u043C
        \u0441\u043A\u0430\u0437\u0430\u0432? \xAB\u0420\u0443\u0434\u0430\xBB?"
    - Language: 1
      Text: 
  - Key: scene_3_105_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u043C\u0443
        \u043C\u043E\u0433\u043B\u043E \u0431\u0443\u0442\u0438 \u043F\u043E\u0432\u043D\u043E
        \u0440\u0443\u0434\u0438\u0445. \u0420\u043E\u0434\u044E\u0447\u0456 \u0437\u0435\u043C\u043B\u0456,
        \u0443\u0441\u0435 \u0442\u0430\u043A\u0435\u2026 \u0410\u043B\u0435 \u044F
        \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0430\u043B\u0430 \u0442\u0456\u043B\u044C\u043A\u0438
        \u043E\u0434\u043D\u0443 \u2014 \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_105_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0430\u0440\u0442\u043E \u0431\u0443\u043B\u043E \u0437 \u043D\u0435\u044E
        \u043F\u043E\u0431\u0430\u043B\u0430\u043A\u0430\u0442\u0438. \u042F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0437\u043D\u043E\u0432\u0443
        \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0457 \u0456 \u0446\u044C\u043E\u0433\u043E
        \u0440\u0430\u0437\u0443 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043D\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_106_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0406\u043B\u043E\u043D\u043E, \u043C\u0438 \u0436 \u0434\u043E\u043C\u043E\u0432\u0438\u043B\u0438\u0441\u044C,
        \u043D\u0456\u044F\u043A\u043E\u0433\u043E \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u0443.
        \u041D\u0430\u0432\u0456\u0442\u044C \u0437 \u0456\u043D\u0448\u043E\u0433\u043E
        \u043D\u043E\u043C\u0435\u0440\u0443. \u041C\u0435\u043D\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
        \u043F\u0440\u043E\u0441\u043B\u0443\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u0456 \u0441\u043E\u0431\u0430\u043A\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_106_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u042F \u043D\u0435 \u0445\u043B\u043E\u043F\u0447\u0438\u043A \u043D\u0430
        \u043F\u043E\u0431\u0456\u0433\u0435\u043D\u044C\u043A\u0430\u0445 \u0443
        \u041A\u043E\u0440\u043D\u0456\u044F \u0456 \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F
        \u043A\u043E\u0436\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043F\u0440\u0438\u0431\u0438\u0440\u0430\u0442\u0438
        \u0437\u0430 \u043D\u0438\u043C \u043B\u0430\u0439\u043D\u043E. \u0425\u043E\u0447\u0435\u0448
        \u0449\u043E\u0441\u044C \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438
        \u2014 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E
        \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E. \u0406 \u0437\u0430\u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0439
        \u0443\u0436\u0435 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u043A\u043B\u044F\u0442\u0438\u0439
        \u043F\u0430\u0440\u043E\u043B\u044C!\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_106_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0447\u0435\u043A\u0430\u044E\u0447\u0438 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0435\u043D\u043D\u044F
        \u0441\u0443\u043F\u0435\u0440\u0435\u0447\u043A\u0438, \u0441\u043F\u0456\u0432\u0440\u043E\u0437\u043C\u043E\u0432\u043D\u0438\u043A
        \u043F\u043E\u043A\u043B\u0430\u0432 \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443.
        \u042F \u043D\u0435 \u0437\u043C\u043E\u0433\u043B\u0430 \u0432\u0438\u043D\u044E\u0445\u0430\u0442\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435, \u0430\u043B\u0435\u2026 \u0406\u043B\u043E\u043D\u0430?
        \u0426\u044E \u0434\u0456\u0432\u0447\u0438\u043D\u0443 \u044F \u0442\u043E\u0447\u043D\u043E
        \u043D\u0435 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043B\u0430
        \u0443 \u044F\u043A\u0438\u0445\u043E\u0441\u044C \u0442\u0430\u0454\u043C\u043D\u0438\u0447\u0438\u0445
        \u0437\u0432\u2019\u044F\u0437\u043A\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_106_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0430\u0440\u0442\u043E \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u0437\u043D\u043E\u0432\u0443 \u0437\u043D\u0430\u0439\u0442\u0438 \u0457\u0457
        \u0456 \u0446\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043D\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0449\u0430\u0441\u0442\u044F, \u0434\u043E\u0440\u043E\u0433\u0443
        \u0434\u043E \u0440\u043E\u0434\u043E\u0432\u0438\u0449 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u044F \u0437\u0430\u043F\u0430\u043C\u2019\u044F\u0442\u0430\u043B\u0430
        \u0434\u043E\u0431\u0440\u0435. \u041C\u0435\u043D\u0456 \u0432\u0436\u0435
        \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u0449\u043E \u0437\u0430
        \u0446\u044E \u043D\u0456\u0447 \u044F \u0432\u0438\u0432\u0447\u0438\u043B\u0430
        \u0433\u0435\u043E\u0433\u0440\u0430\u0444\u0456\u044E \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E
        \u043A\u0440\u0430\u0449\u0435 \u0437\u0430 \u0439\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u043F\u0435\u0432\u043D\u043E, \u0437\u043E\u0432\u0441\u0456\u043C
        \u043D\u0435 \u043C\u0435\u043D\u0435 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0443\u044F\u0432\u043B\u044F\u0432 \u0442\u0438\u043C, \u0445\u0442\u043E
        \u0431\u0443\u0434\u0435 \u043F\u0440\u044F\u043C\u0443\u0432\u0430\u0442\u0438
        \u0434\u043E \u0441\u0442\u043E\u0440\u043E\u0436\u043E\u0432\u043E\u0457
        \u0431\u0443\u0434\u043A\u0438 \u0437 \u0433\u043D\u0438\u043B\u043E\u0433\u043E
        \u043F\u0456\u0434\u0432\u0430\u043B\u0443 \u0432 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0456\u0439
        \u043A\u043E\u043C\u043E\u0440\u0456. \u0410\u043B\u0435 \u0436 \u0443 \u0434\u0432\u043E\u0431\u043E\u0457
        \u043F\u0435\u0440\u0435\u043C\u043E\u0436\u0435\u0446\u044C \u0431\u0443\u0432\u0430\u0454
        \u043B\u0438\u0448\u0435 \u043E\u0434\u0438\u043D, \u0432\u0456\u0440\u043D\u043E?"
    - Language: 1
      Text: 
  - Key: scene_5_112_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0444\u0430\u043D\u0435\u0440\u043D\u0438\u0439
        \u0431\u0443\u0434\u0438\u043D\u043E\u0447\u043E\u043A \u0431\u0443\u0432
        \u0434\u043E\u0431\u0440\u0435 \u0437\u0430\u0445\u043E\u0432\u0430\u043D\u0438\u0439
        \u043F\u043E\u0441\u0435\u0440\u0435\u0434 \u0434\u0435\u0440\u0435\u0432,
        \u044F\u043A\u0456 \u0434\u043E\u0432\u043E\u043B\u0456 \u0433\u0443\u0441\u0442\u043E
        \u0440\u043E\u0441\u043B\u0438 \u0443 \u0444\u043E\u0440\u043C\u0456 \u043F\u0456\u0432\u043A\u043E\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0456\u0441\u0442\u0430\u0432\u0448\u0438 \u043A\u043B\u044E\u0447\u0430,
        \u044F \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u0432\u0441\u0442\u0440\u043E\u043C\u0438\u043B\u0430
        \u0439\u043E\u0433\u043E \u0432 \u0437\u0430\u043C\u043E\u043A. \u0406\u0437
        \u0442\u0438\u0445\u0438\u043C \xAB\u043B\u044F\u0437\u0433\xBB \u0442\u043E\u0439
        \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0432\u0441\u044F \u0442\u0430
        \u0432\u043F\u0430\u0432 \u0434\u043E\u0434\u043E\u043B\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0435\u0440\u0435\u0436\u043D\u043E \u043F\u0440\u043E\u0447\u0438\u043D\u0438\u043B\u0430
        \u0434\u0432\u0435\u0440\u0456, \u044F\u043A\u0456 \u0431\u0435\u0437\u0436\u0430\u043B\u044C\u043D\u043E
        \u0441\u043A\u0440\u0438\u043F\u0456\u043B\u0438, \u0442\u0430 \u0437\u0430\u0437\u0438\u0440\u043D\u0443\u043B\u0430
        \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443 \u0431\u0443\u0434\u043A\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_112_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0417 \u0442\u0435\u043C\u0440\u044F\u0432\u0438 \u043C\u0435\u043D\u0435
        \u043E\u0434\u0440\u0430\u0437\u0443 \u0437\u0443\u0441\u0442\u0440\u0456\u0432
        \u0446\u0456\u043B\u0438\u0439 \u0431\u0443\u043A\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u0456\u0432.
        \u0417\u0430\u0441\u0442\u0438\u0433\u043B\u0438\u0439 \u043F\u0456\u0442,
        \u0441\u043C\u0430\u0436\u0435\u043D\u0430 \u043A\u043E\u0432\u0431\u0430\u0441\u0430,
        \u0441\u043F\u0440\u0435\u0439 \u0432\u0456\u0434 \u043A\u043E\u043C\u0430\u0440\u0456\u0432
        \u0456 \u043F\u0440\u043E\u0432\u043E\u0434\u043A\u0430, \u044F\u043A\u0430,
        \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0442\u0440\u043E\u0445\u0438
        \u043F\u0456\u0434\u0433\u043E\u0440\u0456\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0445, \u0447\u0430\u0440\u0456\u0432\u043D\u0435 \u0445\u043E\u043B\u043E\u0441\u0442\u044F\u0446\u044C\u043A\u0435
        \u0436\u0438\u0442\u0442\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_112_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0432\u043F\u043E\u043C\u0430\u0446\u043A\u0438 \u044F
        \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0432\u0438\u043C\u0438\u043A\u0430\u0447
        \u0456 \u043F\u0440\u0438\u0432\u043D\u0435\u0441\u043B\u0430 \u0432 \u0446\u044E
        \u043A\u0456\u043C\u043D\u0430\u0442\u0443 \u0442\u0440\u043E\u0445\u0438
        \u0441\u0432\u0456\u0442\u043B\u0430. \u042F\u043A \u044F \u0456 \u0433\u0430\u0434\u0430\u043B\u0430,
        \u0442\u0443\u0442 \u043D\u0435 \u0431\u0443\u043B\u043E \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u043E
        \u043D\u0430 \u0449\u043E \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F.
        \u0411\u0456\u043B\u044F \u0441\u0442\u0456\u043D\u0438 \u0441\u0442\u043E\u044F\u043B\u0430
        \u043A\u043E\u0439\u043A\u0430 \u0437 \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u044E
        \u043F\u043E\u043B\u0438\u0446\u0435\u044E. \u041F\u043E\u0440\u044F\u0434
        \u0456\u0437 \u043D\u0435\u044E \u0432\u0438\u0441\u0456\u0432 \u043C\u0430\u0441\u0438\u0432\u043D\u0438\u0439
        \u043F\u043E\u0441\u0440\u0456\u0431\u043B\u0435\u043D\u0438\u0439 \u0445\u0440\u0435\u0441\u0442."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0456\u043D\u0448\u043E\u043C\u0443 \u043A\u0443\u0442\u043A\u0443
        \u0440\u043E\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u0432\u0441\u044F
        \u043D\u0430\u043F\u0456\u0432\u0440\u043E\u0437\u043B\u0430\u043C\u0430\u043D\u0438\u0439
        \u0441\u0442\u0456\u043B, \u043D\u0456\u0436\u043A\u0438 \u044F\u043A\u043E\u0433\u043E
        \u0431\u0443\u043B\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u0430\u0437\u0456\u0432 \u043F\u0435\u0440\u0435\u043C\u043E\u0442\u0430\u043D\u0456
        \u0456\u0437\u043E\u0441\u0442\u0440\u0456\u0447\u043A\u043E\u044E. \u0417\u0432\u0435\u0440\u0445\u0443
        \u043D\u0430 \u043D\u044C\u043E\u043C\u0443 \u0441\u0442\u043E\u044F\u0432
        \u0433\u0440\u043E\u043C\u0456\u0437\u0434\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u2019\u044E\u0442\u0435\u0440
        \u0456\u0437 \u0437\u0443\u0431\u0447\u0430\u0441\u0442\u0438\u043C\u0438
        \u043A\u043E\u043B\u0435\u0441\u0430\u043C\u0438 \u0437 \u0431\u043E\u043A\u0456\u0432.
        \u041C\u0430\u0431\u0443\u0442\u044C, \u0446\u044F \u043C\u043E\u0434\u0435\u043B\u044C
        \u0431\u0443\u043B\u0430 \u043D\u0430\u0432\u0456\u0442\u044C \u0441\u0442\u0430\u0440\u0448\u043E\u044E
        \u0437\u0430 \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_112_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u0439\u0448\u043B\u0430 \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
        \u0431\u0443\u0434\u043A\u0438 \u0442\u0430 \u0437\u0430\u0447\u0438\u043D\u0438\u043B\u0430
        \u0434\u0432\u0435\u0440\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_112_00_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0447\u0438\u0441\u044C
        \u0448\u0432\u0438\u0434\u0448\u0435 \u0442\u0443\u0442 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u0438,
        \u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_112_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0448\u0443\u043A\u0430\u043B\u0430 \u0437\u0430\u0447\u0456\u043F\u043A\u0438
        \u0432 \u0441\u043C\u0456\u0442\u043D\u0438\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_112_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0423\u0432\u0456\u043C\u043A\u043D\u0443\u043B\u0430 \u043A\u043E\u043C\u043F\u2019\u044E\u0442\u0435\u0440."
    - Language: 1
      Text: 
  - Key: scene_5_112_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0437\u0438\u0440\u043D\u0443\u043B\u0430 \u043D\u0430
        \u043F\u043E\u043B\u0438\u0446\u044E."
    - Language: 1
      Text: 
  - Key: scene_5_112_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u043F\u043E\u0440\u043F\u0430\u043B\u0430\u0441\u044C \u0443
        \u044F\u0449\u0438\u043A\u0430\u0445 \u0441\u0442\u043E\u043B\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_112_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F \u043F\u0456\u0434
        \u0441\u0442\u043E\u043B\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_5_112_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F \u0434\u043E
        \u0441\u0456\u043B\u044C\u0441\u044C\u043A\u0438\u0445 \u0432\u0443\u043B\u0438\u0446\u044C."
    - Language: 1
      Text: 
  - Key: scene_5_113_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043D\u0438\u043B\u0456 \u0445\u0430\u0440\u0447\u0456, \u0441\u0435\u0440\u0432\u0435\u0442\u043A\u0438,
        \u043E\u0431\u0433\u043E\u0440\u0442\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_113_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0438\u0434\u043E\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_114_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0456\u0434\u0441\u0456\u043B\u0430 \u0434\u043E \u0441\u0442\u043E\u043B\u0443
        \u0442\u0430 \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u043B\u0430 \u043C\u0430\u0441\u043D\u0443
        \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u0412\u043A\u043B\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_114_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043C\u043F\u2019\u044E\u0442\u0435\u0440 \u0437\u0430\u0433\u0430\u0440\u0447\u0430\u0432,
        \u043D\u0430\u0447\u0435 \u0437\u0430\u0433\u043D\u0430\u043D\u0438\u0439
        \u0437\u0432\u0456\u0440 \u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u043C\u0443
        \u043F\u043E\u0434\u0438\u0445\u0443. \u041D\u0430 \u043C\u043E\u043D\u0456\u0442\u043E\u0440\u0456
        \u043F\u043E\u0432\u0456\u043B\u044C\u043D\u043E \u0437\u2019\u044F\u0432\u0438\u043B\u043E\u0441\u044F
        \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_114_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0442 \u0432\u0438\u043B\u0443\u043F\u043E\u043A!"
    - Language: 1
      Text: 
  - Key: scene_5_114_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043A\u0430\u0443\u043D\u0442 \xAB\u041B\u044C\u043E\u0445\u0430\xBB
        \u0431\u0443\u043B\u043E \u0437\u0430\u043F\u0430\u0440\u043E\u043B\u0435\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_5_114_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u043D\u0430\u0432\u0438\u0447\u043A\u0438
        \u0445\u0430\u043A\u0435\u0440\u043A\u0438 \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u043B\u0438
        \u0434\u043E \u043C\u043E\u0433\u043E \u043F\u043E\u0432\u0430\u0436\u043D\u043E\u0433\u043E
        \u0441\u043F\u0438\u0441\u043A\u0443 \u0442\u0430\u043B\u0430\u043D\u0442\u0456\u0432.
        \u042F \u043C\u043E\u0433\u043B\u0430 \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0445\u0456\u0431\u0430 \u0449\u043E \u043D\u0430 \u0443\u0434\u0430\u0447\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_114_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C
        \xAB1111\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_114_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0431\u043B\u0438\u0448\u0438\u0442\u0438 \u043C\u0430\u0440\u043D\u0443
        \u0441\u043F\u0440\u0430\u0432\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_114_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u043F\u0430\u0440\u043E\u043B\u044C
        \xABkrasav4ik\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_115_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u044F \u0456 \u0433\u0430\u0434\u0430\u043B\u0430, \u0443\u0434\u0430\u0447\u0456
        \u043D\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F. \u0425\u0442\u043E
        \u0431 \u0441\u0443\u043C\u043D\u0456\u0432\u0430\u0432\u0441\u044F. \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u043D\u0435 \u0431\u0443\u0432 \u0433\u0435\u043D\u0456\u0454\u043C, \u0442\u0430
        \u0432\u0441\u0435 \u0436 \u0442\u0440\u043E\u0445\u0438 \u0440\u043E\u0437\u0443\u043C\u043D\u0456\u0448\u0438\u043C
        \u0437\u0430 \u0446\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u0430\u0446\u044E\u0432\u0430\u043B\u043E!"
    - Language: 1
      Text: 
  - Key: scene_5_116_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u043E\u0436\u043D\u044E\u0432\u0430\u043B\u0430
        \u0441\u0432\u0456\u0439 \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434.
        \u042F\u043A \u0449\u0435 \u044F \u043C\u043E\u0433\u043B\u0430 \u0431 \u0442\u0430\u043A
        \u0432\u043F\u0440\u0430\u0432\u043D\u043E \u0432\u0441\u044E\u0434\u0438
        \u043F\u0445\u0430\u0442\u0438 \u0441\u0432\u043E\u0433\u043E \u0432\u0456\u043B\u044C\u0448\u0430\u043D\u044F\u0447\u043E\u0433\u043E
        \xAB\u0434\u0437\u044C\u043E\u0431\u0430\xBB, \u044F\u043A\u0431\u0438 \u043D\u0435
        \u0432\u0456\u043D?"
    - Language: 1
      Text: 
  - Key: scene_5_116_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u043D\u0430\u0442\u0445\u043D\u0435\u043D\u043D\u044F
        \u0448\u0432\u0438\u0434\u043A\u043E \u043C\u0435\u043D\u0435 \u043E\u0431\u043B\u0438\u0448\u0438\u043B\u043E.
        \u041E\u0431\u0441\u044F\u0433 \u043C\u0430\u0442\u0435\u0440\u0456\u0430\u043B\u0456\u0432,
        \u044F\u043A\u0456 \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u043D\u0430\u0440\u0438\u0432
        \u043D\u0430 \u043C\u0435\u043D\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
        \u0436\u0430\u0445\u0430\u0432. \u042F \u043D\u0430\u0432\u0456\u0442\u044C
        \u0440\u0435\u0444\u043B\u0435\u043A\u0442\u043E\u0440\u043D\u043E \u043F\u0440\u0438\u043A\u0440\u0438\u043B\u0430
        \u0440\u0443\u043A\u043E\u044E \u0440\u043E\u0442\u0430 \u2014 \u0431\u0430\u0447\u0438\u043B\u0430
        \u0442\u0430\u043A\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0432 \u043A\u0456\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0456\u043B\u044C\u0448\u0456\u0441\u0442\u044C \u0444\u0430\u0439\u043B\u0456\u0432
        \u0431\u0443\u043B\u0438 \u043E\u0434\u0440\u0430\u0437\u0443 \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0456.
        \u0417\u0456 \u0441\u0442\u0440\u0430\u0445\u043E\u043C \u044F \u043F\u0440\u043E\u043B\u0438\u0441\u0442\u0443\u0432\u0430\u043B\u0430
        \u0457\u0445 \u043E\u0434\u0438\u043D \u0437\u0430 \u043E\u0434\u043D\u0438\u043C.
        \u0423\u0441\u0435 \u043C\u043E\u0454 \u0442\u0456\u043B\u043E \u0442\u0440\u0435\u043C\u0442\u0456\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0431\u0443\u0432 \u043D\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0430\u0433\u0440\u0435\u0441\u0438\u0432\u043D\u0438\u043C
        \u0444\u0430\u043D\u0430\u0442\u0438\u043A\u043E\u043C, \u0442\u0430 \u0449\u0435
        \u0456 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C \u0441\u0442\u0430\u043B\u043A\u0435\u0440\u043E\u043C.
        \u0417\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0433\u043E\u0434\u0438\u043D
        \u0439\u043E\u043C\u0443 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F
        \u043F\u0440\u043E \u043D\u0430\u0439\u0434\u0440\u0456\u0431\u043D\u0456\u0448\u0456
        \u043F\u043E\u0434\u0440\u043E\u0431\u0438\u0446\u0456 \u043C\u043E\u0433\u043E
        \u0436\u0438\u0442\u0442\u044F, \u043D\u0456\u0431\u0438 \u0432\u0456\u043D
        \u0443\u0436\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u0442\u0430\u0432
        \u0442\u0430\u043A\u0435 \u0431\u0430\u0433\u0430\u0442\u043E \u0440\u0430\u0437\u0456\u0432.
        \u042F \u043C\u0430\u043B\u0430 \u0446\u044C\u043E\u0433\u043E \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_116_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0457 \u0444\u043E\u0442\u043E \u0447\u0430\u0441\u0456\u0432
        \u0434\u0438\u0442\u044F\u0447\u043E\u0433\u043E \u0441\u0430\u0434\u043E\u0447\u043A\u0443
        \u0456\u0437 \u043C\u0430\u043C\u0438\u043D\u043E\u0433\u043E \u0420\u0435\u043F\u0456\u0434\u0431\u0443\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0435\u043A \u043F\u0440\u043E \u043F\u043E\u043A\u0443\u043F\u043A\u0443
        \u0431\u0456\u043B\u0435\u0442\u0456\u0432, \u044F\u043A\u0456 \u044F \u0431\u0440\u0430\u043B\u0430
        \u043D\u0430 \u043B\u0456\u0442\u0430\u043A \u0443 \u0432\u0456\u0434\u043F\u0443\u0441\u0442\u043A\u0443
        \u0432 8722 \u0440\u043E\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0424\u043E\u0442\u043E \u043A\u043E\u043B\u0438\u0448\u043D\u044C\u043E\u0433\u043E
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430 \u0437 \u0439\u043E\u0433\u043E
        \u043D\u043E\u0432\u043E\u044E \u0436\u0456\u043D\u043A\u043E\u044E\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_116_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438. \u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438.
        \u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_116_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430,
        \u0442\u043E \u043B\u0435\u0434\u044C \u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043B\u0430\u0441\u044F.
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0431\u0443\u0432 \u043F\u0440\u043E\u0441\u0442\u043E
        \u043D\u0430\u0432\u0456\u0436\u0435\u043D\u0438\u043C, \u0456 \u044F \u043E\u0431\u043E\u0432\u2019\u044F\u0437\u043A\u043E\u0432\u043E
        \u043C\u0430\u043B\u0430 \u0434\u043E\u0431\u0438\u0442\u0438\u0441\u044F
        \u0439\u043E\u0433\u043E \u0430\u0440\u0435\u0448\u0442\u0443 \u043F\u0456\u0437\u043D\u0456\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_117_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0443\u0432\u0430\u0436\u043D\u043E \u0432\u0441\u0435 \u0440\u043E\u0437\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F,
        \u043F\u0440\u043E\u0442\u0435 \u043D\u0430 \u043F\u043E\u043B\u0438\u0446\u044F\u0445
        \u043D\u0435 \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u043D\u0456\u0447\u043E\u0433\u043E,
        \u043E\u043A\u0440\u0456\u043C \u043F\u0438\u043B\u044E\u043A\u0438, \u043F\u0430\u0432\u0443\u0442\u0438\u043D\u043D\u044F
        \u0442\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u0441\u0442\u0430\u0440\u0438\u0445
        \u0436\u0443\u0440\u043D\u0430\u043B\u0456\u0432 \u043F\u0440\u043E \u0440\u0438\u0431\u043E\u043B\u043E\u0432\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_5_117_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0436 \u043E\u0441\u044C \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F
        \u043D\u0435 \u0431\u0443\u0434\u044C-\u0449\u043E, \u0430 \u0446\u0456\u043B\u0430
        \u0431\u0430\u043D\u043A\u0430 \u043A\u043E\u043D\u0441\u0435\u0440\u0432\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_5_117_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0448\u043E\u043D\u043A\u0430 \u0437 \u044F\u043B\u043E\u0432\u0438\u0447\u0438\u043D\u043E\u044E\u2026
        \u041C-\u043C-\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_117_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0440\u0438\u0448\u043A\u0430 \u0437 \u0431\u0430\u043D\u043A\u0438
        \u0437\u043D\u0438\u043A\u043B\u0430 \u0431\u043B\u0438\u0441\u043A\u0430\u0432\u0438\u0447\u043D\u043E.
        \u042F \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u0440\u0443\u043A\u0430\u043C\u0438
        \u0434\u0456\u0441\u0442\u0430\u0432\u0430\u043B\u0430 \u043A\u0430\u0448\u0443
        \u0437 \u0442\u0430\u0440\u0438 \u0439 \u0442\u044F\u0433\u043D\u0443\u043B\u0430
        \u0434\u043E \u0440\u043E\u0442\u0430, \u0449\u0435 \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043D\u0443\u0432\u0448\u0438
        \u043F\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438 \u043C\u0438\u043D\u0443\u043B\u0443
        \u043F\u043E\u0440\u0446\u0456\u044E."
    - Language: 1
      Text: 
  - Key: scene_5_117_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u044F \u043D\u0456\u0447 \u0437\u043E\u0432\u0441\u0456\u043C
        \u043C\u0435\u043D\u0435 \u0437\u043D\u0435\u0441\u0438\u043B\u0438\u043B\u0430,
        \u0442\u043E\u0436 \u044F\u043A\u043E\u044E \u0431 \u0433\u0438\u0434\u043E\u0442\u043D\u043E\u044E
        \u043D\u0435 \u0431\u0443\u043B\u0430 \u0457\u0436\u0430 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456,
        \u0443 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0432\u043E\u043D\u0430
        \u0437\u0434\u0430\u043B\u0430\u0441\u044F \u043C\u0435\u043D\u0456 \u043D\u0430\u0441\u043E\u043B\u043E\u0434\u043E\u044E
        \u0415\u0434\u0435\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_117_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430 \u0435\u043B\u0456\u0442\u043D\u0443
        \u0442\u0440\u0430\u043F\u0435\u0437\u0443 \u0456 \u0432\u0438\u0442\u0435\u0440\u043B\u0430
        \u0440\u0443\u043A\u0438 \u043E\u0431 \u043F\u0440\u043E\u0441\u0442\u0438\u0440\u0430\u0434\u043B\u043E
        \u043D\u0430 \u043B\u0456\u0436\u043A\u0443. \u041D\u0435 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430,
        \u0449\u043E \u0456\u0437 \u0446\u044C\u043E\u0433\u043E \u0431\u0443\u043B\u043E
        \u0431\u0440\u0443\u0434\u043D\u0456\u0448\u0435\u2026 \u041F\u043E\u0442\u0456\u043C
        \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u0442\u0438
        \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_118_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u044F \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u043B\u0430
        \u043B\u0438\u0448\u0435 \u043D\u0430 \u0443\u0441\u0456\u043B\u044F\u043A\u0438\u0439
        \u043C\u043E\u0442\u043B\u043E\u0445. \u041D\u0430\u0439\u0431\u0456\u043B\u044C\u0448\u0435
        \u0437 \u043D\u044C\u043E\u0433\u043E \u0432\u0438\u0434\u0456\u043B\u044F\u043B\u0430\u0441\u044F
        \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u0430 \u043F\u0430\u0447\u043A\u0430
        \u043F\u0440\u0435\u0437\u0435\u0440\u0432\u0430\u0442\u0438\u0432\u0456\u0432
        \xAB\u0429\u0443\u043A\u0430\xBB, \u0442\u0430 \u0432\u043E\u043D\u0438 \u043D\u0456\u044F\u043A
        \u043D\u0435 \u0441\u0442\u043E\u0441\u0443\u0432\u0430\u043B\u0438\u0441\u044F
        \u043C\u043E\u0433\u043E \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434 \u0441\u0442\u043E\u043B\u043E\u043C \u0432\u0438\u044F\u0432\u0438\u043B\u0430\u0441\u044F
        \u0432\u0435\u043B\u0438\u043A\u0430 \u0447\u043E\u0440\u043D\u0430 \u043A\u0443\u043F\u0430
        \u043F\u043E\u043F\u0435\u043B\u0443. \u0421\u0445\u043E\u0436\u0435 \u041E\u043B\u0435\u043A\u0441\u0456\u0439
        \u0449\u043E\u0441\u044C \u0441\u043F\u0430\u043B\u0438\u0432 \u043F\u0440\u044F\u043C\u043E
        \u0442\u0443\u0442, \u0434\u043E \u0442\u043E\u0433\u043E \u0436 \u0437\u043E\u0432\u0441\u0456\u043C
        \u043D\u0435\u0434\u0430\u0432\u043D\u043E, \u0430 \u043F\u043E\u0442\u0456\u043C
        \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F \u043D\u0435\u0430\u043A\u0443\u0440\u0430\u0442\u043D\u043E
        \u0446\u0435 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0440\u043E\u0441\u0442\u044F\u0433\u043D\u0443\u043B\u0430
        \u0440\u0443\u043A\u0438 \u0432\u043F\u0435\u0440\u0435\u0434 \u0442\u0430
        \u043F\u043E\u0447\u0430\u043B\u0430 \u0440\u043E\u0437\u0433\u0440\u0456\u0431\u0430\u0442\u0438
        \u043F\u043E\u043F\u0456\u043B. \u0414\u043E\u043B\u043E\u043D\u0456 \u043C\u0438\u0442\u0442\u0454\u0432\u043E
        \u043F\u043E\u0447\u043E\u0440\u043D\u0456\u043B\u0438, \u0456 \u044F \u0441\u0442\u0430\u043B\u0430
        \u0441\u0445\u043E\u0436\u0430 \u043D\u0430 \u043A\u043E\u0447\u0435\u0433\u0430\u0440\u0430.
        \u041F\u0440\u043E\u0442\u0435 \u043C\u0435\u043D\u0435 \u0446\u0435 \u043D\u0435
        \u0445\u0432\u0438\u043B\u044E\u0432\u0430\u043B\u043E, \u0430\u0434\u0436\u0435
        \u0449\u043E\u0441\u044C \u043F\u0456\u0434\u043A\u0430\u0437\u0443\u0432\u0430\u043B\u043E,
        \u0449\u043E \u044F \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u043B\u0430
        \u043D\u0430 \u043D\u0430\u0439\u0432\u0430\u0436\u043B\u0438\u0432\u0456\u0448\u0443
        \u0437\u0430\u0447\u0456\u043F\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417 \u043C\u0430\u0441\u0438\u0432\u0443 \u0441\u0456\u0440\u043E\u0457
        \u0437\u043E\u043B\u0438, \u044F\u043A\u0430 \u043D\u0430\u0432\u0441\u0456\u0431\u0456\u0447
        \u0440\u043E\u0437\u043B\u0456\u0442\u0430\u043B\u0430\u0441\u044F \u043F\u0456\u0434
        \u0441\u0442\u043E\u043B\u043E\u043C, \u043C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0432\u0446\u0456\u043B\u0456\u043B\u0438\u0445 \u043F\u0430\u043F\u0456\u0440\u0446\u0456\u0432,
        \u044F\u043A\u0456 \u043F\u0435\u0440\u0435\u0436\u0438\u043B\u0438 \xAB\u043A\u0430\u0440\u0443
        \u0432\u043E\u0433\u043D\u0435\u043C\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u0440\u043E\u0437\u0433\u043B\u044F\u043D\u0443\u043B\u0430
        \u0457\u0445 \u0431\u043B\u0438\u0436\u0447\u0435, \u0442\u043E \u0441\u0442\u0430\u043B\u043E
        \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u043E, \u0449\u043E \u0446\u0435
        \u0431\u0443\u043B\u0438 \u0441\u0442\u043E\u0440\u0456\u043D\u043A\u0438
        \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A\u0430, \u0430\u0431\u043E
        \u0440\u0430\u0434\u0448\u0435 \u0434\u0456\u043B\u043E\u0432\u043E\u0457
        \u043A\u043D\u0438\u0436\u043A\u0438, \u0442\u0430 \u0432\u0456\u0434 \u043D\u0435\u0457
        \u043C\u0430\u0439\u0436\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
        \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044C. \u042F \u0448\u0432\u0438\u0434\u043A\u043E
        \u0457\u0457 \u043F\u0440\u043E\u0433\u043E\u0440\u043D\u0443\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0425\u0432\u043E\u0439\u043D\u0438\u0439 \u2014 4 \u043A\u0433\xBB.
        \xAB\u0414\u0443\u0431\u0435\u043D\u044C \u2014 6 \u043A\u0433\xBB. \xAB\u0413\u0456\u043B\u043A\u043E\u0441\u0442\u0456\u0439
        \u2014 1,5 \u043A\u0433. \u0426\u044C\u043E\u0433\u043E \u043C\u0456\u0441\u044F\u0446\u044F
        \u0440\u043E\u0431\u043E\u0442\u0430 \u0439\u0448\u043B\u0430 \u0434\u0443\u0436\u0435
        \u043F\u043E\u0433\u0430\u043D\u043E\xBB. \u0426\u0435 \u0432\u0456\u0434\u043C\u0456\u0442\u043A\u0438
        \u043F\u0440\u043E \u0431\u0443\u0440\u0448\u0442\u0438\u043D!"
    - Language: 1
      Text: 
  - Key: scene_5_119_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u043F\u0430\u0437\u043B\u0438\u043A
        \u0443 \u0433\u043E\u043B\u043E\u0432\u0456 \u043F\u043E\u0432\u043E\u043B\u0456
        \u0441\u043A\u043B\u0430\u0434\u0430\u0432\u0441\u044F. \u0428\u0432\u0438\u0434\u0448\u0435
        \u0437\u0430 \u0432\u0441\u0435, \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A
        \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u041A\u043E\u0440\u043D\u0456\u044E.
        \u041E\u0442\u0436\u0435, \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0437\u043D\u0430\u0432
        \u043F\u0440\u043E \u0439\u043E\u0433\u043E \u043D\u0435\u043B\u0435\u0433\u0430\u043B\u044C\u043D\u0443
        \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C, \u043F\u0440\u043E\u0442\u0435
        \u0445\u043E\u0442\u0456\u0432 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438
        \u0446\u0435\u0439 \u0441\u0435\u043A\u0440\u0435\u0442."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u0435, \u043D\u0430\u0432\u0456\u0442\u044C \xAB\u043E\u0447\u0438\u0441\u0442\u0438\u0442\u0438
        \u041A\u043E\u0440\u043D\u0456\u044F \u0432 \u0431\u043E\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u043C\u0443
        \u043F\u043E\u043B\u0443\u043C\u2019\u0457\xBB, \u0437\u0432\u0430\u0436\u0430\u044E\u0447\u0438
        \u043D\u0430 \u0439\u043E\u0433\u043E \u0434\u043E\u0432\u0431\u0430\u043D\u0443\u0442\u0456\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0441\u0456\u043B\u0430\u0441\u044F \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0443
        \u0431\u0456\u043B\u044F \u0441\u0442\u043E\u043B\u0443 \u0442\u0430 \u043F\u043E\u0447\u0430\u043B\u0430
        \u0432\u0438\u0432\u0447\u0430\u0442\u0438 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A
        \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0443\u0432\u0430\u0436\u043D\u0456\u0448\u0435.
        \u041D\u0430 \u0436\u0430\u043B\u044C, \u0443\u0441\u0456 \u0456\u043C\u0435\u043D\u0430
        \u0432 \u043D\u044C\u043E\u043C\u0443 \u0431\u0443\u043B\u043E \u0437\u0430\u043C\u0456\u043D\u0435\u043D\u043E
        \u043D\u0430 \u043A\u043E\u0434\u043E\u0432\u0456 \u043F\u0440\u0456\u0437\u0432\u0438\u0441\u044C\u043A\u0430.
        \xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430\xBB \u0432\u043F\u0438\u0441\u0430\u043B\u0430\u0441\u044F
        \u0431 \u0441\u0435\u0440\u0435\u0434 \u043D\u0438\u0445 \u044F\u043A \u0441\u0432\u043E\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u041A\u043E\u0440\u043D\u0456\u0439
        \u043C\u0430\u0432 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E\u0433\u043E
        \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u0430 \u043D\u0430 \u043F\u0440\u0456\u0437\u0432\u0438\u0441\u044C\u043A\u043E
        \xAB\u0414\u0436\u043C\u0456\u043B\u044C\xBB. \u0426\u044F \u043B\u044E\u0434\u0438\u043D\u0430-\u043A\u043E\u043C\u0430\u0445\u0430
        \u0434\u043E\u043F\u043E\u043C\u0430\u0433\u0430\u043B\u0430 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0443
        \u0440\u043E\u0437\u0432'\u044F\u0437\u0443\u0432\u0430\u0442\u0438 \u043F\u0438\u0442\u0430\u043D\u043D\u044F
        \u044E\u0440\u0438\u0434\u0438\u0447\u043D\u043E\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0443
        \u0442\u0430 \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0443\u0432\u0430\u043B\u0430
        \u043F\u0440\u0438\u043A\u0440\u0438\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0437\u043D\u0430\u0447\u0438\u0442\u044C, \u0446\u0435 \u043C\u0430\u0432
        \u0431\u0443\u0442\u0438 \u0445\u0442\u043E\u0441\u044C \u0434\u0443\u0436\u0435
        \u0440\u043E\u0437\u0443\u043C\u043D\u0438\u0439 \u0442\u0430 \u043E\u0441\u0432\u0456\u0447\u0435\u043D\u0438\u0439.
        \u041D\u0430\u0432\u0440\u044F\u0434 \u0447\u0438 \u043C\u043E\u0432\u0430
        \u043F\u0440\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_119_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0456\u043C\u0438 \u0434\u043D\u044F\u043C\u0438
        \u041A\u043E\u0440\u043D\u0456\u0439 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u0432,
        \u0449\u043E \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A \u043F\u0440\u0438\u0432\u043B\u0430\u0441\u043D\u0438\u0432
        \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043E\u0433\u043E
        \u043C\u0456\u043D\u0435\u0440\u0430\u043B\u0443 \u0441\u043E\u0431\u0456
        \u0439 \u0445\u043E\u0442\u0456\u0432 \u0437\u0431\u0443\u0442\u0438 \u0441\u0430\u043C\u043E\u0441\u0442\u0456\u0439\u043D\u043E,
        \u0449\u043E\u0431\u0438 \u0434\u043E\u0431\u0440\u044F\u0447\u0435 \u043D\u0430\u0432\u0430\u0440\u0438\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A\u0443 \u0447\u043E\u043B\u043E\u0432\u0456\u043A
        \u043D\u0430\u0432\u0456\u0442\u044C \u0440\u043E\u0431\u0438\u0432 \u043F\u0440\u0438\u043F\u0443\u0449\u0435\u043D\u043D\u044F,
        \u0449\u043E \u0437\u0430\u0445\u043E\u0432\u0430\u0442\u0438 \u0432\u0435\u043B\u0438\u043A\u0443
        \u043F\u0430\u0440\u0442\u0456\u044E \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0414\u0436\u043C\u0435\u043B\u044E \u0434\u043E\u043F\u043E\u043C\u0456\u0433
        \u0445\u0442\u043E\u0441\u044C \u043D\u0430 \u043F\u0440\u0456\u0437\u0432\u0438\u0441\u044C\u043A\u043E
        \xAB\u0420\u043E\u0437\u0431\u0438\u0442\u0438\u0439 \u043C\u0456\u0441\u044F\u0446\u044C\xBB."
    - Language: 1
      Text: 
  - Key: scene_5_119_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u0432\u0438\u0434\u0448\u0435 \u0437\u0430 \u0432\u0441\u0435,
        \u0414\u0436\u043C\u0456\u043B\u044C \u043F\u043E\u0433\u043E\u0434\u0436\u0443\u0432\u0430\u0432\u0441\u044F
        \u043D\u0430 \u043F\u043E\u0441\u043B\u0443\u0433\u0443 \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
        \u0434\u043B\u044F \u0420\u043E\u0437\u0431\u0438\u0442\u043E\u0433\u043E
        \u043C\u0456\u0441\u044F\u0446\u044F. \u041A\u043E\u0440\u043D\u0456\u0439
        \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u0432, \u0449\u043E
        \u0439\u043E\u0433\u043E \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A
        \u043C\u0430\u0432 \u0434\u0456\u0441\u0442\u0430\u0442\u0438 \u0434\u043B\u044F
        \u0446\u0456\u0454\u0457 \u043B\u044E\u0434\u0438\u043D\u0438 \u044F\u043A\u0456\u0441\u044C
        \u043D\u0430\u0440\u043A\u043E\u0442\u0438\u0447\u043D\u0456 \u0437\u043D\u0435\u0431\u043E\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0456
        \u0440\u0435\u0447\u043E\u0432\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u0435\u0441\u0442\u0435\u0440\u043D\u0456 \u0432 \u043C\u043E\u0457\u0439
        \u0433\u043E\u043B\u043E\u0432\u0456 \u043A\u0440\u0443\u0442\u0438\u043B\u0438\u0441\u044F
        \u0442\u0430 \u0441\u043A\u0440\u0435\u0433\u043E\u0442\u0430\u043B\u0438.
        \u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u043F\u043E\u0442\u0440\u043E\u0445\u0443
        \u0432\u0438\u043C\u0430\u043B\u044C\u043E\u0432\u0443\u0432\u0430\u043B\u0430\u0441\u044F.
        \u042F \u0437\u0430\u043F\u0430\u043B\u0438\u043B\u0430 \u0446\u0438\u0433\u0430\u0440\u043A\u0443
        \u0442\u0430 \u0437\u0430\u043D\u0443\u0440\u0438\u043B\u0430\u0441\u044F
        \u0432 \u0440\u043E\u0437\u0434\u0443\u043C\u0438, \u0449\u043E\u0431 \u0443\u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0442\u0438
        \u0432\u0456\u0434\u043E\u043C\u0456 \u043C\u0435\u043D\u0456 \u0444\u0430\u043A\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u043C\u043E\u0433\u043B\u043E
        \u0441\u0442\u0430\u0442\u0438\u0441\u044F \u043F\u0456\u0441\u043B\u044F
        \u0442\u043E\u0433\u043E, \u044F\u043A \u041A\u043E\u0440\u043D\u0456\u0439
        \u043F\u043E\u0441\u0432\u0430\u0440\u0438\u0432\u0441\u044F \u0437\u0456
        \u0441\u0432\u043E\u0457\u043C \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u043E\u043C.
        \u0422\u043E\u0439 \u043C\u0430\u0432 \u0434\u043E\u0432\u0433\u043E \u043E\u0431\u0434\u0443\u043C\u0443\u0432\u0430\u0442\u0438
        \u0437\u043B\u043E\u0447\u0438\u043D, \u0430\u0434\u0436\u0435 \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043D\u044F
        \u0431\u0443\u043B\u043E \u0445\u043E\u0447 \u0456 \u043D\u0435 \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u0439\u043D\u0435,
        \u043F\u0440\u043E\u0442\u0435 \u0439 \u043D\u0435 \u0433\u0430\u0440\u044F\u0447\u043A\u043E\u0432\u0435."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0431\u0438\u0432\u0446\u044F \u0437\u0430\u043C\u0430\u043D\u0438\u0432
        \u0436\u0435\u0440\u0442\u0432\u0443 \u0434\u043E \u043E\u0437\u0435\u0440\u0430.
        \u0412\u0435\u0440\u0441\u0456\u044F \u0437 \u043D\u0430\u043F\u0430\u0440\u043D\u0438\u043A\u043E\u043C
        \u043F\u043E\u044F\u0441\u043D\u044E\u0432\u0430\u043B\u0430, \u0447\u043E\u043C\u0443
        \u041A\u043E\u0440\u043D\u0456\u0439 \u043F\u0456\u0448\u043E\u0432 \u0437\u0430
        \u043D\u0438\u043C \u0434\u043E\u0431\u0440\u043E\u0432\u0456\u043B\u044C\u043D\u043E.
        \u0414\u043E \u0442\u043E\u0433\u043E \u0436 \u0446\u044F \u043B\u043E\u043A\u0430\u0446\u0456\u044F
        \u0447\u0443\u0434\u043E\u0432\u043E \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u043B\u0430,
        \u0430\u0431\u0438 \u0437\u0430\u043C\u0430\u0441\u043A\u0443\u0432\u0430\u0442\u0438
        \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u043F\u0456\u0434 \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u0435
        \u0443\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u044F \u0430\u0431\u043E
        \u0441\u0430\u043C\u043E\u0433\u0443\u0431\u0441\u0442\u0432\u043E."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0445\u0442\u043E \u0436 \u0431\u0443\u0432 \u0446\u0435\u0439
        \xAB\u0414\u0436\u043C\u0456\u043B\u044C\xBB? \u041E\u043B\u0435\u043A\u0441\u0456\u0439,
        \u0434\u043E\u0431\u0440\u0438\u0439 \u0434\u0440\u0443\u0433 \u041A\u043E\u0440\u043D\u0456\u044F,
        \u044F\u043A\u0438\u0439 \u043F\u043E\u043A\u0440\u0438\u0432\u0430\u0432
        \u0439\u043E\u0433\u043E \u0434\u0456\u044F\u043B\u044C\u043D\u0456\u0441\u0442\u044C
        \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430\u0445? \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0432\u0456\u043D \u043D\u0430\u043F\u0430\u0432 \u043D\u0430 \u043C\u0435\u043D\u0435,
        \u0449\u043E\u0431 \u044F \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
        \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F \u043F\u0440\u0430\u0432\u0434\u0438?"
    - Language: 1
      Text: 
  - Key: scene_5_120_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0438, \u043C\u043E\u0436\u0435, \u0446\u0435 \u0431\u0443\u0432
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441? \u0406\u043D\u043E\u0434\u0456
        \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439 \u0441\u043F\u043E\u0441\u0456\u0431
        \u0441\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u2014 \u0437\u0430\u043B\u0438\u0448\u0430\u0442\u0438\u0441\u044F
        \u0443 \u0432\u0441\u0456\u0445 \u043D\u0430 \u0432\u0438\u0434\u043D\u043E\u0442\u0456.
        \u0406 \u0432\u0434\u0430\u0432\u0430\u0442\u0438, \u0449\u043E \u0442\u0438
        \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E
        \u0437\u043D\u0430\u0439\u0448\u043E\u0432 \u0442\u0456\u043B\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_120_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0440\u0438\u0432\u0430\u0439\u0442\u0435-\u043D\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_5_120_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0433\u043E\u043B\u043E\u0432\u0456 \u044F \u0437\u043D\u043E\u0432\u0443
        \u0432\u0438\u043C\u0430\u043B\u044E\u0432\u0430\u043B\u0430 \u043F\u0435\u0440\u0435\u0434
        \u0441\u043E\u0431\u043E\u044E \u043E\u0431\u0440\u0430\u0437 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0433\u0440\u0430\u0431\u0430\u0440\u044F. \u041F\u043E\u0436\u043E\u0432\u043A\u043B\u0438\u0439
        \u0431\u0456\u043B\u043E\u043A \u043E\u0447\u0435\u0439. \u041D\u0435\u0434\u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0430
        \u0431\u043E\u0440\u043E\u0434\u0430. \u0427\u0435\u0440\u0432\u043E\u043D\u0430
        \u0441\u043E\u0440\u043E\u0447\u043A\u0430, \u044F\u043A\u0430 \u0432\u0438\u0446\u0432\u0456\u043B\u0430
        \u0442\u0430\u043A \u0441\u0438\u043B\u044C\u043D\u043E, \u0449\u043E \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044F
        \u043D\u0430 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0443."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u0434\u0430\u043B\u044C\u0439\u043E\u043D \u0443 \u0444\u043E\u0440\u043C\u0456
        \u043F\u0456\u0432\u043C\u0456\u0441\u044F\u0446\u044F."
    - Language: 1
      Text: 
  - Key: scene_5_120_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0432\u043E\u043D\u043E!"
    - Language: 1
      Text: 
  - Key: scene_5_120_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0420\u043E\u0437\u0431\u0438\u0442\u0438\u0439 \u043C\u0456\u0441\u044F\u0446\u044C\xBB
        \u0456\u0437 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A\u0430 \u041A\u043E\u0440\u043D\u0456\u044F!
        \u041C\u043E\u0432\u0430 \u0442\u043E\u0447\u043D\u043E \u0431\u0443\u043B\u0430
        \u043F\u0440\u043E \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430! \u0420\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F
        \u043D\u0435\u043C\u0438\u043D\u0443\u0447\u0435 \u0432\u0435\u043B\u043E
        \u0434\u043E \u043D\u043E\u0432\u043E\u0457 \u0437\u0443\u0441\u0442\u0440\u0456\u0447\u0456
        \u0437 \u0433\u0440\u0430\u0431\u0430\u0440\u0435\u043C. \u042F \u043C\u0430\u043B\u0430
        \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0440\u043E \u0449\u043E \u0437
        \u043D\u0438\u043C \u043F\u043E\u0442\u0435\u0440\u0435\u0432\u0435\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_122_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u043F\u043E\u0432\u0435\u0440\u0442\u0430\u043B\u0430\u0441\u044F
        \u043D\u0430\u0437\u0430\u0434 \u0443 \u0431\u0456\u043A \u043B\u0456\u0441\u0443,
        \u0434\u0435 \u0432\u0441\u0435 \u0446\u0435 \u0439 \u0440\u043E\u0437\u043F\u043E\u0447\u0430\u043B\u043E\u0441\u044F,
        \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F,
        \u043D\u0456\u0431\u0438 \u043C\u0438\u043D\u0443\u043B\u043E \u0432\u0436\u0435
        \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u043E\u043A\u0456\u0432 \u0437
        \u0442\u043E\u0433\u043E \u0447\u0430\u0441\u0443 \u044F\u043A \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0441\u044F
        \u0440\u043E\u0437\u0433\u0430\u0434\u0430\u0442\u0438 \u0445\u0438\u043C\u0435\u0440\u043D\u0456
        \u0442\u0430\u0454\u043C\u043D\u0438\u0446\u0456 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_122_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0442\u0430\u043C, \u043D\u0430 \u043C\u0456\u0441\u0446\u0456
        \u0430\u0432\u0430\u0440\u0456\u0457 \u0432 \u043B\u0456\u0441\u0456, \u0447\u0430\u0441
        \u043D\u0430\u0447\u0435 \u0437\u0430\u0432\u043C\u0435\u0440. \u042F \u0431\u0438
        \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u0438,
        \u0449\u043E \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u043B\u0430 \u0434\u043E
        \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u0447\u0438\u0441\u0442\u0438\u043B\u0438\u0449\u0430,
        \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u043E\u0433\u043E \u0446\u0438\u043A\u043B\u0443,
        \u044F\u043A\u0431\u0438 \u0442\u0430\u043A \u0434\u043E\u0431\u0440\u0435
        \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430 \u2014 \u0446\u0435
        \u0440\u0435\u0430\u043B\u044C\u043D\u0435 \u0436\u0438\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_122_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u043D\u0430\u0431\u043B\u0438\u0437\u0438\u043B\u0430\u0441\u044F,
        \u0442\u043E \u043F\u043E\u043C\u0456\u0442\u0438\u043B\u0430, \u0449\u043E
        \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u043C\u043E\u0454\u0457
        \u0430\u0432\u0442\u0456\u0432\u043A\u0438 \u0431\u0443\u043B\u043E \u0437\u0430\u043F\u0430\u043B\u0435\u043D\u0435
        \u0441\u0432\u0456\u0442\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_122_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043E\u0441\u043F\u043E\u0434\u0438, \u044F\u043A\u0449\u043E
        \u0446\u0435 \u044F\u043A\u0438\u0439\u0441\u044C \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u0438\u0439
        \u0430\u0432\u0442\u043E\u0432\u0438\u043A\u0440\u0430\u0434\u0430\u0447,
        \u0442\u043E \u0439\u043E\u043C\u0443 \u0432 \u0436\u0438\u0442\u0442\u0456
        \u0449\u0430\u0441\u0442\u0438\u0442\u044C \u0449\u0435 \u043C\u0435\u043D\u0448\u0435,
        \u043D\u0456\u0436 \u043C\u0435\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_122_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0435\u0439, \u0445\u0442\u043E \u0442\u0430\u043C? \u041F\u043E\u043A\u0430\u0436\u0456\u0442\u044C\u0441\u044F!"
    - Language: 1
      Text: 
  - Key: scene_1_123_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0446\u0435 \u0431\u0443\u043B\u0430
        \u043B\u0438\u0448\u0435 \u0406\u043B\u043E\u043D\u0430. \u0414\u0456\u0432\u0447\u0438\u043D\u0430
        \u043A\u0443\u0442\u0430\u043B\u0430\u0441\u044F \u0432 \u043A\u0443\u0440\u0442\u043A\u0443,
        \u044F\u043A \u0442\u0456\u043B\u044C\u043A\u0438 \u043C\u043E\u0433\u043B\u0430,
        \u0456 \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u043D\u0435
        \u043D\u0430\u0434\u0442\u043E \u0442\u0440\u0435\u043C\u0442\u0456\u0442\u0438
        \u0432\u0456\u0434 \u0445\u043E\u043B\u043E\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_123_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041E, \u0432\u0438 \u0442\u0430\u043A \u0448\u0432\u0438\u0434\u043A\u043E
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044F\u2026
        \u041F\u0440\u043E\u0431\u0430\u0447\u0442\u0435, \u0449\u043E \u0437\u0430\u043B\u0456\u0437\u043B\u0430
        \u0443 \u0432\u0430\u0448\u0435 \u0430\u0432\u0442\u043E \u0431\u0435\u0437
        \u0434\u043E\u0437\u0432\u043E\u043B\u0443. \u0414\u0432\u0435\u0440\u0456
        \u0431\u0443\u043B\u0438 \u0432\u0456\u0434\u0447\u0438\u043D\u0435\u043D\u0456,
        \u0442\u043E\u0436 \u044F\u2026 \u0420\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u0435,
        \u044F \u0442\u0430\u043A \u0456 \u043D\u0435 \u043F\u0456\u0439\u043C\u0430\u043B\u0430
        \u0436\u043E\u0434\u043D\u043E\u0457 \u043F\u043E\u043F\u0443\u0442\u043A\u0438,
        \u0442\u043E\u043C\u0443 \u043C\u0435\u043D\u0456 \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F
        \u0445\u043E\u0447 \u044F\u043A\u043E\u0441\u044C \u0437\u0456\u0433\u0440\u0456\u0442\u0438\u0441\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_123_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0456\u0431\u0438-\u0442\u043E \u0437\u0430\u0447\u0438\u043D\u044F\u043B\u0430
        \u0434\u0432\u0435\u0440\u0456. \u041F\u0440\u043E\u0432\u0430\u043B\u0438
        \u0432 \u043F\u0430\u043C\u2019\u044F\u0442\u0456 \u0432 \u043C\u0435\u043D\u0435
        \u0449\u0435 \u0442\u0440\u0430\u043F\u043B\u044F\u0442\u0438\u0441\u044F
        \u043D\u0435 \u043F\u043E\u0447\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_123_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0445, \u0430\u043B\u0435 \u0436\u2026 \u041D\u0430\u043F\u0435\u0432\u043D\u043E,
        \u0437\u0430\u043C\u043E\u043A \u043F\u043E\u0448\u043A\u043E\u0434\u0438\u0432\u0441\u044F
        \u043F\u0456\u0434 \u0447\u0430\u0441 \u0430\u0432\u0430\u0440\u0456\u0457.
        \u0422\u0430 \u0432\u0438 \u0436 \u0431\u0430\u0447\u0438\u0442\u0435, \u044F
        \u043D\u0435 \u044F\u043A\u0430\u0441\u044C \u0437\u043B\u043E\u043C\u043D\u0438\u0446\u044F,
        \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430\u0441\u044F
        \u0448\u0430\u043D\u0441\u043E\u043C. \u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F,
        \u0432\u0438 \u043D\u0435 \u043E\u0431\u0440\u0430\u0436\u0430\u0454\u0442\u0435\u0441\u044C,
        \u043F\u0430\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_123_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0442\u0430\u043A \u043F\u0440\u043E\u0441\u0442\u043E
        \u0437\u0430\u043B\u0430\u0437\u0438\u0442\u0438 \u0432 \u043F\u043E\u043B\u0456\u0446\u0435\u0439\u0441\u044C\u043A\u0443
        \u043C\u0430\u0448\u0438\u043D\u0443. \u0410\u043B\u0435 \u043F\u0440\u043E\u043F\u043E\u043D\u0443\u044E
        \u0441\u0432\u0456\u0439 \u0436\u0430\u043A\u0435\u0442, \u0432\u0456\u043D
        \u0434\u043E\u0432\u043E\u043B\u0456 \u0442\u0435\u043F\u043B\u0438\u0439."
    - Language: 1
      Text: 
  - Key: scene_1_123_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043F\u043E\u0447\u0438\u0432\u0430\u0439 \u0441\u043E\u0431\u0456
        \u043D\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F. \u041D\u0456\u0447\u043E\u0433\u043E
        \u0432\u0430\u0436\u043B\u0438\u0432\u043E\u0433\u043E \u0442\u0430\u043C
        \u043D\u0435 \u043B\u0438\u0448\u0438\u043B\u043E\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_123_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043B\u0456\u0437\u044C
        \u0443 \u0447\u0443\u0436\u0456 \u043C\u0430\u0448\u0438\u043D\u0438 \u0431\u0435\u0437
        \u0434\u043E\u0437\u0432\u043E\u043B\u0443. \u042F\u043A\u0449\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E,
        \u0454 \u0432\u0430\u0440\u0456\u0430\u043D\u0442 \u043F\u043E\u0442\u0430\u043D\u0446\u044E\u0432\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_124_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u044F\u043A\u0443\u044E \u0432\u0430\u043C! \u0410\u043B\u0435
        \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044E\u0441\u044F. \u0411\u043E
        \u043F\u0430\u043D\u0456 \u0441\u043B\u0456\u0434\u0447\u0456\u0439 \u0432\u0456\u043D
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0456\u0448\u0438\u0439 \u2014
        \u0432\u0456\u0434 \u0432\u0430\u0441 \u0437\u0430\u043B\u0435\u0436\u0438\u0442\u044C
        \u0434\u043E\u0431\u0440\u043E\u0431\u0443\u0442 \u043D\u0430\u0448\u043E\u0433\u043E
        \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_125_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u0447\u043E\u043C\u0443 \u0432\u0438 \u0442\u0430\u043A
        \u0448\u0432\u0438\u0434\u043A\u043E \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044F?"
    - Language: 1
      Text: 
  - Key: scene_1_125_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u044F \u043F\u0440\u0438\u0439\u0448\u043B\u0430
        \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437 \u0442\u043E\u0431\u043E\u044E
        \u0449\u043E\u0434\u043E \u043C\u043E\u0433\u043E \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_125_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F?
        \u0417 \u041A\u043E\u0440\u043D\u0456\u0454\u043C \u0441\u0442\u0430\u043B\u043E\u0441\u044F
        \u0449\u043E\u0441\u044C \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
        \u043F\u043E\u0433\u0430\u043D\u0435? \u0421\u0435\u043B\u043E\u043C \u0445\u043E\u0434\u0438\u043B\u0438
        \u0442\u0456\u043B\u044C\u043A\u0438 \u0447\u0443\u0442\u043A\u0438, \u0449\u043E
        \u0432\u0456\u043D \u0432\u0438\u043F\u0430\u0434\u043A\u043E\u0432\u043E\u2026
        \u041D\u0443, \u0437\u043D\u0430\u0454\u0442\u0435, \u0432\u0442\u043E\u043F\u0438\u0432\u0441\u044F
        \u0432 \u043E\u0437\u0435\u0440\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_125_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u0446\u044F \u0432\u0435\u0440\u0441\u0456\u044F
        \u043C\u0435\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u0430. \u0410\u043B\u0435
        \u044F \u0434\u043E \u043D\u0435\u0457 \u043D\u0435 \u0441\u0445\u0438\u043B\u044C\u043D\u0430.
        \u0429\u043E\u0431 \u0441\u043A\u043B\u0430\u0441\u0442\u0438 \u0434\u043E\u0441\u0438\u0442\u044C
        \u043E\u0431\u0491\u0440\u0443\u043D\u0442\u043E\u0432\u0430\u043D\u0443
        \u0456\u043D\u0448\u0443, \u043C\u0435\u043D\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044C \u0431\u0456\u043B\u044C\u0448\u0435
        \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u0457. \u0422\u043E\u043C\u0443
        \u044F \u0445\u043E\u0447\u0443 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u0438
        \u0442\u043E\u0431\u0456 \u043A\u0456\u043B\u044C\u043A\u0430 \u0437\u0430\u043F\u0438\u0442\u0430\u043D\u044C.
        \u0417\u0433\u043E\u0434\u043D\u0430?"
    - Language: 1
      Text: 
  - Key: scene_1_125_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u0438\u0447\u0430\u0439\u043D\u043E, \u0432\u0438 \u0436
        \u0441\u043B\u0456\u0434\u0447\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_125_00_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0434\u0456 \u044F \u0441\u043F\u0438\u0442\u0430\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_125_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0442\u043E\u0431\u0456 \u0432\u0456\u0434\u043E\u043C\u043E
        \u043F\u0440\u043E \u043D\u0435\u043B\u0435\u0433\u0430\u043B\u044C\u043D\u0438\u0439
        \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043E\u043A \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0432 \u0441\u0435\u043B\u0438\u0449\u0456?"
    - Language: 1
      Text: 
  - Key: scene_1_125_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0438 \u0431\u0443\u043B\u0430 \u0442\u0438 \u0437\u043D\u0430\u0439\u043E\u043C\u0430
        \u0456\u0437 \u0437\u0430\u0433\u0438\u0431\u043B\u0438\u043C?"
    - Language: 1
      Text: 
  - Key: scene_1_125_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F \u0437 \u0442\u0432\u043E\u0457\u043C
        \u043F\u0456\u0434\u0431\u043E\u0440\u0456\u0434\u0434\u044F\u043C?"
    - Language: 1
      Text: 
  - Key: scene_1_125_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0456\u043B\u044C\u0448\u0435 \u043D\u0456\u0447\u043E\u0433\u043E.
        \u0417\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0430 \u0434\u043E\u043F\u0438\u0442
        \u0442\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u0441\u0435\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_125_5_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E \u0415\u0439\u0441\u0442\u0435\u043D\u0433\u0435\u0440\u0430,
        \u043F\u0430\u043D\u0456. \u0420\u043E\u0437\u0443\u043C\u0456\u044E, \u0446\u0435
        \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454 \u0434\u0438\u0432\u043D\u043E,
        \u0449\u043E \u044F \u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043B\u0430
        \u043D\u0430 \u043F\u043E\u043F\u0443\u0442\u043A\u0443 \u0442\u0430\u043A
        \u043F\u0456\u0437\u043D\u043E. \u0422\u0430 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
        \u043D\u0430 \u0448\u043E\u0441\u0435 \u0457\u0445 \u043E \u0442\u0430\u043A\u0456\u0439
        \u0433\u043E\u0434\u0438\u043D\u0456 \u043D\u0435\u043C\u0430\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_125_5_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0449\u0435 \u044F \u043B\u044E\u0431\u043B\u044E \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u0443\u0432\u0430\u0442\u0438
        \u0432\u043D\u043E\u0447\u0456, \u0430\u0434\u0436\u0435 \u043C\u043E\u0436\u043D\u0430
        \u043F\u043E\u0454\u0434\u043D\u0430\u0442\u0438 \u0446\u0435 \u0437\u0456
        \u0441\u043D\u043E\u043C \u0437\u0430\u043C\u0456\u0441\u0442\u044C \u0431\u0430\u043B\u0430\u0447\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_1_125_5_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C \u0432\u0438\u044F\u0432\u0438\u043B\u0430\u0441\u044F
        \u043F\u0440\u043E\u0437\u0430\u0457\u0447\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_125_5_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0431\u0440\u0435, \u0406\u043B\u043E\u043D\u043E. \u0417\u0430\u0447\u0435\u043A\u0430\u0439
        \u0434\u043E \u0440\u0430\u043D\u043A\u0443, \u043A\u043E\u043B\u0438 \u043C\u043E\u044E
        \u0430\u0432\u0442\u0456\u0432\u043A\u0443 \u043F\u043E\u043B\u0430\u0433\u043E\u0434\u044F\u0442\u044C,
        \u0456 \u044F \u0432\u0456\u0434\u0432\u0435\u0437\u0443 \u0442\u0435\u0431\u0435
        \u0434\u043E \u0415\u0439\u0441\u0442\u0435\u043D\u0433\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_125_5_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u043D\u0435
        \u0432 \u044F\u043A\u043E\u0441\u0442\u0456 \u0430\u0440\u0435\u0448\u0442\u0430\u043D\u0442\u043A\u0438,
        \u0445\u0430-\u0445\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_126_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0445\u2026 \u0426\u0435, \u043D\u0430\u043F\u0435\u0432\u043D\u043E,
        \u0447\u0443\u043B\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0432\u0441\u0456.
        \u0410\u0434\u0436\u0435 \u043A\u043E\u043B\u0438\u0441\u044C \u043F\u0440\u043E
        \u0446\u0438\u0445 \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u0456\u0432
        \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0438\u0441\u0430\u043B\u0438
        \u0432 \u0433\u0430\u0437\u0435\u0442\u0430\u0445. \u041F\u043E\u043B\u0456\u0446\u0456\u044F
        \u043D\u0456\u0431\u0438 \u0437\u0430\u0439\u043C\u0430\u043B\u0430\u0441\u044F
        \u0446\u0456\u0454\u044E \u0441\u043F\u0440\u0430\u0432\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_126_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456
        \u0434\u043E \u043D\u0430\u0448\u043E\u0433\u043E \u0441\u0435\u043B\u0438\u0449\u0430
        \u043C\u0430\u043B\u043E \u043A\u043E\u043C\u0443 \u0454 \u0434\u0456\u043B\u043E.
        \u0422\u043E\u0436 \u043A\u043E\u043B\u0438 \u0430\u0436\u0456\u043E\u0442\u0430\u0436
        \u0441\u043F\u0430\u0432, \u0456 \u0441\u0442\u0430\u0442\u0442\u0456 \u0432
        \u0433\u0430\u0437\u0435\u0442\u0430\u0445 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
        \u0437\u2019\u044F\u0432\u043B\u044F\u0442\u0438\u0441\u044F, \u043F\u043E\u043B\u0456\u0446\u0456\u044F
        \u043E\u0431\u043B\u0438\u0448\u0438\u043B\u0430 \u043C\u0430\u0440\u043D\u0435
        \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_126_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438, \u0447\u043E\u043C\u0443
        \u0437\u0431\u0443\u0432\u0430\u0447 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0437\u043D\u0430\u0432 \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_126_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u0456\u043D\u0448\u0438\u0445 \u043F\u0438\u0442\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_127_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0456\u0434\u043E\u043C\u043E \u043B\u0438\u0448\u0435
        \u0442\u0435, \u0449\u043E \u0439 \u0443\u0441\u0456\u043C \u0456\u043D\u0448\u0438\u043C.
        \u041A\u043E\u043B\u0438\u0441\u044C \u043F\u0440\u043E \u043D\u0435\u043B\u0435\u0433\u0430\u043B\u0456\u0432
        \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u0438\u0441\u0430\u043B\u0438
        \u0432 \u0433\u0430\u0437\u0435\u0442\u0430\u0445. \u041D\u0430\u0448\u0435
        \u0441\u0435\u043B\u0438\u0449\u0435 \u0442\u0430\u043A\u043E\u0436 \u043D\u0435
        \u043E\u043C\u0438\u043D\u0443\u043B\u0438 \u0443\u0432\u0430\u0433\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_127_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438, \u0447\u043E\u043C\u0443
        \u0437\u0431\u0443\u0432\u0430\u0447 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0437\u043D\u0430\u0432 \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_127_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u0456\u043D\u0448\u0438\u0445 \u043F\u0438\u0442\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u2026 \u042F\u2026 \u041E\u0445, \u0434\u043E\u0431\u0440\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u0440\u043E\u0437\u043A\u0440\u0430\u0434\u0430\u043D\u043D\u044F
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443 \u0434\u0443\u0436\u0435
        \u043C\u0435\u043D\u0435 \u0445\u0432\u0438\u043B\u044E\u0432\u0430\u043B\u043E.
        \u0416\u0438\u0442\u0435\u043B\u0456 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E
        \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0436\u0438\u0432\u0443\u0442\u044C
        \u0443 \u0437\u043B\u0438\u0434\u043D\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u0447\u0435\u0440\u0435\u0437 \u0446\u0435 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
        \u0456 \u0437\u2019\u044F\u0432\u043B\u044F\u044E\u0442\u044C\u0441\u044F
        \u043A\u0440\u0430\u0434\u0456\u0457, \u0430\u043B\u0435 \u0436 \u0432\u043E\u043D\u0438
        \u043B\u0438\u0448\u0435 \u043F\u043E\u0433\u0456\u0440\u0448\u0443\u044E\u0442\u044C
        \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E, \u0441\u0430\u043C\u0456
        \u0434\u043E\u0432\u043E\u0434\u044F\u0442\u044C \u0434\u043E \u0442\u0430\u043A\u043E\u0433\u043E
        \u0441\u0442\u0430\u043D\u0443. \u0412\u0438\u0445\u043E\u0434\u0438\u0442\u044C
        \u0437\u0430\u043C\u043A\u043D\u0435\u043D\u0435 \u043A\u043E\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u044F \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430
        \u0445\u043E\u0447 \u0449\u043E\u0441\u044C \u0456\u0437 \u0446\u0438\u043C
        \u0440\u043E\u0431\u0438\u0442\u0438. \u0423\u0437\u044F\u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0443
        \u0443 \u0441\u0432\u043E\u0457 \u0440\u0443\u043A\u0438, \u044F\u043A\u0449\u043E
        \u043C\u043E\u0436\u043D\u0430 \u0442\u0430\u043A \u0432\u0438\u0441\u043B\u043E\u0432\u0438\u0442\u0438\u0441\u044C.
        \u042F \u043D\u0435 \u043D\u0430\u0439\u0445\u043E\u0440\u043E\u0431\u0440\u0456\u0448\u0430
        \u0436\u0456\u043D\u043A\u0430\u2026 \u0414\u0456\u044F\u0442\u0438 \u043C\u043E\u0433\u043B\u0430
        \u0445\u0456\u0431\u0430 \u0449\u043E \u0445\u0438\u0442\u0440\u0456\u0441\u0442\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0434\u0456\u0437\u043D\u0430\u0442\u0438\u0441\u044F \u043D\u043E\u043C\u0435\u0440
        \u0437\u0431\u0443\u0432\u0430\u0447\u0430 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443
        \u0439 \u043D\u0430\u0432\u0456\u0442\u044C \u0432\u0442\u0435\u0440\u0442\u0438\u0441\u044F
        \u0439\u043E\u043C\u0443 \u0432 \u0434\u043E\u0432\u0456\u0440\u0443. \u041D\u0430\u0439\u0431\u043B\u0438\u0436\u0447\u0438\u043C
        \u0447\u0430\u0441\u043E\u043C \u044F \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
        \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u0438 \u0439\u043E\u0433\u043E
        \u0434\u0430\u043D\u0456 \u043F\u043E\u043B\u0456\u0446\u0456\u0457."
    - Language: 1
      Text: 
  - Key: scene_1_128_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0436 \u0443 \u0446\u044C\u043E\u043C\u0443 \u043A\u043B\u044F\u0442\u043E\u043C\u0443
        \u0441\u0435\u043B\u0438\u0449\u0456 \u0432\u0441\u0456 \u0442\u0430\u043A\u0456
        \u0441\u0430\u043C\u043E\u0432\u0456\u0434\u0434\u0430\u043D\u0456?"
    - Language: 1
      Text: 
  - Key: scene_1_129_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u044F \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u043B\u0430\u0441\u044F
        \u0437 \u043D\u0438\u043C \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u0430\u0437\u0456\u0432. \u0410\u043B\u0435, \u044F\u043A \u043B\u044E\u0434\u0438\u043D\u0443,
        \u043C\u0430\u0439\u0436\u0435 \u0439\u043E\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_129_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_129_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0456\u0431\u0430? \u0410 \u0437\u0431\u0443\u0432\u0430\u0447
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443 \u0437\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F
        \u0434\u043E \u043C\u0435\u043D\u0435, \u044F\u043A \u0434\u043E \xAB\u0406\u043B\u043E\u043D\u0438\xBB,
        \u043A\u043E\u043B\u0438 \u044F \u0437\u0433\u0430\u0434\u0430\u043B\u0430
        \u041A\u043E\u0440\u043D\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_129_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0456\u0447\u043E\u0433\u043E. \u0406 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u0456\u043D\u0448\u0438\u0445 \u043F\u0438\u0442\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_130_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0448\u0435 \u0441\u0435\u043B\u0438\u0449\u0435 \u043C\u0430\u043B\u0435,
        \u0442\u0443\u0442 \u0443\u0441\u0456 \u0437\u043D\u0430\u0439\u043E\u043C\u0456
        \u0437 \u0443\u0441\u0456\u043C\u0430. \u0417 \u041A\u043E\u0440\u043D\u0456\u0454\u043C
        \u043C\u0435\u043D\u0435 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
        \u043F\u043E\u0432\u2019\u044F\u0437\u0443\u0432\u0430\u043B\u043E, \u0442\u043E\u043C\u0443
        \u043C\u0438 \u043D\u0435 \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u043B\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_130_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_130_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0456\u0431\u0430? \u0410 \u0437\u0431\u0443\u0432\u0430\u0447
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443 \u0437\u0432\u0435\u0440\u043D\u0443\u0432\u0441\u044F
        \u0434\u043E \u043C\u0435\u043D\u0435, \u044F\u043A \u0434\u043E \xAB\u0406\u043B\u043E\u043D\u0438\xBB,
        \u043A\u043E\u043B\u0438 \u044F \u0437\u0433\u0430\u0434\u0430\u043B\u0430
        \u041A\u043E\u0440\u043D\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_130_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0456\u0447\u043E\u0433\u043E \u0439 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u0456\u043D\u0448\u0438\u0445 \u043F\u0438\u0442\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_131_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u0430 \u0433\u043B\u0438\u0431\u043E\u043A\u043E
        \u0437\u0456\u0442\u0445\u043D\u0443\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_131_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0431\u0430\u0447\u0442\u0435, \u0449\u043E \u043E\u0434\u0440\u0430\u0437\u0443
        \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B\u0430 \u0432\u0430\u043C
        \u043F\u0440\u0430\u0432\u0434\u0443. \u0410\u043B\u0435 \u0441\u043F\u0440\u0430\u0432\u0430
        \u0432 \u0442\u043E\u043C\u0443, \u0449\u043E \u041A\u043E\u0440\u043D\u0456\u0439
        \u0431\u0443\u0432 \u043F\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0438\u0439
        \u0456\u0437 \u0440\u043E\u0437\u043A\u0440\u0430\u0434\u0430\u043D\u043D\u044F\u043C
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443. \u042F \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u0430
        \u043F\u0440\u0438\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u0446\u0435,
        \u0449\u043E\u0431 \u043D\u0435 \u043F\u0441\u0443\u0432\u0430\u0442\u0438
        \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0456\u044E \u043F\u043E\u043C\u0435\u0440\u043B\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_131_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435, \u0441\u0445\u043E\u0436\u0435, \u0446\u0435
        \u043C\u0430\u0454 \u044F\u043A\u0435\u0441\u044C \u0432\u0430\u0436\u043B\u0438\u0432\u0435
        \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u0434\u043B\u044F \u0432\u0430\u0448\u043E\u0433\u043E
        \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_131_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A. \u0427\u0438\u043C\u0430\u043B\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_131_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u043B\u0430\u0441\u043D\u0435, \u0446\u0435 \u0431\u0443\u043B\u043E
        \u043C\u043E\u0457\u043C \u0454\u0434\u0438\u043D\u0438\u043C \u043F\u0440\u0438\u0432\u043E\u0434\u043E\u043C
        \u0434\u043B\u044F \u0441\u043F\u0456\u043B\u043A\u0443\u0432\u0430\u043D\u043D\u044F
        \u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C"
    - Language: 1
      Text: 
  - Key: scene_1_132_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u2026 \u041D\u0435 \u0432\u0430\u0440\u0442\u043E \u0445\u0432\u0438\u043B\u044E\u0432\u0430\u043D\u043D\u044F,
        \u0446\u0435 \u043F\u0443\u0441\u0442\u0435, \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430
        \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0430. \u0412\u043F\u0430\u043B\u0430,
        \u044F\u043A \u0431\u0443\u043B\u0430 \u0432\u0434\u043E\u043C\u0430 \u2014
        \u0437\u0430\u043B\u0456\u0437\u043B\u0430 \u043D\u0430 \u0442\u0430\u0431\u0443\u0440\u0435\u0442\u043A\u0443,
        \u0449\u043E\u0431 \u0446\u0443\u043A\u043E\u0440 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u0456\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_132_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0443\u0454\u0442\u0435,
        \u044F\u043A\u0449\u043E \u044F \u043E\u0433\u043B\u044F\u043D\u0443 \u0440\u0430\u043D\u043A\u0443
        \u0431\u043B\u0438\u0436\u0447\u0435?"
    - Language: 1
      Text: 
  - Key: scene_1_132_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u0456\u043D\u0448\u0438\u0445 \u043F\u0438\u0442\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_133_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0432\u0436\u0435\u0436, \u0434\u0438\u0432\u0456\u0442\u044C\u0441\u044F.
        \u0429\u043E, \u0442\u0430\u043A \u043F\u043E\u0433\u0430\u043D\u043E \u0437\u0456
        \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454?"
    - Language: 1
      Text: 
  - Key: scene_1_133_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u0430 \u0437\u0430\u0434\u0435\u0440\u043B\u0430
        \u0433\u043E\u043B\u043E\u0432\u0443 \u0439 \u0434\u0430\u043B\u0430 \u043C\u0435\u043D\u0456
        \u0432\u0441\u0435 \u0440\u043E\u0437\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F.
        \u042F \u043F\u0456\u0434\u0456\u0439\u0448\u043B\u0430 \u0431\u043B\u0438\u0436\u0447\u0435
        \u0442\u0430 \u043E\u0433\u043B\u044F\u043D\u0443\u043B\u0430 \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_133_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u043D\u0456, \u0443\u0441\u0435 \u0437 \u043D\u0435\u044E
        \u0433\u0430\u0440\u0430\u0437\u0434. \u0417\u0430\u0433\u043E\u0457\u0442\u044C\u0441\u044F,
        \u043F\u043E\u043A\u0438 \u0432\u0435\u0441\u0456\u043B\u043B\u044F \u0441\u043A\u043E\u0457\u0442\u044C\u0441\u044F.
        \u0425\u043E\u0447\u0430 \u043E\u0441\u044C \u0446\u0435 \u0432\u0436\u0435
        \u0431\u0443\u0434\u0435 \u0433\u0456\u0440\u0448\u0435 \u044F\u043A\u043E\u0457\u0441\u044C
        \u043F\u043E\u0434\u0440\u044F\u043F\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_133_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0440\u0438\u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F
        \u0434\u043E \u0444\u043E\u0440\u043C\u0438 \u0442\u0430 \u0433\u043B\u0438\u0431\u0438\u043D\u0438
        \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u043D\u044F. \u0428\u0438\u0440\u043E\u043A\u0435
        \u0439 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u0435\u0432\u0435. \u041F\u0440\u0438\u043F\u0443\u0445\u043B\u0435.
        \u041D\u0430\u0432\u043A\u043E\u043B\u043E \u0449\u0435 \u0432\u0438\u0434\u043D\u0456\u0432\u0441\u044F
        \u0431\u043B\u0456\u0434\u0438\u0439 \u043E\u0440\u0435\u043E\u043B \u0441\u0438\u043D\u0446\u044F,
        \u0445\u043E\u0447\u0430 \u0432\u0436\u0435 \u043C\u0430\u0439\u0436\u0435
        \u043F\u0440\u043E\u043F\u0430\u0432. \u0411\u0443\u043B\u043E \u0441\u0445\u043E\u0436\u0435
        \u043D\u0430 \u0441\u043B\u0456\u0434 \u0432\u0456\u0434 \u0443\u0434\u0430\u0440\u0443
        \u043A\u0443\u043B\u0430\u043A\u043E\u043C. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0456 \u043D\u043E\u0441\u0438\u043B\u0438
        \u043F\u0435\u0440\u0441\u0442\u0435\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_133_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0441\u0432\u043E\u044E \u0432\u0435\u0440\u0441\u0456\u044E,
        \u044F\u043A\u0430 \u043D\u0435 \u0437\u0431\u0456\u0433\u0430\u043B\u0430\u0441\u044F
        \u0456\u0437 \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0434\u0434\u044E
        \u0406\u043B\u043E\u043D\u0438, \u044F \u043F\u043E\u043A\u0438 \u0449\u043E
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u0438.
        \u041F\u0440\u043E \u0442\u0430\u043A\u0435 \u0434\u0456\u0432\u0447\u0438\u043D\u0456
        \u043A\u0440\u0430\u0449\u0435 \u0431\u0443\u043B\u043E \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438,
        \u043A\u043E\u043B\u0438 \u0432\u043E\u043D\u0430 \u0431\u0443\u0434\u0435
        \u0433\u043E\u0442\u043E\u0432\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_134_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431 \u0446\u044C\u043E\u0433\u043E \u043D\u0435 \u0432\u043E\u043B\u0456\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_134_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0441\u043A\u0430\u0436\u0435\u0448, \u0406\u043B\u043E\u043D\u043E.
        \u042F \u043D\u0435 \u043C\u0430\u044E \u043E\u0440\u0434\u0435\u0440\u0430,
        \u0430 \u0442\u043E\u043C\u0443 \u0456 \u043F\u0440\u0430\u0432\u0430 \u0442\u0435\u0431\u0435
        \u0434\u043E \u0447\u043E\u0433\u043E\u0441\u044C \u0441\u043F\u043E\u043D\u0443\u043A\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_135_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u043D\u043E\u0432\u0443 \u0441\u0442\u043E\u044F\u043B\u0430
        \u043F\u043E\u0441\u0435\u0440\u0435\u0434 \u0441\u0435\u043B\u0430. \u0422\u0430\u0454\u043C\u043D\u0438\u0446\u044F,
        \u0437 \u044F\u043A\u043E\u044E \u043C\u0435\u043D\u0456 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F
        \u0437\u0456\u0442\u043A\u043D\u0443\u0442\u0438\u0441\u044F, \u0437\u0430\u043A\u0440\u0443\u0447\u0443\u0432\u0430\u043B\u0430\u0441\u044F
        \u0432\u0441\u0435 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435. \u042F
        \u043C\u0430\u043B\u0430 \u0449\u043E\u0441\u044C \u0456\u0437 \u0446\u0438\u043C
        \u0440\u043E\u0431\u0438\u0442\u0438, \u0442\u043E\u043C\u0443 \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_135_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u0438\u0441\u044F
        \u0434\u043E \u0441\u0442\u043E\u0440\u043E\u0436\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_135_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0406\u043B\u043E\u043D\u0443
        \u0431\u0456\u043B\u044F \u043C\u0430\u0448\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_135_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438 \u0437
        \u0434\u0456\u0434\u043E\u043C \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u043D\u0430\u0440\u0435\u0448\u0442\u0456
        \u0434\u0456\u0441\u0442\u0430\u043B\u0430\u0441\u044F \u0445\u0430\u0442\u0438\u043D\u0438
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430, \u0441\u0432\u0456\u0442\u043B\u043E
        \u0432\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0432\u0436\u0435
        \u043D\u0435 \u0433\u043E\u0440\u0456\u043B\u043E. \u0421\u0442\u043E\u044F\u043B\u0430
        \u0433\u043B\u0443\u0445\u0430 \u043D\u0456\u0447. \u041C\u0435\u043D\u0456
        \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u043E\u0441\u044F \u0431\u0443\u0434\u0438\u0442\u0438
        \u0439 \u043B\u044F\u043A\u0430\u0442\u0438 \u0434\u0456\u0434\u0430, \u0430\u043B\u0435
        \u0456\u043D\u0448\u043E\u0433\u043E \u0432\u0438\u0431\u043E\u0440\u0443
        \u044F \u043D\u0435 \u043C\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0431\u043B\u0438\u0437\u0438\u0432\u0448\u0438\u0441\u044C
        \u0434\u043E \u0434\u0432\u0435\u0440\u0435\u0439, \u044F \u043B\u0435\u0433\u0435\u043D\u044C\u043A\u043E
        \u043F\u043E\u0441\u0442\u0443\u043A\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u0433\u043E \u0446\u0435 \u044F?"
    - Language: 1
      Text: 
  - Key: scene_2_136_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u0441\u0442\u0443\u043A\u0430\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435.
        \u0422\u0430\u043A, \u0449\u043E\u0431 \u043D\u0430\u0432\u0456\u0442\u044C
        \u0433\u043B\u0443\u0445\u0438\u0439 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0432
        \u2014 \u0442\u0440\u0435\u0431\u0430 \u043D\u0435\u0433\u0430\u0439\u043D\u043E
        \u043F\u0456\u0434\u0432\u0435\u0441\u0442\u0438\u0441\u044F \u0456 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0443\u0436\u0435 \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0438
        \u0445\u0430\u0442\u0438 \u043F\u043E\u0447\u0443\u043B\u043E\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_136_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u043E \u0437\u0430 \u0433\u0430\u0441\u043F\u0438\u0434\u0430
        \u0442\u0443\u0442 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u043E?! \u042F\u043A
        \u043D\u0435 \u0433\u0456\u0432\u043D\u043E, \u0442\u043E \u0437\u0430\u0441\u0440\u0430\u043D\u0430
        \u0442\u0440\u0456\u0441\u043A\u0430! \u0421\u043C\u0456\u0448\u043D\u043E
        \u0432\u0430\u043C \u0434\u0443\u0436 \u0441\u0435\u0440\u0435\u0434 \u043D\u043E\u0447\u0456
        \u043F\u043E \u0434\u0432\u0435\u0440\u044F\u0445 \u0434\u043E\u0432\u0431\u0438\u0442\u0438!"
    - Language: 1
      Text: 
  - Key: scene_2_136_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0431\u0443\u0432 \u0442\u0430\u043A\u0438\u043C
        \u043C\u0438\u043B\u0438\u043C, \u043A\u043E\u043B\u0438 \u0439\u043E\u0433\u043E
        \u0431\u0443\u0434\u0438\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0435\u0448\u0442\u0456 \u0443 \u0434\u0432\u0435\u0440\u044F\u0445
        \u0437\u2019\u044F\u0432\u0438\u043B\u0430\u0441\u044F \u043D\u0435\u0432\u0434\u043E\u0432\u043E\u043B\u0435\u043D\u0430
        \u0439 \u0437\u0430\u0441\u043F\u0430\u043D\u0430 \u043F\u0438\u043A\u0430
        \u0441\u0442\u0430\u0440\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_136_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0430\u0439 \u0431\u0438 \u0432\u0430\u0441 \u0433\u0443\u0441\u0438\u2026
        \u0410, \u0441\u043B\u0456\u0434\u0447\u0430, \u0442\u043E \u0442\u0438 \u043D\u043E\u0447\u0447\u044E
        \u043B\u0430\u0437\u0438\u0448. \u042F \u0436 \u0442\u043E\u0431\u0456 \u043D\u0456\u0431\u0438
        \u0432\u0441\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u0432, \u0448\u043E
        \u0448\u0435 \u043D\u0430\u0434\u043E?"
    - Language: 1
      Text: 
  - Key: scene_2_136_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0430\u0447\u0442\u0435, \u0449\u043E \u0440\u043E\u0437\u0431\u0443\u0434\u0438\u043B\u0430
        \u043E \u043F\u0456\u0437\u043D\u0456\u0439 \u0433\u043E\u0434\u0438\u043D\u0456.
        \u0422\u0430 \u043A\u043E\u043B\u0438 \u0432\u0430\u043C \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u0433\u043E
        \u0440\u0430\u0437\u0443 \u0432\u0438\u043F\u0430\u0434\u0435 \u0448\u0430\u043D\u0441
        \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0442\u0440\u043E\u0445\u0438
        \u0447\u0430\u0441\u0443 \u0437 \u0442\u0430\u043A\u043E\u044E \u043F\u0440\u0438\u0454\u043C\u043D\u043E\u044E
        \u0442\u0430 \u0433\u0430\u043B\u0430\u043D\u0442\u043D\u043E\u044E \u0436\u0456\u043D\u043A\u043E\u044E?"
    - Language: 1
      Text: 
  - Key: scene_2_136_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0442\u0443\u0442, \u0449\u043E\u0431 \u0442\u0440\u043E\u0445\u0438
        \u043F\u043E\u0431\u0430\u0437\u0456\u043A\u0430\u0442\u0438 \u0437 \u0432\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_136_00_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u043B\u0456 \u044F \u0437\u0430\u043F\u0438\u0442\u0430\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_136_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0442\u0430
        \u0439\u043E\u0433\u043E \u0437\u0432\u2019\u044F\u0437\u043A\u0438 \u0437
        \u041A\u043E\u0440\u043D\u0456\u0454\u043C."
    - Language: 1
      Text: 
  - Key: scene_2_136_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0406\u043B\u043E\u043D\u0430 \u0431\u0443\u043B\u0430
        \u043F\u043E\u0432\u2019\u044F\u0437\u0430\u043D\u0430 \u0437 \u0440\u043E\u0437\u043A\u0440\u0430\u0434\u0430\u043D\u043D\u044F\u043C
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_2_136_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u043E\u0441\u043E\u0432\u043D\u043E \u043C\u0435\u0434\u0430\u043B\u044C\u0439\u043E\u043D\u0430
        \u0442\u0430 \u043F\u0440\u0456\u0437\u0432\u0438\u0441\u044C\u043A\u0430
        \xAB\u0420\u043E\u0437\u0431\u0438\u0442\u0438\u0439 \u043C\u0456\u0441\u044F\u0446\u044C\xBB
        \u0456\u0437 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A\u0430 \u041A\u043E\u0440\u043D\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_136_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0438 \u0434\u043E\u0431\u0440\u0435 \u0441\u0430\u043C \u0417\u0430\u0445\u0430\u0440\u0435\u0441
        \u0437\u043D\u0430\u0432 \u0443\u0431\u0438\u0442\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_136_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u043C\u0435\u0434\u0430\u043B\u044C\u0439\u043E\u043D
        \u0443 \u0444\u043E\u0440\u043C\u0456 \u043D\u0430\u043F\u0456\u0432\u043C\u0456\u0441\u044F\u0446\u044F,
        \u044F\u043A\u0438\u0439 \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0431\u0456\u043B\u044F
        \u043E\u0437\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0440\u043C\u2026 \u041D\u0435\u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u0435
        \u043F\u0438\u0442\u0430\u043D\u043D\u044F. \u0422\u043E\u0439 \u041E\u043B\u0435\u043A\u0441\u0430
        \u043C\u0435\u043D\u0456 \u043D\u0456\u043A\u043E\u043B\u0438 \u0434\u0443\u0436\u0435
        \u043F\u0440\u0438\u043A\u043C\u0435\u0442\u043D\u0438\u043C \u043D\u0435
        \u0437\u0434\u0430\u0432\u0430\u0432\u0441\u044F. \u0421\u0438\u0434\u0438\u0442\u044C
        \u0441\u043E\u0431\u0456 \u043D\u0430 \u043A\u043E\u043F\u0430\u043B\u044C\u043D\u044F\u0445,
        \u0442\u0430 \u0439 \u0441\u0438\u0434\u0438\u0442\u044C. \u0410 \u0432 \u0447\u043E\u043C
        \u0432\u0438 \u0439\u043E\u0433\u043E \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0454\u0442\u0435?"
    - Language: 1
      Text: 
  - Key: scene_2_137_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0432\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u0442\u0438,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435. \u0422\u0443\u0442 \u043B\u0435\u0433\u0448\u0435
        \u0431\u0443\u043B\u043E \u0431 \u0432\u0438\u0431\u0440\u0430\u0442\u0438,
        \u0443 \u0447\u043E\u043C\u0443 \u044F \u0439\u043E\u0433\u043E \u041D\u0415
        \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u044E. \u041F\u0440\u043E\u0442\u0435
        \u0441\u0430\u043C\u0435 \u0449\u043E\u0434\u043E \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430
        \u041A\u043E\u0440\u043D\u0456\u044F \u043F\u043E\u043A\u0438 \u0449\u043E
        \u0441\u043A\u0430\u0437\u0430\u0442\u0438 \u0441\u043A\u043B\u0430\u0434\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u044E, \u044F\u043A
        \u041B\u0435\u0441\u044C \u0448\u0435 \u043C\u0430\u043B\u0438\u0439 \u0431\u0443\u0432.
        \u041F\u043E \u044E\u043D\u043E\u0441\u0442\u0456 \u0437\u043E\u0432\u0441\u0456\u043C
        \u043C\u0440\u0456\u0439\u043D\u0438\u043A. \u0410 \u0439 \u0442\u043E\u0447\u043D\u043E!
        \u0417\u0431\u0438\u0440\u0430\u0432\u0441\u044C \u043F\u043E\u043B\u0456\u0446\u0456\u044F\u043D\u0442\u043E\u043C
        \u0431\u0443\u0442\u044C, \u043F\u0440\u044F\u043C \u044F\u043A \u0442\u0438.
        \u041A\u0430\u0437\u0430\u0432, \u0448\u043E \u0445\u043E\u0447\u0435 \u0434\u043E\u0431\u0440\u0435
        \u043B\u044E\u0434\u044F\u043C \u0440\u043E\u0431\u0438\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0432\u0436\u0435 \u043D\u0430\u0440\u043E\u0431\u0438\u0432\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435, \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
        \u0435\u043A\u0445\u0437\u0443\u043C\u043D\u0456\u0432 \u0442\u0430\u043A
        \u0456 \u043D\u0435 \u0441\u043A\u043B\u0430\u0432. \u0428\u043E\u0441\u044C
        \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
        \u0428\u043E \u043F\u043E\u0440\u043E\u0431\u0438\u0448, \u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044C
        \u0430\u043A\u0430\u0434\u0435\u043C\u0456\u044F \u0431\u0435\u0437 \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E
        \u0442\u0430\u043B\u0430\u043D\u0442\u0430. \u0428\u043A\u043E\u0434\u0430
        \u0445\u043B\u043E\u043F\u0446\u044F \u0431\u0443\u043B\u043E, \u0437 \u043C\u0440\u0456\u0454\u044E
        \u043D\u0435 \u0437\u0430\u0434\u0430\u043B\u043E\u0441\u044F \u0456 \u0441\u0432\u0456\u0442
        \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u044C, \u044F\u043A \u0445\u0442\u0456\u0432,
        \u043D\u0435 \u0432\u0438\u0431\u0440\u0430\u0432\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0442\u043E\u043C\u0456\u0441\u0442\u044C \u0441\u0442\u0430\u0432
        \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u0435\u043C, \u0437 \u0442\u043E\u0433\u043E
        \u0447\u0430\u0441\u0443 \u0432\u0441\u0435 \u0436\u0438\u0442\u0442\u044F
        \u0441\u0442\u0438\u0440\u0447\u0438\u0442\u044C \u043D\u0430 \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430\u0445.
        \u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0454 \u0431\u0443\u0440\u0448\u0442\u0438\u043D."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438,
        \u044F \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u0440\u0430\u0434\u0456\u043B\u0430,
        \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C \u0443\u0434\u0430\u0447\u0430
        \u043D\u0430\u0441\u0440\u0430\u043B\u0430 \u0432 \u043A\u0438\u0448\u0435\u043D\u0456
        \u0446\u044C\u043E\u043C\u0443 \u043F\u043E\u043A\u0438\u0434\u044C\u043A\u0443,
        \u0456 \u0432\u0456\u043D \u043D\u0435 \u0432\u0438\u0431\u0440\u0430\u0432\u0441\u044F
        \u0437 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E. \u041D\u0435
        \u0437\u0430\u0437\u0434\u0440\u044E \u0442\u0438\u043C, \u043A\u043E\u043C\u0443
        \u0431 \u0434\u043E\u0432\u0435\u043B\u043E\u0441\u044F \u0432\u0447\u0438\u0442\u0438\u0441\u044F
        \u0440\u0430\u0437\u043E\u043C \u0437 \u041E\u043B\u0435\u043A\u0441\u0456\u0454\u043C
        \u0432 \u0410\u043A\u0430\u0434\u0435\u043C\u0456\u0457."
    - Language: 1
      Text: 
  - Key: scene_2_137_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u044F\u043A \u0449\u043E\u0434\u043E \u0439\u043E\u0433\u043E
        \u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0456\u0432 \u0456\u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C?"
    - Language: 1
      Text: 
  - Key: scene_2_137_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0410-\u0430-\u0430, \u0442\u0430\u043A-\u0442\u0430\u043A\u2026 \u0412\u043E\u043D\u0438
        \u043D\u0456\u0431-\u0442\u043E \u0442\u043E\u0432\u0430\u0440\u0438\u0448\u0438
        \u0433\u0430\u0440\u043D\u0456 \u0431\u0443\u043B\u0438. \u0427\u0430\u0441\u0443
        \u0440\u0430\u0437\u043E\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438
        \u0447\u0438\u043C\u0430\u043B\u043E, \u0442\u0430 \u043D\u0430\u0439\u0447\u0430\u0441\u0442\u0456\u0448\u0435
        \u043F\u0438\u044F\u0447\u0438\u043B\u0438. \u0410 \u0434\u0435 \u043F\u043E\u0437\u043D\u0430\u0439\u043E\u043C\u0438\u043B\u0438\u0441\u044F
        \u2014 \u0433\u0430\u0434\u043A\u0438 \u043D\u0435 \u043C\u0430\u044E."
    - Language: 1
      Text: 
  - Key: scene_2_138_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u043D\u0430\u043B\u0430\u0433\u043E\u0434\u0438\u0442\u0438 \u043F\u0435\u0432\u043D\u0456
        \u0437\u0432\u2019\u044F\u0437\u043A\u0438 \u0437\u0456 \u0437\u0431\u0443\u0432\u0430\u0447\u0435\u043C,
        \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430 \u0432\u0441\u0435 \u043D\u0430
        \u0447\u043E\u0440\u043D\u043E\u043C\u0443 \u0440\u0438\u043D\u043A\u0443.
        \u0417\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u0406\u043B\u043E\u043D\u0430
        \u0431\u0443\u043B\u0430 \u0437 \u043D\u0438\u043C \u0443 \u0442\u0456\u0441\u043D\u043E\u043C\u0443
        \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0456."
    - Language: 1
      Text: 
  - Key: scene_2_138_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0448\u0438\u0439 \u0440\u0430\u0437 \u0447\u0443\u044E!
        \u0412\u0437\u0430\u0433\u0430\u043B\u0456 \u043D\u0435 \u0443\u044F\u0432\u043B\u044F\u044E,
        \u0448\u043E\u0431 \u0442\u0430\u043A\u0435 \u0431\u0443\u043B\u043E \u043C\u043E\u0436\u043B\u0438\u0432\u043E.
        \u0412\u0438 \u0436 \u0442\u0443 \u0406\u043B\u043E\u043D\u0443 \u0431\u0430\u0447\u0438\u043B\u0438?
        \u0414\u043E\u0431\u0440\u0430, \u043D\u0456\u0436\u043D\u0430 \u0434\u0456\u0432\u0447\u0438\u043D\u043A\u0430.
        \u0420\u043E\u0437\u0443\u043C\u043D\u0430 \u0442\u0430\u043A\u0430, \u043D\u0430\u0432\u0456\u0442\u044C
        \u0456\u043D\u0442\u0435\u043B\u0456\u0445\u0442\u0443\u0430\u043B\u044C\u043D\u0430.
        \u041A\u043E\u043C\u0443 \u0431 \u0432\u043E\u043D\u0430 \u0437\u043B\u0435
        \u0441\u0442\u0430\u043B\u0430 \u0440\u043E\u0431\u0438\u0442\u044C?"
    - Language: 1
      Text: 
  - Key: scene_2_138_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0448\u043E \u0442\u0438 \u0442\u0430\u043C
        \u043D\u0430\u043A\u043E\u043F\u0430\u043B\u0430, \u0441\u043B\u0456\u0434\u0447\u0430,
        \u0442\u0430 \u0442\u043E \u0432\u0441\u0435 \u043D\u0435 \u043F\u0440\u043E
        \u043D\u0435\u0457. \u042F\u043A \u0445\u043E\u0448, \u0430\u043B\u0435 \u044F
        \u0442\u043E\u043C\u0443 \u043D\u0435 \u0432\u0456\u0440\u044E."
    - Language: 1
      Text: 
  - Key: scene_2_139_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u0448\u043E \u0442\u0438, \u0441\u043B\u0456\u0434\u0447\u0430?
        \u041F\u043E\u0434\u0443\u043C\u0430\u0454\u0448, \xAB\u0440\u043E\u0437\u0431\u0438\u0442\u0438\u0439
        \u043C\u0456\u0441\u044F\u0446\u044C\xBB! \u0422\u0430\u043A \u0432\u043E\u043F\u0448\u0435
        \u0431\u0443\u0434\u044C \u0448\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u0438
        \u043C\u043E\u0436\u043D\u0430. \u0427\u043E\u043C \u0442\u0438 \u0432\u0437\u0430\u0433\u0430\u043B\u0456
        \u0440\u0456\u0448\u0438\u043B\u0430, \u043D\u0456\u0431\u0438 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A
        \u041A\u043E\u0440\u043D\u0456\u0454\u0432 \u0431\u0443\u0432?"
    - Language: 1
      Text: 
  - Key: scene_2_139_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0440\u0438\u0432\u0430\u0439\u0442\u0435, \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435.
        \u041D\u0435 \u0433\u0430\u0440\u044F\u0447\u043A\u0443\u0439\u0442\u0435,
        \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u0442\u043E\u0447\u043D\u043E
        \u0439\u043E\u0433\u043E. \u041A\u043E\u0440\u043D\u0456\u0439 \u0434\u0430\u0432\u0430\u0432
        \u043A\u043E\u0434\u043E\u0432\u0456 \u0456\u043C\u0435\u043D\u0430 \u0432\u0441\u0456\u043C,
        \u043F\u0440\u043E \u043A\u043E\u0433\u043E \u0440\u043E\u0431\u0438\u0432
        \u043D\u043E\u0442\u0430\u0442\u043A\u0438. \u0412\u0438 \u043F\u0435\u0432\u043D\u0456,
        \u0449\u043E \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u0438\u0445\u043E\u0432\u0443\u0454\u0442\u0435?"
    - Language: 1
      Text: 
  - Key: scene_2_139_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0445\u043E\u0432\u0443\u044E?! \u0422\u0438 \u0437\u0430
        \u043A\u043E\u0433\u043E \u043C\u0435\u043D\u0435 \u043C\u0430\u0454\u0448?
        \u0406\u0434\u0438 \u0441\u043C\u0435\u0440\u0442\u044C \u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0439,
        \u0430 \u043D\u0435 \u0432 \u0434\u0456\u043B\u0430 \u043C\u043E\u0457 \u043D\u043E\u0441\u0430
        \u043F\u0445\u0430\u0439! \u0411\u043E \u044F\u043A \u0414\u0436\u043C\u0435\u043B\u044F
        \u0448\u0443\u043A\u0430\u0442\u0438\u043C\u0435\u0448, \u0442\u043E \u0448\u043E,
        \u0434\u0438\u0432\u0438\u0442\u044C\u0441\u044F \u0431\u0443\u0434\u0435\u0448,
        \u0443 \u043A\u043E\u0433\u043E \u0431\u0434\u0436\u043E\u043B\u0438 \u043D\u0430
        \u0433\u043E\u043B\u043E\u0432\u0456 \u043D\u0430\u043C\u0430\u043B\u044C\u043E\u0432\u0430\u043D\u0456?!"
    - Language: 1
      Text: 
  - Key: scene_2_139_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435."
    - Language: 1
      Text: 
  - Key: scene_2_139_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0456\u0434\u044C\u043A\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_139_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E \u0414\u0436\u043C\u0435\u043B\u044F \u044F \u0432\u0430\u043C
        \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_139_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
        \u0442\u0430 \u043F\u043E\u043E\u0431\u0456\u0446\u044F\u0442\u0438 \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438
        \u0432\u0456\u0434 \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u043D\u044F
        \u0437\u0430 \u0441\u043F\u0456\u0432\u0443\u0447\u0430\u0441\u0442\u044C
        \u0443 \u0437\u043B\u043E\u0447\u0438\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_2_139_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0434\u0430\u0432\u0438\u0442\u0438 \u043D\u0430 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u2014 \u044F\u043A\u0449\u043E \u043D\u0435 \u0445\u043E\u0447\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u0438\u0442\u0438
        \u0437\u0430 \u0491\u0440\u0430\u0442\u0438 \u0433\u043B\u0438\u0431\u043E\u043A\u043E
        \u0439 \u043D\u0430\u0434\u043E\u0432\u0433\u043E, \u0445\u0430\u0439 \u0443\u0441\u0435
        \u0440\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_2_140_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0437 \u043A\u0438\u043C\u0441\u044C
        \u0437\u043D\u0430\u0439\u043E\u043C\u043B\u044E\u0441\u044C, \u0442\u0456\u043A\u043E
        \u043A\u043E\u043B\u0438 \u0432 \u043D\u0438\u0445 \u0431\u043B\u0438\u0437\u044C\u043A\u0456
        \u0432\u043C\u0438\u0440\u0430\u044E\u0442\u044C. \u0417\u0432\u0435\u0440\u0442\u0430\u044E\u0442\u044C\u0441\u044F
        \u0434\u043E \u043C\u0435\u043D\u0435, \u0449\u043E\u0431 \u043C\u043E\u0433\u0438\u043B\u0443
        \u043D\u0430\u043A\u043E\u043F\u0430\u0432."
    - Language: 1
      Text: 
  - Key: scene_2_140_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u043E\u0442 \u0456\u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C
        \u043C\u0430\u0439\u0436\u0435 \u043D\u0435 \u0431\u0430\u043B\u0430\u043A\u0430\u0432,
        \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044F.
        \u0425\u0456\u0431\u0430 \u0448\u043E \u0442\u0430\u043A, \u043F\u0430\u0440\u0443
        \u0441\u043B\u0456\u0432 \u043D\u0430 \u0441\u0456\u043B\u044C\u0441\u043A\u0438\u0445
        \u0437\u0431\u043E\u0440\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_2_140_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u043D\u044C\u043E\u0433\u043E \u0432\u043E\u043F\u0448\u0435
        \u043D\u0456\u0431\u0438 \u0440\u043E\u0434\u0438\u0447\u0435\u0439 \u043D\u0435
        \u0431\u0443\u043B\u043E. \u0427\u0438 \u0436\u0438\u043B\u0438 \u0434\u0435\u0441\u044C
        \u0437\u0430 \u0442\u0440\u0438\u0434\u0435\u0432\u2019\u044F\u0442\u044C
        \u0437\u0435\u043C\u0435\u043B\u044C. \u041A\u043E\u0440\u043E\u0442\u0448\u0435,
        \u043C\u0443\u0436\u0438\u043A \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0456\u043A\u043E\u0433\u043E
        \u043D\u0435 \u0445\u043E\u0432\u0430\u0432."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0440-\u043C-\u043C\u2026 \u0429\u043E\u0431 \u0439\u043E\u0433\u043E!
        \u0422\u0430\u043A, \u044F \u043F\u043E\u043C\u0430\u0433\u0430\u0432 \u0406\u043B\u043E\u043D\u0456
        \u0437 \u043F\u0430\u0440\u0442\u0456\u0454\u044E \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443.
        \u0411\u0443\u043B\u043E \u0430\u0436 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u044F\u0449\u0438\u043A\u0456\u0432, \u0442\u043E \u044F \u0437\u0430\u0440\u0438\u0432
        \u0457\u0445 \u0432 \u043E\u0434\u043D\u0456\u0439 \u0456\u0437 \u043C\u043E\u0433\u0438\u043B
        \u043D\u0430 \u0446\u0432\u0438\u043D\u0442\u0430\u0440\u0456."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0441\u043B\u0443\u0445\u0430\u0439-\u043D\u043E
        \u0441\u044E\u0434\u0438. \u0406\u043B\u043E\u043D\u0430 \u2014 \u0448\u0435
        \u0437\u043E\u0432\u0441\u0456\u043C \u0434\u0456\u0432\u0447\u0438\u043D\u043A\u0430.
        \u0411\u0435\u0437\u0437\u0430\u0445\u0438\u0441\u043D\u0430. \u0406 \u0432\u043E\u043D\u0430
        \u0440\u043E\u0431\u0438\u0442\u044C \u0454\u0434\u0438\u043D\u0435, \u0448\u043E
        \u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0432 \u0446\u0456\u0439 \u0433\u043B\u0443\u0448\u0438\u043D\u0456,
        \u043A\u043E\u043B\u0438 \u0432 \u0442\u0435\u0431\u0435 \u0454 \u043C\u043E\u0437\u0433\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0438\u043B \u0448\u043E\u0441\u044C \u0441\u0430\u043C\u0456\u0439
        \u0432\u0438\u043A\u043E\u043F\u0443\u0432\u0430\u0442\u044C \u0457\u0439
        \u0431\u0438 \u043D\u0435 \u0441\u0442\u0430\u043B\u043E, \u0442\u043E \u0456
        \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u043F\u0440\u0430\u0446\u044E\u0432\u0430\u0442\u0438
        \u0437 \u041A\u043E\u0440\u043D\u0456\u0454\u043C. \u0410\u043B\u0435 \u0432\u0456\u043D
        \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u043E \u0434\u0430\u0432\u0438\u0432
        \u043D\u0430 \u043D\u0435\u0457 \u0456 \u0441\u0430\u043C \u0437\u0430\u0432\u0448\u0435
        \u0440\u043E\u0431\u0438\u0432 \u0448\u043E\u0441\u044C \u043D\u0435\u0447\u0435\u0441\u043D\u043E,
        \u043A\u0443\u043C\u0435\u043A\u0430\u0454\u0448?"
    - Language: 1
      Text: 
  - Key: scene_2_143_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0436\u0435 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u043E\u043C
        \u0431\u0443\u043B\u043E \u043B\u0435\u0433\u043A\u043E \u043C\u0430\u043D\u0456\u043F\u0443\u043B\u044E\u0432\u0430\u0442\u0438.
        \u0427\u0438 \u043C\u043E\u0433\u043B\u0430 \u0439\u043E\u0433\u043E \u0441\u0438\u043C\u043F\u0430\u0442\u0456\u044F
        \u0431\u0443\u0442\u0438 \u043C\u043E\u0442\u0438\u0432\u043E\u043C?.."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u043A\u0443\u043C\u0435\u043A\u0430\u043B\u043A\u0430
        \u0432 \u043C\u0435\u043D\u0435 \u043F\u0440\u0430\u0446\u044E\u0454 \u0441\u043F\u0440\u0430\u0432\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0443, \u0437\u0431\u0443\u043B\u0430 \u0431 \u0432\u043E\u043D\u0430
        \u043A\u0440\u0430\u043F\u0430\u043B\u044C \u043A\u0456\u043B\u043E\u0433\u0440\u0430\u043C
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443 \u0431\u0435\u0437 \u0434\u043E\u0437\u0432\u043E\u043B\u0443,
        \u0442\u043E \u0439 \u0448\u043E? \u0413\u0440\u043E\u0448\u0456 \u0432\u0441\u0456\u043C
        \u043D\u0430\u0434\u043E, \u043B\u044E\u0434\u0438 \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0442\u044C\u0441\u044F
        \u0445\u043E\u0447 \u044F\u043A\u043E\u0441\u044C \u0432\u0438\u0436\u0438\u0432\u0430\u0442\u0438.
        \u0410 \u0432 \u043C\u043E\u043B\u043E\u0434\u0456 \u0437\u0430\u0440\u0430
        \u0448\u0430\u043D\u0441\u0456\u0432 \u0432\u043E\u043F\u0448\u0435 \u0434\u0437\u0443\u0441\u044C\u043A\u0438,
        \u044F\u043A\u0448\u043E \u043D\u0435 \u043A\u0440\u0443\u0442\u0438\u0442\u044C\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0446\u0435 \u043D\u0435 \u0440\u043E\u0431\u0438\u0442\u044C
        \u0442\u0430\u043A\u0456 \u0434\u0456\u0457 \u0437\u0430\u043A\u043E\u043D\u043D\u0456\u0448\u0438\u043C\u0438.
        \u0410 \u0432\u0438 \u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0454\u0442\u0435
        \u0431\u0443\u0442\u0438 \u043F\u043E\u0441\u0456\u0431\u043D\u0438\u043A\u043E\u043C
        \u0437\u043B\u043E\u0447\u0438\u043D\u0443, \u044F\u043A\u0449\u043E \u044F
        \u0449\u0435 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u044E
        \u043A\u043E\u0434\u0435\u043A\u0441."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043B\u0456\u0434\u0447\u0430, \u043F\u043E\u0441\u043B\u0443\u0445\u0430\u0439
        \u043C\u0435\u043D\u0435. \u041D\u0456\u0447\u043E\u0433\u043E \u0448\u0435
        \u043D\u0435 \u0441\u0442\u0430\u043B\u043E\u0441\u044F. \u0411\u0443\u0440\u0448\u0442\u0438\u043D
        \u0442\u0430\u043A \u0456 \u043B\u0435\u0436\u0438\u0442\u044C \u043D\u0430
        \u043A\u043B\u0430\u0434\u043E\u0432\u0438\u0449\u0430\u0445, \u043C\u0438
        \u043D\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0438 \u0439\u043E\u0433\u043E
        \u0437\u0431\u0443\u0442\u044C. \u041C\u043E\u0436\u043D\u0430 \u0432\u0441\u0435
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438, \u0437\u043D\u044F\u0442\u0438
        \u043E\u0431\u0432\u0438\u043D\u0443\u0432\u0430\u0447\u0435\u043D\u043D\u044F.
        \u0410\u043B\u0435 \u044F\u043A \u0431\u0438 \u0442\u0430\u043C \u043D\u0435
        \u0431\u0443\u043B\u043E, \u043F\u0440\u043E\u0448\u0443, \u043D\u0435 \u0433\u0443\u0431\u0456\u0442\u044C
        \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_2_143_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u043E\u043D\u0430 \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
        \u0442\u0435 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u0432\u0447\u0438\u043D\u0438\u0442\u044C.
        \u0412\u0438 \u0436 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0442\u0435,
        \u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0441\u0438\u043B \u043D\u0430\u0434\u043E,
        \u0448\u043E\u0431 \u043B\u044E\u0434\u0438\u043D\u0443 \u0432\u0442\u043E\u043F\u0438\u0442\u0438.
        \u041D\u0430\u0432\u0456\u0442\u044C \u044F\u043A\u0431\u0438 \u0434\u0443\u0436\u0435
        \u0445\u043E\u0442\u0456\u043B\u0430, \u0432\u043E\u043D\u0430 \u0431\u0443\u043B\u0430
        \u043D\u0435 \u0437\u0434\u0430\u0442\u043D\u0430 \u0446\u0435 \u0441\u043A\u043E\u0457\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_2_143_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0441\u043B\u043E\u0432\u0438\u0442\u0438 \u0434\u0443\u043C\u043A\u0443,
        \u0449\u043E \u0432 \u0437\u043B\u043E\u0447\u0438\u043D\u0456 \u043C\u0456\u0433
        \u0431\u0443\u0442\u0438 \u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0438\u0439
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_2_143_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u043F\u043E\u0432\u0456\u0441\u0442\u0438 \u043F\u0440\u043E
        \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0443 \u0431\u0456\u043B\u044F
        \u043E\u0437\u0435\u0440\u0430 \u043A\u0443\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_2_143_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0434\u0430\u0442\u0438, \u0449\u043E \u0417\u0430\u0445\u0430\u0440\u0435\u0441
        \u0442\u0430\u043A\u043E\u0436 \u043E\u0434\u0438\u043D \u0456\u0437 \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043D\u0438\u0445,
        \u0430\u0434\u0436\u0435 \u043C\u0430\u0432 \u043C\u043E\u0442\u0438\u0432
        \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F \u041A\u043E\u0440\u043D\u0456\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_144_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0447\u043E\u043C \u0431\u0438 \u0439 \u043D\u0456! \u0425\u0442\u043E,
        \u044F\u043A \u043D\u0435 \u0432\u0456\u043D?"
    - Language: 1
      Text: 
  - Key: scene_2_144_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u0437\u043D\u0430\u0447\u0438\u043B\u0430, \u044F\u043A
        \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u043C\u0456\u043D\u0438\u043B\u0430\u0441\u044F
        \u0434\u0443\u043C\u043A\u0430 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u043F\u0440\u043E \u041E\u043B\u0435\u043A\u0441\u0456\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_144_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0438\u043B\u0438 \u0431 \u0445\u043B\u043E\u043F\u0446\u044E
        \u0442\u043E\u0447\u043D\u043E \u0441\u0442\u0430\u043B\u043E, \u0430 \u041A\u043E\u0440\u043D\u0456\u0439
        \u0439\u043E\u043C\u0443 \u0448\u0435 \u0439 \u0434\u043E\u0432\u0456\u0440\u044F\u0432.
        \u041B\u0435\u0433\u043A\u043E \u043F\u0456\u0434\u0456\u0431\u0438\u0440\u0430\u0442\u0438\u0441\u044F,
        \u044F\u043A \u0442\u043E \u043A\u0430\u0436\u0443\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_2_144_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438 \u043A\u0440\u0443\u0442\u0438\u043B\u0438
        \u0432\u043E\u043D\u0438 \u0448\u043E\u0441\u044C \u0449\u043E\u0434\u043E
        \u0431\u0443\u0440\u0448\u0438\u0442\u043D\u0443. \u0410\u043B\u0435 \u044F\u043A\u0448\u043E
        \u041B\u0435\u0441\u044C \u043D\u0456\u0447\u043E \u043D\u0435 \u0437\u043D\u0430\u0432,
        \u0430 \u043F\u043E\u0442\u0456\u043C \u043D\u0430\u0442\u0440\u0430\u043F\u0438\u0432
        \u043D\u0430 \u0449\u043E\u0434\u0435\u043D\u043D\u0438\u043A \u041A\u043E\u0440\u043D\u0456\u044F,
        \u0446\u0435 \u0431 \u0434\u0443\u0436\u0435 \u0439\u043E\u0433\u043E \u0440\u043E\u0437\u0456\u0437\u043B\u0438\u043B\u043E,
        \u043C\u043E\u0436\u0435\u0448 \u0431\u0443\u0442\u0438 \u043F\u0435\u0432\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_144_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0439\u043E\u0433\u043E \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u044F\u0445
        \u0437\u043B\u0438\u0442\u0438\u0441\u044F \u044F \u0431\u0443\u043B\u0430
        \u043F\u0435\u0432\u043D\u0430 \u043D\u0430 \u0441\u0442\u043E \u0432\u0456\u0434\u0441\u043E\u0442\u043A\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_2_144_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0456\u043A\u0430\u0432\u0430 \u0432\u0435\u0440\u0441\u0456\u044F.
        \u0422\u043E\u0434\u0456 \u043C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
        \u0449\u0435 \u0440\u0430\u0437 \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438
        \u0442\u0456\u043B\u043E \u0432\u0431\u0438\u0442\u043E\u0433\u043E \u0442\u0430
        \u043F\u043E\u0448\u0443\u043A\u0430\u0442\u0438 \u0457\u0439 \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_2_145_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043E\u0441\u043F\u043E\u0434\u0438 \u043F\u043E\u043C\u0438\u043B\u0443\u0439\u2026
        \u042F\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_145_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0448\u043E \u0442\u043E\u0431\u0456
        \u0441\u043A\u0430\u0437\u0430\u0442\u044C, \u0441\u043B\u0456\u0434\u0447\u0430."
    - Language: 1
      Text: 
  - Key: scene_2_145_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0430\u0434\u0430\u0454\u0448 \u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0434\u0456
        \u0432\u0447\u0438\u043D\u0438\u043B\u0430 \u0406\u043B\u043E\u043D\u0430?
        \u0410\u043B\u0435 \u044F \u0434\u043E\u0432\u0456\u0440\u044F\u0432 \u0457\u0439\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_145_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430 \u0456 \u0437\u0432\u0456\u0434\u043A\u0438 \u0432 \u043D\u0435\u0457
        \u0431 \u0432\u0437\u044F\u043B\u0430\u0441\u044F \u0437\u0431\u0440\u043E\u044F?
        \u0422\u0443\u0442 \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u0438\u0441\u043B\u0438\u0432\u0441\u044C\u043A\u0443
        \u0440\u0443\u0448\u043D\u0438\u0446\u044E \u0445\u0440\u0456\u043D \u0434\u0456\u0441\u0442\u0430\u043D\u0435\u0448.
        \u0422\u0440\u0435\u0431\u0430 \u043C\u0430\u0442\u0438 \u0434\u043E\u0437\u0432\u0456\u043B,
        \u0448\u0443\u043A\u0430\u0442\u0438 \u0434\u0435 \u043F\u0440\u0438\u0434\u0431\u0430\u0442\u044C.
        \u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u043F\u043E\u0432\u0456\u0440\u0438\u0442\u0438,
        \u0448\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_145_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0431\u0443\u043B\u0438 \u0431 \u0432\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u043E\u043A\u0456\u0432 \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u043E\u043C,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435, \u043D\u0430\u0432\u0447\u0438\u043B\u0438\u0441\u044F
        \u0431 \u0432\u0456\u0440\u0438\u0442\u0438 \u0432 \u0449\u043E \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_2_145_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043C\u0435\u043D\u0456 \u0442\u0440\u0435\u0431\u0430
        \u0449\u0435 \u0440\u0430\u0437 \u043E\u0433\u043B\u044F\u043D\u0443\u0442\u0438
        \u0442\u0456\u043B\u043E \u0437\u0430\u0433\u0438\u0431\u043B\u043E\u0433\u043E,
        \u044F\u043A\u0449\u043E \u043D\u0435 \u0437\u0430\u043F\u0435\u0440\u0435\u0447\u0443\u0454\u0442\u0435.
        \u041F\u0435\u0440\u0448 \u043D\u0456\u0436 \u0442\u043E\u0447\u043D\u043E
        \u0432\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0438 \u0432\u0435\u0440\u0441\u0456\u044E
        \u0441\u043C\u0435\u0440\u0442\u0456 \u0442\u0440\u0435\u0431\u0430 \u0437\u043D\u0430\u0439\u0442\u0438
        \u0457\u0439 \u043F\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_2_146_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043B\u0456\u0434\u0447\u0430, \u044F\u043A \u0442\u0438 \u0441\u043C\u0456\u0454\u0448!
        \u042F \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0431\u0438\u0432!
        \u0426\u0435 \u0431\u0443\u0434\u0435 \u0432\u0435\u043B\u0438\u043A\u043E\u044E
        \u043F\u043E\u043C\u0438\u043B\u043A\u043E\u044E, \u044F\u043A\u0448\u043E
        \u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_2_146_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u043D\u0430\u044E! \u0419\u0434\u0438, \u0433\u043B\u044F\u043D\u044C
        \u0448\u0435 \u0440\u0430\u0437 \u0442\u0435 \u043A\u043B\u044F\u0442\u0435
        \u0442\u0456\u043B\u043E. \u0422\u0438 \u0436 \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u043A\u0430,
        \u0442\u043E\u0447\u043D\u043E \u0442\u0430\u043C \u043F\u043E\u0431\u0430\u0447\u0438\u0448\u2026
        \u041D\u0435 \u0437\u043D\u0430\u044E, \u044F\u043A\u0456\u0441\u044C \u0441\u043B\u0456\u0434\u0438,
        \u0448\u043E \u044F \u043D\u0435 \u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0438\u0439!
        \u0411\u043E \u044F \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0431\u0438\u0432!"
    - Language: 1
      Text: 
  - Key: scene_2_146_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0431\u0440\u0435-\u0434\u043E\u0431\u0440\u0435, \u043E\u0445\u043E\u043B\u043E\u043D\u044C\u0442\u0435,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435. \u0426\u0435 \u0431\u0443\u043B\u043E
        \u043B\u0438\u0448\u0435 \u043F\u0440\u0438\u043F\u0443\u0449\u0435\u043D\u043D\u044F.
        \u041F\u0456\u0434\u0435\u043C\u043E, \u043F\u043E\u0434\u0438\u0432\u0438\u043C\u043E\u0441\u044F
        \u043D\u0430 \u0442\u0456\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_147_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0442\u0430\u043A \u043C\u0438 \u0437\u043D\u043E\u0432\u0443
        \u043E\u043F\u0438\u043D\u0438\u043B\u0438\u0441\u044F \u0432 \u043B\u044C\u043E\u0441\u0456.
        \u0426\u0456\u0454\u0457 \u043D\u043E\u0447\u0456 \u0445\u043E\u0447\u0430
        \u0431 \u0442\u0440\u0443\u043F \u041A\u043E\u0440\u043D\u0456\u044F \u043D\u0456\u043A\u0443\u0434\u0438
        \u043D\u0435 \u0437\u0440\u0443\u0448\u0438\u0432 \u0456\u0437 \u043C\u0456\u0441\u0446\u044F.
        \u042F \u043C\u043E\u0433\u043B\u0430 \u0437\u043D\u043E\u0432\u0443 \u0434\u043E\u0431\u0440\u0435
        \u0439\u043E\u0433\u043E \u0440\u043E\u0437\u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_147_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0456\u0434\u043A\u0440\u0438\u0432\u0441\u044F
        \u0432\u0438\u0434 \u043D\u0430 \u043E\u0433\u0440\u044F\u0434\u043D\u0435
        \u0442\u0456\u043B\u043E \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u0430,
        \u0440\u043E\u043A\u0456\u0432 \u043F\u2019\u044F\u0442\u0434\u0435\u0441\u044F\u0442\u0438
        \u2014 \u043E\u0434\u044F\u0433 \u044F\u043A \u0433\u0430\u043D\u0447\u0456\u0440\u2019\u044F,
        \u0448\u043A\u0456\u0440\u0430 \u0432\u043E\u043B\u043E\u0445\u0430\u0442\u0430
        \u0442\u0430 \u0431\u0456\u043B\u0430 \u043D\u0435\u043C\u043E\u0432 \u043A\u0440\u0435\u0439\u0434\u0430\u2026
        \u042F\u043A\u0449\u043E \u043D\u0435 \u0440\u0430\u0445\u0443\u0432\u0430\u0442\u0438
        \u0433\u043E\u043B\u043E\u0432\u0438 \u0442\u0430 \u0448\u0438\u0457. \u0412\u043E\u043D\u0438
        \u0441\u0438\u043B\u044C\u043D\u043E \u0440\u043E\u0437\u043F\u0443\u0445\u043B\u0438
        \u0442\u0430 \u0431\u0443\u043B\u0438 \u043A\u043E\u043B\u044C\u043E\u0440\u0443
        \u0441\u0442\u0438\u0433\u043B\u043E\u0457 \u0441\u043B\u0438\u0432\u0438,
        \u0437 \u044F\u043A\u043E\u0457 \u043D\u0456\u0431\u0438 \u043E\u0442-\u043E\u0442
        \u0437\u043B\u0456\u0437\u0435 \u0448\u043A\u0456\u0440\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u0437\u0430\u0434\u0437\u0435\u043B\u0435\u043D\u0447\u0430\u0432
        \u043C\u0456\u0439 \xAB\u043D\u043E\u0432\u0438\u0439\xBB \u0442\u0435\u043B\u0435\u0444\u043E\u043D.
        \u0422\u043E \u0431\u0443\u0432 \u041E\u0440\u0435\u0441\u0442. \u042F \u0432\u0437\u044F\u043B\u0430
        \u0441\u043B\u0443\u0445\u0430\u0432\u043A\u0443, \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u043D\u0430 \u0433\u0443\u0447\u043D\u0438\u0439 \u0437\u0432\u2019\u044F\u0437\u043E\u043A
        \u0442\u0430 \u0432\u0456\u0434\u043A\u043B\u0430\u043B\u0430 \u0442\u0435\u043B\u0435\u0444\u043E\u043D
        \u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0449\u043E\u0431 \u0432\u0456\u043D
        \u043D\u0435 \u0437\u0430\u0432\u0430\u0436\u0430\u0432 \u0440\u043E\u0437\u0434\u0438\u0432\u043B\u044F\u0442\u0438\u0441\u044F
        \u0442\u0456\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0410\u043B\u043B\u043E, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0423\u0433\u0443, \u043A\u0430\u0436\u0438, \u041E\u0440\u0435\u0441\u0442."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0436, \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430
        \u0432\u0441\u0435, \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u0431\u0443\u043B\u043E
        \u0434\u043E\u0431\u0440\u0435 \u0441\u043F\u043B\u0430\u043D\u043E\u0432\u0430\u043D\u0438\u043C.
        \u041E\u0442\u0436\u0435, \u0443 \u0432\u0431\u0438\u0432\u0446\u0456 \u0431\u0443\u0432
        \u0447\u0430\u0441 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
        \u0414\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432
        \u0443\u0441\u0435 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u0438.
        \u041E\u0431\u0440\u0430\u0442\u0438 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
        \u0447\u0430\u0441 \u0442\u0430 \u043C\u043E\u043C\u0435\u043D\u0442. \u0417\u0440\u043E\u0431\u0438\u0442\u0438
        \u043F\u043E\u0441\u0442\u0440\u0456\u043B \u0442\u0430\u043A, \u0449\u043E\u0431
        \u0439\u043E\u0433\u043E \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
        \u0431\u0443\u043B\u043E \u0443\u043D\u0438\u043A\u043D\u0443\u0442\u0438.
        \u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u043B\u043E
        \u0432\u0438\u0436\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u0434\u0438 \u0431 \u044F \u0441\u0442\u0440\u0456\u043B\u044F\u043B\u0430
        \u0432 \u0442\u0430\u043A\u043E\u043C\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443?"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u042F \u043F\u0440\u043E\u0432\u0456\u0432 \u0430\u043D\u0430\u043B\u0456\u0437
        \u0442\u0438\u0445 \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0456\u0439,
        \u044F\u043A\u0456 \u0442\u0438 \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u043B\u0430.
        \u041E\u0442\u0436\u0435, \u0446\u0435 \u0442\u0430\u043A \u0437\u0432\u0430\u043D\u0430
        \xAB\u0435\u043A\u0441\u043F\u0430\u043D\u0441\u0438\u0432\u043D\u0430 \u043A\u0443\u043B\u044F\xBB\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u041A\u043E\u0440\u043D\u0456\u044F
        \u0437\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u041D\u0430 \u0441\u0442\u0456\u043B \u043F\u0456\u0434 \u043D\u0438\u043C
        \u0432\u0438\u043B\u0438\u043B\u043E\u0441\u044F \u0442\u0440\u043E\u0445\u0438
        \u0433\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C-\u043D\u043E,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430, \u0442\u0438
        \u0449\u043E\u0441\u044C \u0441\u043A\u0430\u0437\u0430\u043B\u0430?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0456-\u043D\u0456, \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0422\u043E\u0431\u0456 \u0432\u0456\u0434\u043E\u043C\u043E, \u044F\u043A
        \u0434\u0456\u044E\u0442\u044C \u0442\u0430\u043A\u0456 \u0441\u043D\u0430\u0440\u044F\u0434\u0438?
        \u0412\u043E\u043D\u0438 \u043C\u0430\u044E\u0442\u044C \u043D\u0438\u0437\u044C\u043A\u0443
        \u043F\u0440\u043E\u0431\u0438\u0432\u043D\u0443 \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C,
        \u0430\u043B\u0435 \u043A\u043E\u043B\u0438 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u044E\u0442\u044C
        \u0443 \u0446\u0456\u043B\u044C, \u0442\u043E \xAB\u0440\u043E\u0437\u043A\u0440\u0438\u0432\u0430\u044E\u0442\u044C\u0441\u044F\xBB
        \u0437\u0430\u0432\u0434\u044F\u043A\u0438 \u0432\u0438\u0457\u043C\u0446\u0456
        \u0432 \u0433\u043E\u043B\u043E\u0432\u043D\u0456\u0439 \u0447\u0430\u0441\u0442\u0438\u043D\u0456\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0430\u0437\u043E\u043C \u0437\u0456 \u0441\u0442\u0430\u0440\u0438\u043C,
        \u043C\u0438 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0438
        \u0442\u0456\u043B\u043E \u041A\u043E\u0440\u043D\u0456\u044F \u043D\u0430
        \u0436\u0438\u0432\u0456\u0442. \u042F \u043F\u043E\u0447\u0430\u043B\u0430
        \u043E\u0431\u043C\u0430\u0446\u0443\u0432\u0430\u0442\u0438 \u043F\u043E\u0441\u0438\u043D\u0456\u043B\u0443
        \u043B\u0438\u0441\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u0437 \u0446\u044C\u043E\u0433\u043E \u0431\u043E\u043A\u0443
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u0432
        \u0430\u043A\u043E\u0440\u0434\u0435\u043E\u043D, \u0430\u0434\u0436\u0435
        \u0432\u0441\u044F \u043F\u043E\u0442\u0438\u043B\u0438\u0446\u044F \u0442\u0430
        \u0448\u0438\u044F \u041A\u043E\u0440\u043D\u0456\u044F \u0431\u0443\u043B\u0438
        \u043D\u0435\u043C\u043E\u0432 \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0456
        \u0456\u0437 \u0436\u0438\u0440\u043E\u0432\u0438\u0445 \u0441\u043A\u043B\u0430\u0434\u043E\u043A.
        \u041F\u0456\u0441\u043B\u044F \u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0433\u043E
        \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u043D\u043D\u044F \u0443
        \u0432\u043E\u0434\u0456 \u0432\u043E\u043D\u0438 \u043D\u0430\u0434\u0443\u043B\u0438\u0441\u044F
        \u0442\u0430 \u043F\u043E\u0431\u0456\u043B\u044C\u0448\u0430\u043B\u0438
        \u0432 \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_14
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0422\u0430\u043A\u0456 \u043A\u0443\u043B\u0456 \u0431\u0443\u043B\u043E
        \u0437\u0430\u0431\u043E\u0440\u043E\u043D\u0435\u043D\u043E \u043A\u043E\u043D\u0432\u0435\u043D\u0446\u0456\u0454\u044E
        \u041C\u0456\u0440\u0447\u0443 \u0449\u0435 \u0443 8548-\u043C\u0443. \u0410\u043B\u0435
        \u0432\u043E\u043D\u0438 \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044F
        \u0432 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u0456
        \u0434\u0435\u044F\u043A\u0438\u0445 \u0434\u0435\u0440\u0436\u0430\u0432\u043D\u0438\u0445
        \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_15
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0432\u043E\u043D\u043E!"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_16
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u043C\u0456\u0436
        \u0448\u043E\u0441\u0442\u043E\u044E \u0442\u0430 \u0441\u044C\u043E\u043C\u043E\u044E
        \u0441\u043A\u043B\u0430\u0434\u043A\u043E\u044E \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F
        \u043C\u2019\u044F\u043A\u0438\u0439 \u043E\u0442\u0432\u0456\u0440, \u043F\u043E\u0432\u043D\u0438\u0439
        \u0433\u043D\u043E\u044E. \u0412\u0456\u043D \u0447\u0432\u0430\u043A\u043D\u0443\u0432
        \u043F\u0456\u0434 \u043C\u043E\u0457\u043C\u0438 \u043F\u0430\u043B\u044C\u0446\u044F\u043C\u0438,
        \u043A\u043E\u043B\u0438 \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u0456\u0448\u0435 \u0439\u043E\u0433\u043E
        \u043E\u0431\u043C\u0430\u0446\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_17
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0440\u043E\u0437\u0441\u0443\u043D\u0443\u043B\u0430 \u0441\u043A\u043B\u0430\u0434\u043A\u0438
        \u0432 \u0440\u0456\u0437\u043D\u0456 \u0431\u043E\u043A\u0438. \u0426\u0435
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u043B\u043E
        \u0441\u043F\u043B\u0443\u0442\u0430\u0442\u0438 \u0456\u0437 \u0447\u0438\u043C\u043E\u0441\u044C
        \u0456\u043D\u0448\u0438\u043C!"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_18
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u043B\u044C\u043E\u0432\u0435 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u043D\u044F.
        \u0421\u0445\u043E\u0436\u0435, \u043F\u043E\u0441\u0442\u0440\u0456\u043B
        \u0431\u0443\u0432 \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
        \u043F\u0456\u0434 \u043A\u0443\u0442\u043E\u043C, \u0430\u0434\u0436\u0435
        \u0441\u043D\u0430\u0440\u044F\u0434 \u043D\u0435 \u043F\u0440\u043E\u0431\u0438\u0432
        \u0447\u0435\u0440\u0435\u043F \u0456 \u0437\u0430\u0439\u0448\u043E\u0432
        \u0443 \u0442\u0456\u043B\u043E \u0434\u043E\u0442\u0438\u0447\u043D\u043E.
        \u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043A\u0443\u043B\u044E
        \u0431\u0443\u043B\u043E \u0432\u0438\u043B\u0443\u0447\u0435\u043D\u043E
        \u0437 \u0433\u043E\u043B\u043E\u0432\u0438. \u0410 \u0445\u0438\u0431\u043D\u0435
        \xAB\u0443\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u044F\xBB \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E,
        \u0449\u043E\u0431\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u0438
        \u0441\u043B\u0456\u0434\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0433\u043E
        \u0441\u043F\u043E\u0441\u043E\u0431\u0443 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_19
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u042F \u043F\u0440\u043E \u0442\u0435 \u0439 \u043A\u0430\u0436\u0443,
        \u0449\u043E \u043E\u0441\u044C \u0432\u043E\u043D\u043E! \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E,
        \u0442\u0438 \u0440\u043E\u0437\u0443\u043C\u0456\u0454\u0448? \u0426\u0456
        \u043A\u0443\u043B\u0456 \u043C\u0430\u0454 \u043F\u0440\u0430\u0432\u043E
        \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u043B\u0438\u0448\u0435 \u043F\u043E\u043B\u0456\u0446\u0456\u044F! \u0417\u0432\u0438\u0447\u0430\u0439\u043D\u0456\u0439
        \u043B\u044E\u0434\u0438\u043D\u0456 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u0457\u0445 \u043D\u0435\u0440\u0435\u0430\u043B\u044C\u043D\u043E\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_148_part_20
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0430\u0447, \u041E\u0440\u0435\u0441\u0442\u0435,
        \u0449\u043E?"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_21
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0446\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E?
        \u0417 \u0432\u0438\u0434\u0443 \u043A\u0443\u043B\u0456 \u0436 \u044F\u0441\u043D\u043E,
        \u0449\u043E \u0432\u043E\u043D\u0430 \u0432\u0436\u0435 \u0434\u0435\u044F\u043A\u0438\u0439
        \u043F\u0440\u043E\u043B\u0435\u0436\u0430\u043B\u0430 \u0443 \u0432\u043E\u0434\u0456.
        \u041D\u0456 \u0442\u0438, \u043D\u0456 \u044F \u043D\u0435 \u0431\u0430\u0447\u0438\u043B\u0438
        \u0440\u0430\u043F\u043E\u0440\u0442\u0456\u0432, \u0449\u043E\u0431 \u0445\u0442\u043E\u0441\u044C
        \u0456\u0437 \u043D\u0430\u0448\u0438\u0445 \u043F\u0440\u0438\u0457\u0437\u0434\u0438\u0432
        \u0441\u044E\u0434\u0438 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u043C
        \u0447\u0430\u0441\u043E\u043C. \u0406 \u0436\u043E\u0434\u0435\u043D \u0456\u0437
        \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043D\u0438\u0445
        \u043D\u0435 \u043C\u0456\u0433 \u0431\u0438 \u0434\u0456\u0441\u0442\u0430\u0442\u0438
        \u0446\u0456 \u0441\u043D\u0430\u0440\u044F\u0434\u0438!"
    - Language: 1
      Text: 
  - Key: scene_3_148_part_22
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0432
        \u0437\u0430 \u043C\u043E\u0457\u043C\u0438 \u0434\u0456\u044F\u043C\u0438
        \u043F\u0456\u0434 \u0447\u0430\u0441 \u0443\u0441\u044C\u043E\u0433\u043E
        \u043F\u0440\u043E\u0446\u0435\u0441\u0443, \u0456 \u0431\u0443\u0432 \u0448\u043E\u043A\u043E\u0432\u0430\u043D\u0438\u0439
        \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0436, \u0448\u0432\u0438\u0434\u0448\u0435 \u0437\u0430
        \u0432\u0441\u0435, \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u0431\u0443\u043B\u043E
        \u0434\u043E\u0431\u0440\u0435 \u0441\u043F\u043B\u0430\u043D\u043E\u0432\u0430\u043D\u0438\u043C.
        \u041E\u0442\u0436\u0435, \u0443 \u0432\u0431\u0438\u0432\u0446\u0456 \u0431\u0443\u0432
        \u0447\u0430\u0441 \u043F\u0456\u0434\u0433\u043E\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F.
        \u0414\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432
        \u0443\u0441\u0435 \u043F\u0440\u043E\u043A\u0440\u0443\u0442\u0438\u0442\u0438.
        \u041E\u0431\u0440\u0430\u0442\u0438 \u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u0439
        \u0447\u0430\u0441 \u0442\u0430 \u043C\u043E\u043C\u0435\u043D\u0442. \u0417\u0440\u043E\u0431\u0438\u0442\u0438
        \u043F\u043E\u0441\u0442\u0440\u0456\u043B \u0442\u0430\u043A, \u0449\u043E\u0431
        \u0439\u043E\u0433\u043E \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
        \u0431\u0443\u043B\u043E \u0443\u043D\u0438\u043A\u043D\u0443\u0442\u0438.
        \u041D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u043B\u043E
        \u0432\u0438\u0436\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u0434\u0438 \u0431 \u044F \u0441\u0442\u0440\u0456\u043B\u044F\u043B\u0430
        \u0432 \u0442\u0430\u043A\u043E\u043C\u0443 \u0432\u0438\u043F\u0430\u0434\u043A\u0443?"
    - Language: 1
      Text: 
  - Key: scene_3_149_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B\u0430 \u0433\u043E\u043B\u043E\u0432\u0443
        \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E \u041A\u043E\u0440\u043D\u0456\u044F
        \u0437\u0456 \u0441\u0442\u043E\u0440\u043E\u043D\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u041D\u0430 \u0441\u0442\u0456\u043B \u043F\u0456\u0434 \u043D\u0438\u043C
        \u0432\u0438\u043B\u0438\u043B\u043E\u0441\u044F \u0442\u0440\u043E\u0445\u0438
        \u0433\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u043F\u043E\u043C\u043E\u0436\u0456\u0442\u044C-\u043D\u043E,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0430\u0437\u043E\u043C \u0437\u0456 \u0441\u0442\u0430\u0440\u0438\u043C,
        \u043C\u0438 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0438
        \u0442\u0456\u043B\u043E \u041A\u043E\u0440\u043D\u0456\u044F \u043D\u0430
        \u0436\u0438\u0432\u0456\u0442. \u042F \u043F\u043E\u0447\u0430\u043B\u0430
        \u043E\u0431\u043C\u0430\u0446\u0443\u0432\u0430\u0442\u0438 \u043F\u043E\u0441\u0438\u043D\u0456\u043B\u0443
        \u043B\u0438\u0441\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u0437 \u0446\u044C\u043E\u0433\u043E \u0431\u043E\u043A\u0443
        \u0447\u043E\u043B\u043E\u0432\u0456\u043A \u043D\u0430\u0433\u0430\u0434\u0443\u0432\u0430\u0432
        \u0430\u043A\u043E\u0440\u0434\u0435\u043E\u043D, \u0430\u0434\u0436\u0435
        \u0432\u0441\u044F \u043F\u043E\u0442\u0438\u043B\u0438\u0446\u044F \u0442\u0430
        \u0448\u0438\u044F \u041A\u043E\u0440\u043D\u0456\u044F \u0431\u0443\u043B\u0438
        \u043D\u0435\u043C\u043E\u0432 \u043F\u043E\u0431\u0443\u0434\u043E\u0432\u0430\u043D\u0456
        \u0456\u0437 \u0436\u0438\u0440\u043E\u0432\u0438\u0445 \u0441\u043A\u043B\u0430\u0434\u043E\u043A.
        \u041F\u0456\u0441\u043B\u044F \u0442\u0440\u0438\u0432\u0430\u043B\u043E\u0433\u043E
        \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u043D\u043D\u044F \u0443
        \u0432\u043E\u0434\u0456 \u0432\u043E\u043D\u0438 \u043D\u0430\u0434\u0443\u043B\u0438\u0441\u044F
        \u0442\u0430 \u043F\u043E\u0431\u0456\u043B\u044C\u0448\u0430\u043B\u0438
        \u0432 \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0432\u043E\u043D\u043E!"
    - Language: 1
      Text: 
  - Key: scene_3_149_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0431\u043B\u0438\u0437\u043D\u043E \u043C\u0456\u0436
        \u0448\u043E\u0441\u0442\u043E\u044E \u0442\u0430 \u0441\u044C\u043E\u043C\u043E\u044E
        \u0441\u043A\u043B\u0430\u0434\u043A\u043E\u044E \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0443\u0432\u0430\u0432\u0441\u044F
        \u043C\u2019\u044F\u043A\u0438\u0439 \u043E\u0442\u0432\u0456\u0440, \u043F\u043E\u0432\u043D\u0438\u0439
        \u0433\u043D\u043E\u044E. \u0412\u0456\u043D \u0447\u0430\u0432\u043A\u043D\u0443\u0432
        \u043F\u0456\u0434 \u043C\u043E\u0457\u043C\u0438 \u043F\u0430\u043B\u044C\u0446\u044F\u043C\u0438,
        \u043A\u043E\u043B\u0438 \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u0440\u0435\u0442\u0435\u043B\u044C\u043D\u0456\u0448\u0435 \u0439\u043E\u0433\u043E
        \u043E\u0431\u043C\u0430\u0446\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0440\u043E\u0437\u0441\u0443\u043D\u0443\u043B\u0430 \u0441\u043A\u043B\u0430\u0434\u043A\u0438
        \u0432 \u0440\u0456\u0437\u043D\u0456 \u0431\u043E\u043A\u0438. \u0426\u0435
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u043B\u043E
        \u0441\u043F\u043B\u0443\u0442\u0430\u0442\u0438 \u0456\u0437 \u0447\u0438\u043C\u043E\u0441\u044C
        \u0456\u043D\u0448\u0438\u043C!"
    - Language: 1
      Text: 
  - Key: scene_3_149_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u043B\u044C\u043E\u0432\u0435 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u043D\u044F.
        \u0421\u0445\u043E\u0436\u0435, \u043F\u043E\u0441\u0442\u0440\u0456\u043B
        \u0431\u0443\u0432 \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u0438\u0439
        \u043F\u0456\u0434 \u043A\u0443\u0442\u043E\u043C, \u0430\u0434\u0436\u0435
        \u0441\u043D\u0430\u0440\u044F\u0434 \u043D\u0435 \u043F\u0440\u043E\u0431\u0438\u0432
        \u0447\u0435\u0440\u0435\u043F \u0456 \u0437\u0430\u0439\u0448\u043E\u0432
        \u0443 \u0442\u0456\u043B\u043E \u0434\u043E\u0442\u0438\u0447\u043D\u043E.
        \u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043A\u0443\u043B\u044E
        \u0431\u0443\u043B\u043E \u0432\u0438\u043B\u0443\u0447\u0435\u043D\u043E
        \u0437 \u0433\u043E\u043B\u043E\u0432\u0438. \u0410 \u0445\u0438\u0431\u043D\u0435
        \xAB\u0443\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u044F\xBB \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E,
        \u0449\u043E\u0431\u0438 \u043F\u0440\u0438\u0445\u043E\u0432\u0430\u0442\u0438
        \u0441\u043B\u0456\u0434\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0433\u043E
        \u0441\u043F\u043E\u0441\u043E\u0431\u0443 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_149_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u0432
        \u0437\u0430 \u043C\u043E\u0457\u043C\u0438 \u0434\u0456\u044F\u043C\u0438
        \u043F\u0456\u0434 \u0447\u0430\u0441 \u0443\u0441\u044C\u043E\u0433\u043E
        \u043F\u0440\u043E\u0446\u0435\u0441\u0443, \u0456 \u0431\u0443\u0432 \u0448\u043E\u043A\u043E\u0432\u0430\u043D\u0438\u0439
        \u0432\u0456\u0434\u043A\u0440\u0438\u0442\u0442\u044F\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_150_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043C\u0435\u043D\u0435\u2026 \u0412\u0437\u0430\u0433\u0430\u043B\u0456
        \u043D\u0435\u043C\u0430\u0454 \u0441\u043B\u0456\u0432\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_150_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u043E\u0442\u0456\u043B\u0430 \u043D\u0430\u0434\u0443\u0440\u0438\u0442\u0438
        \u043C\u0435\u043D\u0435, \u043A\u043B\u044F\u0442\u0430 \u043A\u0443\u0440\u0432\u0430?
        \u041D\u0430\u0434\u0443\u0440\u0438\u0442\u0438 \u0432\u0441\u0435 \u0441\u0435\u043B\u0438\u0449\u0435?!"
    - Language: 1
      Text: 
  - Key: scene_3_150_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E, \u0443 \u0442\u0435\u0431\u0435
        \u0442\u0430\u043C \u0443\u0441\u0435 \u0434\u043E\u0431\u0440\u0435?\xBB"
    - Language: 1
      Text: 
  - Key: scene_3_150_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u041E\u0440\u0435\u0441\u0442\u0435. \u0412\u0438\u0431\u0430\u0447,
        \u044F \u043F\u0435\u0440\u0435\u0434\u0437\u0432\u043E\u043D\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_150_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0435\u043F\u0435\u0440 \u043F\u0440\u0438\u0433\u0430\u0434\u0443\u044E!
        \u042F \u0431\u0430\u0447\u0438\u0432 \u0442\u0435 \u043D\u0430 \u0432\u0443\u043B\u0438\u0446\u044F\u0445
        \u0441\u0435\u043B\u0430 \u0434\u0435\u0441\u044C \u043A\u0456\u043B\u044C\u043A\u0430
        \u0434\u043D\u0456\u0432 \u0442\u043E\u043C\u0443. \u042F\u043A \u0437\u0440\u0443\u0447\u043D\u043E,
        \u0432\u0431\u0438\u0442\u0438 \u043B\u044E\u0434\u0438\u043D\u0443, \u0430
        \u043F\u043E\u0442\u0456\u043C \xAB\u0440\u043E\u0437\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u0442\u0438\xBB
        \u0446\u0435. \u041D\u0430\u0448\u043E \u0432\u0435\u0441\u044C \u0446\u0435\u0439
        \u0442\u0435\u0430\u0442\u0440?!"
    - Language: 1
      Text: 
  - Key: scene_3_150_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435, \u0446\u0435 \u044F\u043A\u0435\u0441\u044C
        \u043D\u0435\u043F\u043E\u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F.
        \u042F \u043D\u0435 \u0431\u0443\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_150_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0406\u041A\u041E\u041C\u0423 \u0432 \u0446\u044C\u043E\u043C
        \u043A\u043B\u044F\u0442\u043E\u043C \u0441\u0435\u043B\u0438\u0449\u0456
        \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0440\u0438\u0442\u044C!
        \u0417\u0430\u0431\u0438\u0440\u0430\u0439\u0441\u044F \u0437\u0432\u0456\u0434\u0441\u0438,
        \u0441\u043B\u0456\u0434\u0447\u0430, \u0437\u0430\u0431\u0438\u0440\u0430\u0439\u0441\u044F!!!"
    - Language: 1
      Text: 
  - Key: scene_3_151_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043C\u0435\u043D\u0435\u2026 \u0412\u0437\u0430\u0433\u0430\u043B\u0456
        \u043D\u0435\u043C\u0430\u0454 \u0441\u043B\u0456\u0432. \u042F \u043D\u0435
        \u0437\u043D\u0430\u044E, \u0445\u0442\u043E \u043C\u0456\u0433 \u0446\u0435
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_151_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0442\u0438, \u043F\u0435\u0432\u043D\u043E, \u0434\u0443\u043C\u0430\u0454\u0448,
        \u0448\u043E \u0442\u043E \u0431\u0443\u0432 \u044F?! \u0422\u0438 \u0436
        \u0442\u0430\u043A \u0446\u0435 \u0456 \u0441\u043A\u0430\u0437\u0430\u043B\u0430!
        \u0406\u0437 \u0441\u0430\u043C\u043E\u0433\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u043F\u0456\u0434\u043E\u0437\u0440\u044E\u0432\u0430\u043B\u0430 \u043C\u0435\u043D\u0435!
        \u041B\u0438\u0448 \u0447\u0435\u0440\u0435\u0437 \u0442\u0435, \u0448\u043E
        \u044F \u0437\u0440\u043E\u0431\u0438\u0432 \u0434\u043E\u0431\u0440\u0435
        \u0434\u0456\u043B\u043E, \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u0432
        \u043F\u0440\u043E \u043C\u0435\u0440\u0442\u0432\u043E\u0433\u043E!"
    - Language: 1
      Text: 
  - Key: scene_3_151_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435, \u044F \u043D\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_151_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0406\u041A\u041E\u041C\u0423 \u0432 \u0446\u044C\u043E\u043C
        \u043A\u043B\u044F\u0442\u043E\u043C \u0441\u0435\u043B\u0438\u0449\u0456
        \u043D\u0435 \u043C\u043E\u0436\u043D\u0430 \u0432\u0456\u0440\u0438\u0442\u044C!
        \u0417\u0430\u0431\u0438\u0440\u0430\u0439\u0441\u044F \u0437\u0432\u0456\u0434\u0441\u0438,
        \u0441\u043B\u0456\u0434\u0447\u0430, \u0437\u0430\u0431\u0438\u0440\u0430\u0439\u0441\u044F!!!"
    - Language: 1
      Text: 
  - Key: scene_3_152_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043C\u0435\u043D\u0435\u2026 \u0412\u0437\u0430\u0433\u0430\u043B\u0456
        \u043D\u0435\u043C\u0430\u0454 \u0441\u043B\u0456\u0432. \u042F \u043D\u0435
        \u0437\u043D\u0430\u044E, \u0445\u0442\u043E \u043C\u0456\u0433 \u0446\u0435
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_152_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044C, \u0442\u0438
        \u0437\u2019\u044F\u0441\u0443\u0454\u0448 \u0443\u0441\u0435, \u0441\u043B\u0456\u0434\u0447\u0430,
        \u0431\u043E \u044F \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0430\u043A
        \u043D\u0435 \u043C\u043E\u0436\u0443. \u0421\u0442\u0440\u0430\u0448\u043D\u043E
        \u0443\u044F\u0432\u043B\u044F\u0442\u0438, \u0448\u043E \u0432 \u043D\u0430\u0448\u043E\u043C
        \u0441\u0435\u043B\u0456 \u0445\u043E\u0434\u0438\u0442\u044C \u0443\u0431\u0438\u0432\u0446\u044F
        \u0437 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E
        \u0437\u0431\u0440\u043E\u0454\u044E. \u0426\u0435 \u0436 \u0445\u0442\u043E
        \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u043C\u043E\u0436\u0435
        \u0431\u0443\u0442\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u043C\u2026
        \u042F, \u0430\u0431\u043E \u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_152_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0437\u0430 \u0442\u0443 \u0456\u0441\u0442\u043E\u0440\u0456\u044E
        \u0437 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u043E\u043C \u043D\u0435
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439. \u042F \u043B\u0438\u0448\u0443\u0441\u044F
        \u0442\u0443\u0442, \u0443 \u0434\u043E\u043C\u0456, \u0434\u0435 \u043C\u0435\u043D\u0456
        \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E. \u0417\u0430\u0432\u0442\u0440\u0430
        \u043F\u043E\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456, \u0434\u0435
        \u0437\u0430\u043A\u043E\u043F\u0430\u043D\u0435 \u043A\u0430\u043C\u0456\u043D\u043D\u044F
        \u0456 \u0431\u0443\u0434\u044C \u0449\u043E \u0431\u0443\u0434\u0435. \u0425\u0430\u0439
        \u0443\u0436\u0435 \u043F\u0440\u0430\u0432\u043E\u0441\u0443\u0434\u0434\u044F
        \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C \u043C\u043E\u044E \u0434\u043E\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_152_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
        \u0447\u0438\u043D\u0438\u0442\u0435, \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435.
        \u041E\u0431\u0456\u0446\u044F\u044E \u0432\u0430\u043C, \u0443\u0441\u0435
        \u0431\u0443\u0434\u0435 \u0447\u0435\u0441\u043D\u043E. \u042F \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u044E,
        \u0449\u043E \u0432\u0438 \u0434\u0443\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0438
        \u0441\u043B\u0456\u0434\u0441\u0442\u0432\u0443, \u0456 \u0446\u0435 \u0437\u043D\u0430\u0447\u043D\u043E
        \u043F\u043E\u043C\u2019\u044F\u043A\u0448\u0438\u0442\u044C \u0432\u0438\u0440\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_3_153_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0430\u0440\u0438\u0439 \u0433\u0440\u0430\u0431\u0430\u0440
        \u0441\u0445\u043E\u043F\u0438\u0432 \u043B\u043E\u043F\u0430\u0442\u0443
        \u0439 \u0456\u0437 \u043B\u044E\u0442\u0442\u044E, \u044F\u043A\u0443 \u043F\u0456\u0434\u0436\u0438\u0432\u043B\u044E\u0432\u0430\u0432
        \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0438\u0439 \u0436\u0430\u0445,
        \u043A\u0438\u043D\u0443\u0432\u0441\u044F \u043D\u0430 \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_153_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0404\u0434\u0438\u043D\u0435, \u0449\u043E \u044F \u043C\u043E\u0433\u043B\u0430
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u2014 \u0446\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_153_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u043A\u0440\u0438\u0442\u0438\u0441\u044F \u0440\u0443\u043A\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_153_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0432\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438
        \u043B\u043E\u043F\u0430\u0442\u0443 \u0432 \u0441\u0442\u0430\u0440\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_153_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0434\u0430\u0440\u0438\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u0432 \u043F\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_3_153_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0434\u0443\u0448\u0438\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u0436\u0430\u043A\u0435\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_154_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0436\u0430\u043B\u044C, \u0446\u0435\u0439 \u043A\u0440\u043E\u043A
        \u0431\u0443\u0432 \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u0438\u043C.
        \u0423 \u0442\u0430\u043A\u0438\u0439 \u0441\u043F\u043E\u0441\u0456\u0431
        \u044F \u043D\u0456\u044F\u043A \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
        \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438\u0441\u044F \u0432\u0456\u0434
        \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_154_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u044E
        \u0441\u0432\u0456\u0434\u043E\u043C\u0456\u0441\u0442\u044C \u043D\u0430\u0432\u0456\u043A\u0438
        \u043F\u043E\u0433\u043B\u0438\u043D\u0443\u043B\u0430 \u043F\u0456\u0442\u044C\u043C\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_155_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u043D\u0435 \u0431\u0443\u0432
        \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E \u0433\u043E\u0442\u043E\u0432\u0438\u043C
        \u0434\u043E \u0431\u043E\u044E, \u043D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u0432\u0441\u044F
        \u043F\u0440\u043E\u0434\u0443\u043C\u0443\u0432\u0430\u0442\u0438 \u043A\u0440\u043E\u043A\u0438
        \u043D\u0430\u043F\u0435\u0440\u0435\u0434, \u0442\u043E\u0436 \u043C\u0435\u043D\u0456
        \u043B\u0435\u0433\u043A\u043E \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0432\u0456\u0434\u0456\u0431\u0440\u0430\u0442\u0438 \u0432 \u043D\u044C\u043E\u0433\u043E
        \u0446\u044E \xAB\u043D\u0435\u043F\u0435\u0440\u0435\u0432\u0435\u0440\u0448\u0435\u043D\u0443
        \u0437\u0431\u0440\u043E\u044E\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_155_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u043B\u0456 \u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_155_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043A\u0438\u043D\u0443\u043B\u0430 \u043B\u043E\u043F\u0430\u0442\u0443
        \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0442\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_155_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0443\u0432\u0430\u043B\u0430
        \u0441\u0442\u0430\u0440\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_155_1_1
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0417\u0430\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u044F! \u041C\u0438
        \u043E\u0431\u0438\u0434\u0432\u0430 \u043D\u0456 \u0432 \u0447\u043E\u043C\u0443
        \u043D\u0435 \u0432\u0438\u043D\u043D\u0456! \u042F \u0437\u0433\u043E\u0434\u043D\u0430
        \u0437\u0431\u0440\u0435\u0445\u0430\u0442\u0438 \u0443 \u0437\u0432\u0456\u0442\u0456
        \u0437\u0430\u0440\u0430\u0434\u0438 \u0442\u0435\u0431\u0435\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_155_1_2
    LocalizationDatas:
    - Language: 0
      Text: "\xAB\u0417\u0443\u043F\u0438\u043D\u0438\u0441\u044C, \u0434\u043E\u043A\u0438
        \u043D\u0435 \u043F\u0456\u0437\u043D\u043E! \u0426\u0438\u043C\u0438 \u0434\u0456\u044F\u043C\u0438
        \u0442\u0438 \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u043E\u0433\u0456\u0440\u0448\u0443\u0454\u0448
        \u0441\u0432\u0456\u0439 \u0432\u0438\u0440\u043E\u043A\xBB."
    - Language: 1
      Text: 
  - Key: scene_3_156_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0430\u0445\u2026 \u0425\u0430\u0445\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_156_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u0445-\u0440-\u0440-\u0440\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_156_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0456\u043B\u044C\u043A\u0438 \u043D\u0435 \u0441\u043C\u0456\u0439
        \u0431\u0440\u0435\u0445\u0430\u0442\u0438 \u043C\u0435\u043D\u0456! \u0406\u043D\u0430\u043A\u0448\u0435
        \u044F!.."
    - Language: 1
      Text: 
  - Key: scene_3_156_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u0440\u0442, \u0448\u043E \u043D\u0430 \u043C\u0435\u043D\u0435
        \u043D\u0430\u0439\u0448\u043B\u043E\u2026 \u0414\u044F\u043A\u0443\u044E,
        \u0448\u043E \u043F\u043E\u043C\u043E\u0433\u043B\u0430 \u043E\u043A\u043B\u0438\u0433\u0430\u0442\u0438,
        \u0441\u043B\u0456\u0434\u0447\u0430. \u0414\u043E\u043A\u0438 \u044F \u0448\u043E\u0441\u044C
        \u0436\u0430\u0445\u043B\u0438\u0432\u0435 \u043D\u0435 \u043D\u0430\u0442\u0432\u043E\u0440\u0438\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_156_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044C, \u0442\u0438
        \u0437\u2019\u044F\u0441\u0443\u0454\u0448 \u0443\u0441\u0435, \u0431\u043E
        \u044F \u0431\u0456\u043B\u044C\u0448\u0435 \u0442\u0430\u043A \u043D\u0435
        \u043C\u043E\u0436\u0443. \u0421\u0442\u0440\u0430\u0448\u043D\u043E \u0443\u044F\u0432\u043B\u044F\u0442\u0438,
        \u0448\u043E \u0432 \u043D\u0430\u0448\u043E\u043C \u0441\u0435\u043B\u0456
        \u0445\u043E\u0434\u0438\u0442\u044C \u0443\u0431\u0438\u0432\u0446\u044F
        \u0437 \u0432\u043E\u0433\u043D\u0435\u043F\u0430\u043B\u044C\u043D\u043E\u044E
        \u0437\u0431\u0440\u043E\u0454\u044E. \u0426\u0435 \u0436 \u0445\u0442\u043E
        \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E \u043C\u043E\u0436\u0435
        \u0431\u0443\u0442\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_156_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0437\u0430 \u0442\u0443 \u0456\u0441\u0442\u043E\u0440\u0456\u044E
        \u0437 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u043E\u043C \u043D\u0435
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0439. \u042F \u043B\u0438\u0448\u0443\u0441\u044F
        \u0442\u0443\u0442, \u0443 \u0434\u043E\u043C\u0456, \u0434\u0435 \u043C\u0435\u043D\u0456
        \u0431\u0435\u0437\u043F\u0435\u0447\u043D\u043E. \u0417\u0430\u0432\u0442\u0440\u0430
        \u043F\u043E\u043A\u0430\u0436\u0443 \u0442\u043E\u0431\u0456, \u0434\u0435
        \u0437\u0430\u043A\u043E\u043F\u0430\u043D\u0435 \u043A\u0430\u043C\u0456\u043D\u043D\u044F
        \u0456 \u0431\u0443\u0434\u044C \u0449\u043E \u0431\u0443\u0434\u0435. \u0425\u0430\u0439
        \u0443\u0436\u0435 \u043F\u0440\u0430\u0432\u043E\u0441\u0443\u0434\u0434\u044F
        \u0432\u0438\u0440\u0456\u0448\u0438\u0442\u044C \u043C\u043E\u044E \u0434\u043E\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_156_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438 \u0432\u0447\u0438\u043D\u0438\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0435. \u042F \u0441\u0442\u0440\u0438\u043C\u0430\u044E
        \u0441\u0432\u043E\u044E \u043E\u0431\u0456\u0446\u044F\u043D\u043A\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_157_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0428\u043A\u043E\u0434\u0430, \u043D\u0435 \u043F\u043E\u0434\u0456\u044F\u043B\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_157_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0432\u0438\u0434\u0430\u0432\u0441\u044F
        \u0434\u043E\u0432\u043E\u043B\u0456 \u0441\u0438\u043B\u044C\u043D\u0438\u043C
        \u043D\u0430\u0432\u0456\u0442\u044C \u0431\u0435\u0437 \u043B\u043E\u043F\u0430\u0442\u0438.
        \u0420\u043E\u043A\u0438 \u0432\u0438\u043A\u043E\u043F\u0443\u0432\u0430\u043D\u043D\u044F
        \u043C\u043E\u0433\u0438\u043B \u043D\u0430 \u0446\u0432\u0438\u043D\u0442\u0430\u0440\u0456
        \u0437\u0440\u043E\u0431\u0438\u043B\u0438 \u0439\u043E\u0433\u043E \u0440\u0443\u043A\u0438
        \u043C\u0430\u0439\u0436\u0435 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_157_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0456\u0434\u0447\u0443\u043B\u0430 \u0441\u0438\u043B\u044C\u043D\u0438\u0439
        \u0443\u0434\u0430\u0440 \u0443 \u0432\u0438\u043B\u0438\u0446\u044E \u0456
        \u043B\u0435\u0434\u044C \u043D\u0435 \u0432\u043F\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_157_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u2019\u0454\u0448 \u044F\u043A \u0434\u0456\u0432\u0447\u0430\u2026
        \u041A\u0445\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_157_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u044F
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_157_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0430\u043B\u0438\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_157_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0434\u0430\u0440\u0438\u0442\u0438 \u0433\u0440\u0430\u0431\u0430\u0440\u044F
        \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C."
    - Language: 1
      Text: 
  - Key: scene_3_158_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F, \u0449\u043E
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0443\u0436\u0435 \u043C\u0430\u0439\u0436\u0435
        \u0437\u0440\u0456\u0434\u043D\u0438\u0432\u0441\u044F \u0437 \u043B\u043E\u043F\u0430\u0442\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_158_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u043E\u043D\u0430 \u0431\u0443\u043B\u0430 \u0434\u043B\u044F
        \u043D\u044C\u043E\u0433\u043E \u044F\u043A \u0434\u043E\u0447\u043A\u0430.
        \u0410\u0431\u043E \u044F\u043A \u043F\u2019\u044F\u0442\u0430 \u043A\u0456\u043D\u0446\u0456\u0432\u043A\u0430.
        \u0410\u0431\u043E \u0436 \u044F\u043A\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_158_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435\u0432\u0430\u0436\u043B\u0438\u0432\u043E, \u0431\u043E
        \u0432\u0456\u043D \u043B\u0435\u0433\u043A\u043E \u0432\u0445\u0438\u043B\u0438\u0432\u0441\u044F
        \u0432\u0456\u0434 \u043D\u0435\u0457, \u043F\u0456\u0441\u043B\u044F \u0447\u043E\u0433\u043E
        \u044F \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430 \u0440\u0456\u0432\u043D\u043E\u0432\u0430\u0433\u0443.
        \u0421\u0442\u0430\u0440\u0438\u0439 \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432\u0441\u044F
        \u0446\u0438\u043C \u0448\u0430\u043D\u0441\u043E\u043C, \u0449\u043E\u0431
        \u043C\u0456\u0446\u043D\u043E \u0441\u0445\u043E\u043F\u0438\u0442\u0438
        \u043C\u0435\u043D\u0435 \u0437\u0430 \u0440\u0443\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_158_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0432\u0438\u0434\u0430\u0432\u0441\u044F
        \u0434\u043E\u0432\u043E\u043B\u0456 \u0441\u0438\u043B\u044C\u043D\u0438\u043C
        \u043D\u0430\u0432\u0456\u0442\u044C \u0431\u0435\u0437 \u043B\u043E\u043F\u0430\u0442\u0438.
        \u0420\u043E\u043A\u0438 \u0432\u0438\u043A\u043E\u043F\u0443\u0432\u0430\u043D\u043D\u044F
        \u043C\u043E\u0433\u0438\u043B \u043D\u0430 \u0446\u0432\u0438\u043D\u0442\u0430\u0440\u0456
        \u0437\u0440\u043E\u0431\u0438\u043B\u0438 \u0439\u043E\u0433\u043E \u0440\u0443\u043A\u0438
        \u043C\u0430\u0439\u0436\u0435 \u0441\u0442\u0430\u043B\u0435\u0432\u0438\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_158_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0431\u0440\u043E\u044F \u0432\u0438\u043B\u0435\u0442\u0456\u043B\u0430
        \u0439 \u0443 \u043C\u0435\u043D\u0435, \u0449\u043E \u0437\u0440\u0456\u0432\u043D\u044F\u043B\u043E
        \u043D\u0430\u0448\u0456 \u0437 \u0434\u0456\u0434\u043E\u043C \u0448\u0430\u043D\u0441\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_158_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E \u044F
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_158_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0432\u0430\u043B\u0438\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u043D\u0430 \u043F\u0456\u0434\u043B\u043E\u0433\u0443."
    - Language: 1
      Text: 
  - Key: scene_3_158_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0434\u0430\u0440\u0438\u0442\u0438 \u0433\u0440\u0430\u0431\u0430\u0440\u044F
        \u0443 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C."
    - Language: 1
      Text: 
  - Key: scene_3_159_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430
        \u0432\u0430\u0433\u0443 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u043F\u0440\u043E\u0442\u0438 \u043D\u044C\u043E\u0433\u043E \u0436 \u0441\u0430\u043C\u043E\u0433\u043E.
        \u0421\u0442\u0430\u0440\u0438\u0439 \u043F\u043E\u043B\u0435\u0442\u0456\u0432
        \u0434\u043E\u0434\u043E\u043B\u0443\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_159_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0432 \u043E\u0441\u0442\u0430\u043D\u043D\u0456\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442 \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u0449\u043E \u0432\u0456\u043D \u0441\u0445\u043E\u043F\u0438\u0432 \u043C\u0435\u043D\u0435
        \u0437\u0430 \u043A\u043E\u043C\u0456\u0440, \u0456 \u0432\u0436\u0435 \u0431\u0443\u043B\u0430
        \u0439\u043E\u0433\u043E \u0447\u0435\u0440\u0433\u0430 \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0432\u0430\u0433\u043E\u044E. \u0423 \u043F\u0430\u0434\u0456\u043D\u043D\u0456
        \u0417\u0430\u0440\u0430\u0445\u0435\u0441 \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u0432
        \u0456 \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_159_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0438 \u043F\u043E\u043A\u043E\u0442\u0438\u043B\u0438\u0441\u044F
        \u043F\u0456\u0434\u043B\u043E\u0433\u043E\u044E. \u0420\u0443\u043A\u0430\u043C\u0438
        \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u043F\u0440\u0438\u043A\u0440\u0438\u0432\u0430\u0442\u0438\u0441\u044F
        \u0432\u0456\u0434 \u0445\u0430\u043E\u0442\u0438\u0447\u043D\u0438\u0445
        \u0443\u0434\u0430\u0440\u0456\u0432 \u0441\u0442\u0430\u0440\u043E\u0433\u043E.
        \u0417\u0440\u0435\u0448\u0442\u043E\u044E, \u0432\u0456\u043D \u043E\u043F\u0438\u043D\u0438\u0432\u0441\u044F
        \u0437\u0432\u0435\u0440\u0445\u0443. \u0423 \u0446\u0456\u0439 \u043F\u043E\u0437\u0438\u0446\u0456\u0457
        \u044F \u0440\u0438\u0437\u0438\u043A\u0443\u0432\u0430\u043B\u0430 \u0434\u0443\u0436\u0435
        \u0441\u043A\u043E\u0440\u043E \u043F\u0440\u0438\u0454\u0434\u043D\u0430\u0442\u0438\u0441\u044F
        \u0434\u043E \u041A\u043E\u0440\u043D\u0456\u044F \u0432 \u044F\u043A\u043E\u0441\u0442\u0456
        \u043F\u043E\u043A\u0456\u0439\u043D\u0438\u043A\u0430 \u043D\u0430 \u0441\u0442\u043E\u043B\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_159_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0443\u043C\u0430\u0442\u0438 \u0442\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u0448\u0432\u0438\u0434\u043A\u043E. \u041D\u0430\u0439\u043A\u0440\u0430\u0449\u0438\u043C
        \u0432\u0438\u0445\u043E\u0434\u043E\u043C \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u043B\u043E\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_159_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0456\u0448\u0442\u043E\u0432\u0445\u043D\u0443\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u0456\u0437 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_3_159_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0442\u044F\u0433\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E
        \u043B\u043E\u043F\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_160_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F,
        \u044F \u0437\u0430\u0432\u0436\u0434\u0438 \u0431\u0443\u043B\u0430 \u0448\u0432\u0438\u0434\u043A\u0430,
        \u0430\u043B\u0435 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0443 \u0437
        \u044F\u043A\u043E\u044E\u0441\u044C \u0437\u0432\u0456\u0440\u0438\u043D\u043E\u044E
        \u043F\u0440\u0443\u0434\u043A\u0456\u0441\u0442\u044E \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u043F\u0435\u0440\u0435\u0445\u043E\u043F\u0438\u0442\u0438 \u043C\u043E\u044E
        \u0440\u0443\u043A\u0443 \u0439 \u0432\u0438\u043A\u0440\u0443\u0442\u0438\u0442\u0438
        \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u042F \u0433\u043E\u043B\u043E\u0441\u043D\u043E
        \u0437\u043E\u0439\u043A\u043D\u0443\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_3_160_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0456\u043B\u044C \u0431\u0443\u0432 \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u043D\u0438\u043C\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_160_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u044F \u0456 \u043D\u0435 \u0442\u0435\u0440\u043F\u0456\u043B\u0430
        \u0439\u043E\u0433\u043E \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0434\u043E\u0432\u0433\u043E.
        \u0421\u0442\u0430\u0440\u0438\u0439 \u0441\u0430\u043C \u0437\u0430\u0433\u043D\u0430\u0432
        \u0441\u0435\u0431\u0435 \u0432 \u0433\u043B\u0443\u0445\u0438\u0439 \u043A\u0443\u0442."
    - Language: 1
      Text: 
  - Key: scene_3_160_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0456\u0437\u043A\u0438\u043C \u0440\u0443\u0445\u043E\u043C
        \u044F \u0437\u0456\u0440\u0432\u0430\u043B\u0430 \u0437\u0456 \u0441\u0432\u043E\u0454\u0457
        \u0448\u0438\u0457 \u043F\u043E\u0437\u043E\u043B\u043E\u0447\u0435\u043D\u0435
        \u043C\u0435\u0442\u0430\u043B\u0435\u0432\u0435 \u043D\u0430\u043C\u0438\u0441\u0442\u043E.
        \u041C\u043E\u044E \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u0443 \u0437\u0431\u0440\u043E\u044E\u2026
        \u042F\u043A\u0443 \u044F \u0432\u0438\u0433\u0430\u0434\u0430\u043B\u0430
        \u0437\u0430\u0440\u0430\u0437."
    - Language: 1
      Text: 
  - Key: scene_3_160_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u043A\u0440\u0443\u0442\u0438\u043B\u0430 \u043A\u043E\u043B\u044C\u0454
        \u043D\u0430\u0432\u043A\u043E\u043B\u043E \u043A\u0443\u043B\u0430\u043A\u0430
        \u0439 \u043A\u0456\u043B\u044C\u043A\u0430 \u0440\u0430\u0437\u0456\u0432
        \u0437\u0430\u0440\u044F\u0434\u0438\u043B\u0430 \u0441\u0442\u0430\u0440\u043E\u043C\u0443
        \u043F\u0440\u044F\u043C\u043E \u0432 \u043E\u0431\u043B\u0438\u0447\u0447\u044F.
        \u041C\u0456\u0436 \u043E\u0447\u0435\u0439, \u043F\u043E \u043D\u043E\u0441\u0456,
        \u0443 \u0441\u043A\u0440\u043E\u043D\u044E. \u0423 \u0446\u0456 \u0443\u0434\u0430\u0440\u0438
        \u044F \u0432\u043A\u043B\u0430\u0434\u0430\u043B\u0430 \u0432\u0441\u0435
        \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F \u0431\u043E\u043B\u044E.
        \u041B\u0438\u043D\u0443\u043B\u0430 \u043A\u0440\u043E\u0432\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_161_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0438\u0442\u044F\u0433\u0443\u0432\u0430\u043B\u0430
        \u0440\u0443\u043A\u0443 \u044F\u043A \u0442\u0456\u043B\u044C\u043A\u0438
        \u043C\u043E\u0433\u043B\u0430. \u041C\u2019\u044F\u0437\u0438 \u043F\u0435\u043A\u043B\u043E
        \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u043E. \u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F,
        \u0449\u0435 \u0442\u0440\u043E\u0445\u0438, \u0456 \u044F \u0441\u0430\u043C\u0430
        \u0432\u0456\u0434\u0456\u0440\u0432\u0443 \u0441\u043E\u0431\u0456 \u043A\u0456\u043D\u0446\u0456\u0432\u043A\u0443.
        \u0422\u0430 \u0446\u0435 \u0431\u0443\u0432 \u0454\u0434\u0438\u043D\u0438\u0439
        \u0448\u0430\u043D\u0441 \u043D\u0430 \u043F\u043E\u0440\u044F\u0442\u0443\u043D\u043E\u043A.
        \u0412\u0440\u0435\u0448\u0442\u0456 \u043A\u0456\u043D\u0447\u0438\u043A\u0438
        \u043C\u043E\u0457\u0445 \u043F\u0430\u043B\u044C\u0446\u0456\u0432 \u0432\u043F\u0435\u0440\u043B\u0438\u0441\u044F
        \u0432 \u0440\u0443\u0447\u043A\u0443 \u043B\u043E\u043F\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_161_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0440\u043E\u0445\u0438\u2026 \u0429\u0435 \u0442\u0440\u043E\u0445\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_161_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0443\u0436\u0435 \u043F\u0456\u0434\u0456\u0439\u043C\u0430\u0432\u0441\u044F,
        \u0449\u043E\u0431 \u0437\u0430\u0432\u0434\u0430\u0442\u0438 \u043C\u0435\u043D\u0456
        \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u0443\u0434\u0430\u0440.
        \u0410\u043B\u0435 \u044F \u0432\u0441\u0442\u0438\u0433\u043B\u0430 \u043F\u0435\u0440\u0448\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_3_161_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0442\u0456\u043B\u044C\u043A\u0438 \u044F \u0441\u0445\u043E\u043F\u0438\u043B\u0430
        \u0456\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442, \u0442\u043E
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0442\u0440\u0430\u0447\u0430\u043B\u0430
        \u0447\u0430\u0441\u0443 \u2014 \u0437\u0456 \u0449\u0435\u0434\u0440\u0438\u043C
        \u0440\u043E\u0437\u043C\u0430\u0445\u043E\u043C \u0432\u0433\u0430\u0442\u0438\u043B\u0430
        \u043B\u043E\u043F\u0430\u0442\u043E\u044E \u0434\u0456\u0434\u043E\u0432\u0456
        \u043F\u043E \u0433\u043E\u043B\u043E\u0432\u0456. \u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F,
        \u043D\u0430\u0432\u0456\u0442\u044C \u044F \u043F\u043E\u0447\u0443\u043B\u0430
        \u0434\u0437\u0432\u0456\u043D."
    - Language: 1
      Text: 
  - Key: scene_3_162_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0448\u0432\u0438\u0434\u043A\u043E \u0437\u0456\u0440\u0432\u0430\u043B\u0430
        \u0456\u0437 \u0441\u0435\u0431\u0435 \u0436\u0430\u043A\u0435\u0442 \u0456
        \u0437\u0430\u0441\u043A\u043E\u0447\u0438\u043B\u0430 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0443
        \u0437\u0430 \u0441\u043F\u0438\u043D\u0443. \u041D\u0430\u043A\u0438\u043D\u0443\u0432\u0448\u0438
        \u043F\u0456\u0434\u0436\u0430\u043A \u043D\u0430 \u0448\u0438\u044E \u0441\u0442\u0430\u0440\u043E\u043C\u0443,
        \u044F \u0432\u043F\u0435\u0440\u043B\u0430\u0441\u044F \u0432 \u043D\u044C\u043E\u0433\u043E
        \u043A\u043E\u043B\u0456\u043D\u043E\u043C \u0456 \u043F\u043E\u0447\u0430\u043B\u0430
        \u0434\u0443\u0448\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_162_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0434\u0456\u0434 \u0432\u0438\u044F\u0432\u0438\u0432\u0441\u044F
        \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0432\u0435\u043B\u0438\u043A\u0438\u043C
        \u0442\u0430 \u0432\u0430\u0436\u043A\u0438\u043C. \u042F \u043D\u0435 \u043C\u0430\u043B\u0430
        \u0437\u043C\u043E\u0433\u0438 \u0432\u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0439\u043E\u0433\u043E, \u043A\u043E\u043B\u0438 \u0432\u0456\u043D, \u043D\u0435\u043C\u043E\u0432
        \u0440\u043E\u0437\u043B\u044E\u0447\u0435\u043D\u0438\u0439 \u0437\u0432\u0456\u0440,
        \u0437\u0456\u0440\u0432\u0430\u0432\u0441\u044F \u0437 \u043C\u0456\u0441\u0446\u044F."
    - Language: 1
      Text: 
  - Key: scene_3_162_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u043D\u0430\u043A\u0438\u043D\u0443\u0432\u0441\u044F
        \u043D\u0430 \u043C\u0435\u043D\u0435. \u0426\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443
        \u043C\u0435\u043D\u0456 \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0443\u0445\u0438\u043B\u0438\u0442\u0438\u0441\u044F. \u0421\u0445\u043E\u0436\u0435,
        \u0441\u0442\u0430\u0440\u0438\u0439 \u0432\u0438\u0432\u0447\u0438\u0432
        \u0443\u0440\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_3_162_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0441\u0445\u043E\u043F\u0438\u0432
        \u043C\u0435\u043D\u0435 \u0437\u0430 \u0432\u043E\u043B\u043E\u0441\u0441\u044F.
        \u0411\u0443\u043B\u043E \u0434\u0443\u0436\u0435 \u0431\u043E\u043B\u044F\u0447\u0435,
        \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438\u0441\u044F \u0441\u0438\u043B\u043E\u044E
        \u044F \u043D\u0435 \u043C\u0430\u043B\u0430 \u0448\u0430\u043D\u0441\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_162_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043D\u0447\u0435 \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E
        \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u0438 \u0449\u043E\u0441\u044C
        \u0456\u043D\u0448\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_3_162_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u0442\u0438 \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430
        \u0447\u0435\u0440\u0435\u0437 \u0441\u0442\u0435\u0433\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_3_163_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0456\u0439\u043A\u0443 \u0431\u0443\u043B\u043E \u0437\u0430\u043A\u0456\u043D\u0447\u0435\u043D\u043E.
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0432\u043F\u0430\u0432 \u043D\u0430
        \u043F\u0456\u0434\u043B\u043E\u0433\u0443 \u0442\u0430 \u0437\u043D\u0435\u043F\u0440\u0438\u0442\u043E\u043C\u043D\u0456\u0432."
    - Language: 1
      Text: 
  - Key: scene_3_163_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0430\u0436\u043A\u043E \u0432\u0456\u0434\u0445\u0435\u043A\u0443\u044E\u0447\u0438\u0441\u044C,
        \u044F \u0441\u043F\u0435\u0440\u043B\u0430\u0441\u044F \u043D\u0430 \u0441\u0442\u0456\u043D\u0443.
        \u0421\u0442\u043E\u044F\u0442\u0438 \u0431\u0443\u043B\u043E \u043D\u0430\u0434\u0442\u043E
        \u0441\u043A\u043B\u0430\u0434\u043D\u043E, \u0442\u043E\u0436 \u044F \u0437\u2019\u0457\u0445\u0430\u043B\u0430
        \u043D\u0435\u044E \u0432\u043D\u0438\u0437. \u041C\u0435\u043D\u0456 \u0437\u043D\u0430\u0434\u043E\u0431\u0438\u043B\u043E\u0441\u044F
        \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u0430\u0441\u0443, \u0449\u043E\u0431
        \u0432\u0456\u0434\u043F\u043E\u0447\u0438\u0442\u0438 \u0442\u0430 \u0437\u0456\u0431\u0440\u0430\u0442\u0438
        \u0434\u0443\u043C\u043A\u0438 \u0434\u043E\u043A\u0443\u043F\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_163_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u0440\u043C\u0430 \u0442\u0438 \u0432\u0447\u0438\u043D\u0438\u0432
        \u0442\u0430\u043A, \u0441\u0442\u0430\u0440\u0438\u0433\u0430\u043D\u0435.
        \u0422\u0435\u043F\u0435\u0440 \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443
        \u0432\u0438\u043F\u0430\u0434\u043A\u0443 \u043E\u043F\u0438\u043D\u0438\u0448\u0441\u044F
        \u0437\u0430 \u0491\u0440\u0430\u0442\u0430\u043C\u0438."
    - Language: 1
      Text: 
  - Key: scene_3_163_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0432\u0441\u0442\u0430\u043B\u0430, \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B\u0430
        \u0441\u0432\u0456\u0439 \u043E\u0434\u044F\u0433 \u0456 \u0437\u0430\u0447\u0456\u0441\u043A\u0443.
        \u0425\u0430\u0439 \u0442\u0430\u043C \u044F\u043A, \u0430 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044F
        \u0434\u0435\u0442\u0435\u043A\u0442\u0438\u0432\u043A\u0430 \u0437\u0430\u0432\u0436\u0434\u0438
        \u0441\u0442\u0435\u0436\u0438\u0442\u044C \u0437\u0430 \u0430\u043A\u0443\u0440\u0430\u0442\u043D\u0456\u0441\u0442\u044E
        \u0442\u0430 \u0441\u0442\u0438\u043B\u0435\u043C."
    - Language: 1
      Text: 
  - Key: scene_3_164_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A, \u043F\u043E\u0434\u0456\u0439 \u0432\u0438\u043F\u0430\u043B\u043E
        \u043E\u0434\u043D\u043E\u0437\u043D\u0430\u0447\u043D\u043E \u0437\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u0434\u043B\u044F \u043E\u0434\u043D\u0456\u0454\u0457 \u043D\u043E\u0447\u0456."
    - Language: 1
      Text: 
  - Key: scene_3_164_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0432 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u043C\u0435\u043D\u0456 \u0437\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F,
        \u0449\u043E \u044F \u0437\u043D\u0430\u0439\u0448\u043B\u0430 \u0432\u0436\u0435
        \u0432\u0441\u0456 \u0437\u0430\u0447\u0456\u043F\u043A\u0438 \u0442\u0430
        \u043C\u0430\u043B\u0430 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
        \u0434\u043E\u043A\u0430\u0437\u0456\u0432, \u0430\u0431\u0438 \u0442\u043E\u0447\u043D\u043E
        \u0432\u043A\u0430\u0437\u0430\u0442\u0438 \u043D\u0430 \u0432\u0438\u043D\u0443\u0432\u0430\u0442\u043E\u0433\u043E.
        \u041D\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u0440\u043E\u0437\u0433\u043E\u0440\u043D\u0443\u0442\u0438
        \u043C\u0456\u0439 \u0437\u0430\u043F\u0438\u0441\u043D\u0438\u043A \u0442\u0430
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438 \u0432\u0438\u0431\u0456\u0440,
        \u0432\u0456\u0434 \u044F\u043A\u043E\u0433\u043E \u0437\u0430\u043B\u0435\u0436\u0430\u043B\u0430
        \u043C\u043E\u044F \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u0430 \u0434\u043E\u043B\u044F."
    - Language: 1
      Text: 
  - Key: scene_0_165_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430 \u0437\u0430\u0430\u0440\u0435\u0448\u0442\u0443\u0432\u0430\u043B\u0438.
        \u0421\u0442\u0430\u0440\u0438\u0439 \u0431\u0430\u0433\u0430\u0442\u043E
        \u0441\u043F\u0435\u0440\u0435\u0447\u0430\u0432\u0441\u044F \u044F\u043A
        \u0456\u0437 \u043F\u043E\u043B\u0456\u0446\u0456\u0454\u044E, \u0442\u0430\u043A
        \u0456 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0443\u0434\u0443. \u0410\u043B\u0435
        \u043C\u043E\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0456\u044F
        \u0441\u043B\u0456\u0434\u0447\u043E\u0457 \u0431\u0443\u043B\u0430 \u0431\u0435\u0437\u0434\u043E\u0433\u0430\u043D\u043D\u043E\u044E,
        \u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0445 \u0434\u043E\u043A\u0430\u0437\u0456\u0432
        \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E, \u0449\u043E\u0431\u0438
        \u043F\u043E\u0432\u0456\u0441\u0438\u0442\u0438 \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u043D\u0430 \u0433\u0440\u0430\u0431\u0430\u0440\u044F"
    - Language: 1
      Text: 
  - Key: scene_0_165_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0442\u0430\u043A\u0438\u0439 \u0441\u043F\u043E\u0441\u0456\u0431,
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0432\u0441\u044F
        \u0434\u043E \u0432\u2019\u044F\u0437\u043D\u0438\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_0_165_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0437\u0433\u043E\u0434\u043E\u043C
        \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u044F\u043A\u043E\u0457
        \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u043E\u0457 \u043F\u043E\u043C\u0438\u043B\u043A\u0438
        \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044F. \u0421\u0442\u0430\u0440\u0438\u0439
        \u043D\u0435 \u0431\u0443\u0432 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C
        \u0443\u0431\u0438\u0432\u0446\u0435\u044E."
    - Language: 1
      Text: 
  - Key: scene_0_166_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u043B\u0435\u043A\u0441\u0456\u044F \u0437\u0430\u0430\u0440\u0435\u0448\u0442\u0443\u0432\u0430\u043B\u0438.
        \u0427\u043E\u043B\u043E\u0432\u0456\u043A \u0431\u0430\u0433\u0430\u0442\u043E
        \u0441\u043F\u0435\u0440\u0435\u0447\u0430\u0432\u0441\u044F \u044F\u043A
        \u0456\u0437 \u043F\u043E\u043B\u0456\u0446\u0456\u0454\u044E, \u0442\u0430\u043A
        \u0456 \u043F\u0456\u0434 \u0447\u0430\u0441 \u0441\u0443\u0434\u0443. \u0410\u043B\u0435
        \u043C\u043E\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0456\u044F
        \u0441\u043B\u0456\u0434\u0447\u043E\u0457 \u0431\u0443\u043B\u0430 \u0431\u0435\u0437\u0434\u043E\u0433\u0430\u043D\u043D\u043E\u044E,
        \u0430 \u0437\u043D\u0430\u0439\u0434\u0435\u043D\u0438\u0445 \u0434\u043E\u043A\u0430\u0437\u0456\u0432
        \u0432\u0438\u0441\u0442\u0430\u0447\u0438\u043B\u043E, \u0449\u043E\u0431\u0438
        \u043F\u043E\u0432\u0456\u0441\u0438\u0442\u0438 \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u043D\u0430 \u043E\u0445\u043E\u0440\u043E\u043D\u0446\u044F \u0440\u043E\u0434\u043E\u0432\u0438\u0449."
    - Language: 1
      Text: 
  - Key: scene_0_166_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0442\u0430\u043A\u0438\u0439 \u0441\u043F\u043E\u0441\u0456\u0431,
        \u041E\u043B\u0435\u043A\u0441\u0456\u0439 \u0432\u0456\u0434\u043F\u0440\u0430\u0432\u0438\u0432\u0441\u044F
        \u0434\u043E \u0432\u2019\u044F\u0437\u043D\u0438\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_0_166_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0437\u0433\u043E\u0434\u043E\u043C
        \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430, \u044F\u043A\u043E\u0457
        \u0444\u0430\u0442\u0430\u043B\u044C\u043D\u043E\u0457 \u043F\u043E\u043C\u0438\u043B\u043A\u0438
        \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044F. \u0425\u043E\u0447
        \u044F \u0456 \u0432\u0433\u0430\u043C\u0443\u0432\u0430\u043B\u0430 \u0442\u044F\u0433\u0443
        \u0434\u043E \u043F\u043E\u043C\u0441\u0442\u0438, \u0430\u043B\u0435 \u0447\u043E\u043B\u043E\u0432\u0456\u043A
        \u043D\u0435 \u0431\u0443\u0432 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u043C
        \u0443\u0431\u0438\u0432\u0446\u0435\u044E."
    - Language: 1
      Text: 
  - Key: scene_0_167_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u044F \u043D\u0435\u043E\u0431\u0430\u0447\u043D\u0456\u0441\u0442\u044C
        \u043F\u0440\u0438\u0437\u0432\u0435\u043B\u0430 \u0434\u043E \u043D\u0435\u0432\u0456\u0434\u0432\u043E\u0440\u043E\u0442\u043D\u0438\u0445
        \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0456\u0432. \u0411\u0443\u0440\u0448\u0442\u0438\u043D\u043E\u0432\u0456
        \u0440\u043E\u0434\u043E\u0432\u0438\u0449\u0430 \u0431\u0443\u043B\u043E
        \u0440\u043E\u0437\u0433\u0440\u0430\u0431\u043E\u0432\u0430\u043D\u043E.
        \u0415\u043A\u043E\u043D\u043E\u043C\u0456\u043A\u0430 \u0440\u0435\u0433\u0456\u043E\u043D\u0443
        \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u0430 \u0437\u043D\u0430\u0447\u043D\u0443
        \u0441\u0443\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_0_167_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0441\u043D\u0456\u0433\u043E\u0432\u0438\u0439 \u043A\u043E\u043C,
        \u0446\u0435\u0439 \u0444\u0430\u043A\u0442 \u043D\u0430\u0431\u0438\u0440\u0430\u0432
        \u0441\u0438\u043B\u0438, \u0430 \u0432\u0440\u0435\u0448\u0442\u0456 \u043F\u0440\u0438\u0437\u0432\u0456\u0432
        \u0434\u043E \u043F\u043E\u0442\u0443\u0436\u043D\u043E\u0457 \u0444\u0456\u043D\u0430\u043D\u0441\u043E\u0432\u043E\u0457
        \u043A\u0440\u0438\u0437\u0438 \u0432 \u043E\u043A\u043E\u043B\u0438\u0446\u044F\u0445
        \u0415\u0439\u0441\u0442\u0435\u043D\u0433\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_0_167_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0440\u0435\u0448\u0442\u043E\u044E, \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u043E
        \u043F\u043E\u043B\u0456\u0446\u0456\u0457 \u0437\u0433\u0430\u0434\u0430\u043B\u043E
        \u043F\u0440\u043E \u043C\u0456\u0439 \u0433\u0443\u0447\u043D\u0438\u0439
        \u043F\u0440\u043E\u0432\u0430\u043B. \u0407\u043C \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D
        \u0431\u0443\u0432 \u0446\u0430\u043F-\u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0439\u043B\u043E,
        \u0456 \u044F \u043F\u0456\u0434\u0445\u043E\u0434\u0438\u043B\u0430 \u044F\u043A\u043D\u0430\u0439\u043A\u0440\u0430\u0449\u0435.
        \u041C\u0435\u043D\u0435 \u0441\u0438\u043B\u044C\u043D\u043E \u043F\u043E\u043D\u0438\u0437\u0438\u043B\u0438
        \u0432 \u043F\u043E\u0441\u0430\u0434\u0456, \u043F\u0456\u0441\u043B\u044F
        \u0447\u043E\u0433\u043E \u0436\u0438\u0442\u0442\u044F \u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
        \u043F\u0456\u0448\u043B\u043E \u0448\u043A\u0435\u0440\u0435\u0431\u0435\u0440\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_0_167_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0456 \u0441\u0432\u043E\u0457
        \u0440\u043E\u043A\u0438 \u044F \u043F\u0440\u043E\u0432\u0435\u043B\u0430
        \u0432 \u0437\u043B\u0438\u0434\u043D\u044F\u0445, \u043F\u0438\u044F\u0446\u0442\u0432\u0456
        \u0442\u0430 \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u0438\u0445
        \u0441\u043F\u0440\u043E\u0431\u0430\u0445 \u0432\u0442\u0435\u043A\u0442\u0438
        \u0432\u0456\u0434 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u0431\u0456\u0440 \u0431\u0443\u043B\u043E \u0437\u0440\u043E\u0431\u043B\u0435\u043D\u043E
        \u0440\u0456\u0448\u0443\u0447\u0435. \u0427\u043E\u043C\u0443\u0441\u044C
        \u044F \u0431\u0443\u043B\u0430 \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E
        \u0432 \u043D\u044C\u043E\u043C\u0443 \u0432\u043F\u0435\u0432\u043D\u0435\u043D\u0430.
        \u0423\u0441\u0456 \u0437\u043D\u0430\u043A\u0438 \u0432\u043A\u0430\u0437\u0443\u0432\u0430\u043B\u0438
        \u043D\u0430 \u043D\u0435\u0457. \u041E\u0441\u044C \u0447\u043E\u043C\u0443
        \u0406\u043B\u043E\u043D\u0430 \u0442\u0430\u043A \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u043B\u0430
        \u0437\u0430\u0431\u0440\u0430\u0442\u0438\u0441\u044F \u0437 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E
        \u0441\u0430\u043C\u0435 \u0446\u0456\u0454\u0457 \u043D\u043E\u0447\u0456.
        \u0412\u043E\u043D\u0430 \u0437\u043D\u0430\u043B\u0430, \u0449\u043E \u0441\u044E\u0434\u0438
        \u043F\u0440\u0438\u0457\u0434\u0435 \u043F\u043E\u043B\u0456\u0446\u0456\u044F
        \u0442\u0430 \u0440\u043E\u0437\u043A\u0440\u0438\u0454 \u0457\u0457."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u043F\u0435\u0432\u043D\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442
        \u043C\u0435\u043D\u0456 \u043D\u0430\u0432\u0456\u0442\u044C \u0441\u0442\u0430\u043B\u043E
        \u0448\u043A\u043E\u0434\u0430 \u0434\u0456\u0432\u0447\u0438\u043D\u0443.
        \u0423\u0441\u0435 \u0436 \u0442\u0430\u043A\u0438, \u0441\u043B\u043E\u0432\u0430
        \u0417\u0430\u0445\u0430\u0440\u0435\u0441\u0430 \u043F\u0440\u043E \u043D\u0435\u0457
        \u0431\u0443\u043B\u0438 \u043D\u0435 \u043F\u043E\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u0456
        \u0441\u0435\u043D\u0441\u0443. \u0406\u043B\u043E\u043D\u0430 \u0434\u0456\u0439\u0441\u043D\u043E
        \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u043F\u043E\u0431\u0443\u0434\u0443\u0432\u0430\u0442\u0438
        \u0434\u043B\u044F \u0441\u0435\u0431\u0435 \u043A\u0440\u0430\u0449\u0435
        \u0436\u0438\u0442\u0442\u044F. \u0422\u0438\u043C\u0438 \u0437\u0430\u0441\u043E\u0431\u0430\u043C\u0438,
        \u044F\u043A\u0456 \u0454\u0434\u0438\u043D\u0456 \u0431\u0443\u043B\u0438
        \u0457\u0439 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u043D\u0435\u0457 \u043D\u0430\u0432\u0456\u0442\u044C \u043C\u043E\u0433\u043B\u043E
        \u0432\u0441\u0435 \u0432\u0438\u0439\u0442\u0438. \u0410 \u0442\u0435\u043F\u0435\u0440
        \u043C\u0443\u0441\u0438\u043B\u0430 \u0437\u2019\u044F\u0432\u0438\u0442\u0438\u0441\u044F
        \u044F \u0456 \u0432\u0441\u0435 \u0437\u0456\u043F\u0441\u0443\u0432\u0430\u0442\u0438.
        \u041D\u0435\u0432\u0436\u0435 \u0446\u0435 \u0431\u0443\u043B\u043E \u0454\u0434\u0438\u043D\u0435,
        \u0449\u043E \u044F \u0432\u043C\u0456\u043B\u0430? \u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u0437\u0440\u0443\u0439\u043D\u0443\u0432\u0430\u043B\u0430 \u0432\u043B\u0430\u0441\u043D\u0435
        \u0436\u0438\u0442\u0442\u044F, \u0430 \u043F\u043E\u0442\u0456\u043C \u043E\u0431\u0440\u0430\u043B\u0430
        \u0442\u0430\u043A\u0443 \u043F\u0440\u043E\u0444\u0435\u0441\u0456\u044E,
        \u0434\u0435 \u043C\u043E\u0433\u043B\u0430 \u0440\u0443\u0439\u043D\u0443\u0432\u0430\u0442\u0438
        \u0439\u043E\u0433\u043E \u0456\u043D\u0448\u0438\u043C?"
    - Language: 1
      Text: 
  - Key: scene_1_168_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u043A\u043E\u043B\u0438 \u0446\u0435 \u044F \u043F\u043E\u0447\u0430\u043B\u0430
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u0442\u0438 \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u0437\u0430 \u0442\u0435, \u0449\u043E \u0437\u0431\u0438\u0440\u0430\u043B\u0430\u0441\u044F
        \u0437\u0430\u0432\u0430\u0434\u0438\u0442\u0438 \u043F\u043B\u0430\u043D\u0430\u043C
        \u0437\u043B\u043E\u0447\u0438\u043D\u0446\u0456\u0432?"
    - Language: 1
      Text: 
  - Key: scene_1_168_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0434\u0436\u0435 \u0406\u043B\u043E\u043D\u0430 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E
        \u0440\u043E\u0431\u0438\u043B\u0430 \u043D\u0435\u0432\u0438\u043F\u0440\u0430\u0432\u043D\u0435.
        \u0427\u0435\u0440\u0435\u0437 \u0442\u0435, \u044F\u043A \u043D\u0435\u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E
        \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u0438\u0439 \u0431\u0443\u0440\u0448\u0442\u0438\u043D
        \u0442\u0456\u043A \u0440\u0456\u043A\u043E\u044E \u0456\u0437 \u0446\u044C\u043E\u0433\u043E
        \u0440\u0435\u0433\u0456\u043E\u043D\u0443, \u043D\u0430\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043B\u043E\u0441\u044F
        \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0431\u0430\u0433\u0430\u0442\u043E
        \u043B\u044E\u0434\u0435\u0439."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0430\u043D\u043E \u0447\u0438 \u043F\u0456\u0437\u043D\u043E
        \u0446\u0435 \u043C\u043E\u0433\u043B\u043E \u043F\u0456\u0434\u0434\u0430\u0442\u0438
        \u0440\u0438\u0437\u0438\u043A\u0443 \u0436\u0438\u0442\u0442\u044F \u0432\u0441\u0456\u0445
        \u043C\u0435\u0448\u043A\u0430\u043D\u0446\u0456\u0432 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u0433\u043E.
        \u0412\u043E\u043D\u0438 \u0431 \u043E\u043F\u0438\u043D\u0438\u043B\u0438\u0441\u044F
        \u0432 \u0437\u043B\u0438\u0434\u043D\u044F\u0445, \u044F\u043A\u0456 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0441\u043E\u0431\u0456 \u0443\u044F\u0432\u0438\u0442\u0438.
        \u0422\u0430 \u0449\u043E \u0442\u0430\u043C, \u0446\u044F \u043A\u0440\u0438\u0437\u0430
        \u043C\u043E\u0433\u043B\u0430 \u0440\u043E\u0437\u0440\u043E\u0441\u0442\u0438\u0441\u044F
        \u0432\u0441\u0456\u043C\u0430 \u043E\u043A\u043E\u043B\u0438\u0446\u044F\u043C\u0438
        \u0415\u0439\u0441\u0442\u0435\u043D\u0433\u0435\u0440\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0456\u043A\u0430\u0432\u043E, \u0449\u043E \u0441\u0430\u043C\u0435
        \u0406\u043B\u043E\u043D\u0430 \u0442\u0440\u0430\u043F\u0438\u043B\u0430\u0441\u044F
        \u043C\u0435\u043D\u0456 \u043F\u0435\u0440\u0448\u043E\u044E \u043D\u0430
        \u0434\u043E\u0440\u043E\u0437\u0456, \u043A\u043E\u043B\u0438 \u044F \u043F\u0440\u0438\u0431\u0443\u043B\u0430
        \u0434\u043E \u0441\u0435\u043B\u0430. \u041D\u0435\u0432\u0436\u0435 \u0446\u0435
        \u0431\u0443\u043B\u0430 \u043D\u0430\u0448\u0430 \u0434\u043E\u043B\u044F?
        \u0417\u0456\u0439\u0442\u0438\u0441\u044F \u0432 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0447\u043D\u043E\u043C\u0443
        \u0442\u0430 \u043D\u0435\u0432\u0456\u0434\u0432\u043E\u0440\u043E\u0442\u043D\u043E\u043C\u0443
        \u0434\u0432\u043E\u0431\u043E\u0457? \u041D\u0435\u0432\u043F\u0438\u043D\u043D\u0430
        \u0432\u043D\u0443\u0442\u0440\u0456\u0448\u043D\u044F \u0440\u0443\u0439\u043D\u0430\u0446\u0456\u044F
        \u043F\u0440\u043E\u0442\u0438 \u043D\u0435\u0441\u0442\u0440\u0438\u043C\u043D\u043E\u0457
        \u0437\u043E\u0432\u043D\u0456\u0448\u043D\u044C\u043E\u0457 \u0434\u0435\u0441\u0442\u0440\u0443\u043A\u0446\u0456\u0457?"
    - Language: 1
      Text: 
  - Key: scene_1_168_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u0432\u0441\u0456 \u0446\u0456 \u043F\u0430\u0444\u043E\u0441\u043D\u0456
        \u0434\u0443\u043C\u043A\u0438 \u0432\u043E\u0434\u043D\u043E\u0447\u0430\u0441\u0441\u044F
        \u0440\u043E\u0437\u0431\u0438\u043B\u0438\u0441\u044F, \u043A\u043E\u043B\u0438
        \u044F \u0437\u043D\u043E\u0432\u0443 \u0434\u0456\u0441\u0442\u0430\u043B\u0430\u0441\u044F
        \u043C\u0456\u0441\u0446\u044F \u0430\u0432\u0430\u0440\u0456\u0457. \u0421\u0445\u043E\u0436\u0435,
        \u0442\u0443\u0442 \u043D\u0456\u043A\u043E\u0433\u043E \u0432\u0436\u0435
        \u0434\u0430\u0432\u043D\u043E \u043D\u0435 \u0431\u0443\u043B\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_168_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0446\u0435 \u043C\u043E\u0436\u043B\u0438\u0432\u043E?
        \u0429\u043E \u0436 \u0431\u0443\u0434\u0435 \u0437 \u043D\u0430\u0448\u043E\u044E
        \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0447\u043D\u043E\u044E \u0434\u0443\u0435\u043B\u043B\u044E,
        \u044F\u043A\u0443 \u044F \u0432\u0436\u0435 \u0432\u0441\u0442\u0438\u0433\u043B\u0430
        \u0441\u043E\u0431\u0456 \u043D\u0430\u0444\u0430\u043D\u0442\u0430\u0437\u0443\u0432\u0430\u0442\u0438?"
    - Language: 1
      Text: 
  - Key: scene_1_168_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u043C\u043E\u0433\u043B\u0430
        \u0437\u0434\u0430\u0442\u0438\u0441\u044F \u0437\u0430\u0440\u0430\u0437.
        \u041C\u0430\u0432 \u0431\u0443\u0442\u0438 \u044F\u043A\u0438\u0439\u0441\u044C
        \u0448\u0430\u043D\u0441. \u042F\u043A\u0430\u0441\u044C \u0437\u0430\u0447\u0456\u043F\u043A\u0430.
        \u0425\u043E\u0447 \u0449\u043E\u0441\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043E\u0431\u0448\u0443\u043A\u043E\u0432\u0443\u0432\u0430\u043B\u0430
        \u0432\u0441\u0435 \u043D\u0430\u0432\u043A\u043E\u043B\u043E. \u041A\u043E\u0436\u043D\u0435
        \u0434\u0435\u0440\u0435\u0432\u043E, \u043A\u043B\u0430\u043F\u0442\u0438\u043A
        \u0437\u0435\u043C\u043B\u0456, \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
        \u043E\u0431\u043D\u044E\u0445\u0443\u0432\u0430\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u0443
        \u043F\u043E \u043A\u0440\u0430\u044F\u0445."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0442\u0438 \u0434\u0435 \u043F\u043E\u0434\u0456\u043B\u0430\u0441\u044F!
        \u041D\u0456\u043A\u0443\u0434\u0438 \u0442\u0438 \u043D\u0435 \u0449\u0435\u0437\u043B\u0430,
        \u043B\u0438\u0448\u0435 \u0441\u0445\u043E\u0432\u0430\u043B\u0430\u0441\u044F,
        \u043A\u043E\u043B\u0438 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u0449\u043E \u044F \u0441\u043A\u043E\u0440\u043E \u0432\u0441\u0435 \u0434\u0456\u0437\u043D\u0430\u044E\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_168_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u0440\u043E\u0437\u043C\u2019\u044F\u043A\u043B\u0456\u0439
        \u0437\u0435\u043C\u043B\u0456 \u0431\u0456\u043B\u044F \u0430\u0441\u0444\u0430\u043B\u044C\u0442\u043E\u0432\u0430\u043D\u043E\u0457
        \u0434\u043E\u0440\u043E\u0433\u0438 \u043C\u0435\u043D\u0456 \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F
        \u043A\u0456\u043B\u044C\u043A\u0430 \u0441\u043B\u0456\u0434\u0456\u0432,
        \u044F\u043A\u0456 \u0432\u0435\u043B\u0438 \u0433\u043B\u0438\u0431\u0448\u0435
        \u0434\u043E \u043B\u0456\u0441\u0443. \u0417\u0430 \u0440\u043E\u0437\u043C\u0456\u0440\u0430\u043C\u0438
        \u0432\u043E\u043D\u0438 \u0437\u0431\u0456\u0433\u0430\u043B\u0438\u0441\u044F
        \u0437\u0456 \u0432\u0437\u0443\u0442\u0442\u044F\u043C \u0406\u043B\u043E\u043D\u0438,
        \u044F\u043A \u044F \u0439\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u043C\u2019\u044F\u0442\u0430\u043B\u0430.
        \u041D\u0435 \u0437\u0432\u043E\u043B\u0456\u043A\u0430\u044E\u0447\u0438
        \u0430\u043D\u0456 \u0441\u0435\u043A\u0443\u043D\u0434\u0438, \u044F \u0432\u0438\u0440\u0443\u0448\u0438\u043B\u0430
        \u0441\u043B\u0456\u0434\u0430\u043C\u0438 \u0432 \u0445\u0430\u0449\u0456."
    - Language: 1
      Text: 
  - Key: scene_7_169_part_1
    LocalizationDatas:
    - Language: 0
      Text: ...
    - Language: 1
      Text: 
  - Key: scene_7_169_part_2
    LocalizationDatas:
    - Language: 0
      Text: ......
    - Language: 1
      Text: 
  - Key: scene_7_169_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F?"
    - Language: 1
      Text: 
  - Key: scene_7_169_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0435 \u044F?"
    - Language: 1
      Text: 
  - Key: scene_7_169_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u0435 \u043F\u043B\u0438\u0432\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_7_169_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0443\u0434\u0438 \u043C\u0435\u043D\u0456? \u0429\u043E \u043C\u0435\u043D\u0456
        \u0442\u0440\u0435\u0431\u0430?"
    - Language: 1
      Text: 
  - Key: scene_7_169_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u0434\u0435 \u043F\u0435\u0440\u0435\u0431\u0443\u0432\u0430\u044E \u0456
        \u043A\u0438\u043C \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0431\u0443\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_7_169_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043D\u0456 \u0434\u043E \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0443,
        \u0430\u043D\u0456 \u043A\u043E\u043B\u0438\u0441\u044C \u0443 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_7_169_part_9
    LocalizationDatas:
    - Language: 0
      Text: ...
    - Language: 1
      Text: 
  - Key: scene_7_169_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E?"
    - Language: 1
      Text: 
  - Key: scene_7_170_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0442\u0430\u044E, \u043F\u0430\u043D\u0456! \u041C\u0435\u043D\u0456
        \u0434\u0443\u0436\u0435 \u0448\u043A\u043E\u0434\u0430, \u0449\u043E \u0437
        \u0432\u0430\u043C\u0438 \u0442\u0440\u0430\u043F\u0438\u043B\u0430\u0441\u044F
        \u0442\u0430\u043A\u0430 \u0431\u0456\u0434\u0430."
    - Language: 1
      Text: 
  - Key: scene_7_170_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u043E \u0432 \u043E\u0431\u043B\u0438\u0447\u0447\u0456 \u0432\u0430\u0441
        \u044F \u0431\u0430\u0447\u0443 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044E
        \u0442\u0430 \u0441\u0442\u0430\u0440\u0448\u0443 \u0441\u0435\u0431\u0435.
        \u042F\u043A \u0436\u0435 \u0446\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E,
        \u0449\u043E \u044F \u043C\u043E\u0436\u0443 \u043F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0442\u0430\u043A\u0435 \u0436\u0430\u043B\u044E\u0433\u0456\u0434\u043D\u0435
        \u0441\u0442\u0432\u043E\u0440\u0456\u043D\u043D\u044F. \u041D\u0435\u0432\u0436\u0435
        \u0446\u0435 \u0456 \u0454 \u043C\u043E\u044F \u0434\u043E\u043B\u044F, \u043F\u0440\u043E\u0436\u0438\u0442\u0438
        \u043C\u0430\u0440\u043D\u0435 \u0436\u0438\u0442\u0442\u044F, \u0441\u043F\u043E\u0432\u043D\u0435\u043D\u0435
        \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u044C?"
    - Language: 1
      Text: 
  - Key: scene_7_170_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0446\u044C\u043E\u0433\u043E \u0445\u043E\u0447\u0435\u0448
        \u0432\u0456\u0434 \u0441\u0435\u0431\u0435, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E?"
    - Language: 1
      Text: 
  - Key: scene_7_170_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0447\u0438\u043D\u043A\u0438 \u0432\u0438\u0437\u043D\u0430\u0447\u0430\u044E\u0442\u044C\u0441\u044F
        \u043B\u0438\u0448\u0435 \u0432\u043B\u0430\u0441\u043D\u0438\u043C \u0432\u0438\u0431\u043E\u0440\u043E\u043C.
        \u041F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0434\u043E\u0441\u043B\u0443\u0445\u0430\u0442\u0438\u0441\u044F
        \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u0433\u043E \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_7_170_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0440\u0430\u0449\u0435 \u0431 \u043C\u043E\u0454 \u0436\u0438\u0442\u0442\u044F
        \u043D\u0456\u043A\u043E\u043B\u0438 \u0439 \u043D\u0435 \u043F\u043E\u0447\u0438\u043D\u0430\u043B\u043E\u0441\u044F.
        \u0410\u043B\u0435 \u0446\u0435 \u0431\u0443\u0432 \u043D\u0435 \u043C\u0456\u0439
        \u0432\u0438\u0431\u0456\u0440."
    - Language: 1
      Text: 
  - Key: scene_7_171_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0439 \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0438
        \u0432\u0438\u043D\u043D\u0430 \u0432 \u0443\u0441\u044C\u043E\u043C\u0443,
        \u0449\u043E \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F
        \u0437 \u0442\u043E\u0431\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_7_171_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u043E\u0441\u0438\u0442\u044C. \u0422\u0456\u043A\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_7_171_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F
        \u0432\u0436\u0435 \u0437\u0430\u043D\u0430\u0434\u0442\u043E \u0434\u0430\u043B\u0435\u043A\u043E.
        \u041F\u0435\u0440\u0435\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044F
        \u043D\u0430 \u043D\u0456\u0449\u043E, \u043D\u0430 \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0443.
        \u0406 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u0448
        \u0457\u0457 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_7_171_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0440\u0430\u0437 \u044F \u043F\u043E\u0440\u043E\u0436\u043D\u0435\u0447\u0430.
        \u0410\u043B\u0435 \u0446\u0435 \u043C\u0456\u0439 \u0448\u043B\u044F\u0445
        \u0434\u043E \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044F, \u0449\u043E\u0431
        \u043D\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0441\u0435\u0431\u0435
        \u0447\u0438\u043C\u043E\u0441\u044C \u043D\u043E\u0432\u0438\u043C."
    - Language: 1
      Text: 
  - Key: scene_7_171_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431 \u0456\u0437 \u0440\u0430\u0434\u0456\u0441\u0442\u044E
        \u043E\u0431\u0440\u0430\u043B\u0430 \u0448\u043B\u044F\u0445 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
        \u0432\u0442\u0435\u0447\u0456, \u044F\u043A\u0431\u0438 \u043C\u0430\u043B\u0430
        \u043D\u0430 \u0446\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
        \u0441\u043C\u0456\u043B\u0438\u0432\u043E\u0441\u0442\u0456."
    - Language: 1
      Text: 
  - Key: scene_7_172_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043B\u0456\u0434\u0447\u0430, \u043F\u043E\u0434\u0438\u0432\u0438\u0441\u044F
        \u043D\u0430 \u043C\u0435\u043D\u0435. \u0429\u043E \u0442\u0438 \u0431\u0430\u0447\u0438\u0448?
        \u0421\u0442\u0430\u0440\u0443 \u0442\u0430 \u0437\u043C\u0443\u0447\u0435\u043D\u0443
        \u043B\u044E\u0434\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_7_172_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431\u0430\u0433\u0430\u0442\u043E \u0447\u043E\u0433\u043E
        \u043F\u0435\u0440\u0435\u0436\u0438\u0432 \u0456 \u0431\u0430\u0447\u0438\u0432.
        \u0423\u0441\u0435 \u0437\u0430\u0432\u0436\u0434\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u043E
        \u0442\u0456\u043B\u044C\u043A\u0438 \u043F\u0440\u043E \u043E\u0434\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_7_172_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u043D\u0430\u044E, \u044F\u043A \u0441\u043A\u043B\u0430\u0434\u0430\u0454\u0442\u044C\u0441\u044F
        \u0446\u0435 \u0436\u0438\u0442\u0442\u044F \u0442\u0430 \u0434\u043B\u044F
        \u0441\u043A\u0456\u043B\u044C\u043A\u043E\u0445 \u043B\u044E\u0434\u0435\u0439
        \u0432\u043E\u043D\u043E \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
        \u043D\u0430\u0431\u0443\u0432\u0430\u0454 \u0441\u0435\u043D\u0441\u0443."
    - Language: 1
      Text: 
  - Key: scene_7_172_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438\u0441\u044C \u0442\u0438 \u0442\u0430\u043A
        \u0456 \u043F\u043E\u043C\u0440\u0435\u0448. \u041D\u0456\u043A\u043E\u043C\u0443
        \u043D\u0435 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u0430. \u041D\u0456\u043A\u0438\u043C
        \u043D\u0435 \u043A\u043E\u0445\u0430\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_7_172_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0441\u044F
        \u0436\u0438\u0442\u0438 \u0434\u043B\u044F \u043A\u043E\u0433\u043E\u0441\u044C.
        \u041C\u0435\u043D\u0456 \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
        \u0437\u043D\u0430\u0442\u0438, \u0449\u043E \u043A\u043E\u043B\u0438\u0441\u044C
        \u044F \u0437\u043C\u043E\u0436\u0443 \u043F\u043E\u043B\u044E\u0431\u0438\u0442\u0438
        \u0441\u0430\u043C\u0430 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_7_172_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u2019\u044F\u0437\u043A\u0438 \u2014 \u043D\u0435\u0441\u0442\u0435\u0440\u043F\u043D\u0438\u0439
        \u0431\u0456\u043B\u044C. \u041A\u0440\u0430\u0449\u0435 \u044F \u043E\u0434\u043D\u0430
        \u043F\u0440\u043E\u0439\u0434\u0443 \u043A\u0440\u0456\u0437\u044C \u0446\u0435\u0439
        \u043A\u043E\u0448\u043C\u0430\u0440, \u0449\u043E \u0437\u0432\u0435\u0442\u044C\u0441\u044F
        \u0436\u0438\u0442\u0442\u044F\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u0435 \u043D\u0430\u0432\u043A\u0440\u0443\u0433\u0438
        \u0432\u0442\u0440\u0430\u0442\u0438\u043B\u043E \u0443\u0441\u044F\u043A\u0456
        \u0437\u0432\u2019\u044F\u0437\u043A\u0438 \u0437 \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0438\u043D\u0443\u043B\u0435, \u0442\u0435\u043F\u0435\u0440\u0456\u0448\u043D\u0454
        \u0442\u0430 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454 \u0437\u043B\u0438\u043B\u0438\u0441\u044F
        \u0432 \u0454\u0434\u0438\u043D\u0438\u0439 \u043A\u043B\u0443\u0431\u043E\u043A
        \u0449\u0435\u043C\u043B\u0438\u0432\u043E\u0433\u043E \u0431\u043E\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0430\u0440\u0442\u0438\u043D\u0430 \u043F\u0435\u0440\u0435\u0434
        \u043E\u0447\u0438\u043C\u0430 \u043F\u043E\u0447\u0430\u043B\u0430 \u0440\u043E\u0437\u043A\u043B\u0430\u0434\u0430\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0444\u0440\u0430\u043A\u0442\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_4
    LocalizationDatas:
    - Language: 0
      Text: 
    - Language: 1
      Text: 
  - Key: scene_1_173_part_5
    LocalizationDatas:
    - Language: 0
      Text: 
    - Language: 1
      Text: 
  - Key: scene_1_173_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0430\u0437 \u044F \u0437\u043D\u043E\u0432\u0443 \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F
        \u0431\u0456\u043B\u044F \u0441\u0432\u043E\u0454\u0457 \u043C\u0430\u0448\u0438\u043D\u0438
        \u043D\u0430 \u0434\u043E\u0440\u043E\u0437\u0456 \u0442\u0430 \u0434\u0435\u0440\u0435\u0432\u0430,
        \u044F\u043A\u0435 \u0432\u043F\u0430\u043B\u043E \u043F\u043E\u0440\u0443\u0447.
        \u0417\u0432\u0456\u0434\u043A\u0438\u0441\u044C \u0434\u043E \u043C\u0435\u043D\u0435
        \u0432\u0438\u0439\u0448\u043B\u0430 \u0406\u043B\u043E\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043C\u0430\u0445\u0430\u043B\u0430 \u0440\u0443\u043A\u0430\u043C\u0438
        \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456, \u0449\u043E\u0431 \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438,
        \u0447\u0438 \u0446\u0435 \u043D\u0435 \u0441\u043E\u043D. \u041E\u0431\u043C\u0430\u0446\u0430\u043B\u0430
        \u0441\u0432\u043E\u0454 \u043E\u0431\u043B\u0438\u0447\u0447\u044F, \u043F\u043B\u0435\u0447\u0456,
        \u0441\u0442\u0435\u0433\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0446\u0435 \u0442\u0456\u043B\u044C\u043A\u0438 \u0449\u043E
        \u0432\u0456\u0434\u0431\u0443\u043B\u043E\u0441\u044F? \u041C\u043E\u0436\u0435,
        \u044F \u043F\u043E\u043C\u0435\u0440\u043B\u0430, \u0430 \u043F\u043E\u0442\u0456\u043C
        \u044F\u043A\u0438\u043C\u043E\u0441\u044C \u0447\u0438\u043D\u043E\u043C
        \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0434\u043E \u0436\u0438\u0442\u0442\u044F?"
    - Language: 1
      Text: 
  - Key: scene_1_173_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0447\u0438 \u0456\u043D\u0430\u043A\u0448\u0435,
        \u0442\u0435\u043F\u0435\u0440 \u0443\u0441\u0435 \u0431\u0443\u043B\u043E
        \u0446\u0456\u043B\u043A\u043E\u043C \u0440\u0435\u0430\u043B\u044C\u043D\u043E.
        \u041D\u0430\u0432\u0456\u0442\u044C \u0437\u0430\u043D\u0430\u0434\u0442\u043E.
        \u0413\u0430\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0456\u0457 \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u043B\u0438\u0441\u044F,
        \u0439 \u0443\u0441\u044F \u0432\u0442\u043E\u043C\u0430 \u0442\u0430 \u0431\u0456\u043B\u044C
        \u0446\u0456\u0454\u0457 \u043D\u043E\u0447\u0456 \u0440\u0430\u0437\u043E\u043C
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044F \u0434\u043E
        \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0406\u043B\u043E\u043D\u0438 \u0431\u0443\u0432 \u0434\u0443\u0436\u0435
        \u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0438\u0439 \u0432\u0438\u0433\u043B\u044F\u0434.
        \u041E\u0447\u0456 \u0432\u043E\u043D\u0430 \u0432\u0442\u0443\u043F\u0438\u043B\u0430
        \u0432 \u0437\u0435\u043C\u043B\u044E, \u043D\u0456\u0431\u0438 \u0431\u043E\u044F\u043B\u0430\u0441\u044F
        \u0434\u0438\u0432\u0438\u0442\u0438\u0441\u044F \u043D\u0430 \u043C\u0435\u043D\u0435.
        \u0420\u043E\u0437\u0442\u0438\u0440\u0430\u043B\u0430 \u0440\u0443\u043A\u0438,
        \u043D\u0430\u043C\u0430\u0433\u0430\u044E\u0447\u0438\u0441\u044C \u0437\u0430\u0441\u043F\u043E\u043A\u043E\u0457\u0442\u0438
        \u0441\u0430\u043C\u0443 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_173_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0435\u043A\u043E\u043D\u0430\u0432\u0448\u0438\u0441\u044C,
        \u0449\u043E \u0432\u0441\u0435 \u0449\u0435 \u0432\u043C\u0456\u044E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438,
        \u044F \u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F \u0434\u043E
        \u0434\u0456\u0432\u0447\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_173_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u043E, \u0449\u043E \u0432\u0437\u0430\u0433\u0430\u043B\u0456
        \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0454\u0442\u044C\u0441\u044F?"
    - Language: 1
      Text: 
  - Key: scene_1_173_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A\u2026 \u042F\u043A \u0442\u043E\u0431\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u0438\u0442\u0438 \u0442\u0430\u043A\u0456
        \u0433\u0430\u043B\u044E\u0446\u0438\u043D\u0430\u0446\u0456\u0457?"
    - Language: 1
      Text: 
  - Key: scene_1_173_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0442\u0456\u0439, \u0434\u0435 \u0441\u0442\u043E\u0457\u0448,
        \u0432\u0431\u0438\u0432\u0446\u0435. \u041D\u0435 \u0437\u043D\u0430\u044E,
        \u044F\u043A \u0442\u0438 \u043C\u0435\u043D\u0435 \u043E\u0434\u0443\u0440\u043C\u0430\u043D\u0438\u043B\u0430,
        \u0430\u043B\u0435 \u0434\u0440\u0443\u0433\u043E\u0457 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
        \u043D\u0435 \u0431\u0443\u0434\u0435!"
    - Language: 1
      Text: 
  - Key: scene_1_174_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C \u0431\u0443\u043B\u0430
        \u043D\u0435\u043E\u0447\u0456\u043A\u0443\u0432\u0430\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_174_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043C\u0456\u0441\u0442\u044C \u0441\u043B\u0456\u0432,
        \u0406\u043B\u043E\u043D\u0430 \u043B\u0438\u0448\u0435 \u0440\u043E\u0437\u0440\u0438\u0434\u0430\u043B\u0430\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_174_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0435\u0448\u0442\u0456 \u0457\u0439 \u043B\u0435\u0434\u044C-\u043B\u0435\u0434\u044C
        \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0432\u0438\u0447\u0430\u0432\u0438\u0442\u0438
        \u0456\u0437 \u0441\u0435\u0431\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_174_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438\u2026 \u0425\u043B\u0438\u043F\u2026 \u0422\u0438 \u0441\u0430\u043C\u0430
        \u0437\u043C\u0443\u0441\u0438\u043B\u0430 \u043C\u0435\u043D\u0435 \u0446\u0435
        \u0440\u043E\u0431\u0438\u0442\u0438\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_174_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u043E, \u044F \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_175_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0438 \u0441\u0430\u043C\u0430 \u0446\u0435 \u0432\u0441\u0435
        \u043D\u0430\u0440\u043E\u0431\u0438\u043B\u0430!"
    - Language: 1
      Text: 
  - Key: scene_1_175_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0445\u043E\u0447\u0443 \u0439 \u043D\u0456\u043A\u043E\u043B\u0438
        \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u0430 \u0431\u0443\u0442\u0438
        \u0447\u0430\u0441\u0442\u0438\u043D\u043E\u044E \u0442\u0432\u043E\u0433\u043E
        \u0436\u0438\u0442\u0442\u044F, \u0430\u043B\u0435 \u0442\u0438 \u0437\u0430\u0442\u044F\u0433\u043B\u0430
        \u043C\u0435\u043D\u0435 \u0441\u0438\u043B\u043E\u044E!"
    - Language: 1
      Text: 
  - Key: scene_1_175_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u043E, \u044F \u043D\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u044E\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_176_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0431\u0456\u0439\u0441\u044F, \u044F \u043C\u043E\u0436\u0443
        \u0432\u0441\u0435 \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_176_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417-\u0437\u0430 \u0434\u0435\u0440\u0435\u0432 \u0432\u0438\u0439\u0448\u043B\u0430
        \u0436\u0456\u043D\u043A\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_176_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u044F\u043A \u0432\u0430\u043C \u0446\u0435 \u043E\u043F\u0438\u0441\u0430\u0442\u0438\u2026
        \u0417\u0432\u0443\u0447\u0430\u0442\u0438\u043C\u0435 \u0434\u0438\u043A\u043E,
        \u0456 \u0432\u0438, \u043C\u0430\u0431\u0443\u0442\u044C, \u043D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u0442\u0435
        \u043C\u0435\u043D\u0456. \u0410\u043B\u0435 \u044F\u043A\u0449\u043E \u0432\u0456\u0440\u0438\u043B\u0438
        \u0434\u043E \u0446\u044C\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0443,
        \u0442\u043E \u044F \u0456 \u0434\u0430\u043B\u0456 \u043A\u0430\u0437\u0430\u0442\u0438\u043C\u0443
        \u0432\u0441\u0435, \u044F\u043A \u0431\u0443\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_176_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0417-\u0437\u0430 \u0434\u0435\u0440\u0435\u0432 \u0432\u0438\u0439\u0448\u043B\u0430
        \u044F. \u0406\u043D\u0448\u0430 \u044F. \u041A\u043B\u043E\u043D. \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430
        \u2116\u20092. \u041D\u0430\u0437\u0438\u0432\u0430\u0442\u0438 \u043C\u043E\u0436\u043D\u0430
        \u044F\u043A \u0437\u0430\u0432\u0433\u043E\u0434\u043D\u043E. \u0404\u0434\u0438\u043D\u043E\u044E
        \u0432\u0456\u0434\u043C\u0456\u043D\u043D\u0456\u0441\u0442\u044E \u0431\u0443\u043B\u0430
        \u0442\u0440\u043E\u0445\u0438 \u0431\u0456\u043B\u044C\u0448\u0430 \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C
        \u0437\u043C\u043E\u0440\u0448\u043E\u043A \u043D\u0430 \u043E\u0431\u043B\u0438\u0447\u0447\u0456
        \u0432 \u043C\u043E\u0454\u0457 \u043A\u043E\u043F\u0456\u0457."
    - Language: 1
      Text: 
  - Key: scene_1_176_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0431\u0443\u0434\u0435\u043C\u043E \u043F\u043E\u0441\u043F\u0456\u0448\u0430\u0442\u0438.
        \u0423 \u043D\u0430\u0441 \u0449\u0435 \u0454 \u0447\u0430\u0441 \u043F\u043E\u043F\u0435\u0440\u0435\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_176_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0442\u043E \u0442\u0438 \u0442\u0430\u043A\u0430?"
    - Language: 1
      Text: 
  - Key: scene_1_176_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0422\u041E \u0442\u0438 \u0442\u0430\u043A\u0430?"
    - Language: 1
      Text: 
  - Key: scene_1_176_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E \u0434\u043E \u0431\u0456\u0441\u043E\u0432\u043E\u0457
        \u043C\u0430\u0442\u0435\u0440\u0456 \u0442\u0438 \u0442\u0430\u043A\u0435?"
    - Language: 1
      Text: 
  - Key: scene_1_177_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0456\u0431\u0430 \u0440\u0430\u043D\u0456\u0448\u0435 \u044F
        \u0434\u0456\u0439\u0441\u043D\u043E \u0431\u0443\u043B\u043E \u0442\u0430\u043A\u043E\u044E
        \u043D\u0435\u0434\u043E\u0443\u043C\u043A\u0443\u0432\u0430\u0442\u043E\u044E?
        \u042F \u2014 \u0446\u0435 \u0442\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
        \u0456\u043D\u0448\u0430 \u0432\u0435\u0440\u0441\u0456\u044F, \u044F\u043A\u0430
        \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F \u0437 \u0442\u043E\u0431\u043E\u044E
        \u0432 \u043E\u0434\u043D\u043E\u043C\u0443 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456
        \u0442\u0430 \u0447\u0430\u0441\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A \u0431\u0438 \u0446\u0435 \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438
        \u043F\u0440\u043E\u0441\u0442\u0456\u0448\u0435\u2026 \u041F\u0430\u043C\u2019\u044F\u0442\u0430\u0454\u0448
        \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F, \u043A\u043E\u043B\u0438
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0448
        \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434? \u0413\u043E\u0441\u043F\u043E\u0434\u0438,
        \u0437\u0432\u0438\u0447\u0430\u0439\u043D\u043E \u0436, \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0454\u0448.
        \u042F \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u044E \u0441\u0430\u043C\u0430
        \u0456\u0437 \u0441\u043E\u0431\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u043E\u0442, \u0442\u043E\u0434\u0456 \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F,
        \u0449\u043E \u0447\u0430\u0441 \u0437\u0430\u0432\u043C\u0438\u0440\u0430\u0454,
        \u0456 \u0442\u0438 \u043C\u043E\u0436\u0435\u0448 \xAB\u043F\u0456\u0434\u0433\u043B\u0435\u0434\u0456\u0442\u0438\xBB,
        \u044F\u043A\u0430 \u0434\u0456\u044F \u0431\u0443\u0434\u0435 \u0434\u043B\u044F
        \u0442\u0435\u0431\u0435 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438\u0432\u043D\u0456\u0448\u043E\u044E.
        \u0410\u043B\u0435 \u0442\u0438 \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435
        \u0437\u0430\u043C\u0438\u0441\u043B\u044E\u0432\u0430\u043B\u0430\u0441\u044F,
        \u0437\u0432\u0456\u0434\u043A\u0438 \u0431\u0435\u0440\u0435\u0442\u044C\u0441\u044F
        \u0446\u0435 \u0440\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F?"
    - Language: 1
      Text: 
  - Key: scene_1_177_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u0435\u0448 \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u0442\u0438,
        \u044F \u0456 \u0441\u0430\u043C\u0430 \u0437\u043D\u0430\u044E, \u0449\u043E
        \u0442\u043E\u0434\u0456 \u043D\u0435 \u0437\u0430\u043C\u0438\u0441\u043B\u044E\u0432\u0430\u043B\u0430\u0441\u044F.
        \u0410\u043B\u0435 \u0442\u0435\u043F\u0435\u0440 \u043C\u043E\u0436\u0443
        \u043F\u0440\u043E\u043B\u0438\u0442\u0438 \u043D\u0430 \u0446\u0435 \u0442\u0440\u043E\u0445\u0438
        \u0441\u0432\u0456\u0442\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u0442\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0448
        \u0446\u044E \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C, \u0442\u043E
        \u0437\u0430\u0437\u0438\u0440\u0430\u0454\u0448 \u0443 \u0456\u043D\u0448\u0456
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456. \u0406\u043D\u0448\u0456,
        \u0442\u0430\u043A \u0431\u0438 \u043C\u043E\u0432\u0438\u0442\u0438, \u0433\u0456\u043B\u043A\u0438
        \u0437 \u0440\u0456\u0437\u043D\u0438\u043C\u0438 \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0430\u043C\u0438
        \u0442\u0432\u043E\u0457\u0445 \u0434\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0441\u043B\u044F \u0446\u044C\u043E\u0433\u043E, \u044F\u043A
        \u0442\u0438 \u0432\u0436\u0435 \u043C\u043E\u0433\u043B\u0430 \u0437\u0434\u043E\u0433\u0430\u0434\u0430\u0442\u0438\u0441\u044F,
        \u0442\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u0438\u0431\u0443\u0454\u0448
        \u0443 \u043D\u043E\u0432\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C,
        \u0434\u0435 \u0437\u0430 \u0442\u0435\u0431\u0435 \u0432\u0436\u0435 \u0432\u0441\u0435
        \u0432\u0438\u0440\u0456\u0448\u0435\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0434\u043E\u0431\u0440\u0435 \u0432\u0438\u0432\u0447\u0438\u043B\u0430
        \xAB\u043D\u0430\u0448\u0443\xBB \u0441\u0443\u043F\u0435\u0440\u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C.
        \u041F\u0456\u0441\u043B\u044F \u0434\u043E\u0432\u0433\u0438\u0445 \u0440\u043E\u043A\u0456\u0432
        \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u043D\u044C \u044F \u043D\u0430\u0432\u0447\u0438\u043B\u0430\u0441\u044F
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0457\u0457 \u043D\u0430\u0432\u0456\u0442\u044C \u0431\u0435\u0437 \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434\u0443
        \u0439  \u0443 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u043C\u0443 \u043D\u0430\u043F\u0440\u044F\u043C\u043A\u0443
        \u0447\u0430\u0441\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436 \u044F \u0434\u043E\u0431\u0440\u0435 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044E\u044E
        \u0446\u0435\u0439 \u043F\u0440\u043E\u0446\u0435\u0441 \u0456 \u043D\u0430\u0432\u0456\u0442\u044C
        \u0437\u043C\u043E\u0433\u043B\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0438
        \u0442\u043E\u0431\u0456 \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A\u0438
        \u0456\u043D\u0448\u0438\u0445 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456\u0432.
        \u0429\u043E\u043F\u0440\u0430\u0432\u0434\u0430, \u0442\u0438 \u043D\u0430\u0437\u0432\u0430\u043B\u0430
        \u0446\u0435 \xAB\u0433\u0430\u043B\u044E\u043D\u0430\u043C\u0438\xBB, \u0430\u043B\u0435\u2026
        \u0413\u0430\u0440\u0430\u0437\u0434, \u044F \u0431 \u043D\u0430\u0437\u0432\u0430\u043B\u0430
        \u0442\u0430\u043A \u0441\u0430\u043C\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_177_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u043C\u0443, \u044F\u043A\u0449\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u043E,
        \u044F \u2014 \u0446\u0435 \u0442\u0438, \u0430\u043B\u0435 \u0437 \u0456\u043D\u0448\u043E\u0457
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456. \u042F\u043A\u0443
        \u0442\u0438, \u0434\u043E \u0440\u0435\u0447\u0456, \u0441\u0430\u043C\u0430
        \u0456 \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_177_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0431\u0438\u0440\u0430\u0439\u0441\u044F \u0432 \u0442\u0443
        \u043B\u0430\u0439\u043D\u044F\u043D\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C,
        \u0437 \u044F\u043A\u043E\u0457 \u0432\u0438\u043B\u0456\u0437\u043B\u0430,
        \u0456 \u043D\u0435 \u043C\u0443\u0447 \u043C\u0435\u043D\u0435!"
    - Language: 1
      Text: 
  - Key: scene_1_177_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0449\u043E \u0442\u0438 \u043F\u0440\u0438\u0431\u0443\u043B\u0430
        \u0441\u044E\u0434\u0438? \u0429\u043E \u0442\u043E\u0431\u0456 \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E
        \u0432\u0456\u0434 \u043C\u0435\u043D\u0435?"
    - Language: 1
      Text: 
  - Key: scene_1_177_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0435\u0437 \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434\u0443,
        \u043A\u0430\u0436\u0435\u0448\u2026 \u042F\u043A \u0441\u0430\u043C\u0435
        \u0442\u043E\u0431\u0456 \u0432\u0434\u0430\u0454\u0442\u044C\u0441\u044F
        \u0446\u0435 \u0440\u043E\u0431\u0438\u0442\u0438?"
    - Language: 1
      Text: 
  - Key: scene_1_178_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0430\u2026 \u0412\u043F\u0456\u0437\u043D\u0430\u044E \u0432
        \u0446\u0438\u0445 \u0441\u043B\u043E\u0432\u0430\u0445 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_179_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0430\u2026 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E,
        \u043D\u0435 \u0437\u0430\u0431\u0443\u0432\u0430\u0439, \u0449\u043E \u044F
        \u0442\u0430\u043A\u043E\u0436 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430.
        \u041C\u043E\u0457 \u0432\u043B\u0430\u0441\u043D\u0456 \u0445\u0438\u0442\u0440\u043E\u0449\u0456
        \u043F\u0440\u043E\u0442\u0438 \u043C\u0435\u043D\u0435 \u043D\u0435 \u0441\u043F\u0440\u0430\u0446\u044E\u044E\u0442\u044C.
        \u042F \u043D\u0435 \u0437\u0431\u0438\u0440\u0430\u044E\u0441\u044F \u043E\u0434\u0440\u0430\u0437\u0443
        \u0432\u0438\u043A\u043B\u0430\u0441\u0442\u0438 \u0442\u043E\u0431\u0456
        \u0432\u0441\u0456 \u043A\u043E\u0437\u0438\u0440\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_179_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0432\u0430\u0436\u0430\u0439, \u0443 \u043C\u0435\u043D\u0435
        \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E \u0431\u0456\u043B\u044C\u0448\u0435
        \u0434\u043E\u0441\u0432\u0456\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u0456\u0447 \u0443 \u0442\u043E\u043C\u0443, \u0449\u043E \u0432
        \u043D\u0430\u0448\u043E\u0457 \u0437\u0434\u0430\u0442\u043D\u043E\u0441\u0442\u0456
        \u0454 \u0449\u0435 \u0456 \u0434\u0440\u0443\u0433\u0430 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0456\u0441\u0442\u044C.
        \u041D\u0430 \u0436\u0430\u043B\u044C, \u044F \u0434\u0456\u0437\u043D\u0430\u043B\u0430\u0441\u044F
        \u043F\u0440\u043E \u043D\u0435\u0457 \u043D\u0430\u0431\u0430\u0433\u0430\u0442\u043E
        \u043F\u0456\u0437\u043D\u0456\u0448\u0435. \u0406 \u0446\u0435, \u043C\u043E\u0436\u043D\u0430
        \u0441\u043A\u0430\u0437\u0430\u0442\u0438\u2026 \u041F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u043E
        \u0443\u044F\u0432\u043B\u0435\u043D\u043D\u044F \u043F\u0440\u043E \u043C\u043E\u0454
        \u0436\u0438\u0442\u0442\u044F. \u041F\u0440\u043E \u043D\u0430\u0448\u0435
        \u0436\u0438\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u0442\u0438 \u043B\u0438\u0448\u0430\u0454\u0448
        \u043E\u0434\u043D\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
        \u0442\u0430 \u0442\u0456\u043A\u0430\u0454\u0448 \u0434\u043E \u0456\u043D\u0448\u043E\u0457,
        \u043C\u0438\u043D\u0443\u043B\u0430 \u0437\u0430\u0437\u043D\u0430\u0454
        \u0437\u043C\u0456\u043D. \u0417\u0430 \u0431\u0443\u0434\u044C-\u044F\u043A\u0443
        \u0432\u0434\u0430\u0447\u0443 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C\u0441\u044F
        \u0440\u043E\u0437\u043F\u043B\u0430\u0447\u0443\u0432\u0430\u0442\u0438\u0441\u044C.
        \u0406 \u0446\u0435 \u0432\u0438\u043F\u0430\u0434\u0430\u0454 \u043D\u0430
        \u043F\u043B\u0435\u0447\u0456 \u0442\u0438\u043C \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0438\u043C
        \xAB\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430\u043C\xBB, \u044F\u043A\u0456
        \u043B\u0438\u0448\u0430\u044E\u0442\u044C\u0441\u044F \u0432 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0430\u0445,
        \u0437\u0432\u0456\u0434\u043A\u0438 \u0442\u0438 \u043F\u0456\u0448\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u043D\u0430\u044E, \u0449\u043E \u0442\u0438 \u0432\u0456\u0434\u0447\u0443\u0454\u0448,
        \u0431\u043E \u0436 \u044F \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u044E
        \u0442\u0435 \u0441\u0430\u043C\u0435. \u041F\u043E\u0441\u0442\u0456\u0439\u043D\u0430
        \u043D\u0438\u0437\u043A\u0430 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u044C
        \u0442\u0430 \u043D\u0435\u0432\u0435\u0437\u0456\u043D\u043D\u044F. \u0406
        \u044F\u043A \u0432\u0456\u0434 \u043D\u0435\u0457 \u043D\u0435 \u0442\u0456\u043A\u0430\u0439,
        \u0432\u043E\u043D\u0430 \u0432\u0441\u0435 \u043E\u0434\u043D\u043E \u0437\u043D\u0430\u0439\u0434\u0435
        \u0442\u0435\u0431\u0435. \u0411\u0443\u0434\u044C-\u0434\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u0432 \u0442\u043E\u043C\u0443,
        \u0449\u043E \u0442\u0438 \u0441\u0442\u0432\u043E\u0440\u044E\u0454\u0448
        \u0446\u0435 \u0441\u0430\u043C\u0430 \u2014 \u0434\u043B\u044F \u0456\u043D\u0448\u043E\u0457
        \u0441\u0435\u0431\u0435. \u041A\u043E\u0436\u0435\u043D \u0440\u0430\u0437,
        \u043A\u043E\u043B\u0438 \u0442\u0438\u0446\u044C\u043A\u0430\u043B\u0430
        \u0446\u044E \u043A\u043B\u044F\u0442\u0443 \u043A\u043D\u043E\u043F\u043A\u0443
        \u0444\u043E\u0442\u043E\u043A\u0430\u043C\u0435\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0414\u0430\u0432\u0430\u0439, \u043F\u0440\u0438\u0433\u0430\u0434\u0430\u0439,
        \u043A\u043E\u043B\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430
        \u0441\u0432\u043E\u044E \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C
        \u0443\u043F\u0435\u0440\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0443\u043C\u0456\u043D\u043D\u044F \u043F\u0440\u0438\u0439\u0448\u043B\u043E
        \u0434\u043E \u043C\u0435\u043D\u0435 \u0456\u0437 \u0436\u0430\u0445\u043E\u043C.
        \u0426\u0435 \u0431\u0443\u043B\u043E \u0440\u043E\u043A\u0456\u0432 \u0434\u0435\u0441\u044F\u0442\u044C
        \u0442\u043E\u043C\u0443, \u043C\u0438 \u0456\u0437 \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u043E\u043C
        \u0449\u0435 \u043C\u0430\u043B\u0438 \u0448\u043B\u044E\u0431 \u0442\u0430
        \u0447\u0435\u043A\u0430\u043B\u0438 \u043D\u0430 \u0434\u0438\u0442\u0438\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F
        \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u0438, \u0447\u0438\u043C
        \u0440\u043E\u0437\u0432\u0430\u0436\u0438\u0442\u0438 \u0441\u0435\u0431\u0435
        \u0432 \u0434\u0435\u043A\u0440\u0435\u0442\u0456. \u0417\u0433\u0430\u0434\u0430\u043B\u0430
        \u043F\u0440\u043E \u0441\u0442\u0430\u0440\u0443 \u043F\u0440\u0438\u0441\u0442\u0440\u0430\u0441\u0442\u044C
        \u0434\u043E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0443\u0432\u0430\u043D\u043D\u044F,
        \u0432\u0438\u0440\u0456\u0448\u0438\u043B\u0430 \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u0442\u0438
        \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u0432\u0443 \u043A\u0430\u043C\u0435\u0440\u0443.
        \u0417\u043D\u0430\u0439\u0448\u043B\u0430 \u0434\u0435\u0441\u044C \u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0439
        \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434, \u0430 \u0442\u043E\u0434\u0456\u2026
        \u0442\u043E\u0434\u0456\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_180_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u043C\u043E\u0433\u043B\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
        \u0446\u0435 \u0456\u0437 \u0441\u043E\u0431\u043E\u044E!"
    - Language: 1
      Text: 
  - Key: scene_1_180_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0454 \u043E\u0431\u043B\u0438\u0447\u0447\u044F \u0437\u0431\u043B\u0456\u0434\u043B\u043E.
        \u0406\u043D\u0448\u0430 \u044F, \u0441\u0445\u043E\u0436\u0435, \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u044F\u043A\u0438\u0439 \u0435\u0444\u0435\u043A\u0442 \u043D\u0430 \u043C\u0435\u043D\u0435
        \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0457\u0457 \u0441\u043B\u043E\u0432\u0430,
        \u0442\u043E\u043C\u0443 \u0434\u0430\u043B\u0430 \u0434\u0435\u044F\u043A\u0438\u0439
        \u0447\u0430\u0441 \u0443\u0441\u0435 \u0443\u0441\u0432\u0456\u0434\u043E\u043C\u0438\u0442\u0438,
        \u0430 \u043F\u0456\u0441\u043B\u044F \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0438\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0429\u043E\u0431 \u0443\u0441\u0435 \u0443\u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0438\u0442\u0438,
        \u044F \u0442\u0443\u0442 \u0437 \u043E\u0434\u043D\u0456\u0454\u0457 \u0454\u0434\u0438\u043D\u043E\u0457
        \u043F\u0440\u0438\u0447\u0438\u043D\u0438 \u2014 \u0432\u0431\u0438\u0442\u0438
        \u0442\u0435\u0431\u0435, \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E.
        \u0410\u0434\u0436\u0435 \u0442\u0438 \u0431\u0443\u043B\u0430 \u043F\u0435\u0440\u0448\u043E\u044E
        \u0437 \xAB\u043D\u0430\u0441\xBB, \u0445\u0442\u043E \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0432
        \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C. \u0417 \u0443\u0441\u0456\u0445
        \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0438\u0445
        \u0432\u0435\u0440\u0441\u0456\u0439, \u044F\u043A\u0456 \u043D\u0430\u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043B\u0438\u0441\u044F
        \u0447\u0435\u0440\u0435\u0437 \u0442\u0432\u043E\u0457 \u0434\u0456\u0457."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u043D\u0430\u044E, \u043C\u043E\u0436\u0435, \u0446\u0435 \u0437\u0432\u0443\u0447\u0438\u0442\u044C
        \u0442\u0440\u043E\u0445\u0438 \u043D\u0435 \u0433\u0443\u043C\u0430\u043D\u043D\u043E,
        \u0431\u043E \u0442\u0438 \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435
        \u0437\u043D\u0430\u043B\u0430. \u0410\u043B\u0435 \u0436 \u0442\u0438 \u043F\u0430\u043C\u2019\u044F\u0442\u0430\u0454\u0448
        \u043F\u0440\u0438\u043D\u0446\u0438\u043F: \xAB\u043D\u0435\u0437\u043D\u0430\u043D\u043D\u044F
        \u0437\u0430\u043A\u043E\u043D\u0443 \u043D\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u0434\u0430\u043D\u043D\u044F\xBB.
        \u041C\u0438 \u0431\u0430\u0433\u0430\u0442\u043E \u043A\u043E\u0433\u043E
        \u0437\u0430 \u043D\u0438\u043C \u0441\u0443\u0434\u0438\u043B\u0438. \u0410
        \u0442\u0438 \u0432\u0438\u043D\u0430, \u0431\u0456\u043B\u044C\u0448\u0435
        \u0447\u0438 \u043C\u0435\u043D\u0448\u0435, \u0443 \u0431\u0435\u0437\u043B\u0456\u0447\u0456
        \u0437\u043B\u0430\u043C\u0430\u043D\u0438\u0445 \u0436\u0438\u0442\u0442\u0456\u0432
        \u0456\u043D\u0448\u0438\u0445 \u0432\u0435\u0440\u0441\u0456\u0439 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u0432\u0441\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u044C
        \u043E\u0434\u043D\u0430, \u0441\u0430\u043C\u0435 \u0442\u0432\u043E\u044F
        \u0441\u043C\u0435\u0440\u0442\u044C. \u0406\u043D\u0448\u0456 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0438
        \u0437 \u0443\u0441\u0456\u0445 \u0440\u043E\u0437\u0433\u0430\u043B\u0443\u0436\u0435\u043D\u044C
        \u0432\u0441\u0435\u0441\u0432\u0456\u0442\u0443 \u043D\u0435\u0441\u0443\u0442\u044C
        \u0443 \u0441\u043E\u0431\u0456 \u0447\u0430\u0441\u0442\u0438\u043D\u043A\u0438
        \u0442\u0432\u043E\u0454\u0457 \u0435\u043D\u0435\u0440\u0433\u0456\u0457.
        \u041F\u0440\u043E\u0442\u0435 \u043A\u043E\u043B\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435
        \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438 \u0442\u0435, \u0449\u043E
        \u0457\u0445 \u043F\u043E\u0440\u043E\u0434\u0438\u043B\u043E, \u0446\u0438\u043A\u043B
        \u0437\u0430\u043C\u043A\u043D\u0435\u0442\u044C\u0441\u044F. \u041C\u0438
        \u0432\u0441\u0456 \u0449\u0435\u0437\u043D\u0435\u043C\u043E, \u0456 \u043D\u0435
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0431\u0443\u0434\u0435
        \u0442\u0435\u0440\u043F\u0456\u0442\u0438 \u0431\u0456\u043B\u044C\u0448\u0435
        \u0436\u043E\u0434\u043D\u0438\u0445 \u0442\u0440\u0430\u0433\u0435\u0434\u0456\u0439."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043C\u0430\u043D\u0438\u0442\u0438 \u0442\u0435\u0431\u0435
        \u0441\u044E\u0434\u0438 \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F
        \u0434\u043E\u0432\u043E\u043B\u0456 \u043B\u0435\u0433\u043A\u043E. \u0422\u0430\u043A,
        \u0442\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u0442\u0440\u043E\u0445\u0438
        \u043D\u0430\u0434\u0430\u0432\u0438\u0442\u0438 \u043D\u0430 \u0446\u044E
        \u043C\u0438\u043B\u0443 \u0434\u0456\u0432\u0447\u0438\u043D\u0443, \u0406\u043B\u043E\u043D\u0443,
        \u043F\u0440\u043E\u0442\u0435 \u043F\u0456\u0441\u043B\u044F \u0432\u043E\u043D\u0430
        \u0440\u0430\u0434\u043E \u043F\u043E\u0433\u043E\u0434\u0438\u043B\u0430\u0441\u044F
        \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438. \u041D\u0443, \u0456
        \u043F\u043E\u0437\u0431\u0443\u0442\u0438\u0441\u044F \u041A\u043E\u0440\u0438\u0444\u0435\u044F,
        \u0447\u0438 \u044F\u043A \u0442\u0430\u043C \u0439\u043E\u0433\u043E \u0437\u0432\u0430\u043B\u0438.
        \u0417\u0430 \u0446\u0438\u043C \u0447\u043E\u043B\u043E\u0432\u0456\u043A\u043E\u043C
        \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E \u043D\u0456\u0445\u0442\u043E
        \u043D\u0435 \u0441\u0443\u043C\u0443\u0432\u0430\u0442\u0438\u043C\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_14
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0441\u0435 \u0446\u0435 \u0437\u0432\u0443\u0447\u0430\u043B\u043E
        \u044F\u043A \u043F\u043E\u0432\u043D\u0435 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u043B\u044F.
        \u042F \u043D\u0435 \u0432\u0456\u0440\u0438\u043B\u0430 \u0442\u043E\u043C\u0443,
        \u0449\u043E \u0447\u0443\u043B\u0430, \u0430\u043B\u0435 \u0436 \u043C\u043E\u0457
        \u043E\u0447\u0456 \u043D\u0435 \u0431\u0440\u0435\u0445\u0430\u043B\u0438.
        \u0426\u0435 \u0434\u0456\u0439\u0441\u043D\u043E \u0431\u0443\u043B\u0430
        \u044F, \u0441\u0442\u043E\u044F\u043B\u0430 \u0441\u0430\u043C\u0430 \u043F\u0435\u0440\u0435\u0434
        \u0441\u043E\u0431\u043E\u044E \u0456 \u043D\u0435\u0441\u043B\u0430 \u0432\u0441\u044E
        \u0446\u044E \u043C\u0430\u044F\u0447\u043D\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_180_part_15
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u044F
        \u0431\u0443\u043B\u0430 \u0437\u0434\u0430\u0442\u043D\u0430 \u043B\u0438\u0448\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_180_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0432\u0438\u043D\u0443\u0432\u0430\u0442\u0438\u0442\u0438 \u0456\u043D\u0448\u0443
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0443 \u0432 \u0442\u043E\u043C\u0443,
        \u0449\u043E \u0432\u043E\u043D\u0430 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430
        \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_180_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u043F\u043E\u0432\u0456\u0440\u0438\u0442\u0438 \u0436\u043E\u0434\u043D\u043E\u043C\u0443
        \u0441\u043B\u043E\u0432\u0443. \u0426\u0435 \u0431\u0443\u0432 \u044F\u043A\u0438\u0439\u0441\u044C
        \u043D\u0435\u0434\u043E\u043B\u0443\u0433\u0438\u0439 \u043E\u0431\u043C\u0430\u043D!
        \u0420\u043E\u0437\u0456\u0433\u0440\u0430\u0448!"
    - Language: 1
      Text: 
  - Key: scene_1_180_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043F\u0438\u0442\u0430\u0442\u0438, \u0447\u0438 \u043D\u0435\u043C\u0430
        \u0445\u043E\u0447 \u044F\u043A\u043E\u0433\u043E\u0441\u044C \u0456\u043D\u0448\u043E\u0433\u043E
        \u0441\u043F\u043E\u0441\u043E\u0431\u0443 \u0432\u0441\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438?"
    - Language: 1
      Text: 
  - Key: scene_1_181_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0445\u0456\u0431\u0430 \u0446\u0435 \u043D\u0435 \u0437\u0430\u0432\u0436\u0434\u0438
        \u0431\u0443\u043B\u043E \u043D\u0430\u0448\u043E\u044E \u0440\u0438\u0441\u043E\u044E,
        \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0432\u0430\u0442\u0438
        \u0456\u043D\u0448\u0438\u0445 \u0437\u0430\u0440\u0430\u0434\u0438 \u0441\u0432\u043E\u0454\u0457
        \u0446\u0456\u043B\u0456? \u0412\u0435\u0441\u044C \u0447\u0430\u0441 \u0442\u0438
        \u0432\u0447\u0438\u043D\u044F\u043B\u0430 \u0442\u0430\u043A \u0441\u0430\u043C\u043E.
        \u0412\u0456\u043A \u0437\u043C\u0456\u043D\u0438\u0442\u044C \u0443 \u0442\u043E\u0431\u0456
        \u0442\u0456\u043B\u044C\u043A\u0438 \u0442\u0435, \u0449\u043E \u0442\u0438
        \u0446\u0435 \u0432\u0438\u0437\u043D\u0430\u0454\u0448 \u0456 \u043D\u0430\u0432\u0447\u0438\u0448\u0441\u044F
        \u0432\u0438\u0434\u043E\u0431\u0443\u0432\u0430\u0442\u0438 \u0456\u0437
        \u0446\u044C\u043E\u0433\u043E \u043A\u043E\u0440\u0438\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_181_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u0430 \u0432\u0456\u0440\u0438\u0442\u0438,
        \u0449\u043E \u0440\u043E\u043A\u0438 \u0437\u0440\u043E\u0431\u043B\u044F\u0442\u044C
        \u043C\u0435\u043D\u0435 \u043D\u0430\u0441\u0442\u0456\u043B\u044C\u043A\u0438
        \u0446\u0438\u043D\u0456\u0447\u043D\u043E\u044E, \u043F\u0440\u043E\u0442\u0435\u2026
        \u0421\u0445\u043E\u0436\u0435, \u0443\u0441\u0435 \u0439\u0448\u043B\u043E
        \u0441\u0430\u043C\u0435 \u0434\u043E \u0442\u043E\u0433\u043E. \u042F\u043A\u0449\u043E
        \u043C\u0435\u043D\u0456 \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0432\u0434\u0430\u0441\u0442\u044C\u0441\u044F
        \u0432\u0438\u0436\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_181_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435\u2026 \u0426\u044C\u043E\u0433\u043E \u0440\u0430\u0437\u0443
        \u044F \u0431\u0443\u043B\u0430 \u043C\u0438\u043B\u043E\u0441\u0435\u0440\u0434\u043D\u0456\u0448\u043E\u044E.
        \u0422\u0438 \u0436 \u0437\u043D\u0430\u0454\u0448, \u0406\u043B\u043E\u043D\u0430
        \u0442\u0430\u043A \u0456 \u0442\u0430\u043A \u0437\u043B\u043E\u0447\u0438\u043D\u043D\u0438\u0446\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_181_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u0436, \u0432 \u043E\u0431\u043C\u0456\u043D \u043D\u0430
        \u0457\u0457 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443, \u044F \u0437\u0430\u043F\u0440\u043E\u043F\u043E\u043D\u0443\u0432\u0430\u043B\u0430
        \u0406\u043B\u043E\u043D\u0456 \u0441\u0432\u0456\u0439 \u0437\u0430\u0445\u0438\u0441\u0442,
        \u043E\u0442 \u0456 \u0432\u0441\u0435. \u0412\u0456\u0434 \u0432\u043B\u0430\u0434\u0438,
        \u044F\u043A\u0430 \u043F\u043E\u043B\u044E\u0432\u0430\u043B\u0430 \u0431
        \u043D\u0430 \u043D\u0435\u0457 \u0447\u0435\u0440\u0435\u0437 \u0432\u0438\u043A\u0440\u0430\u0434\u0435\u043D\u0438\u0439
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D. \u041D\u0443 \u0456 \u0442\u0440\u043E\u0445\u0438
        \u0432\u0456\u0434 \u0441\u0435\u0431\u0435 \u0441\u0430\u043C\u043E\u0457."
    - Language: 1
      Text: 
  - Key: scene_1_181_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431\u0430\u0447\u0438\u043B\u0430, \u044F\u043A \u043E\u0447\u0456
        \u0406\u043B\u043E\u043D\u0438 \u0437 \u043E\u0441\u0442\u0440\u0430\u0445\u043E\u043C
        \u0437\u0438\u0440\u043A\u0430\u044E\u0442\u044C \u0442\u043E \u043D\u0430
        \u043C\u0435\u043D\u0435, \u0442\u043E \u043D\u0430 \u0456\u043D\u0448\u0443
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0443. \u0412\u043E\u043D\u0430
        \u043D\u0435 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u043B\u0430 \u044F\u043A
        \u043F\u0456\u0434\u0441\u0442\u0443\u043F\u043D\u0438\u0439 \u043B\u0438\u0445\u043E\u0434\u0456\u0439.
        \u0420\u0430\u0434\u0448\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0435,
        \u043D\u0430\u043B\u044F\u043A\u0430\u043D\u0435 \u0437\u0432\u0456\u0440\u044F\u0442\u043A\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_181_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0433\u043E\u0434\u0438\u0442\u0438\u0441\u044C \u0456\u0437
        \u043F\u0440\u043E\u0432\u0438\u043D\u043E\u044E \u0406\u043B\u043E\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_181_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438 \u0406\u043B\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_182_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0435 \u0437\u043D\u0430\u044E, \u0447\u0438 \u0441\u043F\u0440\u0430\u0432\u0434\u0456
        \u0442\u0438 \u0454 \u0442\u0430, \u0437\u0430 \u043A\u043E\u0433\u043E \u0441\u0435\u0431\u0435
        \u0432\u0438\u0434\u0430\u0454\u0448, \u0456 \u044F\u043A\u0430 \u0440\u043E\u043B\u044C
        \u0406\u043B\u043E\u043D\u0438 \u0432 \u0446\u0456\u0439 \u0432\u0438\u0441\u0442\u0430\u0432\u0456,
        \u0430\u043B\u0435 \u043E\u0434\u043D\u0435 \u043C\u0435\u043D\u0456 \u044F\u0441\u043D\u043E
        \u0442\u043E\u0447\u043D\u043E. \u042F\u043A\u0449\u043E \u0447\u0438\u043D\u0438\u0448
        \u0437\u043B\u043E, \u0437\u0430\u0432\u0436\u0434\u0438 \u043D\u0430\u0441\u0442\u0430\u0454
        \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u043D\u044F. \u0422\u0430\u043A
        \u0431\u0443\u0434\u0435 \u0437 \u0406\u043B\u043E\u043D\u043E\u044E. \u0406
        \u0437\u0456 \u043C\u043D\u043E\u044E \u0441\u0430\u043C\u043E\u044E, \u044F\u043A\u0449\u043E
        \u044F \u0442\u043E\u0433\u043E \u0437\u0430\u0441\u043B\u0443\u0433\u043E\u0432\u0443\u0432\u0430\u0442\u0438\u043C\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_182_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0457 \u0441\u043B\u043E\u0432\u0430 \u0437\u0430\u0434\u0456\u043B\u0438
        \u0434\u0456\u0432\u0447\u0438\u043D\u0443 \u043D\u0430\u0432\u0456\u0442\u044C
        \u0441\u0438\u043B\u044C\u043D\u0456\u0448\u0435, \u043D\u0456\u0436 \u044F
        \u0440\u043E\u0437\u0440\u0430\u0445\u043E\u0432\u0443\u0432\u0430\u043B\u0430.
        \u0412\u043E\u043D\u0430 \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435
        \u043C\u043E\u0433\u043B\u0430 \u0441\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u0442\u0438
        \u0441\u043B\u044C\u043E\u0437\u0438. \u0421\u0442\u043E\u044F\u043B\u0430
        \u0434\u0435\u0441\u044C \u0443 \u0442\u0456\u043D\u044F\u0445 \u0456 \u0433\u043E\u043B\u043E\u0441\u043D\u043E
        \u0440\u0438\u0434\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_183_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0436\u043B\u0438\u0432\u043E, \u0406\u043B\u043E\u043D\u0430
        \u0445\u043E\u0442\u0456\u043B\u0430 \u043A\u0440\u0430\u0449\u043E\u0433\u043E
        \u0436\u0438\u0442\u0442\u044F \u0434\u043B\u044F \u0441\u0435\u0431\u0435
        \u0456 \u0441\u043F\u0456\u0442\u043A\u043D\u0443\u043B\u0430\u0441\u044F
        \u0432 \u043F\u0440\u0430\u0433\u043D\u0435\u043D\u043D\u0456 \u0434\u043E
        \u043D\u044C\u043E\u0433\u043E. \u0410\u043B\u0435 \u044F \u043D\u0435 \u0432\u0456\u0440\u044E,
        \u0449\u043E \u0432\u043E\u043D\u0430 \u043F\u043E\u0433\u0430\u043D\u0430
        \u043B\u044E\u0434\u0438\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_183_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_183_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u2026 \u0412\u043E\u043D\u0430 \u043A\u0430\u0436\u0435 \u043F\u0440\u0430\u0432\u0434\u0443.
        \u042F \u043D\u0435 \u043C\u043E\u0436\u0443 \u0431\u0456\u043B\u044C\u0448\u0435
        \u0431\u0440\u0435\u0445\u0430\u0442\u0438 \u0447\u0438 \u0449\u043E\u0441\u044C
        \u043F\u0440\u0438\u0445\u043E\u0432\u0443\u0432\u0430\u0442\u0438. \u042F
        \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
        \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E. \u0417\u0430\u043C\u0430\u043D\u0438\u043B\u0430
        \u041A\u043E\u0440\u043D\u0456\u044F \u0434\u043E \u043E\u0437\u0435\u0440\u0430.
        \u041D\u0430\u0432\u0456\u0442\u044C \u0433\u0440\u0430\u043B\u0430 \u0440\u043E\u043B\u044C
        \u043D\u0435\u0432\u0438\u043D\u043D\u043E\u0433\u043E \u044F\u0433\u043D\u044F\u0442\u0438
        \u043F\u0435\u0440\u0435\u0434 \u0442\u043E\u0431\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_183_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u043E \u0446\u044F \u0436\u0456\u043D\u043A\u0430\u2026 \u0412\u043E\u043D\u0430
        \u043E\u0431\u0456\u0446\u044F\u043B\u0430 \u043C\u0435\u043D\u0456, \u0449\u043E
        \u0434\u043E\u043F\u043E\u043C\u043E\u0436\u0435 \u043F\u0440\u0438\u043A\u0440\u0438\u0442\u0438
        \u043F\u0440\u043E\u0434\u0430\u0436 \u043E\u0441\u0442\u0430\u043D\u043D\u044C\u043E\u0457
        \u043F\u0430\u0440\u0442\u0456\u0457 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0443.
        \u041F\u043E\u043F\u0435\u0440\u0435\u0434\u0438\u043B\u0430, \u0449\u043E
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435
        \u043F\u0440\u0438\u0441\u0443\u0442\u043D\u044F \u0442\u0443\u0442 \u043E\u0441\u043E\u0431\u0438\u0441\u0442\u043E,
        \u0430\u043B\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0430 \u043B\u0438\u0441\u0442
        \u0434\u043E \u043D\u0430\u0434\u0456\u0439\u043D\u043E\u0457 \u043B\u044E\u0434\u0438\u043D\u0438.
        \u042F\u043A\u0438\u0439\u0441\u044C \u043F\u0430\u043D \u041E\u0440\u0435\u0441\u0442\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_183_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E\u043C\u0443 \u044F \u043C\u043E\u0433\u043B\u0430 \u043D\u0430\u0440\u0435\u0448\u0442\u0456
        \u0432\u0438\u0431\u0440\u0430\u0442\u0438\u0441\u044F \u0437\u0432\u0456\u0434\u0441\u0438.
        \u0426\u0435 \u0431\u0443\u043B\u0430 \u043C\u043E\u044F \u043F\u0443\u0442\u0456\u0432\u043A\u0430
        \u0432 \u043A\u0440\u0430\u0449\u0435 \u0436\u0438\u0442\u0442\u044F. \u0410\u043B\u0435
        \u0437\u0430\u0440\u0430\u0437 \u044F \u0440\u043E\u0437\u0443\u043C\u0456\u044E,
        \u044F\u043A\u043E\u043C\u0443 \u0434\u0438\u044F\u0432\u043E\u043B\u043E\u0432\u0456
        \u043C\u0430\u043B\u043E \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u043B\u0430
        \u0434\u0443\u0448\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_183_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0442\u0430\u043A\u043E\u0436 \u043F\u0440\u0430\u0432\u0434\u0430,
        \u0449\u043E \u044F \u043D\u0435 \u043A\u043E\u0457\u043B\u0430 \u043D\u0456\u044F\u043A\u043E\u0433\u043E
        \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u0430. \u041D\u0435 \u044F \u0442\u0438\u0441\u043D\u0443\u043B\u0430
        \u043D\u0430 \u0433\u0430\u0447\u043E\u043A \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_184_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0430\u0439 \u0442\u0430\u043C \u044F\u043A, \u0446\u0435 \u0432\u0441\u0435
        \u043E\u0434\u043D\u043E \u043D\u0435 \u0432\u043F\u043B\u0438\u043D\u0435
        \u043D\u0430 \u0442\u0435, \u0449\u043E \u044F \u043C\u0430\u044E \u043D\u0430\u043C\u0456\u0440
        \u0437\u0440\u043E\u0431\u0438\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_185_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A\u0431\u0438 \u0436 \u0442\u043E. \u0422\u0438 \u0437\u043D\u0430\u0454\u0448
        \u0441\u0435\u0431\u0435. \u042F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u0432\u0441\u0456 \u0456\u043D\u0448\u0456 \u043C\u043E\u0436\u043B\u0438\u0432\u0456
        \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0438. \u0423 \u043F\u0440\u043E\u0446\u0435\u0441\u0456
        \u0431\u0430\u0447\u0438\u043B\u0430, \u044F\u043A\u0438\u0445 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u044C
        \u0437\u0430\u0437\u043D\u0430\u044E\u0442\u044C \u0434\u0435\u044F\u043A\u0456
        \u0432\u0435\u0440\u0441\u0456\u0457 \u0442\u0435\u0431\u0435. \u0406 \u0432\u0441\u0435
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043F\u0435\u0440\u0435\u043A\u043E\u043D\u0443\u0432\u0430\u043B\u0430\u0441\u044F,
        \u0449\u043E \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u2014 \u0454\u0434\u0438\u043D\u0438\u0439
        \u0432\u0438\u0445\u0456\u0434."
    - Language: 1
      Text: 
  - Key: scene_1_185_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0440\u043E\u0437\u0443\u043C\u0456\u0439, \u043C\u0435\u043D\u0456
        \u0441\u0430\u043C\u0456\u0439 \u043D\u0435 \u043B\u0435\u0433\u0448\u0435.
        \u0410\u0434\u0436\u0435 \u0440\u0430\u0437\u043E\u043C \u0437 \u0442\u043E\u0431\u043E\u044E,
        \u043F\u043E\u043C\u0440\u0443 \u0456 \u044F. \u0429\u0435\u0437\u043D\u0443
        \u0437 \u0431\u0443\u0434\u044C-\u044F\u043A\u043E\u0457 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456.
        \u0410\u043B\u0435 \u0446\u0435 \u0431\u0443\u0434\u0435 \u043A\u0440\u0430\u0449\u0438\u043C
        \u0432\u0447\u0438\u043D\u043A\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0436\u0435, \u0456\u043D\u0448\u0430 \u044F \u0431\u0443\u043B\u0430
        \u043D\u0430\u043B\u0430\u0448\u0442\u043E\u0432\u0430\u043D\u0430 \u0434\u0443\u0436\u0435
        \u0440\u0456\u0448\u0443\u0447\u0435. \u042F\u043A\u0449\u043E \u043D\u0435
        \u0431\u0443\u0434\u0443 \u0434\u0456\u044F\u0442\u0438, \u0432\u043E\u043D\u0430
        \u0432\u0431\u2019\u0454 \u043C\u0435\u043D\u0435 \u0441\u0430\u043C\u0435
        \u0442\u0443\u0442. \u0406 \u0447\u043E\u043C\u0443\u0441\u044C \u044F \u043D\u0435
        \u043C\u0430\u043B\u0430 \u0441\u0443\u043C\u043D\u0456\u0432\u0456\u0432,
        \u0449\u043E \u0431\u0443\u043B\u0430 \u043D\u0430 \u0442\u0430\u043A\u0435
        \u0437\u0434\u0430\u0442\u043D\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0440\u0435\u0431\u0430 \u0431\u0443\u043B\u043E \u0449\u043E\u0441\u044C
        \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u0442\u0438, \u0437\u043D\u0430\u0439\u0442\u0438
        \u0441\u043F\u043E\u0441\u0456\u0431 \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438\u0441\u044F,
        \u0443\u0437\u044F\u0442\u0438 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0438\u0439
        \xAB\u0442\u0430\u0439\u043C-\u0430\u0443\u0442\xBB, \u0449\u043E\u0431 \u0432\u0438\u0440\u043E\u0431\u0438\u0442\u0438
        \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0456\u044E. \u042F \u0448\u0432\u0438\u0434\u043A\u043E
        \u0432\u0438\u0445\u043E\u043F\u0438\u043B\u0430 \u043F\u043E\u043B\u0430\u0440\u043E\u0457\u0434
        \u0456\u0437 \u0441\u0443\u043C\u043A\u0438 \u0456 \u0432\u0436\u0435 \u043C\u0430\u0439\u0436\u0435
        \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u043B\u0430 \u043A\u043D\u043E\u043F\u043A\u0443
        \u0444\u043E\u0442\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0430\u0445!"
    - Language: 1
      Text: 
  - Key: scene_1_186_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0424\u043E\u0442\u043E\u043A\u0430\u043C\u0435\u0440\u0430 \u0440\u043E\u0437\u043B\u0435\u0442\u0456\u043B\u0430\u0441\u044C
        \u043F\u0440\u043E\u0441\u0442\u043E \u0432 \u043C\u043E\u0457\u0445 \u0440\u0443\u043A\u0430\u0445.
        \u0414\u0435\u043A\u0456\u043B\u044C\u043A\u0430 \u0443\u043B\u0430\u043C\u043A\u0456\u0432
        \u043F\u043B\u0430\u0441\u0442\u043C\u0430\u0441\u0438 \u043F\u0435\u043A\u0443\u0447\u0438\u043C
        \u0431\u043E\u043B\u0435\u043C \u0432\u043F\u2019\u044F\u043B\u0438\u0441\u044F
        \u0432 \u0434\u043E\u043B\u043E\u043D\u0456. \u042F \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044F
        \u0432 \u0431\u0456\u043A \u0437\u0432\u0443\u043A\u0443 \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A \u0456 \u043D\u0435 \u0437\u0443\u043F\u0438\u043D\u0438\u0432\u0448\u0438
        \u0441\u043B\u0456\u0437, \u0406\u043B\u043E\u043D\u0430 \u0441\u0442\u043E\u044F\u043B\u0430
        \u0437 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C \u0443
        \u0440\u0443\u043A\u0430\u0445 \u0456 \u043D\u0435\u0449\u0430\u0434\u043D\u043E
        \u0442\u0440\u0435\u043C\u0442\u0456\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0431\u0430\u0447\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_186_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u0448\u0430 \u044F \u0442\u0435\u0430\u0442\u0440\u0430\u043B\u044C\u043D\u043E
        \u043F\u043E\u0430\u043F\u043B\u043E\u0434\u0443\u0432\u0430\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0440\u0435\u0448\u0442\u0456. \u0422\u0432\u043E\u044E
        \u0447\u0430\u0441\u0442\u0438\u043D\u0443 \u0443\u0433\u043E\u0434\u0438
        \u043F\u043E\u0432\u043D\u0456\u0441\u0442\u044E \u0432\u0438\u043A\u043E\u043D\u0430\u043D\u043E.
        \u042F \u0432\u0436\u0435 \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u0438\u043B\u0430
        \u0432\u0441\u0456\u0445, \u043A\u043E\u0433\u043E \u0431\u0443\u043B\u043E
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E, \u0449\u043E\u0431 \u0442\u0435\u0431\u0435
        \u0437\u0430\u0445\u0438\u0441\u0442\u0438\u0442\u0438. \u0422\u0435\u043F\u0435\u0440
        \u0442\u0438 \u0432\u0456\u043B\u044C\u043D\u0430, \u0406\u043B\u043E\u043D\u043E,
        \u0456 \u0437\u043C\u043E\u0436\u0435\u0448 \u0434\u043E\u0431\u0440\u0435
        \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0440\u0435\u0448\u0442\u0443
        \u0436\u0438\u0442\u0442\u044F. \u042F \u0431\u0430\u0447\u0438\u043B\u0430
        \u0446\u0435 \u0432 \u043E\u0434\u043D\u0456\u0439 \u0456\u0437 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0427\u043E\u043C\u0443\u0441\u044C \u0406\u043B\u043E\u043D\u0430
        \u0437\u043E\u0432\u0441\u0456\u043C \u043D\u0435 \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u043B\u0430
        \u0449\u0430\u0441\u043B\u0438\u0432\u043E\u044E \u0432\u0456\u0434 \u0442\u0430\u043A\u043E\u0433\u043E
        \u043F\u0440\u0438\u0432\u0456\u0442\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0410 \u0442\u0435\u043F\u0435\u0440, \u0434\u0456\u0432\u0447\u0438\u043D\u043E,
        \u0434\u0430\u0439-\u043D\u043E \u043C\u0435\u043D\u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442.
        \u041D\u0430\u0441\u0442\u0430\u0432 \u0447\u0430\u0441 \u0434\u043B\u044F
        \u0444\u0456\u043D\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0430\u043A\u043E\u0440\u0434\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u043E, \u0431\u0443\u0434\u044C \u043B\u0430\u0441\u043A\u0430,
        \u043D\u0435 \u0440\u043E\u0431\u0438 \u0446\u044C\u043E\u0433\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0442\u0443\u043F\u0438\u0432\u0448\u0438 \u043E\u0447\u0456,
        \u0406\u043B\u043E\u043D\u0430 \u0446\u0435 \u0437\u0440\u043E\u0431\u0438\u043B\u0430.
        \u0422\u0435\u043F\u0435\u0440 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
        \u0431\u0443\u0432 \u0443 \u0456\u043D\u0448\u043E\u0457 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0438.
        \u0422\u043E\u0434\u0456 \u043C\u0435\u043D\u0456 \u0441\u0442\u0430\u043B\u043E
        \u043F\u043E-\u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u043C\u0443
        \u0441\u0442\u0440\u0430\u0448\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430 \u0437 \u0456\u043D\u0448\u043E\u0457
        \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456 \u043D\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0430
        \u0434\u0443\u043B\u043E \u043D\u0430 \u043C\u0435\u043D\u0435. \u0411\u0443\u043B\u043E
        \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E, \u0449\u043E \u0432\u043E\u043D\u0430
        \u0434\u0443\u0436\u0435 \u0445\u043E\u0447\u0435 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
        \u0446\u0435\u0439 \u043F\u043E\u0441\u0442\u0440\u0456\u043B \u0441\u0432\u043E\u0457\u043C\u0438
        \u0440\u0443\u043A\u0430\u043C\u0438. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0430\u0431\u0438 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u043F\u043E\u043C\u0441\u0442\u0438\u0442\u0438\u0441\u044F
        \u0441\u0430\u043C\u0456\u0439 \u0441\u043E\u0431\u0456 \u0437\u0430 \u0432\u0441\u0456
        \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u043D\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_186_part_14
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u0446\u0435\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u044F
        \u0437\u0440\u043E\u0431\u0438\u043B\u0430 \u0432\u0438\u0431\u0456\u0440\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_186_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0433\u043E\u0434\u0438\u0442\u0438\u0441\u044C, \u0449\u043E
        \u043F\u0440\u0438\u0439\u043D\u044F\u0442\u0438 \u0441\u043C\u0435\u0440\u0442\u044C
        \u2014 \u0446\u0435 \u0454\u0434\u0438\u043D\u0438\u0439 \u0433\u0456\u0434\u043D\u0438\u0439
        \u0432\u0438\u0445\u0456\u0434."
    - Language: 1
      Text: 
  - Key: scene_1_186_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0438\u043D\u0443\u0442\u0438\u0441\u044F \u043D\u0430 \u0456\u043D\u0448\u0443
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0443 \u0442\u0430 \u0432\u0438\u0431\u0438\u0442\u0438
        \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442."
    - Language: 1
      Text: 
  - Key: scene_1_187_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u043B\u0443\u043D\u0430\u0432 \u0449\u0435 \u043E\u0434\u0438\u043D
        \u043F\u043E\u0441\u0442\u0440\u0456\u043B."
    - Language: 1
      Text: 
  - Key: scene_1_187_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F\u043A\u0438\u043C\u043E\u0441\u044C \u0434\u0438\u0432\u043E\u0432\u0438\u0436\u043D\u0438\u043C
        \u0447\u0438\u043D\u043E\u043C, \u0432\u0456\u043D \u0443 \u043C\u0435\u043D\u0435
        \u043D\u0435 \u0432\u043B\u0443\u0447\u0438\u0432. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0456\u043D\u0448\u0430 \u044F \u0437\u043B\u044F\u043A\u0430\u043B\u0430\u0441\u044F
        \u0432\u0431\u0438\u0442\u0438 \u0441\u0430\u043C\u0443 \u0441\u0435\u0431\u0435,
        \u0456 \u0446\u044F \u043F\u043E\u043C\u0438\u043B\u043A\u0430 \u0437\u0431\u0438\u043B\u0430
        \u0457\u0457 \u043F\u0440\u0438\u0446\u0456\u043B."
    - Language: 1
      Text: 
  - Key: scene_1_187_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430 \u043C\u0438\u0442\u044C \u044F \u0432\u0436\u0435 \u043E\u043F\u0438\u043D\u0438\u043B\u0430\u0441\u044F
        \u0431\u0456\u043B\u044F \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u0446\u0456.
        \u0421\u043F\u0440\u0430\u0432\u043D\u0438\u043C \u0443\u0434\u0430\u0440\u043E\u043C
        \u0432\u0438\u0431\u0438\u043B\u0430 \u0437\u0431\u0440\u043E\u044E \u0437
        \u0457\u0457 \u0440\u0443\u043A, \u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
        \u0437\u0430\u0432\u0435\u0440\u0442\u0456\u0432\u0441\u044F \u0432 \u043F\u043E\u0432\u0456\u0442\u0440\u0456,
        \u043D\u0430\u0447\u0435 \u0444\u0440\u0438\u0437\u0431\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_187_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0435\u043D\u0456 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u0437\u0430\u0441\u0442\u0430\u0442\u0438 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0443
        \u0437 \u0456\u043D\u0448\u043E\u0457 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456
        \u0437\u043D\u0435\u043D\u0430\u0446\u044C\u043A\u0430, \u0442\u043E\u043C\u0443
        \u0434\u0456\u044F\u0442\u0438 \u0434\u0430\u043B\u0456 \u0442\u0440\u0435\u0431\u0430
        \u0431\u0443\u043B\u043E \u043D\u0435\u0433\u0430\u0439\u043D\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_187_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u0432\u0434\u0430\u0432\u0430\u0442\u0438 \u0443\u0434\u0430\u0440
        \u043D\u043E\u0433\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_187_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0438\u043D\u0443\u0442\u0438\u0441\u044F \u0437\u0430 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_188_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u0448\u0430 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430,
        \u0437\u0434\u0430\u0454\u0442\u044C\u0441\u044F, \u043C\u043E\u0433\u043B\u0430
        \u043F\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0438\u0442\u0438 \u0431\u0443\u0434\u044C-\u044F\u043A\u0456
        \u043C\u043E\u0457 \u0440\u0443\u0445\u0438. \u0412\u0456\u0434 \u0443\u0441\u0456\u0445
        \u0443\u0434\u0430\u0440\u0456\u0432 \u0432\u043E\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u043B\u0430
        \u0430\u0431\u043E \u0431\u043B\u043E\u043A\u0443\u0432\u0430\u043B\u0430
        \u0457\u0445, \u043D\u0456\u0431\u0438 \u0437\u043D\u0430\u043B\u0430 \u0432\u0441\u0435
        \u043D\u0430\u043F\u0435\u0440\u0435\u0434. \u0423 \u0440\u0443\u043A\u043E\u043F\u0430\u0448\u043D\u0456\u0439
        \u0431\u0456\u0439\u0446\u0456 \u044F \u0431\u0443\u043B\u0430 \u043D\u0435
        \u0440\u0456\u0432\u043D\u044F \u0431\u0456\u043B\u044C\u0448 \u0434\u043E\u0441\u0432\u0456\u0434\u0447\u0435\u043D\u0456\u0439
        \u0432\u0435\u0440\u0441\u0456\u0457 \u0441\u0435\u0431\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_188_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0434\u0456\u0431\u0440\u0430\u0432\u0448\u0438 \u0433\u0430\u0440\u043D\u0438\u0439
        \u043C\u043E\u043C\u0435\u043D\u0442, \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0430
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430 \u0432\u0434\u0430\u0440\u0438\u043B\u0430
        \u043C\u0435\u043D\u0435 \u043F\u0456\u0434 \u0434\u0438\u0445. \u0429\u043E
        \u0436, \u043D\u0430\u0432\u0456\u0442\u044C \u0441\u0442\u0430\u0440\u0448\u0430,
        \u0443\u0434\u0430\u0440 \u0432\u043E\u043D\u0430 \u0442\u0440\u0438\u043C\u0430\u0442\u0438
        \u0432\u043C\u0456\u043B\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_188_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430 \u043C\u0438\u0442\u044C \u0443 \u043C\u0435\u043D\u0435
        \u0437\u0430\u0431\u0440\u0430\u043B\u043E \u0434\u0443\u0445. \u0414\u043E\u043A\u0438
        \u044F \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u043F\u0440\u0438\u0439\u0442\u0438
        \u0434\u043E \u0442\u044F\u043C\u0438, \u0441\u0443\u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u0446\u044F
        \u0432\u0441\u0442\u0438\u0433\u043B\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438
        \u0437\u0431\u0440\u043E\u044E \u0441\u043E\u0431\u0456. \u041C\u0438 \u0437\u043D\u043E\u0432\u0443
        \u0431\u0443\u043B\u0438 \u0442\u0430\u043C, \u0456\u0437 \u0447\u043E\u0433\u043E
        \u043F\u043E\u0447\u0430\u043B\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_188_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u0442\u0430\u043D\u043D\u0456\u043C \u0448\u0430\u043D\u0441\u043E\u043C
        \u0434\u043B\u044F \u043C\u0435\u043D\u0435 \u0431\u0443\u043B\u043E\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_188_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u0442\u0438\u0441\u044F
        \u043D\u0430 \u0433\u043B\u0438\u0431\u0438\u043D\u043D\u0438\u0445 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u044F\u0445
        \u0456 \u043D\u0430\u043C\u0430\u0433\u0430\u0442\u0438\u0441\u044F \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438
        \u0437\u0434\u0456\u0431\u043D\u0456\u0441\u0442\u044C \u0431\u0435\u0437
        \u0444\u043E\u0442\u043E\u043A\u0430\u043C\u0435\u0440\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_188_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F \u0432\u0456\u0434
        \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u0443 \u0437\u0430 \u0406\u043B\u043E\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u0430\u043F\u043B\u044E\u0449\u0438\u043B\u0430 \u043E\u0447\u0456.
        \u0412\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0456 \u0431\u0443\u0432
        \u0446\u0456\u043B\u0438\u0439 \u0432\u0438\u0445\u043E\u0440 \u0435\u043C\u043E\u0446\u0456\u0439.
        \u0421\u0442\u0440\u0430\u0445. \u0417\u0431\u0443\u0434\u0436\u0435\u043D\u043D\u044F.
        \u0412\u0442\u043E\u043C\u0430. \u0417\u043B\u0456\u0441\u0442\u044C. \u042F
        \u0432\u0456\u0434\u0447\u0443\u0432\u0430\u043B\u0430, \u044F\u043A \u0430\u0434\u0440\u0435\u043D\u0430\u043B\u0456\u043D
        \u0442\u0435\u0447\u0435 \u0432 \u043C\u043E\u0457\u0439 \u043A\u0440\u043E\u0432\u0456."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u043E\u0441\u0442\u0440\u0456\u043B."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0447\u0443\u043B\u0430 \u044F\u043A \u043A\u0443\u043B\u044F
        \u043B\u0435\u0442\u0438\u0442\u044C \u0443 \u043C\u043E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0413\u043E\u0441\u0442\u0440\u0438\u0439 \u0431\u0456\u043B\u044C
        \u043F\u0440\u043E\u0439\u043D\u044F\u0432 \u0443\u0441\u0435 \u0442\u0456\u043B\u043E.
        \u041A\u0443\u043B\u044F \u043D\u0435 \u0432\u043B\u0443\u0447\u0438\u043B\u0430
        \u0432 \u0436\u0438\u0442\u0442\u0454\u0432\u043E-\u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0438\u0439
        \u043E\u0440\u0433\u0430\u043D, \u0442\u0430 \u0432\u0456\u0434 \u0446\u044C\u043E\u0433\u043E
        \u043D\u0435 \u0441\u0442\u0430\u043B\u043E \u043A\u0440\u0430\u0449\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u0440\u043E\u0432 \u043F\u043B\u0435\u0441\u043A\u0430\u043B\u0430
        \u0437 \u0440\u0430\u043D\u0438 \u0432 \u0431\u043E\u0446\u0456. \u0411\u0456\u043B\u044C
        \u043F\u0435\u0440\u0435\u043A\u0440\u0438\u0432 \u043C\u0430\u0439\u0436\u0435
        \u0432\u0441\u0435 \u0456\u043D\u0448\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0437\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043B\u0430\u0441\u044F
        \u043D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0432\u0456\u0434\u0447\u0443\u0442\u0442\u0456.
        \u0421\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430 \u043F\u043E\u0440\u0438\u043D\u0443\u0442\u0438
        \u0432 \u043D\u044C\u043E\u0433\u043E, \u043F\u0435\u0440\u0435\u043C\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044F
        \u0437 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u0432\u0456\u0442\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0436 \u043E\u0441\u044C, \u0443\u0441\u0435 \u043D\u0430\u0432\u043A\u0440\u0443\u0433\u0438
        \u0437\u0430\u0432\u043C\u0435\u0440\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_189_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043C\u0435\u043D\u0435 \u0432\u0438\u0439\u0448\u043B\u043E
        \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0434\u0432\u0435\u0440\u0456
        \u0434\u043E \u0456\u043D\u0448\u0438\u0445 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439!"
    - Language: 1
      Text: 
  - Key: scene_1_189_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0430\u043B\u0438\u0448\u0438\u043B\u0438\u0441\u044C \u0442\u0456\u043B\u044C\u043A\u0438
        \u044F, \u0431\u0456\u043B\u044C \u0442\u0430 \u043D\u0435\u0437\u043B\u0456\u0447\u0435\u043D\u043D\u0430
        \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0456\u043D\u0448\u0438\u0445
        \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456\u0432, \u0443 \u044F\u043A\u0456
        \u044F \u043C\u043E\u0433\u043B\u0430 \u0437\u0440\u043E\u0431\u0438\u0442\u0438
        \u043A\u0440\u043E\u043A."
    - Language: 1
      Text: 
  - Key: scene_1_190_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0432\u0456\u0442\u044C \u043D\u0435 \u0437\u043D\u0430\u044E,
        \u043D\u0430 \u0449\u043E \u044F \u0441\u043F\u043E\u0434\u0456\u0432\u0430\u043B\u0430\u0441\u044F.
        \u0414\u0443\u043C\u0430\u043B\u0430, \u0449\u043E \u0456\u043D\u0448\u0456\u0439
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u0446\u0456 \u0441\u0442\u0430\u043D\u0435
        \u0448\u043A\u043E\u0434\u0430 \u0406\u043B\u043E\u043D\u0443? \u0410\u043B\u0435
        \u0436 \u044F \u0432\u0436\u0435 \u0431\u0430\u0447\u0438\u043B\u0430, \u0449\u043E
        \u043F\u0435\u0440\u0435\u0434 \u0441\u0432\u043E\u0454\u044E \u043C\u0435\u0442\u043E\u044E
        \u0432\u043E\u043D\u0430 \u043D\u0435 \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u044C\u0441\u044F
        \u043D\u0456 \u043F\u0435\u0440\u0435\u0434 \u0447\u0438\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_190_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0411\u0435\u0437 \u0436\u043E\u0434\u043D\u0438\u0445 \u0432\u0430\u0433\u0430\u043D\u044C
        \u0432\u043E\u043D\u0430 \u0437\u0440\u043E\u0431\u0438\u043B\u0430 \u043F\u043E\u0441\u0442\u0440\u0456\u043B."
    - Language: 1
      Text: 
  - Key: scene_1_190_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u043F\u043E\u0447\u0430\u0442\u043A\u0443 \u044F \u043F\u043E\u0447\u0443\u043B\u0430
        \u0433\u043E\u043B\u043E\u0441\u043D\u0438\u0439 \u043F\u043E\u0441\u043C\u0435\u0440\u0442\u043D\u0438\u0439
        \u043A\u0440\u0438\u043A \u0406\u043B\u043E\u043D\u0438, \u043A\u043E\u043B\u0438
        \u043A\u0443\u043B\u044F \u043F\u0440\u043E\u0439\u0448\u043B\u0430 \u043A\u0440\u0456\u0437\u044C
        \u0457\u0457 \u0442\u0456\u043B\u043E. \u041E\u0434\u0440\u0430\u0437\u0443
        \u0437\u0430 \u0446\u0438\u043C \u0433\u043E\u0441\u0442\u0440\u0438\u0439
        \u0431\u0456\u043B\u044C \u043F\u0440\u043E\u0439\u043D\u044F\u0432 \u0456
        \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_1_191_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F, \u0449\u043E
        \u0456\u043D\u0448\u0430 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430
        \u0434\u0443\u043C\u0430\u043B\u0430, \u0442\u0430\u043A \u0441\u0430\u043C\u043E
        \u044F\u043A \u044F. \u0417 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u044E
        \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E \u043C\u0438 \u043F\u0456\u0434\u0441\u043A\u043E\u0447\u0438\u043B\u0438
        \u0442\u0430 \u043F\u043E\u0442\u044F\u0433\u043D\u0443\u043B\u0438\u0441\u044F
        \u0437\u0430 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C,
        \u0430\u043B\u0435\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_191_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0421\u0445\u043E\u043F\u0438\u0442\u0438 \u0439\u043E\u0433\u043E
        \u043D\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F \u0436\u043E\u0434\u043D\u0456\u0439
        \u0456\u0437 \u043D\u0430\u0441. \u041D\u0430\u0448\u0456 \u0440\u0443\u043A\u0438
        \u0441\u0442\u0443\u043A\u043D\u0443\u043B\u0438\u0441\u044F \u043E\u0431
        \u0437\u0431\u0440\u043E\u044E, \u0456 \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
        \u0437\u043D\u043E\u0432\u0443 \u043F\u043E\u043B\u0435\u0442\u0456\u0432
        \u043A\u0443\u0434\u0438\u0441\u044C \u0443 \u043C\u043E\u043A\u0440\u0443
        \u0442\u0440\u0430\u0432\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_191_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u041A\u043E\u043B\u0438 \u044F \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
        \u0432\u0456\u0434\u0432\u043E\u043B\u0456\u043A\u043B\u0430\u0441\u044F,
        \u0449\u043E\u0431\u0438 \u043F\u0440\u043E\u0441\u043B\u0456\u0434\u043A\u0443\u0432\u0430\u0442\u0438
        \u0442\u0440\u0430\u0454\u043A\u0442\u043E\u0440\u0456\u044E \u0439\u043E\u0433\u043E
        \u043F\u043E\u043B\u044C\u043E\u0442\u0443, \u0456\u043D\u0448\u0430 \u044F
        \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043B\u0430\u0441\u044F
        \u0448\u0430\u043D\u0441\u043E\u043C \u0442\u0430 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0440\u0430\u0437\u0456\u0432 \u0446\u0430\u0440\u0430\u043F\u043D\u0443\u043B\u0430
        \u043C\u0435\u043D\u0435 \u043D\u0456\u0433\u0442\u044F\u043C\u0438 \u043F\u043E
        \u043E\u0431\u043B\u0438\u0447\u0447\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_191_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0442 \u0436\u0435\u0436 \u043A\u043B\u044F\u0442\u0430 \u0445\u0432\u043E\u0439\u0434\u0430!"
    - Language: 1
      Text: 
  - Key: scene_1_191_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0456\u0434 \u0442\u0430\u043A\u043E\u0457 \u0436 \u0447\u0443\u044E!"
    - Language: 1
      Text: 
  - Key: scene_1_191_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0434\u0438\u043D \u0437\u0430 \u043E\u0434\u043D\u0438\u043C
        \u043D\u0430 \u043C\u0435\u043D\u0435 \u0441\u0438\u043F\u0430\u043B\u0438\u0441\u044F
        \u0443\u0434\u0430\u0440\u0438 \u0432\u0456\u0434 \u043C\u0435\u043D\u0435
        \u0436 \u0441\u0430\u043C\u043E\u0457. \u042F \u0431\u0456\u043B\u044C\u0448\u0435
        \u043D\u0435 \u043C\u0430\u043B\u0430 \u0441\u0438\u043B \u0431\u043E\u0440\u043E\u043D\u0438\u0442\u0438\u0441\u044F\u2026"
    - Language: 1
      Text: 
  - Key: scene_1_191_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0431\u0440\u0430\u0432\u0448\u0438 \u043F\u043E\u0432\u0456\u0442\u0440\u044F
        \u0432 \u0433\u0440\u0443\u0434\u0438, \u044F \u043A\u0440\u0438\u043A\u043D\u0443\u043B\u0430
        \u0443 \u0432\u0456\u0434\u0447\u0430\u0439\u0434\u0443\u0448\u043D\u0456\u0439
        \u0441\u043F\u0440\u043E\u0431\u0456 \u0431\u043B\u0430\u0433\u0430\u0442\u0438
        \u043F\u0440\u043E \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0443."
    - Language: 1
      Text: 
  - Key: scene_1_191_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043B\u043E\u043D\u043E! \u041A\u0445\u0430\u2026 \u041F\u0456\u0441\u0442\u043E\u043B\u0435\u0442
        \u0431\u0456\u043B\u044F \u0442\u0435\u0431\u0435\u2026 \u0421\u0442\u0440\u0456\u043B\u044F\u0439!"
    - Language: 1
      Text: 
  - Key: scene_1_191_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0423 \u0442\u0443 \u043C\u0438\u0442\u044C \u043E\u0431\u0438\u0434\u0432\u0456
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0438 \u0441\u043F\u043E\u0441\u0442\u0435\u0440\u0456\u0433\u0430\u043B\u0438,
        \u044F\u043A \u0434\u0456\u0432\u0447\u0438\u043D\u0430 \u043F\u0456\u0434\u043D\u044F\u043B\u0430
        \u0437\u0431\u0440\u043E\u044E \u0442\u0430 \u043D\u0430\u0432\u0435\u043B\u0430
        \u0432 \u043D\u0430\u0448\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
        \u0422\u0435\u043F\u0435\u0440 \u0443\u0441\u0435 \u0437\u0430\u043B\u0435\u0436\u0430\u043B\u043E
        \u043B\u0438\u0448\u0435 \u0432\u0456\u0434 \u0457\u0457 \u0432\u0438\u0431\u043E\u0440\u0443. "
    - Language: 1
      Text: 
  - Key: scene_1_191_part_10
    LocalizationDatas:
    - Language: 0
      Text: ...
    - Language: 1
      Text: 
  - Key: scene_1_192_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0454 \u0442\u0456\u043B\u043E \u043F\u0440\u043E\u0439\u043D\u044F\u0432
        \u0433\u043E\u0441\u0442\u0440\u0438\u0439 \u0431\u0456\u043B\u044C. \u041A\u0440\u043E\u0432
        \u043F\u043B\u0435\u0441\u043A\u0430\u043B\u0430 \u0437 \u0440\u0430\u043D\u0438
        \u0432 \u0431\u043E\u0446\u0456. \u0421\u0438\u043B \u0431\u0456\u043B\u044C\u0448\u0435
        \u043D\u0435 \u043B\u0438\u0448\u0430\u043B\u043E\u0441\u044F, \u0456 \u044F
        \u043F\u043E\u043A\u0456\u0440\u043D\u043E \u0437\u0430\u043F\u043B\u044E\u0449\u0438\u043B\u0430
        \u043E\u0447\u0456, \u0432\u0456\u0434\u0434\u0430\u0432\u0448\u0438\u0441\u044C
        \u043E\u0431\u0456\u0439\u043C\u0430\u043C \u0432\u0441\u0435\u043F\u043E\u0433\u043B\u0438\u043D\u0430\u044E\u0447\u043E\u0457
        \u0442\u0435\u043C\u0440\u044F\u0432\u0438."
    - Language: 1
      Text: 
  - Key: scene_1_193_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u0431\u0430\u0447\u0438\u043B\u0430 \u044F\u043A \u043A\u0443\u043B\u044F
        \u0432\u0438\u043B\u0435\u0442\u0456\u043B\u0430 \u0437 \u0434\u0443\u043B\u0430
        \u043F\u0456\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
        \u043C\u0435\u043D\u0435. \u0417\u0430\u043C\u0440\u0443\u0436\u0438\u0432\u0448\u0438
        \u043E\u0447\u0456, \u044F \u043F\u0440\u0438\u0433\u043E\u0442\u0443\u0432\u0430\u043B\u0430\u0441\u044F
        \u0434\u043E \u043D\u0430\u0439\u0433\u0456\u0440\u0448\u043E\u0433\u043E.
        \u042F\u043A\u0449\u043E \u0441\u044C\u043E\u0433\u043E\u0434\u043D\u0456
        \u0441\u0443\u0434\u0438\u043B\u043E\u0441\u044F \u043F\u043E\u043C\u0435\u0440\u0442\u0438,
        \u0442\u0430\u043A \u0442\u043E\u043C\u0443 \u0439 \u0431\u0443\u0442\u0438.
        \u042F \u043D\u0435 \u043C\u0430\u043B\u0430 \u0441\u0438\u043B \u0456 \u0434\u0430\u043B\u0456
        \u0431\u043E\u0440\u043E\u0442\u0438\u0441\u044F \u0437 \u0434\u043E\u043B\u0435\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_193_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0420\u043E\u0437\u0434\u0430\u0432\u0441\u044F \u0433\u043E\u0441\u0442\u0440\u0438\u0439
        \u043A\u0440\u0438\u043A \u0456 \u0448\u0432\u0438\u0434\u043A\u043E \u043E\u0431\u0456\u0440\u0432\u0430\u0432\u0441\u044F.
        \u0412\u0456\u043D \u043D\u0430\u043B\u0435\u0436\u0430\u0432 \u043C\u0435\u043D\u0456\u2026
        \u041F\u0440\u043E\u0442\u0435 \u0432\u0438\u0445\u043E\u0434\u0438\u0432
        \u043D\u0435 \u0437 \u043C\u043E\u0433\u043E \u0440\u043E\u0442\u0430."
    - Language: 1
      Text: 
  - Key: scene_1_193_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0456\u043B\u043E \u0456\u043D\u0448\u043E\u0457 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0438
        \u0431\u0456\u043B\u044F \u043C\u0435\u043D\u0435 \u0432\u043F\u0430\u043B\u043E
        \u043D\u0430 \u0437\u0435\u043C\u043B\u044E. \u041D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0432\u0456\u0440\u0438\u043B\u043E\u0441\u044F, \u0449\u043E
        \u043F\u0456\u0441\u043B\u044F \u0432\u0441\u044C\u043E\u0433\u043E \u044F
        \u0437\u0430\u043B\u0438\u0448\u0438\u043B\u0430\u0441\u044F \u0436\u0438\u0432\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u043E \u043E\u0441\u044C \u044F\u043A \u0432\u043E\u043D\u043E,
        \u043F\u043E\u043C\u0438\u0440\u0430\u0442\u0438."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u043E\u0434\u0456 \u0436\u0435\u0440\u0442\u0432\u0430
        \u043E\u0434\u043D\u0456\u0454\u0457 \u043B\u044E\u0434\u0438\u043D\u0438
        \u043D\u0435\u043E\u0431\u0445\u0456\u0434\u043D\u0430, \u0430\u0431\u0438
        \u0432\u0440\u044F\u0442\u0443\u0432\u0430\u0442\u0438 \u0431\u0430\u0433\u0430\u0442\u044C\u043E\u0445
        \u0456\u043D\u0448\u0438\u0445."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0412 \u043C\u043E\u0454\u043C\u0443 \u0436 \u0432\u0438\u043F\u0430\u0434\u043A\u0443
        \u044F \u0432\u0456\u0434\u0434\u0430\u043B\u0430 \u0432\u0441\u0456 \u0448\u0430\u043D\u0441\u0438
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u0438 \u0432\u043B\u0430\u0441\u043D\u0435
        \u0449\u0430\u0441\u0442\u044F, \u0430\u0431\u0438 \u043D\u0456\u044F\u043A\u0430
        \u0432\u0435\u0440\u0441\u0456\u044F \u043C\u0435\u043D\u0435 \u043D\u0435
        \u0437\u043D\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0438\u0445
        \u0442\u0440\u0430\u0433\u0435\u0434\u0456\u0439 \u0442\u0430 \u0431\u043E\u043B\u044E."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0442\u043E\u0441\u044C \u043C\u0456\u0433 \u0431\u0438 \u043D\u0430\u0437\u0432\u0430\u0442\u0438
        \u0446\u0435 \u0445\u043E\u0440\u043E\u0431\u0440\u0438\u043C \u0432\u0447\u0438\u043D\u043A\u043E\u043C,
        \u043D\u0430\u0432\u0456\u0442\u044C \u0433\u0435\u0440\u043E\u0457\u0447\u043D\u0438\u043C.
        \u042F \u0432\u0456\u0434\u0434\u0430\u043B\u0430 \u0436\u0438\u0442\u0442\u044F,
        \u0449\u043E\u0431 \u0432\u0438\u043F\u0440\u0430\u0432\u0438\u0442\u0438
        \u0432\u0441\u0456 \u0441\u0432\u043E\u0457 \u043A\u043E\u043B\u0438\u0448\u043D\u0456
        \u043F\u043E\u043C\u0438\u043B\u043A\u0438."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0456\u043B\u044C\u043A\u0438 \u0448\u043A\u043E\u0434\u0430,
        \u043D\u0456\u0445\u0442\u043E \u0432\u0436\u0435 \u043D\u0435 \u0434\u0456\u0437\u043D\u0430\u0454\u0442\u044C\u0441\u044F
        \u043F\u0440\u043E \u0446\u0435\u0439 \u0432\u0447\u0438\u043D\u043E\u043A,
        \u0430\u0434\u0436\u0435 \u043C\u043E\u0454 \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F
        \u0441\u0442\u0435\u0440\u043B\u043E\u0441\u044F \u0437 \u0443\u0441\u0456\u0445
        \u043C\u043E\u0436\u043B\u0438\u0432\u0438\u0445 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0435\u0439.
        \u041D\u0456\u044F\u043A\u043E\u0457 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0438
        \u043D\u0456\u043A\u043E\u043B\u0438 \u043D\u0435 \u0431\u0443\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0425\u0442\u043E\u0441\u044C \u0456\u043D\u0448\u0438\u0439 \u043D\u0430\u0432\u043F\u0430\u043A\u0438
        \u043D\u0430\u0437\u0432\u0430\u0432 \u0431\u0438 \u0446\u0435 \u0431\u043E\u044F\u0433\u0443\u0437\u0442\u0432\u043E\u043C
        \u0447\u0438 \u0441\u043B\u0430\u0431\u043A\u0456\u0441\u0442\u044E. \u0410\u0434\u0436\u0435
        \u044F \u043D\u0435 \u0432\u0438\u0431\u043E\u0440\u043E\u043B\u0430 \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0456
        \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438 \u0434\u0430\u043B\u0456
        \u0456 \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0441\u0438\u0442\u0443\u0430\u0446\u0456\u044E,
        \u044F\u043A\u0430 \u0441\u043A\u043B\u0430\u043B\u0430\u0441\u044F \u0437
        \u043C\u043E\u0457\u043C \u0436\u0438\u0442\u0442\u044F\u043C. \u041D\u0435
        \u0437\u0443\u0441\u0442\u0440\u0456\u043B\u0430\u0441\u044F \u0432\u0456\u0447-\u043D\u0430-\u0432\u0456\u0447
        \u0456\u0437 \u0442\u0440\u0443\u0434\u043D\u043E\u0449\u0430\u043C\u0438
        \u0437 \u0433\u043E\u0440\u0434\u043E \u043F\u0456\u0434\u043D\u044F\u0442\u043E\u044E
        \u0433\u043E\u043B\u043E\u0432\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0434\u0436\u0435 \u0449\u0430\u0441\u0442\u044F \u0442\u0440\u0435\u0431\u0430
        \u0432\u0438\u0431\u043E\u0440\u044E\u0432\u0430\u0442\u0438. \u0416\u043E\u0434\u043D\u0438\u0445
        \u0448\u0430\u043D\u0441\u0456\u0432 \u043D\u0435 \u0437\u0434\u043E\u0431\u0443\u0434\u0435\u0448,
        \u044F\u043A\u0449\u043E \u043F\u043E\u043C\u0440\u0435\u0448 \u0456 \u0432\u0456\u0434\u043C\u043E\u0432\u0438\u0448\u0441\u044F
        \u0432\u0456\u0434 \u0446\u0456\u0454\u0457 \u0431\u0430\u0442\u0430\u043B\u0456\u0457
        \u0437\u0430\u0432\u0434\u043E\u0432\u0436\u043A\u0438 \u0436\u0438\u0442\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_8_197_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0440\u0435\u0448\u0442\u043E\u044E, \u0446\u0435 \u043D\u0435
        \u043C\u0430\u0454 \u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F. \u0410\u0434\u0436\u0435
        \u044F\u043A\u0438\u043C\u0438 \u0431 \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u043C\u0438
        \u043C\u0438 \u0441\u043E\u0431\u0456 \u043D\u0435 \u0432\u0432\u0438\u0436\u0430\u043B\u0438\u0441\u044F,
        \u0443\u0441\u0435 \u043E\u0434\u043D\u043E \u0443 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0456\u0439
        \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u043F\u043E\u0434\u0456\u0439,
        \u044F\u043A\u0456 \u0432\u0436\u0435 \u0432\u0456\u0434\u0431\u0443\u043B\u0438\u0441\u044F,
        \u0430 \u0442\u0430\u043A\u043E\u0436 \u0442\u0438\u0445, \u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438
        \u043C\u043E\u0433\u043B\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u044F,
        \u0430\u0431\u043E \u044F\u043A\u0456 \u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0441\u043C\u0456\u043B\u0438 \u0441\u043E\u0431\u0456 \u0443\u044F\u0432\u0438\u0442\u0438,
        \u043D\u0430\u0448\u0435 \u0436\u0438\u0442\u0442\u044F \u0431\u0443\u043B\u043E
        \u043B\u0438\u0448\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u044E
        \u043C\u0438\u0442\u0442\u044E, \u043D\u0435\u043C\u043E\u0432 \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A
        \u0441\u0432\u0456\u0442\u043B\u0430 \u0432 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430 \u0442\u0443
        \u0433\u0456\u043B\u043A\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456,
        \u0443 \u043A\u043E\u0442\u0440\u0456\u0439 \u043D\u0456\u043A\u043E\u043B\u0438
        \u043D\u0435 \u0431\u0443\u043B\u0430 \u043F\u043E\u0440\u0430\u043D\u0435\u043D\u0430
        \u043F\u043E\u0441\u0442\u0440\u0456\u043B\u043E\u043C \u0437\u0456 \u0437\u0431\u0440\u043E\u0457.
        \u041F\u0435\u0440\u0435\u043C\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044F
        \u0432 \u043D\u0435\u0457 \u0432\u0438\u044F\u0432\u0438\u043B\u043E\u0441\u044F
        \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u043B\u0435\u0433\u043A\u043E,
        \u044F\u043A \u043F\u043E\u0440\u0443\u0445\u0430\u0442\u0438 \u0440\u0443\u043A\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435, \u044F\u043A \u0442\u0456\u043B\u044C\u043A\u0438
        \u0447\u0430\u0441 \u0437\u043D\u043E\u0432\u0443 \u043F\u0456\u0448\u043E\u0432,
        \u0456\u043D\u0448\u0430 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430
        \u0442\u0430\u043A \u0441\u0430\u043C\u043E \u0431\u0443\u043B\u0430 \u0442\u0443\u0442.
        \u041C\u0435\u043D\u0456 \u043D\u0456\u044F\u043A \u043D\u0435 \u0432\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F
        \u0432\u0442\u0435\u043A\u0442\u0438 \u0432\u0456\u0434 \u043D\u0435\u0457.
        \u0423 \u044F\u043A\u0456\u0439 \u0431\u0438 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456
        \u044F \u043D\u0435 \u043E\u043F\u0438\u043D\u044F\u043B\u0430\u0441\u044F,
        \u0432\u043E\u043D\u0430 \u0442\u0430\u043A\u043E\u0436 \u043F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u043B\u0430\u0441\u044F
        \u0442\u0443\u0434\u0438. \u0412\u0441\u044E\u0434\u0438 \u043F\u0435\u0440\u0435\u0441\u043B\u0456\u0434\u0443\u0432\u0430\u043B\u0430
        \u043C\u0435\u043D\u0435."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435 \u043C\u043E\u0436\u043D\u0430 \u0431\u0443\u043B\u043E
        \u0431 \u043D\u0430\u0437\u0432\u0430\u0442\u0438 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044C\u043E\u044E
        \u0431\u0438\u0442\u0432\u043E\u044E \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0438\u0445
        \u0441\u0432\u0456\u0442\u0456\u0432. \u0406\u043D\u0448\u0430 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430
        \u043D\u0430\u043C\u0430\u0433\u0430\u043B\u0430\u0441\u044F \u0437\u0430\u043F\u0445\u0430\u0442\u0438
        \u043C\u0435\u043D\u0435 \u0434\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0456,
        \u0434\u0435 \u043D\u0430\u0440\u0435\u0448\u0442\u0456 \u0437\u043C\u043E\u0436\u0435
        \u0437\u0430\u0431\u0438\u0442\u0438 \u0432 \u0433\u043B\u0443\u0445\u0438\u0439
        \u043A\u0443\u0442."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u044F \u0432\u0441\u044E\u0434\u0438 \u0432\u0438\u043A\u0438\u0434\u0430\u043B\u0430
        \u0457\u0457 \u0437\u0430 \u043C\u0435\u0436\u0456 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0443,
        \u0430 \u043F\u043E\u0442\u0456\u043C \u0442\u0456\u043A\u0430\u043B\u0430
        \u0439 \u0441\u0430\u043C\u0430. \u041D\u0435 \u0437\u043D\u0430\u044E, \u0441\u043A\u0456\u043B\u044C\u043A\u0438
        \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456 \u043F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0432\u0430\u0432\u0441\u044F
        \u0446\u0435\u0439 \u0434\u0432\u043E\u0431\u0456\u0439. \u041C\u043E\u0436\u043B\u0438\u0432\u043E,
        \u0443 \u043D\u044C\u043E\u0433\u043E \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0431\u0443\u043B\u043E \u043F\u043E\u0447\u0430\u0442\u043A\u0443
        \u0439 \u043A\u0456\u043D\u0446\u044F."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u0417\u0434\u0430\u0432\u0430\u043B\u043E\u0441\u044F, \u043C\u0438
        \u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438 \u0442\u0430\u043A\u0443
        \u043A\u0456\u043B\u044C\u043A\u0456\u0441\u0442\u044C \u0430\u043B\u044C\u0442\u0435\u0440\u043D\u0430\u0442\u0438\u0432\u043D\u0438\u0445
        \u0432\u0430\u0440\u0456\u0430\u043D\u0442\u0456\u0432 \u0456\u0441\u043D\u0443\u0432\u0430\u043D\u043D\u044F
        \u0432\u0441\u0435\u0441\u0432\u0456\u0442\u0443, \u0449\u043E \u043F\u0440\u043E\u0440\u043E\u0431\u0438\u043B\u0438
        \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u044E \u0434\u0456\u0440\u043A\u0443
        \u0432 \u0439\u043E\u0433\u043E \u043A\u043E\u0440\u0434\u043E\u043D\u0430\u0445."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u0412\u0440\u0435\u0448\u0442\u0456 \u043C\u0435\u043D\u0435 \u0432\u0438\u043A\u0438\u043D\u0443\u043B\u043E
        \u0443 \u044F\u043A\u0435\u0441\u044C \u043C\u0456\u0441\u0446\u0435, \u0449\u043E
        \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0431\u0443\u043B\u043E
        \u043E\u043F\u0438\u0441\u0430\u0442\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438.
        \u0423 \u0442\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442 \u044F \u0437\u043D\u0430\u043B\u0430
        \u2014 \u0432\u043E\u043D\u043E \u0440\u043E\u0437\u0442\u0430\u0448\u043E\u0432\u0443\u0432\u0430\u043B\u043E\u0441\u044F
        \u043F\u043E\u0437\u0430 \u043C\u0435\u0436\u0430\u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0443
        \u0442\u0430 \u0447\u0430\u0441\u0443. \u042F \u0437\u043D\u0430\u043B\u0430
        \u0432\u0437\u0430\u0433\u0430\u043B\u0456 \u0432\u0441\u0435 \u0439 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E
        \u043D\u0456\u0447\u043E\u0433\u043E, \u0430\u0434\u0436\u0435 \u0437\u043D\u0430\u043D\u043D\u044F
        \u0442\u0430\u043C \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435 \u0456\u0441\u043D\u0443\u0432\u0430\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u0406\u043D\u0448\u0430 \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u0430
        \u0442\u0430\u043A\u043E\u0436 \u043A\u0443\u0434\u0438\u0441\u044C \u043F\u043E\u0434\u0456\u043B\u0430\u0441\u044F.
        \u041C\u043E\u043C\u0435\u043D\u0442\u043E\u043C \u043F\u0456\u0437\u043D\u0456\u0448\u0435\u2026
        \u0410\u0431\u043E \u043D\u0430\u0432\u043F\u0430\u043A\u0438 \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C
        \u0440\u0430\u043D\u0456\u0448\u0435, \u044F \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u043B\u0430,
        \u0449\u043E \u0442\u0443\u0442 \u043D\u0435 \u043C\u043E\u0433\u043B\u043E
        \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438 \u0434\u0435\u043A\u0456\u043B\u044C\u043A\u0430
        \u0432\u0435\u0440\u0441\u0456\u0439 \u043C\u0435\u043D\u0435 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E.
        \u0427\u0435\u0441\u043D\u043E \u043A\u0430\u0436\u0443\u0447\u0438, \u0442\u0430\u043C
        \u043D\u0435 \u043C\u0430\u043B\u043E \u0456\u0441\u043D\u0443\u0432\u0430\u0442\u0438
        \u043D\u0430\u0432\u0456\u0442\u044C \u043E\u0434\u043D\u0456\u0454\u0457."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0442\u0435 \u044F\u043A\u0438\u043C\u043E\u0441\u044C
        \u0447\u0438\u043D\u043E\u043C \u043C\u0435\u043D\u0456 \u0446\u0435 \u0432\u0434\u0430\u043B\u043E\u0441\u044F.
        \u042F \u043C\u043E\u0433\u043B\u0430 \u043E\u0441\u044F\u0433\u043D\u0443\u0442\u0438
        \u0432\u0435\u0441\u044C \u0432\u0441\u0435\u0441\u0432\u0456\u0442 \u0443
        \u0447\u043E\u0442\u0438\u0440\u044C\u043E\u0445\u0432\u0438\u043C\u0456\u0440\u043D\u043E\u043C\u0443
        \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u0456. \u042F \u0431\u0430\u0447\u0438\u043B\u0430
        \u043C\u0438\u043D\u0443\u043B\u0435, \u0442\u0435\u043F\u0435\u0440\u0456\u0448\u043D\u0454
        \u0442\u0430 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u0454 \u043E\u0434\u043D\u043E\u0447\u0430\u0441\u043D\u043E,
        \u0432 \u043E\u0434\u043D\u0456\u0439 \u0442\u043E\u0447\u0446\u0456."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_9
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0434\u0435\u0441\u044C \u0441\u0435\u0440\u0435\u0434 \u0446\u0456\u0454\u0457
        \u0440\u0430\u0437\u044E\u0447\u043E\u0457 \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u043E\u0441\u0442\u0456,
        \u044F\u043A\u0443 \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E
        \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438, \u0434\u043E \u043C\u0435\u043D\u0435
        \u0434\u043E\u043B\u0438\u043D\u0443\u0432 \u043E\u0434\u0438\u043D \u0454\u0434\u0438\u043D\u0438\u0439
        \u0437\u0432\u0443\u043A."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_10
    LocalizationDatas:
    - Language: 0
      Text: "\u0426\u0435 \u0431\u0443\u0432 \u0442\u0438\u0445\u0435\u043D\u044C\u043A\u0438\u0439
        \u043F\u043B\u0430\u0447 \u043D\u043E\u0432\u043E\u043D\u0430\u0440\u043E\u0434\u0436\u0435\u043D\u043E\u0457
        \u0434\u0438\u0442\u0438\u043D\u0438."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_11
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u0454\u0457 \u0434\u0438\u0442\u0438\u043D\u0438, \u0443
        \u0442\u0456\u0439 \u0432\u0435\u0440\u0441\u0456\u0457 \u0432\u0441\u0435\u0441\u0432\u0456\u0442\u0443,
        \u0434\u0435 \u043C\u0435\u043D\u0456 \u0432 \u0440\u0443\u043A\u0438 \u043D\u0456\u043A\u043E\u043B\u0438
        \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u043F\u043B\u044F\u043B\u0430
        \u0444\u043E\u0442\u043E\u043A\u0430\u043C\u0435\u0440\u0430. \u042F \u0441\u043F\u0440\u043E\u0431\u0443\u0432\u0430\u043B\u0430
        \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0433\u043B\u0438\u0431\u0448\u0435,
        \u043D\u0435\u043C\u043E\u0432 \u0432\u0438\u0432\u0447\u0430\u044E\u0447\u0438
        \u0434\u0435\u0442\u0430\u043B\u0456 \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A\u0443
        \u0441\u0432\u0456\u0442\u043B\u0430 \u0432 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_12
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043C \u044F \u043F\u043E\u0431\u0430\u0447\u0438\u043B\u0430
        \u0457\u0457 \u2014 \u0449\u0430\u0441\u043B\u0438\u0432\u0443 \u043C\u0430\u0442\u0438
        \u0437 \u043C\u0430\u043B\u044E\u043A\u043E\u043C \u043D\u0430 \u0440\u0443\u043A\u0430\u0445,
        \u044F\u043A\u0430 \u0434\u0438\u0432\u0438\u043B\u0430\u0441\u044F \u0432
        \u0433\u043B\u0438\u0431\u043E\u043A\u0456, \u0446\u0456\u043A\u0430\u0432\u0456
        \u043E\u0447\u0456 \u043D\u043E\u0432\u043E\u043D\u0430\u0440\u043E\u0434\u0436\u0435\u043D\u043E\u0433\u043E
        \u0439 \u0431\u0430\u0447\u0438\u043B\u0430 \u0432 \u043D\u0438\u0445 \u043C\u0435\u043D\u0435,
        \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u0456\u0441\u0442\u044C
        \u0442\u0430 \u0449\u0430\u0441\u0442\u044F."
    - Language: 1
      Text: 
  - Key: scene_6_199_part_13
    LocalizationDatas:
    - Language: 0
      Text: "\u041D\u0430\u0448\u0456 \u0441\u0432\u0456\u0434\u043E\u043C\u043E\u0441\u0442\u0456
        \u0437\u043B\u0438\u043B\u0438\u0441\u044F \u0440\u0430\u0437\u043E\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u0422\u0430\u043A\u0438\u043C \u0431\u0443\u0432 \u043C\u0456\u0439
        \u0432\u0438\u0431\u0456\u0440."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043D\u0435 \u0445\u043E\u0442\u0456\u043B\u0430 \u0432\u0456\u0434\u043C\u043E\u0432\u043B\u044F\u0442\u0438\u0441\u044F
        \u0432\u0456\u0434 \u0441\u0432\u043E\u0433\u043E \u0436\u0438\u0442\u0442\u044F.
        \u0422\u0430\u043A, \u043C\u043E\u0436\u043B\u0438\u0432\u043E, \u044F \u043D\u0430\u043A\u043E\u0457\u043B\u0430
        \u0431\u0430\u0433\u0430\u0442\u043E \u043F\u043E\u043C\u0438\u043B\u043E\u043A,
        \u044F\u043A \u0456 \u0456\u043D\u0448\u0456 \u0432\u0435\u0440\u0441\u0456\u0457
        \u043C\u0435\u043D\u0435. \u0427\u0435\u0440\u0435\u0437 \u0446\u0435 \u043C\u0438
        \u0437\u0430\u0441\u0442\u0440\u044F\u0433\u043B\u0438 \u0432 \u043D\u0435\u0441\u043A\u0456\u043D\u0447\u0435\u043D\u043D\u043E\u043C\u0443
        \u043A\u043E\u043B\u0435\u0441\u0456 \u0441\u0442\u0440\u0430\u0436\u0434\u0430\u043D\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u043B\u0435 \u043A\u043E\u0436\u043D\u0430 \u0437 \u043D\u0430\u0441,
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043E\u043A, \u043C\u0430\u043B\u0430
        \u043C\u043E\u0436\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u0438
        \u0431\u0456\u0433\u0442\u0438 \u0439 \u0437\u0456\u0439\u0442\u0438 \u0437
        \u043A\u043E\u043B\u0435\u0441\u0430. \u0414\u043B\u044F \u0446\u044C\u043E\u0433\u043E
        \u043F\u043E\u0442\u0440\u0456\u0431\u043D\u043E \u0445\u043E\u0447 \u0440\u0430\u0437
        \u0437\u0443\u043F\u0438\u043D\u0438\u0442\u0438\u0441\u044F. \u0412\u0456\u0447-\u043D\u0430-\u0432\u0456\u0447
        \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044F \u0437\u0456
        \u0441\u0432\u043E\u0457\u043C\u0438 \u0441\u0442\u0440\u0430\u0445\u0430\u043C\u0438,
        \u043D\u0430\u0441\u043B\u0456\u0434\u043A\u0430\u043C\u0438 \u0434\u0456\u0439
        \u0442\u0430 \u043D\u0435\u0432\u0434\u0430\u0447\u0430\u043C\u0438 \u2014
        \u0431\u0435\u0437 \u0441\u043F\u0440\u043E\u0431 \xAB\u0437\u0456\u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438\xBB
        \u0443 \u044F\u043A\u0443\u0441\u044C \u043A\u0440\u0430\u0449\u0443 \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0456\u0437\u043D\u0456\u0448\u0435 \u0406\u043B\u043E\u043D\u0430
        \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u043A\u0440\u0430\u0434\u0435\u043D\u0438\u0439
        \u0431\u0443\u0440\u0448\u0442\u0438\u043D. \u0407\u0457 \u0432\u0434\u0430\u043B\u043E\u0441\u044F
        \u043C\u0430\u0439\u0436\u0435 \u0432\u0438\u043F\u0440\u0430\u0432\u0434\u0430\u0442\u0438,
        \u0434\u0456\u0432\u0447\u0438\u043D\u0430 \u043D\u0435 \u0437\u0430\u0437\u043D\u0430\u043B\u0430
        \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043F\u043E\u043A\u0430\u0440\u0430\u043D\u043D\u044F,
        \u043B\u0438\u0448\u0435 \u0443\u043C\u043E\u0432\u043D\u0438\u0439 \u0442\u0435\u0440\u043C\u0456\u043D
        \u0437\u0430 \u0441\u043F\u0440\u0438\u044F\u043D\u043D\u044F \u0437\u043B\u043E\u0447\u0438\u043D\u043D\u0438\u043C
        \u043E\u0440\u0433\u0430\u043D\u0456\u0437\u0430\u0446\u0456\u044F\u043C."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u043E\u044F \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0430
        \u0434\u043E\u043B\u044F \u0441\u043A\u043B\u0430\u043B\u0430\u0441\u044F
        \u043D\u0435 \u0441\u043E\u043B\u043E\u0434\u043A\u043E. \u0410\u0431\u0438
        \u0445\u043E\u0447 \u044F\u043A\u043E\u0441\u044C \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0438
        \u0442\u0435, \u0449\u043E \u0442\u0440\u0430\u043F\u0438\u043B\u043E\u0441\u044F
        \u0432 \u0411\u043B\u0438\u0441\u043A\u0443\u0447\u043E\u043C\u0443, \u044F
        \u0432\u0437\u044F\u043B\u0430 \u043F\u0440\u043E\u0432\u0438\u043D\u0443
        \u0437\u0430 \u0432\u0431\u0438\u0432\u0441\u0442\u0432\u043E \u043D\u0430
        \u0441\u0435\u0431\u0435. \u0417\u0440\u0435\u0448\u0442\u043E\u044E, \u0442\u0430\u043A
        \u0446\u0435 \u0439 \u0431\u0443\u043B\u043E."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0430\u0439\u0436\u0435 \u0432\u0435\u0441\u044C \u0437\u0430\u043B\u0438\u0448\u043E\u043A
        \u0436\u0438\u0442\u0442\u044F \u044F \u043C\u0430\u043B\u0430 \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
        \u0443 \u0432\u2019\u044F\u0437\u043D\u0438\u0446\u0456. \u0422\u0430\u043A,
        \u043C\u043E\u044F \u0440\u0435\u0430\u043B\u044C\u043D\u0456\u0441\u0442\u044C
        \u043D\u0435 \u0431\u0443\u043B\u0430 \u0432\u0435\u0441\u0435\u043B\u043E\u044E
        \u0456 \u0449\u0430\u0441\u043B\u0438\u0432\u043E\u044E. \u0412\u043E\u043D\u0430
        \u0432\u0438\u044F\u0432\u0438\u043B\u0430\u0441\u044F \u043B\u0438\u0448\u0435
        \u0441\u0443\u0432\u043E\u0440\u043E \u0447\u0435\u0441\u043D\u043E\u044E."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_7
    LocalizationDatas:
    - Language: 0
      Text: "\u042F \u043F\u043E\u043A\u043B\u044F\u043B\u0430\u0441\u044F \u043D\u0456\u043A\u043E\u043B\u0438
        \u0431\u0456\u043B\u044C\u0448\u0435 \u043D\u0435 \u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438\u0441\u044F
        \u0441\u0432\u043E\u0454\u044E \u0441\u0443\u043F\u0435\u0440\u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044E.
        \u0406, \u0437\u0440\u0435\u0448\u0442\u043E\u044E, \u043D\u0430\u0432\u0447\u0438\u043B\u0430\u0441\u044F
        \u0436\u0438\u0442\u0438 \u0442\u0430\u043A, \u0449\u043E\u0431\u0438 \u043F\u0440\u0438\u0439\u043C\u0430\u0442\u0438
        \u0434\u043E\u043B\u044E, \u0430 \u043D\u0435 \u0442\u0456\u043A\u0430\u0442\u0438
        \u0432\u0456\u0434 \u043D\u0435\u0457. \u0426\u0435 \u0431\u0443\u0432 \u0436\u043E\u0440\u0441\u0442\u043E\u043A\u0438\u0439
        \u0443\u0440\u043E\u043A, \u0430\u043B\u0435 \u044F \u0440\u0430\u0434\u0430,
        \u0449\u043E \u0437\u043C\u043E\u0433\u043B\u0430 \u0445\u043E\u0447 \u0456\u0437
        \u043A\u0438\u043C\u043E\u0441\u044C \u043D\u0438\u043C \u043F\u043E\u0434\u0456\u043B\u0438\u0442\u0438\u0441\u044F."
    - Language: 1
      Text: 
  - Key: scene_1_200_part_8
    LocalizationDatas:
    - Language: 0
      Text: "\u0410\u0434\u0436\u0435 \u044F\u043A\u0438\u043C\u0438 \u0431 \u0432\u0430\u0436\u043B\u0438\u0432\u0438\u043C\u0438
        \u043C\u0438 \u0441\u043E\u0431\u0456 \u043D\u0435 \u0432\u0432\u0438\u0436\u0430\u043B\u0438\u0441\u044F,
        \u0443\u0441\u0435 \u043E\u0434\u043D\u043E \u0443 \u0432\u0435\u043B\u0438\u0447\u0435\u0437\u043D\u0456\u0439
        \u043A\u0456\u043B\u044C\u043A\u043E\u0441\u0442\u0456 \u043F\u043E\u0434\u0456\u0439,
        \u044F\u043A\u0456 \u0432\u0436\u0435 \u0432\u0456\u0434\u0431\u0443\u043B\u0438\u0441\u044F,
        \u0430 \u0442\u0430\u043A\u043E\u0436 \u0442\u0438\u0445, \u0449\u043E \u0442\u0456\u043B\u044C\u043A\u0438
        \u043C\u043E\u0433\u043B\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u044F,
        \u0430\u0431\u043E \u044F\u043A\u0456 \u043C\u0438 \u043D\u0430\u0432\u0456\u0442\u044C
        \u043D\u0435 \u0441\u043C\u0456\u043B\u0438 \u0441\u043E\u0431\u0456 \u0443\u044F\u0432\u0438\u0442\u0438,
        \u043D\u0430\u0448\u0435 \u0436\u0438\u0442\u0442\u044F \u0431\u0443\u043B\u043E
        \u043B\u0438\u0448\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u044E
        \u043C\u0438\u0442\u0442\u044E, \u043D\u0435\u043C\u043E\u0432 \u0432\u0456\u0434\u0431\u043B\u0438\u0441\u043A
        \u0441\u0432\u0456\u0442\u043B\u0430 \u0432 \u0431\u0443\u0440\u0448\u0442\u0438\u043D\u0456."
    - Language: 1
      Text: 
  - Key: scene_8_202_part_1
    LocalizationDatas:
    - Language: 0
      Text: "\u041E\u0441\u044C \u0442\u0430\u043A\u043E\u044E \u0431\u0443\u043B\u0430
        \u0446\u044F \u0456\u0441\u0442\u043E\u0440\u0456\u044F. \u041D\u0430\u043F\u0435\u0432\u043D\u043E,
        \u0432\u0438 \u0432\u0432\u0430\u0436\u0430\u0454\u0442\u0435 \u043C\u0435\u043D\u0435
        \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u044C\u043D\u043E\u044E, \u0442\u0430\u043A?
        \u0410\u043B\u0435 \u043C\u0435\u043D\u0456 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E.
        \u042F \u043B\u0438\u0448\u0435 \u043F\u0435\u0440\u0435\u043A\u0430\u0437\u0430\u043B\u0430
        \u0442\u0435, \u0449\u043E \u0441\u0442\u0430\u043B\u043E\u0441\u044F \u043D\u0430\u0441\u043F\u0440\u0430\u0432\u0434\u0456."
    - Language: 1
      Text: 
  - Key: scene_8_202_part_2
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0438 \u0432\u0456\u0440\u0438\u043C\u043E \u0432\u0430\u043C,
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E."
    - Language: 1
      Text: 
  - Key: scene_8_202_part_3
    LocalizationDatas:
    - Language: 0
      Text: "\u0406 \u0449\u043E \u0436? \u041D\u0430\u0449\u043E \u043F\u0440\u0438\u0439\u0448\u043B\u0438
        \u0442\u0430 \u0437\u043C\u0443\u0441\u0438\u043B\u0438 \u043C\u0435\u043D\u0435
        \u043F\u0440\u0438\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u0432\u0441\u0456
        \u0446\u0456 \u043F\u043E\u0434\u0456\u0457?"
    - Language: 1
      Text: 
  - Key: scene_8_202_part_4
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0438 \u0445\u043E\u0447\u0435\u043C\u043E \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0438
        \u0432\u0430\u0441 \u043F\u043E\u0440\u0443\u0448\u0438\u0442\u0438 \u043A\u043B\u044F\u0442\u0432\u0443.
        \u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0437\u0434\u0456\u0431\u043D\u043E\u0441\u0442\u0456
        \u0437\u043D\u043E\u0432\u0443."
    - Language: 1
      Text: 
  - Key: scene_8_202_part_5
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0440\u043E\u0431\u0430\u0447\u0442\u0435, \u043D\u0435 \u0440\u043E\u0437\u0447\u0443\u043B\u0430?"
    - Language: 1
      Text: 
  - Key: scene_8_202_part_6
    LocalizationDatas:
    - Language: 0
      Text: "\u041C\u0438 \u0437\u0431\u0438\u0440\u0430\u0454\u043C\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0443,
        \u0412\u0456\u043B\u044C\u0448\u0430\u043D\u043A\u043E. \u0422\u0430\u043A\u0438\u0445
        \u0441\u0430\u043C\u0435 \u043E\u0441\u043E\u0431\u043B\u0438\u0432\u0438\u0445,
        \u044F\u043A \u0456 \u0432\u0438. \u0412\u0456\u0434 \u0446\u044C\u043E\u0433\u043E
        \u043C\u043E\u0436\u0435 \u0437\u0430\u043B\u0435\u0436\u0430\u0442\u0438
        \u0434\u043E\u043B\u044F \u0432\u0441\u0456\u0454\u0457 \u043A\u0440\u0430\u0457\u043D\u0438\u2026"
    - Language: 1
      Text: 
