  - Key: ADVANCE_DIALOG
    LocalizationDatas:
    - Language: 0
      Text: "\u041F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u043D\u043D\u044F \u0434\u0456\u0430\u043B\u043E\u0433\u0456\u0432"
